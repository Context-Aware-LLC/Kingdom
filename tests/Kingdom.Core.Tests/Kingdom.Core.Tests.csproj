<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kingdom.Core.Tests — the headless determinism base of the test pyramid (dev-docs/quality/testing-and-ci.md:20).
    Plain `dotnet test`, NO Unity license. Holds L1 (unit), L2 (contract), L3 (golden-replay, the R1
    gate), and the assembly-firewall + banned-API scans (dev-docs/quality/testing-and-ci.md:10).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kingdom.Core.Contracts\Kingdom.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Kingdom.Core.Serialization\Kingdom.Core.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Kingdom.Core.Cards\Kingdom.Core.Cards.csproj" />
    <ProjectReference Include="..\..\src\Kingdom.Core\Kingdom.Core.csproj" />
    <ProjectReference Include="..\..\src\Kingdom.Core.Collection\Kingdom.Core.Collection.csproj" />

    <!-- The ADR-0009 migration TOOL, referenced for its pure Plan() only. It is what decides what
         happens to a player's only copy of their decks, so it is tested here rather than trusted;
         nothing else in this assembly touches it, and it comes out with the tool. -->
    <ProjectReference Include="..\..\src\Kingdom.Tools.CollectionMigrate\Kingdom.Tools.CollectionMigrate.csproj" />
    <!-- A5: referenced so the firewall/banned-API scans can Assembly.Load the wire assembly. -->
    <ProjectReference Include="..\..\src\Kingdom.Net.Protocol\Kingdom.Net.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity-free gesture policy: compile the production model into headless tests so target-plan
         changes do not require launching the Unity editor to verify. -->
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\DragTargetingModel.cs"
             Link="Presentation\DragTargetingModel.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Session\HeroPowerBeat.cs"
             Link="Session\HeroPowerBeat.cs" />
    <!-- #139: placement is solved from the drop's x, so the gesture model needs the row's
         arithmetic. BoardRowGeometry is UnityEngine-free for exactly this reason. -->
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\BoardRowGeometry.cs"
             Link="Presentation\BoardRowGeometry.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\OngoingEffectStatusModel.cs"
             Link="Presentation\OngoingEffectStatusModel.cs" />
    <!-- Card SFX event routing is Unity-free; audio loading/playback remains in the Unity-only director. -->
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\CardSoundCueRouter.cs"
             Link="Presentation\CardSoundCueRouter.cs" />
    <!-- Hero-impact event classification is Unity-free; native haptics and camera motion stay in Unity. -->
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\HeroImpactFeedbackPolicy.cs"
             Link="Presentation\HeroImpactFeedbackPolicy.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\MinionSummonArchetypes.cs"
             Link="Presentation\MinionSummonArchetypes.cs" />
    <!-- Unearth snapshot interpretation is Unity-free so reconnect/redaction/order behavior can
         be proved without taking the machine-wide Unity Editor seat. -->
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\UnearthChoiceModel.cs"
             Link="Presentation\UnearthChoiceModel.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\TurnSealRecord.cs"
             Link="Presentation\TurnSealRecord.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\MatchOpeningDeal.cs"
             Link="Presentation\MatchOpeningDeal.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\BackgroundVariantPolicy.cs"
             Link="Presentation\BackgroundVariantPolicy.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Presentation\TablePropRules.cs"
             Link="Presentation\TablePropRules.cs" />
    <!-- Unity-free authoring model/writer: compile and round-trip them without launching Unity. -->
    <Compile Include="..\..\unity\Assets\Scripts\Editor\EditableCard.cs"
             Link="Editor\EditableCard.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Editor\CardJsonRowIO.cs"
             Link="Editor\CardJsonRowIO.cs" />
  </ItemGroup>

</Project>
