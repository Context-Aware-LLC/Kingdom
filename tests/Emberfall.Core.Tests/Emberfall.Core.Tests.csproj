<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Core.Tests — the headless determinism base of the test pyramid (dev-docs/quality/testing-and-ci.md:20).
    Plain `dotnet test`, NO Unity license. Holds L1 (unit), L2 (contract), L3 (golden-replay, the R1
    gate), and the assembly-firewall + banned-API scans (dev-docs/quality/testing-and-ci.md:10).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Emberfall.Core.Contracts\Emberfall.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core.Serialization\Emberfall.Core.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core.Cards\Emberfall.Core.Cards.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core\Emberfall.Core.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core.Collection\Emberfall.Core.Collection.csproj" />
    <!-- A5: referenced so the firewall/banned-API scans can Assembly.Load the wire assembly. -->
    <ProjectReference Include="..\..\src\Emberfall.Net.Protocol\Emberfall.Net.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity-free gesture policy: compile the production model into headless tests so target-plan
         changes do not require launching the Unity editor to verify. -->
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\DragTargetingModel.cs"
             Link="Presentation\DragTargetingModel.cs" />
    <!-- #139: placement is solved from the drop's x, so the gesture model needs the row's
         arithmetic. BoardRowGeometry is UnityEngine-free for exactly this reason. -->
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\BoardRowGeometry.cs"
             Link="Presentation\BoardRowGeometry.cs" />
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\OngoingEffectStatusModel.cs"
             Link="Presentation\OngoingEffectStatusModel.cs" />
    <!-- Card SFX event routing is Unity-free; audio loading/playback remains in the Unity-only director. -->
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\CardSoundCueRouter.cs"
             Link="Presentation\CardSoundCueRouter.cs" />
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\MinionSummonArchetypes.cs"
             Link="Presentation\MinionSummonArchetypes.cs" />
    <!-- Unearth snapshot interpretation is Unity-free so reconnect/redaction/order behavior can
         be proved without taking the machine-wide Unity Editor seat. -->
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Presentation\UnearthChoiceModel.cs"
             Link="Presentation\UnearthChoiceModel.cs" />
    <!-- Unity-free authoring model/writer: compile and round-trip them without launching Unity. -->
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Editor\EditableCard.cs"
             Link="Editor\EditableCard.cs" />
    <Compile Include="..\..\unity\Emberfall\Assets\Scripts\Editor\CardJsonRowIO.cs"
             Link="Editor\CardJsonRowIO.cs" />
  </ItemGroup>

</Project>
