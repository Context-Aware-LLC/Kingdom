<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Net.Client.Tests — the B3 client-seam tests (dev-docs/quality/testing-and-ci.md:22),
    hard-blocking via the existing CI category stages (Unit/Contract), slnx membership IS the
    enrollment (a5 §11 / b1 §2). The peer is B1's REAL MatchSession over the loopback transport
    (§8, RC-F9): this project references Emberfall.Net.Server so the authority under test is the
    shipped one, never a hand-written fake. Emberfall.Net.Client itself must NEVER reference the
    server — that direction is asserted by FirewallTests (§11.8, OQ-B).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Emberfall.Core.Contracts\Emberfall.Core.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core.Cards\Emberfall.Core.Cards.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core.Serialization\Emberfall.Core.Serialization.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Core\Emberfall.Core.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Net.Protocol\Emberfall.Net.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Net.Server\Emberfall.Net.Server.csproj" />
    <ProjectReference Include="..\..\src\Emberfall.Net.Client\Emberfall.Net.Client.csproj" />
  </ItemGroup>

</Project>
