<Project>
  <!--
    A compiler warning in a test project is a build failure, matching src/Directory.Build.props.
    Test code is where a silently-ignored warning does the most damage: CS8600 here was a real
    null-into-non-nullable in TurnTimerSeamTests that had been printing on every build for long
    enough to become invisible.

    SCOPED TO tests/ ON PURPOSE, for the same reason src/ is — a repo-root Directory.Build.props
    would also reach Unity's generated .csproj files, which tools/ci/unity-compile.ps1 builds with
    `dotnet build`, and fail that gate on warnings in source nobody here authors.

    Suppress a deliberate warning at its declaration with a justification comment rather than
    adding it to NoWarn here; a blanket exemption also hides the next genuine instance.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Quiets the in-process server's stderr in test output; the file says why. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
