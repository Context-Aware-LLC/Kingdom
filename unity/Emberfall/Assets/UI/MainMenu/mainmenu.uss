/*
 * mainmenu.uss — S1 front door styles. Consumes tokens from theme.uss only (no literal
 * colors/sizes a token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 *
 * THIS WARNING LIVES HERE BECAUSE UI BUILDER DELETES UXML COMMENTS. Opening
 * MainMenuScreen.uxml in Unity's UI Builder rewrites the file and strips every comment in it
 * — 87 lines of documentation went that way on 2026-07-31, including this warning, which is
 * why it now sits in the stylesheet instead. Unity does not rewrite .uss.
 *
 * NEVER write a BEM modifier's double dash inside a UXML comment. XML forbids that sequence
 * in a comment, so the importer fails the WHOLE file, CloneTree() returns zero children,
 * every Q<>() is null, and NOTHING is logged — the screen is simply empty. Refer to modifier
 * classes in words ("the hidden modifier"), never by writing the literal class name in a
 * comment. `Emberfall/UI/Check UXML Integrity` catches it if it happens again.
 */

.main-menu {
    flex-grow: 1;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/MainMenu_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    /* 24dp each side, not --space-12's 48dp: 96dp of a 411dp landscape panel went to padding
       alone. Edge clearance is NOT this padding's job -- that is .emb-edge on the chrome. */
    padding: var(--space-6);
}

/* Boot state: hidden until MainMenuController.RevealMenu() runs (LoadingOverlay covers frame 0
 * instead). visibility:hidden, NOT display:none: this root is the panel's only top-level
 * element, so display:none here means Yoga never runs a single layout pass on it (unlike a
 * modal, which starts hidden too but sits inside an already-laid-out root) - flipping display
 * back on later leaves worldBound stuck at NaN and nothing ever draws. visibility keeps it in
 * the layout tree (bounds always valid) while still suppressing paint and click-through. */
.mm-root--hidden {
    visibility: hidden;
}

/* Dark scrim over the plate so the wordmark + buttons stay legible (design-system §4.5). */
.mm-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.42);
}

/* ---------- Brand ---------- */
.mm-brand {
    align-items: center;
    /* 24dp, not --space-16's 64dp. 64 was authored when the panel scaled by pixel count and the
       column had far more vertical room; at referenceDpi 160 it was 64 of the 411dp the whole
       screen gets. See the budget note on .mm-menu (#249). */
    margin-bottom: var(--space-6);
}
/* 72px HARDCODED was the last survivor of the pre-refDpi-160 authoring, and it is the same
   artifact the margin note above records: at referenceDpi 160 one authored px is one Android dp,
   so 72 was 72 of the 411dp the landscape panel gets, and 'EMBERFALL' plus 8dp of tracking ran
   about 57% of the 920dp width — over the identity plate on one side and the shard pill on the
   other. It was also a raw px, so it was the one piece of type on this screen that did NOT step
   with the screen classes. Now a token, and part of the run. */
.mm-wordmark {
    font-size: var(--type-wordmark);
    -unity-font-style: bold;
    color: var(--ink-1);
    letter-spacing: 4px;
}
.mm-tagline {
    font-size: var(--type-h2);
    color: var(--accent);
    margin-top: var(--space-2);
    letter-spacing: 2px;
}

/* ---------- Menu column ----------
 * One carved control, not five floating buttons. The column is a single slab with a
 * dimmed-accent frame and rounded corners; the buttons are slats that touch edge-to-edge
 * and clip to the group's rounded corners (overflow: hidden). A dark hairline between
 * slats reads as a groove cut into the stone. (Version A — segmented tablet.)
 */
.mm-menu {
    align-items: stretch;
    min-width: 300px;
    /* flex-shrink:0 IS LOAD-BEARING, and its absence deleted two buttons from the front door.
       At referenceDpi 160 a 1080-tall landscape panel is 411dp. The column asked for ~432dp
       (96 padding + ~112 brand + 64 brand margin + 4 slats x 64), so this group -- the only
       shrinkable thing in the column -- absorbed the whole ~117dp overflow, and `overflow: hidden`
       below then clipped the last two slats to nothing. Store and Leaderboards were in the UXML,
       wired in the controller, laid out, and invisible, with no warning anywhere. Measured on a
       Pixel 5a, 2026-08-23 (#249).
       The padding and brand margin below were cut in the same change to make the column fit;
       whoever grows either one back must re-check that four slats still fit in 411dp. */
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.35);        /* dark inscribed edge — reads as carved, not glowing */
    border-radius: var(--space-3);
    overflow: hidden;                            /* slats clip to the rounded group */
}
.mm-button {
    font-size: var(--type-h2);                   /* 22dp. Was bumped to 30px on 2026-08-21 to
                                                    survive the reference-resolution scale; the
                                                    panels are physical-size now and the token
                                                    lands at its stated size. */
    -unity-font-style: bold;
    color: var(--ink-1);
    background-color: rgba(30, 37, 48, 0);      /*fully transparent — backdrop shows straight through (styling base) */
    border-width: 0;
    
    border-radius: 0;                            /* the group owns the shape, not the slat */
    border-top-width: 1px;                       /* groove between slats */
    border-top-color: rgba(11, 14, 19, 0.55);
    height: 56px;                                /* 56dp — still 8dp over Android's 48dp touch floor.
                                                    88 -> 64 when the scale was corrected (#233);
                                                    64 -> 56 to close the last 32dp of the 117dp
                                                    landscape overflow that was eating two slats
                                                    (#249). Do not go below 48. */
    margin-bottom: 0;                            /* slats touch */
    padding: 0 var(--space-6);
    letter-spacing: 1px;
}
.mm-button:hover {
    background-color: rgba(42, 51, 64, 0.45);   /* --surface-3, light wash — backdrop still reads through */
}
.mm-button:active {
    background-color: rgba(20, 25, 34, 0.95);   /* --surface-1 */
}
/* Find Game — visually identical to the other slats on arrival (no ember fill). The only
 * override is positional: it's the top of the stack, so it carries no groove hairline under
 * the frame's top edge. Hover/active fall through to the shared .mm-button states. */
.mm-button--cta {
    border-top-width: 0;
}

/* ---------- Shard balance ----------
 * Top-right, mirroring the identity plate. These percentages are the no-inset fallback; the
 * controller adds Screen.safeArea's normalized top/right inset at runtime and keeps this plate
 * inside cutouts and system bars as they change.
 */
.mm-shard-balance {
    position: absolute;
    top: var(--space-6);                         /* was 2% — a percentage of the WIDTH, so it
                                                    moved with aspect and landed differently on
                                                    every device. Edge clearance comes from
                                                    .emb-edge in theme.uss; this is the gutter. */
    right: var(--space-6);
    min-width: 12%;
    font-size: var(--type-label);                /* 16dp. Was --type-h2 to survive the old scale. */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-1);
    background-color: rgba(20, 25, 34, 0.55);
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.7);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
}

/* ---------- Identity plate ----------
 * Top-left: who you are on this device, with your active character and deck. It was a Button
 * while renaming was its one affordance; names are permanent now (NOR-287), so it is a plain
 * VisualElement with no hover state — nothing about it should read as pressable.
 * Row layout: showcase image left, name+deck text stack right (NOR-289).
 */
.mm-identity {
    position: absolute;
    top: var(--space-6);                         /* clearance is .emb-edge's, not this rule's */
    left: var(--space-6);
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 25, 34, 0.55);
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.7);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
}
.mm-identity__showcase {
    width: 72px;
    height: 90px;
    border-radius: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(11, 14, 19, 0.55);
    flex-shrink: 0;
    margin-right: var(--space-3);
}
.mm-identity__text {
    flex-direction: column;
    align-items: flex-start;
}
.mm-identity__name {
    font-size: var(--type-label);                /* 16dp. Was --type-h2 to survive the old scale. */
    -unity-font-style: bold;
    color: var(--ink-1);
}
.mm-identity__deck {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-top: var(--space-1);
}

/* ---------- Account switcher rows ---------- */
.mm-accounts {
    flex-direction: column;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}
.mm-account-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--space-1);
    background-color: rgba(20, 25, 34, 0.45);
    margin-bottom: var(--space-2);
}
.mm-account-row--active {
    background-color: rgba(42, 51, 64, 0.75);
    border-left-width: 3px;
    border-left-color: var(--accent);
}
.mm-account-row__label {
    font-size: var(--type-label);
    color: var(--ink-1);
    flex-grow: 1;
}
.mm-account-row__sub {
    font-size: var(--type-caption);
    color: var(--ink-2);
}
.mm-account-row__button {
    font-size: var(--type-caption);
    padding: 2px var(--space-3);
    margin-left: var(--space-2);
}

/* ---------- Modals ----------
 * Full-screen backdrop + a centred panel. The backdrop is opaque enough to read as modal and
 * picks up clicks itself (UI Toolkit will not block the menu underneath otherwise).
 */
.mm-modal {
    position: absolute;
    /* These four are not decoration. Without them the backdrop shrink-wraps its panel and sits at
       its STATIC position, so it stops covering the menu AND the two modals stack on each other at
       the same spot instead of each filling the screen in turn. Measured 2026-08-23. */
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.78);
}
.mm-modal--hidden {
    display: none;
}
/* A modal whose content is a LIST wants the height. `.emb-bleed` insets all four sides by
 * --edge-safe (52), which spends 104 of a 411 landscape panel — a quarter of the screen — and the
 * camera cutout it exists for is on a SIDE edge in landscape, never the top or bottom. Left and
 * right therefore keep the full clearance and only the vertical is reduced.
 *
 * LONGHANDS, not the `padding` shorthand. The shorthand would replace the horizontal clearance
 * too, and that is the exact defeat `tooling/scripts/audit_edge_safety.py` PASS 6 exists to fail —
 * a rule on this element outranking .emb-bleed on the same property, silently.
 *
 * RETIREMENT TRIGGER: if this project ever ships in portrait, or --edge-safe stops meaning "cutout
 * clearance", the top/bottom edges stop being free and this rule has to go. */
.mm-modal--tall {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
}
.mm-modal__panel {
    width: 520px;
    max-width: 90%;
    /* The panel may never be taller than the screen it is centred in. A flex child that overflows a
       justify-content:center parent overflows EQUALLY at both ends, so the first field goes off the
       TOP edge with no way to reach it — that is what hid the sign-in email field. */
    max-height: 100%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-8);
}
.mm-modal__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    white-space: normal;
}
.mm-modal__help {
    font-size: var(--type-caption);
    color: var(--ink-2);
    white-space: normal;
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
}
.mm-modal__field {
    font-size: var(--type-h2);
    margin-bottom: var(--space-2);
}
.mm-modal__field > .unity-base-text-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    padding: var(--space-3);
    color: var(--ink-1);
    /* The caret defaults to black when unset, invisible against this near-black background —
       a focused field looked unresponsive with nothing wrong functionally. */
    --unity-cursor-color: var(--ink-1);
}
.mm-modal__dropdown {
    margin-bottom: var(--space-2);
}
.mm-modal__dropdown .unity-base-field__label {
    color: var(--ink-2);
    font-size: var(--type-label);
    min-width: 96px;
}
.mm-modal__dropdown .unity-base-popup-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
}
/* The selected class is permanent player-facing data; style its text directly instead of depending
 * on the popup input's inherited color. */
.mm-modal__dropdown .unity-base-popup-field__text {
    color: var(--ink-1);
}
/* Reserves its line whether or not there is an error, so confirming does not shift the buttons. */
.mm-modal__error {
    font-size: var(--type-caption);
    color: var(--negative);
    white-space: normal;
    min-height: 18px;
    margin-bottom: var(--space-4);
}
.mm-modal__actions {
    flex-direction: row;
    justify-content: flex-end;
}
.mm-modal__button {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    height: var(--touch-min);
    padding: 0 var(--space-6);
    margin-left: var(--space-2);
}
.mm-modal__button:hover {
    background-color: var(--surface-3);
}
.mm-modal__button--cta {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--surface-0);
}
.mm-modal__button--cta:hover {
    background-color: rgb(250, 186, 90);
}
.mm-modal__button--cta:disabled {
    background-color: var(--surface-2);
    border-color: var(--surface-3);
    color: var(--ink-2);
}

/* ---------- Ranked ladder ---------- */
.mm-leaderboard {
    width: 820px;
    max-width: 100%;
    height: 100%;
    padding: var(--space-6);
    border-color: rgba(240, 166, 60, 0.55);
}
/* Title and close on ONE row, close hard right. The title takes the growth, so there is no wrapper
 * element between it and the header — a `__heading` box existed only to stack a kicker above the
 * title, and the kicker is gone. */
.mm-leaderboard__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-4);
}
.mm-leaderboard__title {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--ink-1);
    font-size: var(--type-h1);
    -unity-font-style: bold;
}
.mm-leaderboard__close {
    margin-left: var(--space-6);
}
.mm-leaderboard__columns,
.mm-leaderboard__row {
    flex-direction: row;
    align-items: center;
}
.mm-leaderboard__columns {
    min-height: 30px;
    color: var(--ink-2);
    font-size: var(--type-caption);
    -unity-font-style: bold;
    padding: 0 var(--space-3);
}
.mm-leaderboard__list {
    flex-grow: 1;
    flex-shrink: 1;
}
.mm-leaderboard__row {
    min-height: var(--touch-min);
    background-color: var(--surface-2);
    border-bottom-width: 1px;
    border-color: var(--surface-3);
    padding: 0 var(--space-3);
}
.mm-leaderboard__row--even {
    background-color: rgba(30, 37, 48, 0.72);
}
.mm-leaderboard__row--podium {
    border-left-width: 3px;
    border-left-color: var(--accent);
}
.mm-leaderboard__rank {
    width: 64px;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
}
.mm-leaderboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-font-style: bold;
}
.mm-leaderboard__rating {
    width: 100px;
    color: var(--accent);
    font-size: var(--type-body);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
.mm-leaderboard__record {
    width: 150px;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-right;
}
.mm-leaderboard__status {
    flex-grow: 1;
    justify-content: center;
    color: var(--ink-2);
    font-size: var(--type-body);
    -unity-text-align: middle-center;
    white-space: normal;
}
.mm-leaderboard__status--error {
    color: var(--negative);
}
.mm-leaderboard__status--hidden {
    display: none;
}
.mm-leaderboard__updated {
    color: var(--ink-2);
    font-size: var(--type-caption);
    margin-top: var(--space-3);
}

/* ---------- First-launch sign-in gate (EF-074e / NOR-231) ---------- */
/* Nearly opaque, where an ordinary modal is 0.78. A dialog you can see the menu through reads as
 * something you could dismiss to get back to it; this one cannot be dismissed, and looking
 * dismissible is what would make a player hunt for the close button that is not there. */
.mm-modal--gate {
    background-color: rgba(11, 14, 19, 0.96);
}

/* ---------- First-login sizing (NOR-283, extended NOR-284) ----------
 * Every rule below is scoped to .mm-modal--onboard on purpose. It marks a modal that IS the first
 * launch — the sign-in gate, and the name/password prompt that follows it — on a phone held at arm's
 * length. The ordinary modals (rename, accounts) are things a player opens on top of a menu they can
 * already read, so they must NOT carry this class: they keep the compact base .mm-modal__* size.
 *
 * The gate always onboards, so it gets the class in the UXML. The name modal is REUSED for later
 * renames, so it gets the class only for the required (first-run) state — MainMenuController toggles
 * it in OpenNameModal. Both first-login modals were inheriting a 520px box with 13px help text built
 * for a desktop monitor; on a handset that reads as a small floating dialog on an empty screen rather
 * than the screen itself.
 *
 * Sized in percentages, not pixels: the box should be a fraction of whatever canvas it lands on,
 * which is the one thing a fixed pixel width cannot be. That is still true and is independent of
 * how the panel scales — do not turn these back into pixels.
 * Do not fold these values back into .mm-modal__* — that would resize the rename and account modals.
 */
.mm-modal--onboard .mm-modal__panel {
    width: 72%;
    min-width: 480px;
    max-width: 92%;
    /* HEIGHT is the scarce axis here, not width. The panels are ConstantPhysicalSize at
       referenceDpi 160, so a 1080-tall landscape handset gives roughly 414dp of panel height, and
       the email step stacks title, help, field, error, actions, "or" and the Google button into it.
       48dp of padding at each end spent a quarter of that budget on nothing. Vertical padding is
       --space-6; the horizontal stays --space-12, where there is room to spare. */
    padding: var(--space-6) var(--space-12);
    border-radius: var(--space-4);
}
/* TYPOGRAPHY IS DELIBERATELY ABSENT HERE, and its absence is the fix.
 * Until 2026-08-23 this block also set a 46px title, 26px help, 30px fields, 24px errors and 28px
 * buttons. Those were authored when the panels scaled to a 1920x1080 REFERENCE RESOLUTION, which on
 * a handset delivered every base size at roughly half a millimetre; the overrides were the only
 * thing making the gate readable. The panels are ConstantPhysicalSize at referenceDpi 160 now, so an
 * authored pixel is one Android dp and the base .mm-modal__* scale arrives at the size it claims.
 * Kept, the overrides multiplied a real scale a second time and the gate overflowed the screen.
 * Add a size here only for a reason that survives that sentence. */

/* Touch target, not a pointer target — the one size that does still need saying. The base 44px is a
 * mouse height; Android's floor for a finger is 48dp, which at referenceDpi 160 is 48px. */
.mm-modal--onboard .mm-modal__button {
    height: 48px;
}
/* ---------- Pitch / form columns ----------
 * A COLUMN BY DEFAULT. Both first-login modals wrap their contents in .mm-modal__columns, and in
 * the ordinary (rename, account) case that wrapper does nothing at all — a 520px dialog has no
 * width to give away, and two 236px columns would wrap the title onto three lines.
 */
.mm-modal__columns {
    flex-direction: column;
}
.mm-modal__pitch,
.mm-modal__form {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* A ROW only when the modal IS the first login. Landscape is wide and short, and these two modals
 * are the only ones that have to fit a whole flow into it.
 *
 * Measured on the Pixel-class emulator 2026-08-23 (1080x2400 at density 420 = a 914x411dp panel
 * canvas). As one column BOTH overflowed and BOTH lost the control that ends the step:
 *   - the gate put "or" and the Google button below the fold;
 *   - the name modal clipped the second password field and pushed Continue off the screen
 *     entirely, with no scroll to reach it. That one was a dead end, not a cosmetic problem.
 * In both cases the right half of the panel was empty space beside a two-line help paragraph.
 * Splitting the pitch from the form spends the axis that had room: the gate lands near 276dp and
 * the name modal near 358dp, against 411 available.
 */
.mm-modal--onboard .mm-modal__columns,
.account-create-screen .mm-modal__columns {
    flex-direction: row;
    align-items: flex-start;
}
.mm-modal--onboard .mm-modal__pitch,
.account-create-screen .mm-modal__pitch {
    padding-right: var(--space-8);
}
/* 24dp under every help paragraph was a desktop rhythm. The name modal carries TWO of them and
 * needs the 24 back. */
.mm-modal--onboard .mm-modal__help,
.account-create-screen .mm-modal__help {
    margin-bottom: var(--space-3);
}

/* The code is six characters the player is copying by eye off another screen. Wide tracking and a
 * larger face is the difference between reading it back once and reading it back three times.
 * Must come after .mm-modal__field, which the code field also carries: equal specificity, so this
 * rule wins only by being later in the file. Keep it below the modal block. */
.mm-signin__code {
    font-size: var(--type-h1);
    letter-spacing: 8px;
    -unity-text-align: middle-center;
}
.mm-signin__code > .unity-base-text-field__input {
    -unity-text-align: middle-center;
}
/* A text link, not a third button: resending is a recovery, and giving it a button's weight puts it
 * in competition with the thing the player should actually be doing. */
.mm-signin__resend {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink-2);
    font-size: var(--type-caption);              /* 14dp. Below the 16dp .mm-modal__button so the
                                                  * recovery reads as subordinate to the CTA. Was a
                                                  * bare 24px from the old reference-resolution
                                                  * scale, which made it the LARGEST text in the
                                                  * step. */
    align-self: flex-end;
    padding: var(--space-4) 0 0 0;
    margin-top: var(--space-2);
}
.mm-signin__resend:hover {
    color: var(--ink-1);
}
.mm-signin__resend:disabled {
    color: var(--surface-3);
}
/* A separator label between two buttons, so it sits ON the button's own size (--type-label) and
 * separates by colour and weight instead — --ink-2 and unbold against the CTA's --ink-1 bold. */
.mm-signin__or {
    color: var(--ink-2);
    font-size: var(--type-label);
    align-self: center;
    padding: var(--space-4) 0 var(--space-2) 0;
}
.mm-signin__google {
    align-self: stretch;
    justify-content: center;
    margin-left: 0;
}

/* ---------- Footer ----------
 * Bottom-left (Sam, 2026-08-09): the in-match settings gear (.ms-gear, matchsettings.uss) lives
 * bottom-right, and MainMenuController now mounts that same overlay over this screen so Settings
 * is reachable from the menu too. The version label moved out of that corner to make room for it,
 * rather than the two ever sharing a slot.
 */
.mm-footer {
    position: absolute;
    bottom: var(--space-6);                      /* clearance is .emb-edge's, not this rule's */
    left: var(--space-6);
}
.mm-version {
    font-size: var(--type-caption);              /* 14dp. Was --type-label to survive the old scale. */
    color: var(--ink-2);
}

/* ---------- Account creation, as a SCREEN (Sam, 2026-08-25) ----------
 * The sign-in gate and the name step were two .mm-modal overlays here until then. This root
 * replaces .mm-modal AND .mm-modal__panel: there is no backdrop to draw and nothing to centre a
 * 520px dialog inside, because the root IS the panel.
 *
 * WHY THE ROW TREATMENT ABOVE WAS NOT ALREADY ENOUGH. Its comment budgets the flow "against 411
 * available", and that number is wrong: both modals carried .emb-bleed — padding: var(--edge-safe),
 * 52dp PER EDGE — when it was written, so the real box was 411 - 104 = 307dp. The gate's 276dp
 * fitted with 31 to spare; the name step's 358dp overflowed by 51, and the name step is the one
 * with no way past it. On top of that .mm-modal__panel spent another var(--space-8) per edge
 * INSIDE that box. Re-hosting is the fix precisely because the nesting was the problem: one
 * clearance (.emb-bleed on this root, in the UXML) and no second padding inside it.
 *
 * flex-grow: 1 is the same load-bearing declaration .character-create-screen documents at length:
 * without it a scene root sizes to CONTENT and everything below it resolves to nothing.
 *
 * RETIREMENT TRIGGER: if the sign-in gate ever becomes skippable — it is unskippable by Sam's
 * 2026-08-08 ruling — this stops being a whole screen and the .mm-modal rules above come back
 * into play. Neither this block nor AccountCreateController survives that change unread. */
.account-create-screen {
    flex-grow: 1;
    background-color: var(--surface-1);
    color: var(--ink-1);
    justify-content: center;
}
.account-create-screen #signin-view,
.account-create-screen #name-view {
    flex-grow: 1;
    justify-content: center;
}
