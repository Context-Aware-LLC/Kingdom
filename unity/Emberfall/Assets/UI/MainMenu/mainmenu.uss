/*
 * mainmenu.uss — S1 front door styles. Consumes tokens from theme.uss only (no literal
 * colors/sizes a token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 *
 * THIS WARNING LIVES HERE BECAUSE UI BUILDER DELETES UXML COMMENTS. Opening
 * MainMenuScreen.uxml in Unity's UI Builder rewrites the file and strips every comment in it
 * — 87 lines of documentation went that way on 2026-07-31, including this warning, which is
 * why it now sits in the stylesheet instead. Unity does not rewrite .uss.
 *
 * NEVER write a BEM modifier's double dash inside a UXML comment. XML forbids that sequence
 * in a comment, so the importer fails the WHOLE file, CloneTree() returns zero children,
 * every Q<>() is null, and NOTHING is logged — the screen is simply empty. Refer to modifier
 * classes in words ("the hidden modifier"), never by writing the literal class name in a
 * comment. `Emberfall/UI/Check UXML Integrity` catches it if it happens again.
 */

.main-menu {
    flex-grow: 1;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/MainMenu_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    padding: var(--space-12);
}

/* Boot state: hidden until MainMenuController.RevealMenu() runs (LoadingOverlay covers frame 0
 * instead). visibility:hidden, NOT display:none: this root is the panel's only top-level
 * element, so display:none here means Yoga never runs a single layout pass on it (unlike a
 * modal, which starts hidden too but sits inside an already-laid-out root) - flipping display
 * back on later leaves worldBound stuck at NaN and nothing ever draws. visibility keeps it in
 * the layout tree (bounds always valid) while still suppressing paint and click-through. */
.mm-root--hidden {
    visibility: hidden;
}

/* Dark scrim over the plate so the wordmark + buttons stay legible (design-system §4.5). */
.mm-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.42);
}

/* ---------- Brand ---------- */
.mm-brand {
    align-items: center;
    margin-bottom: var(--space-16);
}
.mm-wordmark {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--ink-1);
    letter-spacing: 8px;
}
.mm-tagline {
    font-size: var(--type-h2);
    color: var(--accent);
    margin-top: var(--space-2);
    letter-spacing: 2px;
}

/* ---------- Menu column ----------
 * One carved control, not five floating buttons. The column is a single slab with a
 * dimmed-accent frame and rounded corners; the buttons are slats that touch edge-to-edge
 * and clip to the group's rounded corners (overflow: hidden). A dark hairline between
 * slats reads as a groove cut into the stone. (Version A — segmented tablet.)
 */
.mm-menu {
    align-items: stretch;
    min-width: 300px;
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.35);        /* dark inscribed edge — reads as carved, not glowing */
    border-radius: var(--space-3);
    overflow: hidden;                            /* slats clip to the rounded group */
}
.mm-button {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    background-color: rgba(30, 37, 48, 0);      /*fully transparent — backdrop shows straight through (styling base) */
    border-width: 0;
    
    border-radius: 0;                            /* the group owns the shape, not the slat */
    border-top-width: 1px;                       /* groove between slats */
    border-top-color: rgba(11, 14, 19, 0.55);
    height: 64px;
    margin-bottom: 0;                            /* slats touch */
    padding: 0 var(--space-6);
    letter-spacing: 1px;
}
.mm-button:hover {
    background-color: rgba(42, 51, 64, 0.45);   /* --surface-3, light wash — backdrop still reads through */
}
.mm-button:active {
    background-color: rgba(20, 25, 34, 0.95);   /* --surface-1 */
}
/* Find Game — visually identical to the other slats on arrival (no ember fill). The only
 * override is positional: it's the top of the stack, so it carries no groove hairline under
 * the frame's top edge. Hover/active fall through to the shared .mm-button states. */
.mm-button--cta {
    border-top-width: 0;
}

/* ---------- Shard balance ----------
 * Top-right, mirroring the identity plate. These percentages are the no-inset fallback; the
 * controller adds Screen.safeArea's normalized top/right inset at runtime and keeps this plate
 * inside cutouts and system bars as they change.
 */
.mm-shard-balance {
    position: absolute;
    top: 2%;
    right: 2%;
    min-width: 12%;
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-1);
    background-color: rgba(20, 25, 34, 0.55);
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.7);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
}

/* ---------- Identity plate ----------
 * Top-left: who you are on this device. It was a Button while renaming was its one affordance;
 * names are permanent now (NOR-287), so it is a plain VisualElement with no hover state —
 * nothing about it should read as pressable.
 */
.mm-identity {
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    align-items: flex-start;
    background-color: rgba(20, 25, 34, 0.55);
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.7);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
}
.mm-identity__name {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--ink-1);
}

/* ---------- Account switcher rows ---------- */
.mm-accounts {
    flex-direction: column;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}
.mm-account-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--space-1);
    background-color: rgba(20, 25, 34, 0.45);
    margin-bottom: var(--space-2);
}
.mm-account-row--active {
    background-color: rgba(42, 51, 64, 0.75);
    border-left-width: 3px;
    border-left-color: var(--accent);
}
.mm-account-row__label {
    font-size: var(--type-label);
    color: var(--ink-1);
    flex-grow: 1;
}
.mm-account-row__sub {
    font-size: var(--type-caption);
    color: var(--ink-2);
}
.mm-account-row__button {
    font-size: var(--type-caption);
    padding: 2px var(--space-3);
    margin-left: var(--space-2);
}

/* ---------- Modals ----------
 * Full-screen backdrop + a centred panel. The backdrop is opaque enough to read as modal and
 * picks up clicks itself (UI Toolkit will not block the menu underneath otherwise).
 */
.mm-modal {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.78);
}
.mm-modal--hidden {
    display: none;
}
.mm-modal__panel {
    width: 520px;
    max-width: 90%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-8);
}
.mm-modal__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    white-space: normal;
}
.mm-modal__help {
    font-size: var(--type-caption);
    color: var(--ink-2);
    white-space: normal;
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
}
.mm-modal__field {
    font-size: var(--type-h2);
    margin-bottom: var(--space-2);
}
.mm-modal__field > .unity-base-text-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    padding: var(--space-3);
    color: var(--ink-1);
    /* The caret defaults to black when unset, invisible against this near-black background —
       a focused field looked unresponsive with nothing wrong functionally. */
    --unity-cursor-color: var(--ink-1);
}
.mm-modal__dropdown {
    margin-bottom: var(--space-2);
}
.mm-modal__dropdown .unity-base-field__label {
    color: var(--ink-2);
    font-size: var(--type-label);
    min-width: 96px;
}
.mm-modal__dropdown .unity-base-popup-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
}
/* The selected class is permanent player-facing data; style its text directly instead of depending
 * on the popup input's inherited color. */
.mm-modal__dropdown .unity-base-popup-field__text {
    color: var(--ink-1);
}
/* Reserves its line whether or not there is an error, so confirming does not shift the buttons. */
.mm-modal__error {
    font-size: var(--type-caption);
    color: var(--negative);
    white-space: normal;
    min-height: 18px;
    margin-bottom: var(--space-4);
}
.mm-modal__actions {
    flex-direction: row;
    justify-content: flex-end;
}
.mm-modal__button {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    height: 44px;
    padding: 0 var(--space-6);
    margin-left: var(--space-2);
}
.mm-modal__button:hover {
    background-color: var(--surface-3);
}
.mm-modal__button--cta {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--surface-0);
}
.mm-modal__button--cta:hover {
    background-color: rgb(250, 186, 90);
}
.mm-modal__button--cta:disabled {
    background-color: var(--surface-2);
    border-color: var(--surface-3);
    color: var(--ink-2);
}

/* ---------- First-launch sign-in gate (EF-074e / NOR-231) ---------- */
/* Nearly opaque, where an ordinary modal is 0.78. A dialog you can see the menu through reads as
 * something you could dismiss to get back to it; this one cannot be dismissed, and looking
 * dismissible is what would make a player hunt for the close button that is not there. */
.mm-modal--gate {
    background-color: rgba(11, 14, 19, 0.96);
}

/* ---------- First-login sizing and typography (NOR-283, extended NOR-284) ----------
 * Every rule below is scoped to .mm-modal--onboard on purpose. It marks a modal that IS the first
 * launch — the sign-in gate, and the name/password prompt that follows it — on a phone held at arm's
 * length. The ordinary modals (rename, accounts) are things a player opens on top of a menu they can
 * already read, so they must NOT carry this class: they keep the compact base .mm-modal__* size.
 *
 * The gate always onboards, so it gets the class in the UXML. The name modal is REUSED for later
 * renames, so it gets the class only for the required (first-run) state — MainMenuController toggles
 * it in OpenNameModal. Both first-login modals were inheriting a 520px box with 13px help text built
 * for a desktop monitor; on a handset that reads as a small floating dialog on an empty screen rather
 * than the screen itself.
 *
 * Sized in percentages, not pixels: the panel settings scale to a 1920x1080 reference, so a fixed
 * width is a fixed FRACTION of a monitor and a much smaller one of a wide phone canvas.
 * Do not fold these values back into .mm-modal__* — that would resize the rename and account modals.
 */
.mm-modal--onboard .mm-modal__panel {
    width: 62%;
    min-width: 640px;
    max-width: 92%;
    padding: var(--space-12);
    border-radius: var(--space-4);
}
.mm-modal--onboard .mm-modal__title {
    font-size: 46px;
}
.mm-modal--onboard .mm-modal__help {
    font-size: 26px;
    margin-top: var(--space-3);
    margin-bottom: var(--space-8);
}
.mm-modal--onboard .mm-modal__field {
    font-size: 30px;
    margin-bottom: var(--space-3);
}
.mm-modal--onboard .mm-modal__field > .unity-base-text-field__input {
    padding: var(--space-4);
}
.mm-modal--onboard .mm-modal__error {
    font-size: 24px;
    min-height: 30px;
    margin-bottom: var(--space-6);
}
/* Touch targets, not pointer targets: 84px against a 1080-tall reference is roughly a fingertip on
 * a phone in landscape, where the 44px desktop height is about half of one. */
.mm-modal--onboard .mm-modal__button {
    font-size: 28px;
    height: 84px;
    padding: 0 var(--space-12);
    margin-left: var(--space-4);
}
/* The code is six characters the player is copying by eye off another screen. Wide tracking and a
 * larger face is the difference between reading it back once and reading it back three times. */
.mm-signin__code {
    font-size: var(--type-h1);
    letter-spacing: 8px;
    -unity-text-align: middle-center;
}
.mm-signin__code > .unity-base-text-field__input {
    -unity-text-align: middle-center;
}
/* Must out-specify .mm-modal--onboard .mm-modal__field above, which would otherwise shrink the code
 * back to ordinary field size — the code field carries both classes. Equal specificity, so this
 * rule wins by coming later in the file; keep it below the onboard block. */
.mm-modal--onboard .mm-signin__code {
    font-size: 56px;
    letter-spacing: 16px;
}
/* A text link, not a third button: resending is a recovery, and giving it a button's weight puts it
 * in competition with the thing the player should actually be doing. */
.mm-signin__resend {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink-2);
    font-size: 24px;
    align-self: flex-end;
    padding: var(--space-4) 0 0 0;
    margin-top: var(--space-2);
}
.mm-signin__resend:hover {
    color: var(--ink-1);
}
.mm-signin__resend:disabled {
    color: var(--surface-3);
}
.mm-signin__or {
    color: var(--ink-2);
    font-size: 20px;
    align-self: center;
    padding: var(--space-4) 0 var(--space-2) 0;
}
.mm-signin__google {
    align-self: stretch;
    justify-content: center;
    margin-left: 0;
}

/* ---------- Footer ----------
 * Bottom-left (Sam, 2026-08-09): the in-match settings gear (.ms-gear, matchsettings.uss) lives
 * bottom-right, and MainMenuController now mounts that same overlay over this screen so Settings
 * is reachable from the menu too. The version label moved out of that corner to make room for it,
 * rather than the two ever sharing a slot.
 */
.mm-footer {
    position: absolute;
    bottom: var(--space-6);
    left: var(--space-6);
}
.mm-version {
    font-size: var(--type-caption);
    color: var(--ink-2);
}
