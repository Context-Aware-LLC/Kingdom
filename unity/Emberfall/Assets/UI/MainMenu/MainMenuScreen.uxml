<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="CollectionScreen" src="project://database/Assets/UI/Collection/CollectionScreen.uxml?fileID=9197481963319205126&amp;guid=c2b9a146e6e8bc54b884c6fa1b972992&amp;type=3#CollectionScreen"/>
    <Style src="project://database/Assets/UI/Deckbuilder/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/MainMenu/mainmenu.uss?fileID=7433441132597879392&amp;guid=a7ebbdf5907b4c844915adc374612cc8&amp;type=3#mainmenu"/>
    <Style src="project://database/Assets/UI/Shop/shop.uss?fileID=7433441132597879392&amp;guid=1bfa8e0e1ac74f0287ff03d16cc57e01&amp;type=3#shop"/>
    <ui:VisualElement name="root" class="emb-root main-menu mm-root--hidden">
        <ui:VisualElement name="scrim" picking-mode="Ignore" class="mm-scrim" style="background-image: none;"/>
        <ui:Label name="shard-balance" text="Shards  —" picking-mode="Ignore" class="mm-shard-balance"/>
        <ui:VisualElement name="identity" picking-mode="Ignore" class="mm-identity">
            <ui:Label name="identity-name" text="Unnamed player" class="mm-identity__name"/>
            <ui:Label name="identity-sub" text="" class="mm-identity__sub"/>
        </ui:VisualElement>
        <ui:VisualElement name="brand" class="mm-brand">
            <ui:Label text="EMBERFALL" class="mm-wordmark"/>
            <ui:Label text="A duel of embers" class="mm-tagline"/>
        </ui:VisualElement>
        <ui:VisualElement name="tab-bar" style="flex-grow: 1; flex-direction: column-reverse; align-self: flex-start; position: relative; left: 0; bottom: 0;">
            <ui:Tab label="Tab" name="Tab" class="class-tab__art class-tab__art--emberward class-tab"/>
        </ui:VisualElement>
        <ui:VisualElement name="menu" class="mm-menu">
            <ui:Button name="btn-find-game" text="Find Game" class="mm-button mm-button--cta"/>
            <ui:Button name="btn-single-player" text="Single Player" class="mm-button"/>
            <ui:Button name="btn-deck-builder" text="Deck Builder" class="mm-button"/>
            <ui:Button name="btn-store" text="Store" class="mm-button"/>
            <ui:Button name="btn-leaderboards" text="Leaderboards" class="mm-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="mm-footer">
            <ui:Label name="version-label" text="M1 · vertical slice" class="mm-version"/>
        </ui:VisualElement>
        <ui:VisualElement name="name-modal" class="mm-modal mm-modal--hidden">
            <ui:VisualElement name="name-panel" class="mm-modal__panel">
                <ui:Label name="name-title" text="What should we call you?" class="mm-modal__title"/>
                <ui:Label name="name-help" text="This is the name other players see. Choose carefully — it is permanent. To change it later you would have to contact support." class="mm-modal__help"/>
                <ui:TextField name="name-field" max-length="16" class="mm-modal__field"/>
                <ui:Label name="name-password-help" text="Optional: set a password so you can sign back in without checking your email." class="mm-modal__help" style="display: none;"/>
                <ui:TextField name="name-password" password="true" class="mm-modal__field" style="display: none;"/>
                <ui:TextField name="name-password-confirm" password="true" class="mm-modal__field" style="display: none;"/>
                <ui:Label name="name-error" text=" " class="mm-modal__error"/>
                <ui:VisualElement class="mm-modal__actions">
                    <ui:Button name="btn-name-confirm" text="Continue" class="mm-modal__button mm-modal__button--cta"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="signin-modal" class="mm-modal mm-modal--gate mm-modal--onboard mm-modal--hidden">
            <ui:VisualElement name="signin-panel" class="mm-modal__panel">
                <ui:Label name="signin-title" text="Create your account" class="mm-modal__title"/>
                <ui:Label name="signin-help" text="Emberfall needs an account before you can play. Enter your email and we will send you a six-digit code." class="mm-modal__help"/>
                <ui:TextField name="signin-email" class="mm-modal__field"/>
                <ui:TextField name="signin-code" max-length="6" class="mm-modal__field mm-signin__code" style="display: none;"/>
                <ui:Label name="signin-error" text=" " class="mm-modal__error"/>
                <ui:VisualElement class="mm-modal__actions">
                    <ui:Button name="btn-signin-back" text="Use another email" class="mm-modal__button" style="display: none;"/>
                    <ui:Button name="btn-signin-primary" text="Email me a code" class="mm-modal__button mm-modal__button--cta"/>
                </ui:VisualElement>
                <ui:Button name="btn-signin-resend" text="Send another code" class="mm-signin__resend" style="display: none;"/>
                <ui:Label name="signin-or" text="or" class="mm-signin__or"/>
                <ui:Button name="btn-signin-google" text="Continue with Google" class="mm-modal__button mm-signin__google"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="shop-overlay" class="shop-overlay shop-overlay--hidden">
            <ui:VisualElement name="shop-shell" class="shop-shell">
                <ui:VisualElement class="shop-header">
                    <ui:VisualElement class="shop-heading">
                        <ui:Label text="Booster Shop" class="shop-title"/>
                        <ui:Label text="Choose a set. Pack contents and wallet changes are resolved by the server." class="shop-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-wallet">
                        <ui:Label name="shop-gold-balance" text="Gold  —" class="shop-wallet__balance shop-wallet__balance--gold"/>
                        <ui:Label name="shop-gem-balance" text="Gems  —" class="shop-wallet__balance shop-wallet__balance--gems"/>
                    </ui:VisualElement>
                    <ui:Button name="btn-shop-close" text="Close" class="shop-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="shop-scroll" class="shop-scroll">
                    <ui:VisualElement class="shop-section">
                        <ui:Label text="Booster Packs" class="shop-section__title"/>
                        <ui:Label text="Each pack contains five cards from Core plus its expansion, with at least one Rare or better." class="shop-section__help"/>
                        <ui:VisualElement name="shop-pack-list" class="shop-pack-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-section">
                        <ui:Label text="Gem Bundles" class="shop-section__title"/>
                        <ui:Label text="Founder-approved tiers. Live platform purchasing remains disabled until store product IDs are bound." class="shop-section__help"/>
                        <ui:VisualElement name="shop-gem-list" class="shop-gem-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="shop-status" text="" class="shop-status"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="reveal-overlay" class="shop-overlay shop-overlay--hidden">
            <ui:VisualElement class="shop-shell reveal-shell">
                <ui:Label name="reveal-title" text="Pack opened" class="reveal-title"/>
                <ui:Label name="reveal-summary" text="" class="reveal-summary"/>
                <ui:VisualElement name="reveal-cards" class="reveal-cards"/>
                <ui:Button name="btn-reveal-done" text="Add to collection" class="reveal-done"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="CollectionScreen" style="height: 0;"/>
</ui:UXML>
