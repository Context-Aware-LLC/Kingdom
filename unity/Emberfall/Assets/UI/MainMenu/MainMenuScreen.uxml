<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/MainMenu/mainmenu.uss?fileID=7433441132597879392&amp;guid=a7ebbdf5907b4c844915adc374612cc8&amp;type=3#mainmenu"/>
    <ui:VisualElement name="root" class="emb-root main-menu mm-root--hidden">
        <ui:VisualElement name="scrim" picking-mode="Ignore" class="mm-scrim emb-bleed" style="background-image: none;"/>
        <ui:Label name="shard-balance" text="Shards  —" picking-mode="Ignore" class="mm-shard-balance emb-edge"/>
        <ui:VisualElement name="identity" picking-mode="Ignore" class="mm-identity emb-edge">
            <ui:VisualElement name="identity-showcase" class="mm-identity__showcase"/>
            <ui:VisualElement class="mm-identity__text">
                <ui:Label name="identity-name" text="Unnamed player" class="mm-identity__name"/>
                <ui:Label name="identity-deck" text="" class="mm-identity__deck"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="brand" class="mm-brand">
            <ui:Label text="EMBERFALL" class="mm-wordmark"/>
            <ui:Label text="A duel of embers" class="mm-tagline"/>
        </ui:VisualElement>
        <ui:VisualElement name="menu" class="mm-menu">
            <ui:Button name="btn-find-game" text="Find Game" class="mm-button mm-button--cta"/>
            <ui:Button name="btn-collection" text="Collection" class="mm-button"/>
            <ui:Button name="btn-store" text="Store" class="mm-button"/>
            <ui:Button name="btn-leaderboards" text="Leaderboards" class="mm-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="leaderboard-modal" class="mm-modal mm-modal--hidden emb-bleed">
            <ui:VisualElement class="mm-modal__panel mm-leaderboard">
                <ui:VisualElement class="mm-leaderboard__header">
                    <ui:VisualElement class="mm-leaderboard__heading">
                        <ui:Label text="RANKED LADDER" class="mm-leaderboard__kicker"/>
                        <ui:Label text="The Emberfall Crown" class="mm-leaderboard__title"/>
                    </ui:VisualElement>
                    <ui:Button name="btn-leaderboard-close" text="Close" class="mm-modal__button mm-leaderboard__close"/>
                </ui:VisualElement>
                <ui:VisualElement class="mm-leaderboard__rules">
                    <ui:VisualElement class="mm-leaderboard__rule">
                        <ui:Label text="START" class="mm-leaderboard__rule-label"/>
                        <ui:Label text="1000" class="mm-leaderboard__rule-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-leaderboard__rule">
                        <ui:Label text="PROVISIONAL" class="mm-leaderboard__rule-label"/>
                        <ui:Label text="20 GAMES" class="mm-leaderboard__rule-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="mm-leaderboard__rule mm-leaderboard__rule--last">
                        <ui:Label text="RANKED" class="mm-leaderboard__rule-label"/>
                        <ui:Label text="PLAYER DUELS" class="mm-leaderboard__rule-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="mm-leaderboard__columns">
                    <ui:Label text="RANK" class="mm-leaderboard__rank"/>
                    <ui:Label text="PLAYER" class="mm-leaderboard__name"/>
                    <ui:Label text="RATING" class="mm-leaderboard__rating"/>
                    <ui:Label text="W — L — D" class="mm-leaderboard__record"/>
                </ui:VisualElement>
                <ui:Label name="leaderboard-status" text="Calling the keepers…" class="mm-leaderboard__status"/>
                <ui:ScrollView name="leaderboard-list" mode="Vertical" class="mm-leaderboard__list"/>
                <ui:Label name="leaderboard-updated" text="Ratings update after every eligible match." class="mm-leaderboard__updated"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="mm-footer emb-edge">
            <ui:Label name="version-label" text="—" class="mm-version"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
