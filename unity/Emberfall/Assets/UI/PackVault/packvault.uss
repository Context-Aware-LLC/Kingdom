/* The pack vault — the shelf of unopened packs, and the chrome around the reveal.
 *
 * The reveal itself is NOT styled here. `packreveal.uss` owns every `.reveal-*` rule and this
 * screen links it alongside this sheet, the same way ShopScreen.uxml does. That sheet was pulled
 * out of shop.uss in 2026-08-20 precisely so a second host could exist; this is that host.
 *
 * `.emb-root` (theme.uss) is the only other dependency, and only for the design tokens. */

.pack-vault-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
}

/* Carries .emb-bleed in the markup, so the horizontal clearance is the theme's and the padding
 * below is vertical only. Do not add a horizontal padding here: a class rule in this sheet ties
 * theme.uss on specificity and wins on sheet order, so it would silently defeat --edge-safe.
 * (The same defeat packreveal.uss documents for .reveal-overlay.) */
.vault-shell {
    flex-grow: 1;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
}

/* ONE BAR, the same shape the store settled on 2026-08-31: what you act on, in a single row.
 * A screen you reached by opening your packs does not need a header telling you so, and on a
 * 411dp landscape phone a title/subtitle pair plus its own padding is most of a shelf row. */
.vault-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

.vault-title {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
}

.vault-subtitle {
    color: var(--ink-2);
    font-size: var(--type-label);
    margin-left: var(--space-3);
}

.vault-bar__gap {
    flex-grow: 1;
}

.vault-back {
    min-height: var(--touch-min);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    font-size: var(--type-label);
}

.vault-back:active {
    background-color: var(--surface-3);
}

/* ── The gift banner ─────────────────────────────────────────────────────────────────────────
 *
 * Gift mode only (PackVaultMode.Gift), and only once a non-empty shelf has rendered. It is TEXT ON
 * A PLATE, not an image: `gift_ribbon.png` is specified (spec §6.3 #10) and does not exist, and a
 * banner that waits for art is a banner that ships blank. When the ribbon lands it becomes a
 * background-image on this rule and nothing else moves.
 * RETIREMENT TRIGGER: when Assets/Art/UI/Chrome/PackVault/gift_ribbon.png is placed, set it here
 * as a 9-sliced background and drop the border. */
.vault-banner {
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: var(--space-3);
    align-items: center;

    /* The entrance. Both properties are transitioned here rather than on the --enter rule, so the
     * animation runs in BOTH directions off one declaration and a class that is only ever removed
     * still animates. Duration matches the tile stagger's step. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-banner__title {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.vault-banner__body {
    color: var(--ink-2);
    font-size: var(--type-label);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Vault mode's resting state, and the authored default in the UXML — a returning player must never
 * be congratulated for arriving. `display: none` rather than opacity, so it holds no height. */
.vault-banner--hidden {
    display: none;
}

/* Staged. PackVaultController adds this at show time and schedules its removal, at which point the
 * transition above runs. */
.vault-banner--enter {
    opacity: 0;
    translate: 0 -12px;
}

/* A WRAPPING ROW, NOT A ScrollView. UI Toolkit's ScrollView content lays out correctly and PAINTS
 * above its viewport on Android (#285, #307) — a renderer fault no stylesheet can reach. The shelf
 * holds five packs at the gift and ten at its cap, so it does not need one, and inheriting that
 * bug for a surface this small is a bad trade. PackVaultController counts the overflow instead.
 * RETIREMENT TRIGGER: when #285 and #307 close, a ScrollView here becomes the ordinary answer and
 * the tile cap can go with it. */
.vault-shelf {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
}

/* Three up on a phone, and sized off the row rather than a min-width: the store learned on
 * 2026-08-31 that a floor can only ever fight the percentage, and clamps a tile UP into a layout
 * that then leaves dead width beside it. 31% plus the 1% margins fills the row exactly. */
.vault-pack {
    width: 31%;
    flex-shrink: 0;
    margin: 1%;
    padding: var(--space-3);
    align-items: stretch;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);

    /* Rest state for the gift entrance (.vault-pack--enter). Harmless in Vault mode, which never
     * stages the tile and so never transitions it. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-pack:active {
    border-color: var(--accent);
}

/* The gift's entrance. Applied at BUILD time by PackVaultController and scheduled off one tile at a
 * time, so the packs arrive in sequence rather than all at once — five objects landing on a shelf,
 * which is the thing the beat is about.
 *
 * Selected on the modifier alone (not `.vault-pack.vault-pack--enter`) so the overflow label, which
 * is not a `.vault-pack`, stages and releases with the tiles it stands for.
 *
 * The transition lives on `.vault-pack` and `.vault-pack__overflow`, not here — see the banner. */
.vault-pack--enter {
    opacity: 0;
    translate: 0 16px;
}

.vault-pack:disabled {
    opacity: 0.45;
}

/* A booster is a portrait object. 0.7 is the reveal card's ratio, so a pack and the cards it
 * becomes read as the same family — and it is the ratio the starter pack's art is authored at
 * (1024x1536, spec §6.1). `aspect-ratio` IS supported; the claim that it is not was true once and
 * is not now — see the note in shop.uss. */
.vault-pack__face {
    width: 100%;
    aspect-ratio: 0.7;
    flex-shrink: 0;
    margin-bottom: var(--space-2);
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* Only once art actually resolved. A set whose art has not been drawn yet is the normal state
 * (PackArtProvider says so out loud), so an artless pack keeps the plain plate above rather than
 * reading as a picture that failed to load. Assets/Art/Shop/Packs/STARTER/ does not exist yet. */
.vault-pack__face--art {
    background-color: rgba(11, 14, 19, 0.35);
}

.vault-pack__name {
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.vault-pack__hint {
    color: var(--ink-2);
    font-size: var(--type-caption);
    -unity-text-align: middle-center;
}

/* The tail of a shelf too long to draw. A count, not a tile: the packs it stands for are real and
 * openable, they are just not on screen until the ones in front of them are gone. */
.vault-pack__overflow {
    width: 31%;
    margin: 1%;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    -unity-font-style: bold;

    /* Stages and releases with the tiles — see .vault-pack--enter. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-status {
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: var(--space-3);
    min-height: var(--space-8);
}

/* Collapsed rather than blanked, so an empty status does not hold a band of dead space above the
 * bottom edge while the shelf is full. */
.vault-status--empty {
    display: none;
}

/* ============================================================================================
 * THE TEAR (slice 3). PackTearAnimator drives every rule below by adding and removing a modifier;
 * there is no keyframe anywhere, because USS has none — each beat is a transition on the base rule
 * that a scheduled class toggle releases. Read PackTearAnimator's remarks before changing a
 * duration here: the C# schedule and these transitions are one clock, and moving only one half
 * makes the burst land after the split instead of between the strip and it.
 *
 * THE TORN HALVES ARE NO LONGER PLACEHOLDERS (2026-09-03). PackWrapperBaker bakes them, and the
 * intact face, from one source sprite across a shared procedural tear line, so it assigns a
 * background-image to .tear-half-top and .tear-half-bottom at runtime. The colours those two rules
 * carry are the ARTLESS-SET fallback — a set with no art still tears — not art waiting to arrive.
 * Files 4 and 5 of spec §6.1 were never needed; that table is corrected.
 *
 * PLACEHOLDER ART, still. The foil strip (§6.1 file 3) and the burst sheet (§6.2 file 6) do not
 * exist; both are flat colour and become correct by gaining a background-image on the rule they
 * already have.
 * RETIREMENT TRIGGER: when Assets/Art/VFX/Pack/fx_pack_burst.png lands, replace .tear-burst's glow
 * and drop it from this paragraph; likewise pack_tear_strip.png and .tear-strip. When both are in,
 * drop this paragraph. */

.tear-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.92);
}

.tear-overlay--hidden {
    display: none;
}

.tear-stage {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

/* Behind the pack, and picking-mode Ignore in the markup so it can never eat the gesture that opens
 * it. Sized generously: a burst that stops at the pack's edge reads as a highlight. */
.tear-burst {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 260px;
    background-color: rgba(255, 214, 148, 0);
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale, background-color;
    transition-duration: 300ms, 300ms, 300ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.tear-burst--fired {
    background-color: rgba(255, 214, 148, 0.45);
    opacity: 1;
    scale: 1.15 1.15;
}

/* 0.7 is the ratio the shelf tile and the reveal card both use, so the object the player tapped on
 * the shelf is the object that arrives here. */
.tear-pack {
    width: 260px;
    aspect-ratio: 0.7;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}

/* The idle breath: a class the animator TOGGLES on an interval, not a keyframe loop, because USS
 * has none. The transition on .tear-pack is what makes the flip a breath rather than a jump. */
.tear-pack--breathe {
    scale: 1.035 1.035;
}

/* Struck — a beat of recoil before the halves part, so the split reads as caused. */
.tear-pack--opening {
    scale: 1.06 1.06;
}

/* The two halves of the pack face. Absolute, so parting them cannot reflow the stage around them:
 * a layout-driven split would emit a GeometryChangedEvent every frame, which is the same reason
 * collection.uss animates its drawers on translate and never on width. */
/* THE INTACT SEALED WRAPPER — the third of the crimp shader's three baked views, and the only one
 * visible before the tear. It covers the two pieces underneath because their torn edges are alpha
 * and they overlap: without it the seam reads through an unopened pack. Topmost by document order,
 * and it fades rather than vanishing so the strip leaving and the wrapper going are one gesture. */
.tear-pack-face {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--surface-2);
    border-radius: var(--space-3);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.tear-pack-face--gone {
    opacity: 0;
}

/* NOT TWO HALVES, and the art is what says so. Spec §6.1 sizes pack_torn_top at 1024 × 640 and
 * pack_torn_bottom at 1024 × 1024 against a 1024 × 1536 front: 41.7% and 66.7%, overlapping by
 * ~8% at the tear line. That is how a pack actually opens — you tear the crimped end OFF, you do
 * not halve it — and it is also what lets a crimp shader live on the OUTER edge of each piece and
 * never cross the tear. Each height is set on the piece's own rule below; do not collapse them
 * back to 50% without changing the art brief with it. */
.tear-pack-half {
    position: absolute;
    left: 0;
    right: 0;
    background-color: var(--surface-1);
    translate: 0 0;
    rotate: 0deg;
    opacity: 1;
    transition-property: translate, rotate, opacity;
    transition-duration: 380ms, 380ms, 380ms;
    transition-timing-function: ease-in-out, ease-in-out, ease-in-out;
}

/* 640 / 1536. The torn edge is its BOTTOM edge; the crimp is its top. */
.tear-pack-half_top {
    top: 0;
    height: 41.7%;
    border-top-left-radius: var(--space-3);
    border-top-right-radius: var(--space-3);
}

/* 1024 / 1536. The torn edge is its TOP edge; the crimp is its bottom. It overlaps the top piece
 * by design — the two torn edges interlock rather than meeting on a line, which is what stops a
 * seam showing through the pack before it is opened. */
.tear-pack-half_bottom {
    bottom: 0;
    height: 66.7%;
    border-bottom-left-radius: var(--space-3);
    border-bottom-right-radius: var(--space-3);
}

/* Parted. The modifier alone carries what both halves share; the direction comes from each half's
 * own rule below — one class, two directions. */
.tear-pack-half--parted {
    opacity: 0;
}

/* They rotate as well as travel, in OPPOSITE directions. Two pieces sliding straight apart read as
 * a door; a torn wrapper falls away off-axis. The shader bakes each piece as its own texture so the
 * rotation costs nothing and never distorts the source image (Sol, 2026-09-03). */
.tear-pack-half_top.tear-pack-half--parted {
    translate: 0 -120px;
    rotate: -4deg;
}

.tear-pack-half_bottom.tear-pack-half--parted {
    translate: 0 120px;
    rotate: 5deg;
}

/* The foil strip: sits across the tear line and leaves first, revealing it. Flat foil colour today;
 * it becomes pack_tear_strip.png (1024 × 192, alpha on both long edges) with no other change.
 *
 * CENTRED ON 37.5%, WHICH IS DERIVED, NOT CHOSEN. The top piece spans 0 to 41.7% and the bottom
 * spans 33.3% to 100%, so they overlap over 33.3-41.7% and the shared tear line is that band's
 * midpoint: 37.5% (confirmed against the crimp baker's own crop math, 2026-09-03). The strip is
 * 12.5% tall (192 / 1536), so it starts at 37.5 - 6.25 = 31.25%. If the baker's tear line ever
 * moves, this number and the two piece heights move together — they are three views of one seam. */
.tear-strip {
    position: absolute;
    left: -4%;
    right: -4%;
    top: 31.25%;
    height: 12.5%;
    background-color: rgba(226, 200, 142, 0.9);
    border-radius: var(--space-1);
    translate: 0 0;
    opacity: 1;
    rotate: 0deg;
    transition-property: translate, opacity, rotate;
    transition-duration: 320ms, 320ms, 320ms;
    transition-timing-function: ease-in, ease-in, ease-in;
}

.tear-strip--away {
    translate: 0 26px;
    opacity: 0;
    rotate: 3deg;
}

/* A pull earns more travel than a tap — the player's own gesture already moved it, so the strip
 * carries on the way they threw it. Declared after --away so it wins on sheet order. */
.tear-strip--pulled {
    translate: 0 64px;
    rotate: 7deg;
}

.tear-hint {
    position: absolute;
    bottom: 18%;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Hidden outright on the gift's first pack (spec §8), never merely disabled: emb-back makes this a
 * target for Android's back gesture, and a disabled button would still be found by it. */
.tear-skip {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    min-height: var(--touch-min);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    color: var(--ink-2);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    font-size: var(--type-label);
}

.tear-skip:active {
    background-color: var(--surface-3);
}
