/* The pack vault — the shelf of unopened packs, and the chrome around the reveal.
 *
 * The reveal itself is NOT styled here. `packreveal.uss` owns every `.reveal-*` rule and this
 * screen links it alongside this sheet, the same way ShopScreen.uxml does. That sheet was pulled
 * out of shop.uss in 2026-08-20 precisely so a second host could exist; this is that host.
 *
 * `.emb-root` (theme.uss) is the only other dependency, and only for the design tokens. */

.pack-vault-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/PackVault_AncientCache_Backdrop_v1.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* Carries .emb-bleed in the markup, so the horizontal clearance is the theme's and the padding
 * below is vertical only. Do not add a horizontal padding here: a class rule in this sheet ties
 * theme.uss on specificity and wins on sheet order, so it would silently defeat --edge-safe.
 * (The same defeat packreveal.uss documents for .reveal-overlay.) */
.vault-shell {
    flex-grow: 1;
    padding-top: var(--space-4);
    /* Same 56px Back footprint, 24px edge offset, and 12px gap reserved by Shop. */
    padding-bottom: 92px;
}

.vault-back {
    min-height: var(--touch-min);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    font-size: var(--type-label);
}

.vault-back:active {
    background-color: var(--surface-3);
}

/* ── The gift banner ─────────────────────────────────────────────────────────────────────────
 *
 * Gift mode only (PackVaultMode.Gift), and only once a non-empty shelf has rendered. It is TEXT ON
 * A PLATE, not an image: `gift_ribbon.png` is specified (spec §6.3 #10) and does not exist, and a
 * banner that waits for art is a banner that ships blank. When the ribbon lands it becomes a
 * background-image on this rule and nothing else moves.
 * RETIREMENT TRIGGER: when Assets/Art/UI/Chrome/PackVault/gift_ribbon.png is placed, set it here
 * as a 9-sliced background and drop the border. */
.vault-banner {
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: var(--space-3);
    align-items: center;

    /* The entrance. Both properties are transitioned here rather than on the --enter rule, so the
     * animation runs in BOTH directions off one declaration and a class that is only ever removed
     * still animates. Duration matches the tile stagger's step. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-banner__title {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.vault-banner__body {
    color: var(--ink-2);
    font-size: var(--type-label);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Vault mode's resting state, and the authored default in the UXML — a returning player must never
 * be congratulated for arriving. `display: none` rather than opacity, so it holds no height. */
.vault-banner--hidden {
    display: none;
}

/* Staged. PackVaultController adds this at show time and schedules its removal, at which point the
 * transition above runs. */
.vault-banner--enter {
    opacity: 0;
    translate: 0 -12px;
}

/* A WRAPPING ROW, NOT A ScrollView. UI Toolkit's ScrollView content lays out correctly and PAINTS
 * above its viewport on Android (#285, #307) — a renderer fault no stylesheet can reach. The shelf
 * holds five packs at the gift and ten at its cap, so it does not need one, and inheriting that
 * bug for a surface this small is a bad trade. PackVaultController counts the overflow instead.
 * RETIREMENT TRIGGER: when #285 and #307 close, a ScrollView here becomes the ordinary answer and
 * the tile cap can go with it. */
.vault-shelf {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
}

/* Three up on a phone, and sized off the row rather than a min-width: the store learned on
 * 2026-08-31 that a floor can only ever fight the percentage, and clamps a tile UP into a layout
 * that then leaves dead width beside it. 31% plus the 1% margins fills the row exactly. */
.vault-pack {
    width: 31%;
    flex-shrink: 0;
    margin: 1%;
    padding: var(--space-3);
    align-items: stretch;
    background-color: transparent;
    border-width: 0;

    /* Rest state for the gift entrance (.vault-pack--enter). Harmless in Vault mode, which never
     * stages the tile and so never transitions it. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

/* The gift's entrance. Applied at BUILD time by PackVaultController and scheduled off one tile at a
 * time, so the packs arrive in sequence rather than all at once — five objects landing on a shelf,
 * which is the thing the beat is about.
 *
 * Selected on the modifier alone (not `.vault-pack.vault-pack--enter`) so the overflow label, which
 * is not a `.vault-pack`, stages and releases with the tiles it stands for.
 *
 * The transition lives on `.vault-pack` and `.vault-pack__overflow`, not here — see the banner. */
.vault-pack--enter {
    opacity: 0;
    translate: 0 16px;
}

.vault-pack:disabled {
    opacity: 0.45;
}

/* A booster is a portrait object. 0.7 is the reveal card's ratio, so a pack and the cards it
 * becomes read as the same family — and it is the ratio the starter pack's art is authored at
 * (1024x1536, spec §6.1). `aspect-ratio` IS supported; the claim that it is not was true once and
 * is not now — see the note in shop.uss. */
.vault-pack__face {
    width: 100%;
    aspect-ratio: 0.7;
    flex-shrink: 0;
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* Only once art actually resolved. A set whose art has not been drawn yet is the normal state
 * (PackArtProvider says so out loud), so an artless pack keeps the plain plate above rather than
 * reading as a picture that failed to load. */
.vault-pack__face--art {
    background-color: rgba(11, 14, 19, 0.35);
}

.vault-pack__tooltip {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    display: none;
    padding: var(--space-2);
    background-color: rgba(11, 14, 19, 0.9);
    border-radius: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
}

/* The tail of a shelf too long to draw. A count, not a tile: the packs it stands for are real and
 * openable, they are just not on screen until the ones in front of them are gone. */
.vault-pack__overflow {
    width: 31%;
    margin: 1%;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    -unity-font-style: bold;

    /* Stages and releases with the tiles — see .vault-pack--enter. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-status {
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: var(--space-3);
    min-height: var(--space-8);
}

/* Collapsed rather than blanked, so an empty status does not hold a band of dead space above the
 * bottom edge while the shelf is full. */
.vault-status--empty {
    display: none;
}

/* ============================================================================================
 * THE TEAR (slice 3), IN PLACE. Every rule below is a child of `.vault-pack__face` — the tile the
 * player tapped. There is no stage, no overlay and no second render of the pack; PackTearAnimator's
 * remarks say why, and the UXML carries the same note where the stage used to be.
 *
 * PackTearAnimator drives all of this by adding a modifier; there is no keyframe anywhere, because
 * USS has none — each beat is a transition on the base rule that a scheduled class toggle releases.
 * Read that class's remarks before changing a duration: the C# schedule and these transitions are
 * one clock, and moving only one half lands the burst after the split instead of between the recoil
 * and it.
 *
 * THE TORN PIECES ARE BAKED. PackWrapperBaker renders them, and the intact face, from one source
 * sprite across a shared procedural tear line, so files 4 and 5 of spec §6.1 were never art anybody
 * had to produce — that table is corrected. There is no fallback colour on the pieces: a bake that
 * cannot run means there is no picture to tear, and the animator fades the tile instead.
 *
 * THE FOIL STRIP IS GONE (Sam, 2026-09-03). It was a flat placeholder band laid across the pack art
 * and it read as exactly that — a block of yellow over the picture. A strip only makes sense as a
 * thing you pull, and there is no pull gesture any more. If pack_tear_strip.png is ever drawn, it
 * belongs baked INTO the wrapper by the crimp shader, not painted over it by a rule here.
 *
 * RETIREMENT TRIGGER: when Assets/Art/VFX/Pack/fx_pack_burst.png lands, .tear-burst's glow becomes a
 * background-image on that same rule and this paragraph goes with it. */

/* The tile while it is coming apart. `overflow: hidden` is off so the pieces can travel past the
 * tile's own bounds — a tear clipped to the pack it came out of reads as a wipe. */
.vault-pack__face--tearing {
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
}

/* The artless degrade: nothing to tear, so the pack goes. See PackTearAnimator's remarks on why
 * this branch exists rather than parting two blank plates. */
.vault-pack__face--spent {
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale;
    transition-duration: 320ms, 320ms;
    transition-timing-function: ease-out, ease-out;
}

/* Behind both pieces, and picking-mode Ignore from script so it can never eat a gesture. Sized past
 * the tile on every side: a burst that stops at the pack's edge reads as a highlight. */
.tear-burst {
    position: absolute;
    left: -25%;
    right: -25%;
    top: -25%;
    bottom: -25%;
    /* Clamped to a circle by UI Toolkit; a length rather than a percentage because the
     * element has no intrinsic size of its own to resolve one against. */
    border-radius: 400px;
    background-color: rgba(255, 214, 148, 0);
    opacity: 0;
    scale: 0.4 0.4;
    transition-property: opacity, scale, background-color;
    transition-duration: 280ms, 280ms, 280ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.tear-burst--fired {
    background-color: rgba(255, 214, 148, 0.42);
    opacity: 1;
    scale: 1.15 1.15;
}

/* NOT TWO HALVES, and the art is what says so. Spec §6.1 sizes pack_torn_top at 1024 × 640 and
 * pack_torn_bottom at 1024 × 1024 against a 1024 × 1536 front: 41.7% and 66.7%, overlapping by
 * ~8% at the tear line. That is how a pack actually opens — you tear the crimped end OFF, you do
 * not halve it — and it is also what lets the crimp shader live on the OUTER edge of each piece and
 * never cross the tear. Each height is set on the piece's own rule below; do not collapse them back
 * to 50% without changing the art brief with it.
 *
 * Absolute, so parting them cannot reflow the shelf around them: a layout-driven split would emit a
 * GeometryChangedEvent every frame, which is the same reason collection.uss animates its drawers on
 * translate and never on width. */
.tear-half {
    position: absolute;
    left: 0;
    right: 0;
    /* No scale mode here: PackWrapperBaker sets background-size Contain inline on both
     * pieces, which is what keeps them aligned with the intact face they replace. */
    translate: 0 0;
    rotate: 0deg;
    opacity: 1;
    transition-property: translate, rotate, opacity;
    transition-duration: 360ms, 360ms, 360ms;
    transition-timing-function: ease-in-out, ease-in-out, ease-in-out;
}

/* 640 / 1536. The torn edge is its BOTTOM edge; the crimp is its top. */
.tear-half--top {
    top: 0;
    height: 41.7%;
}

/* 1024 / 1536. The torn edge is its TOP edge; the crimp is its bottom. It overlaps the top piece by
 * design — the two torn edges interlock rather than meeting on a line, which is what stops a seam
 * showing through the pack in the frame before it parts. */
.tear-half--bottom {
    bottom: 0;
    height: 66.7%;
}

/* Parted. The modifier alone carries what both pieces share; the direction comes from each piece's
 * own rule below — one class, two directions.
 *
 * They rotate as well as travel, in OPPOSITE directions. Two pieces sliding straight apart read as
 * a door; a torn wrapper falls away off-axis. The shader bakes each piece as its own texture so the
 * rotation costs nothing and never distorts the source image (Sol, 2026-09-03).
 *
 * Travel is in PERCENT, not pixels: the tile is 31% of a shelf whose width is the screen's, so a
 * fixed 120px throw that clears a phone tile barely moves a tablet one. */
.tear-half--parted {
    opacity: 0;
}

.tear-half--top.tear-half--parted {
    translate: 0 -60%;
    rotate: -5deg;
}

.tear-half--bottom.tear-half--parted {
    translate: 0 60%;
    rotate: 6deg;
}
