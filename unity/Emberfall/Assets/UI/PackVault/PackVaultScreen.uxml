<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/PackVault/packvault.uss?fileID=7433441132597879392&amp;guid=36eac866b4624b47af05d928f36743f1&amp;type=3#packvault"/>
    <Style src="project://database/Assets/UI/PackReveal/packreveal.uss?fileID=7433441132597879392&amp;guid=a201f4cb62914110a1d96762b261bb3d&amp;type=3#packreveal"/>
    <!-- The pack vault. The shelf is authored empty; PackVaultController fills it from the pack
         balance on GET /collection, one tile per unopened pack.

         THE reveal-* TREE IS THE STORE'S, VERBATIM, AND MUST STAY THAT WAY. PackRevealPanel
         queries these NAMES out of whatever root it is handed, which is the whole reason it was
         split out of the store in 2026-08-20. Renaming one here does not break a build; it makes
         a pack open to a blank screen after the entitlement is already spent.
         (No double dash anywhere in this comment. An XML comment may not contain one, and Unity
         does not report the parse failure: the whole screen renders EMPTY.) -->
    <ui:VisualElement name="root" class="emb-root pack-vault-screen">
        <ui:VisualElement name="vault-shell" class="vault-shell emb-bleed">
            <!-- Gift mode only, and hidden here so Vault mode never has to turn it off. It is shown
                 by PackVaultController once a shelf with packs on it has actually rendered: a banner
                 saying "here is a gift" over a spinner, or over "could not reach the server", is
                 worse than no banner at all. The staged entrance modifier is added at show time and
                 is deliberately not authored here.
                 (No double dash anywhere in this comment either, for the reason above.) -->
            <ui:VisualElement name="vault-banner" class="vault-banner vault-banner--hidden">
                <ui:Label name="vault-banner-title" text="A gift to start you off" class="vault-banner__title"/>
                <ui:Label name="vault-banner-body" text="Open them and keep everything inside." class="vault-banner__body"/>
            </ui:VisualElement>
            <ui:VisualElement name="vault-shelf" class="vault-shelf"/>
            <ui:Label name="vault-status" text="" class="vault-status vault-status--empty"/>
        </ui:VisualElement>
        <ui:Button name="btn-vault-back" text="Back" class="emb-back emb-back-button"/>
        <!-- THERE IS NO TEAR STAGE, and its absence is the design (Sam, 2026-09-03).
             A full screen overlay used to sit here, re-render the tapped pack into itself at a fixed
             size and ask for a second tap. PackTearAnimator now tears the shelf tile itself, so
             everything the beat draws is a child of that tile and there is nothing to author here.
             Adding a stage back would put a second copy of an on-screen object on screen. -->
        <!-- The reveal is the cards on the vault backdrop, nothing else (Sam, 2026-09-27): no
             panel, no title, no count, no button. A tap anywhere off a card dismisses it.
             reveal-dismiss is that tap: it fills the overlay BEHIND the cards, and reveal-cards
             ignores picking so its gaps fall through to it. It also carries emb-back, so Android's
             back gesture dismisses the reveal before it leaves the screen: BackNavigation clicks
             the DEEPEST visible back control, and this sits one level below Back. -->
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay reveal-overlay--hidden emb-bleed">
            <ui:VisualElement name="reveal-dismiss" class="reveal-dismiss emb-back"/>
            <ui:VisualElement name="reveal-cards" class="reveal-cards" picking-mode="Ignore"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
