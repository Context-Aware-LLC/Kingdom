<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/PackVault/packvault.uss?fileID=7433441132597879392&amp;guid=36eac866b4624b47af05d928f36743f1&amp;type=3#packvault"/>
    <Style src="project://database/Assets/UI/PackReveal/packreveal.uss?fileID=7433441132597879392&amp;guid=a201f4cb62914110a1d96762b261bb3d&amp;type=3#packreveal"/>
    <!-- The pack vault. The shelf is authored empty; PackVaultController fills it from the pack
         balance on GET /collection, one tile per unopened pack.

         THE reveal-* TREE IS THE STORE'S, VERBATIM, AND MUST STAY THAT WAY. PackRevealPanel
         queries these NAMES out of whatever root it is handed, which is the whole reason it was
         split out of the store in 2026-08-20. Renaming one here does not break a build; it makes
         a pack open to a blank screen after the entitlement is already spent.
         (No double dash anywhere in this comment. An XML comment may not contain one, and Unity
         does not report the parse failure: the whole screen renders EMPTY.) -->
    <ui:VisualElement name="root" class="emb-root pack-vault-screen">
        <ui:VisualElement name="vault-shell" class="vault-shell emb-bleed">
            <ui:VisualElement name="vault-bar" class="vault-bar">
                <ui:Label text="Packs" class="vault-title"/>
                <ui:Label name="vault-subtitle" text="" class="vault-subtitle"/>
                <ui:VisualElement picking-mode="Ignore" class="vault-bar__gap"/>
                <ui:Button name="btn-vault-back" text="← Back" class="vault-back emb-back"/>
            </ui:VisualElement>
            <!-- Gift mode only, and hidden here so Vault mode never has to turn it off. It is shown
                 by PackVaultController once a shelf with packs on it has actually rendered: a banner
                 saying "here is a gift" over a spinner, or over "could not reach the server", is
                 worse than no banner at all. The staged entrance modifier is added at show time and
                 is deliberately not authored here.
                 (No double dash anywhere in this comment either, for the reason above.) -->
            <ui:VisualElement name="vault-banner" class="vault-banner vault-banner--hidden">
                <ui:Label name="vault-banner-title" text="A gift to start you off" class="vault-banner__title"/>
                <ui:Label name="vault-banner-body" text="Open them and keep everything inside." class="vault-banner__body"/>
            </ui:VisualElement>
            <ui:VisualElement name="vault-shelf" class="vault-shelf"/>
            <ui:Label name="vault-status" text="" class="vault-status vault-status--empty"/>
        </ui:VisualElement>
        <!-- THE TEAR. Declared BEFORE the reveal and after the shelf, which is its z order: it covers
             the shelf it was launched from and is covered by the reveal it hands off to.
             PackTearAnimator queries these names out of the root, the same host-agnostic contract
             PackRevealPanel uses, so a host that omits this whole block still opens packs (IsBound
             goes false and the tear hands straight through).
             Every image this wants is unbuilt: files 3, 4 and 5 of spec 6.1 and file 6 of 6.2. The
             elements exist anyway so that landing the art is a background-image on a rule that is
             already here, rather than a markup change. -->
        <ui:VisualElement name="tear-overlay" class="tear-overlay tear-overlay--hidden emb-bleed">
            <ui:VisualElement name="tear-stage" class="tear-stage">
                <ui:VisualElement name="tear-burst" picking-mode="Ignore" class="tear-burst"/>
                <!-- THREE VIEWS OF ONE PACK, baked by the crimp shader (Sol, 2026-09-03): the intact
                     sealed wrapper, a top piece carrying the top crimp, and a bottom piece carrying
                     the bottom crimp. Both pieces have an irregular TRANSPARENT torn edge, which is
                     why the intact wrapper exists as its own element and sits last (topmost): the
                     pieces overlap by about 8% and their torn edges are alpha, so a sealed pack
                     showing them directly would show the seam through itself. The wrapper covers
                     them until the tear, then hides and hands the stage to the two pieces. -->
                <ui:VisualElement name="tear-pack" class="tear-pack">
                    <ui:VisualElement name="tear-pack-top" picking-mode="Ignore" class="tear-pack-half tear-pack-half_top"/>
                    <ui:VisualElement name="tear-pack-bottom" picking-mode="Ignore" class="tear-pack-half tear-pack-half_bottom"/>
                    <ui:VisualElement name="tear-pack-face" picking-mode="Ignore" class="tear-pack-face"/>
                    <ui:VisualElement name="tear-strip" picking-mode="Ignore" class="tear-strip"/>
                </ui:VisualElement>
                <ui:Label name="tear-hint" text="Tap or pull down to open" class="tear-hint"/>
                <ui:Button name="btn-tear-skip" text="Skip" class="tear-skip emb-back"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- emb-back on Done as well as on Back, so Android's back gesture dismisses the reveal
             before it leaves the screen. BackNavigation clicks the TOPMOST visible back control,
             and a modal declared after the content it covers is topmost by document order. -->
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay reveal-overlay--hidden emb-bleed">
            <ui:VisualElement class="reveal-shell">
                <ui:Label name="reveal-title" text="Pack opened" class="reveal-title"/>
                <ui:Label name="reveal-summary" text="" class="reveal-summary"/>
                <ui:VisualElement name="reveal-cards" class="reveal-cards"/>
                <ui:Button name="btn-reveal-done" text="Add to collection" class="reveal-done emb-back"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
