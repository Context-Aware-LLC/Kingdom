/* The pack-opening reveal. Moved out of shop.uss on 2026-08-20 with the controller it styles, so
 * the reveal could be hosted somewhere other than the store; the vault is that host.
 *
 * It is self-sufficient on purpose. `.emb-root` (theme.uss) is the only outside dependency, and
 * only for the design tokens. */

/* No panel of its own (Sam, 2026-09-27): the cards sit on the vault's own backdrop. It is painted
 * again here, rather than left transparent, because the shelf is still laid out underneath and a
 * transparent overlay would show the cards over the packs. Same image, same scale mode, same box
 * as `.pack-vault-screen`, so the two are indistinguishable.
 * No padding: this element carries .emb-bleed, and a class rule here ties theme.uss on specificity
 * and wins on sheet order, so the clearance would never apply. */
.reveal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/PackVault_AncientCache_Backdrop_v1.png");
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-overlay--hidden {
    display: none;
}

/* The tap-off-a-card target. Behind the cards, filling the overlay. */
.reveal-dismiss {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.reveal-cards {
    width: 96%;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.reveal-card {
    width: 18%;
    min-width: 135px;
    max-width: 230px;
    aspect-ratio: 0.7;
    align-items: stretch;
    justify-content: space-between;
    background-color: var(--surface-0);
    border-width: 3px;
    border-color: var(--rarity-common);
    border-radius: var(--space-3);
    padding: var(--space-3);
    margin: 1%;
    opacity: 0;
    scale: 0 1;
    transition-property: opacity, scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    overflow: hidden;
}

.reveal-card--shown {
    opacity: 1;
    scale: 1 1;
}

.reveal-card--rare {
    border-color: var(--rarity-rare);
}

.reveal-card--epic {
    border-color: var(--rarity-epic);
}

.reveal-card--legendary {
    border-color: var(--rarity-legendary);
    background-color: rgb(48, 35, 20);
}

.reveal-card__flourish {
    position: absolute;
    top: -18%;
    left: -15%;
    width: 130%;
    height: 34%;
    rotate: -8deg;
    background-color: rgba(255, 255, 255, 0.05);
}

.reveal-card--rare .reveal-card__flourish {
    background-color: rgba(77, 149, 255, 0.18);
}

.reveal-card--epic .reveal-card__flourish {
    background-color: rgba(181, 102, 255, 0.22);
}

.reveal-card--legendary .reveal-card__flourish {
    background-color: rgba(255, 190, 65, 0.28);
}

/* The illustration. flex-grow takes the space above the name. `scale-and-crop` rather than
   `scale-to-fit`: card art is drawn to its own aspect and the tile is 0.7, so fitting would
   letterbox every card against the surface colour. Painted from script — a card whose art has not
   been generated yet keeps this rule's background and simply reads as a card without a picture. */
.reveal-card__art {
    flex-grow: 1;
    margin-bottom: var(--space-2);
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-card__name {
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.reveal-card__upgrade {
    color: var(--accent);
    font-size: var(--type-caption);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── Several packs at once (PackRevealPanel.ShowMany, vault only) ──────────────────────────────
 *
 * The shown row is the best of the run, up to ten cards, so the cards shrink to fit one row and the
 * row stops growing: the space under it belongs to the list. No ScrollView anywhere — it paints
 * wrong on Android (#285/#307) — so the list is sized to fit, and commons are counted, not named.
 * The list ignores picking throughout, so a tap on it falls through to .reveal-dismiss. */
.reveal-cards--batch {
    flex-grow: 0;
    flex-wrap: nowrap;
}

.reveal-cards--batch .reveal-card {
    width: 9%;
    min-width: 0;
    margin: 0.5%;
    padding: var(--space-2);
}

.reveal-cards--batch .reveal-card__name {
    font-size: var(--type-caption);
}

.reveal-list {
    width: 96%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
}

.reveal-list--hidden {
    display: none;
}

/* "stopped after 3 of 10" — a run cut short by a failed open. Full width, above the blocks. */
.reveal-list__note {
    width: 100%;
    color: var(--warning);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-2);
}

/* One class. Five to a row, so every class in the game fits in two. */
.reveal-list__block {
    width: 19%;
    margin: 0.5%;
    padding: var(--space-2) var(--space-3);
    background-color: var(--surface-0);
    border-left-width: 4px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
}

.reveal-list__block--neutral { border-color: var(--class-neutral); }
.reveal-list__block--emberward { border-color: var(--class-emberward); }
.reveal-list__block--tidecaller { border-color: var(--class-tidecaller); }
.reveal-list__block--gravekeep { border-color: var(--class-gravekeep); }
.reveal-list__block--verdant { border-color: var(--class-verdant); }
.reveal-list__block--clockwright { border-color: var(--class-clockwright); }
.reveal-list__block--nightveil { border-color: var(--class-nightveil); }
.reveal-list__block--stonewarden { border-color: var(--class-stonewarden); }
.reveal-list__block--tempest { border-color: var(--class-tempest); }

.reveal-list__class {
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    margin-bottom: var(--space-1);
}

.reveal-list__line {
    color: var(--ink-2);
    font-size: var(--type-caption);
    white-space: normal;
}

.reveal-list__line--rare { color: var(--rarity-rare); }
.reveal-list__line--epic { color: var(--rarity-epic); }
.reveal-list__line--legendary { color: var(--rarity-legendary); }
