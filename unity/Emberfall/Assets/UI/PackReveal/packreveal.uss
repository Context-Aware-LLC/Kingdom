/* The pack-opening reveal. Moved out of shop.uss on 2026-08-20 with the controller it styles, so
 * the reveal could be hosted somewhere other than the store; the vault is that host.
 *
 * It is self-sufficient on purpose. `.emb-root` (theme.uss) is the only outside dependency, and
 * only for the design tokens. */

/* No panel of its own (Sam, 2026-09-27): the cards sit on the vault's own backdrop. It is painted
 * again here, rather than left transparent, because the shelf is still laid out underneath and a
 * transparent overlay would show the cards over the packs. Same image, same scale mode, same box
 * as `.pack-vault-screen`, so the two are indistinguishable.
 * No padding: this element carries .emb-bleed, and a class rule here ties theme.uss on specificity
 * and wins on sheet order, so the clearance would never apply. */
.reveal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/PackVault_AncientCache_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-overlay--hidden {
    display: none;
}

/* The tap-off-a-card target. Behind the cards, filling the overlay. */
.reveal-dismiss {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.reveal-cards {
    width: 80%;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-4);
}

.reveal-card {
    width: 18%;
    min-width: 120px;
    aspect-ratio: 0.7135;
    align-items: stretch;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 1%;
    opacity: 0;
    scale: 0 1;
    transition-property: opacity, scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}

.reveal-card--shown {
    opacity: 1;
    scale: 1 1;
}

.reveal-card--rare {
    border-color: var(--rarity-rare);
}

.reveal-card--epic {
    border-color: var(--rarity-epic);
}

.reveal-card--legendary {
    border-color: var(--rarity-legendary);
}

.reveal-card__fallback {
    flex-grow: 1;
    align-items: stretch;
    justify-content: space-between;
    background-color: rgba(7, 10, 15, 0.88);
    border-width: 3px;
    border-color: var(--rarity-common);
    border-radius: var(--space-3);
    padding: var(--space-3);
    overflow: hidden;
}

.reveal-card--rare .reveal-card__fallback { border-color: var(--rarity-rare); }
.reveal-card--epic .reveal-card__fallback { border-color: var(--rarity-epic); }
.reveal-card--legendary .reveal-card__fallback { border-color: var(--rarity-legendary); }

.reveal-card__flourish {
    position: absolute;
    top: -18%;
    left: -15%;
    width: 130%;
    height: 34%;
    rotate: -8deg;
    background-color: rgba(255, 255, 255, 0.05);
}

.reveal-card--rare .reveal-card__flourish {
    background-color: rgba(77, 149, 255, 0.18);
}

.reveal-card--epic .reveal-card__flourish {
    background-color: rgba(181, 102, 255, 0.22);
}

.reveal-card--legendary .reveal-card__flourish {
    background-color: rgba(255, 190, 65, 0.28);
}

/* The illustration. flex-grow takes the space above the name. `scale-and-crop` rather than
   `scale-to-fit`: card art is drawn to its own aspect and the tile is 0.7, so fitting would
   letterbox every card against the surface colour. Painted from script — a card whose art has not
   been generated yet keeps this rule's background and simply reads as a card without a picture. */
.reveal-card__art {
    flex-grow: 1;
    margin-bottom: var(--space-2);
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
}

.reveal-card__name {
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── Several packs at once (PackRevealPanel.ShowMany, vault only) ──────────────────────────────
 *
 * The shown row is the best of the run, up to ten cards, so the cards shrink to fit one row and the
 * row stops growing: the space under it belongs to the list. No ScrollView anywhere — it paints
 * wrong on Android (#285/#307) — so the list is sized to fit, and commons are counted, not named.
 * The list ignores picking throughout, so a tap on it falls through to .reveal-dismiss. */
.reveal-cards--batch {
    flex-grow: 0;
}

.reveal-cards--batch .reveal-card {
    width: 18%;
}

.reveal-cards--batch .reveal-card__name {
    font-size: var(--type-caption);
}

/* Preserve the "show every epic and legendary" rule when a remarkable batch produces more than
 * five premium cards. Ordinary batches get the large 80%-wide five-card gallery above; only this
 * exceptional row returns to the compact width needed to keep all ten and the receipt on screen. */
.reveal-cards--crowded {
    flex-wrap: nowrap;
}

.reveal-cards--crowded .reveal-card {
    min-width: 0;
    margin: 0.5%;
}

.reveal-list {
    width: 80%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
}

.reveal-list--hidden {
    display: none;
}

/* "stopped after 3 of 10" — a run cut short by a failed open. Full width, above the blocks. */
.reveal-list__note {
    width: 100%;
    color: var(--warning);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-2);
}

/* One rarity plate. These are deliberately translucent: the ancient cache stays present behind
 * the receipt, while the paired border and inset-dark surface give names a stable reading ground. */
.reveal-list__panel {
    width: 23.5%;
    min-width: 180px;
    min-height: 96px;
    margin: 0.75%;
    padding: var(--space-3) var(--space-4);
    background-color: rgba(7, 11, 17, 0.82);
    border-width: 1px;
    border-top-width: 3px;
    border-color: rgba(154, 167, 182, 0.58);
    border-radius: var(--space-3);
}

.reveal-list__panel--rare { border-color: rgba(61, 123, 245, 0.78); }
.reveal-list__panel--epic { border-color: rgba(162, 75, 229, 0.82); }
.reveal-list__panel--legendary { border-color: rgba(240, 166, 60, 0.86); }

.reveal-list__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.reveal-list__rarity {
    color: var(--rarity-common);
    font-size: var(--type-label);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.reveal-list__panel--rare .reveal-list__rarity { color: var(--rarity-rare); }
.reveal-list__panel--epic .reveal-list__rarity { color: var(--rarity-epic); }
.reveal-list__panel--legendary .reveal-list__rarity { color: var(--rarity-legendary); }

.reveal-list__total {
    min-width: 38px;
    padding: 2px var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
}

.reveal-list__body {
    flex-grow: 1;
}

.reveal-list__common-count {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: var(--space-1);
}

.reveal-list__item {
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.reveal-list__marker {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-right: var(--space-2);
    background-color: var(--rarity-common);
    border-radius: 999px;
}

.reveal-list__panel--rare .reveal-list__marker { background-color: var(--rarity-rare); }
.reveal-list__panel--epic .reveal-list__marker { background-color: var(--rarity-epic); }
.reveal-list__panel--legendary .reveal-list__marker { background-color: var(--rarity-legendary); }

.reveal-list__name {
    flex-grow: 1;
    color: var(--ink-1);
    font-size: var(--type-caption);
    white-space: normal;
}

.reveal-list__copies {
    margin-left: var(--space-2);
    color: var(--ink-2);
    font-size: var(--type-caption);
    -unity-font-style: bold;
}
