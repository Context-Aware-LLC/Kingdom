/* The store's own scene root. `.emb-root` carries only design tokens, so — exactly like
 * `.main-menu` and `.collection` do for their screens — the sizing lives here: the two overlays
 * below are absolutely positioned against it and need a parent that actually fills the panel. */
.shop-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
}

.shop-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.94);
    /* No padding here on purpose: this element carries .emb-bleed, and theme.uss
       pads every bleed layer by --edge-safe. Restating it here would win on source
       order (shop.uss loads after theme.uss) and quietly become the real value. */
}

.shop-overlay--hidden {
    display: none;
}


.chrome-button {
    min-height: 56px;
    padding: 12px 30px;
    border-width: 0;
    border-radius: 0;
    color: var(--ink-1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: rgb(232, 236, 242);
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.chrome-button--primary {
    background-color: rgba(16, 13, 10, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.5px;
    color: rgb(250, 230, 193);
}
.chrome-button--secondary {
    background-color: rgba(21, 28, 38, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
}
 
.chrome-button:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(205, 211, 220);
}
.chrome-button:disabled {
    opacity: 0.42;
}
.chrome-button {
    min-height: 56px;
    height: 56px;
    padding: 12px 30px;

}
/* The store uses the same plate-and-scrim language as Collection: illustrated space is the page,
 * and controls sit on dark translucent surfaces instead of inside a second generic modal.
 *
 * The id scope kept this off the pack-reveal stage, which shared `.shop-overlay`. It no longer
 * does — the reveal moved to packreveal.uss on 2026-08-20 and `#shop-overlay` is now the only
 * `.shop-overlay` there is, so the two blocks could be collapsed into one whenever someone is
 * in here anyway. Left split because a merge is a re-test of the store's whole layout for no
 * behaviour change. */
#shop-overlay {
    align-items: stretch;
    justify-content: flex-start;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    /* No padding here either, and this is the block that actually mattered. The
       element carries .emb-bleed, whose `padding: var(--edge-safe)` comes from
       theme.uss as a CLASS rule -- and `#shop-overlay` is an ID selector, so it
       outranks the theme no matter what order the sheets load in. The padding
       that used to live here (0 24 24) is why the store looked untouched on a
       Pixel 5a after the clearance landed everywhere else: the Back button sat
       under the front camera and the theme never got a say. */
}

.shop-shell {
    width: 96%;
    height: 94%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-4);
}

#shop-overlay .shop-shell {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
}

/* ---------- The bar: tabs, wallet, Back ----------
 * Replaced `.shop-header` on 2026-08-31. The store's `Shop` title and its subtitle are gone, and
 * so is the pair of `.shop-section__title` labels below — the tabs carry the section names now.
 *
 * WHY, in dp. The Pixel 5a's panel is 914.3 x 411.4. The header cost ~96 of that (a --type-h1
 * line, a caption under it, 12dp of padding each side and a 16dp margin) and each section spent
 * another ~30 on a title it did not need, against a content area of ~280 that the two sections
 * had to share between them. They never did: the packs section alone came to ~304dp, so Gem
 * Bundles began below the fold and could only be reached by scrolling.
 *
 * TABS, NOT A TALLER SCROLLER. The sections no longer share the screen: exactly one compact tab is
 * visible, so the old ScrollView was retired after empty-range overscroll could move a complete
 * pack row offscreen and make its purchase buttons appear clipped. */
.shop-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

#shop-overlay .shop-bar {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 0 0 var(--space-2) var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
}

/* The one element in the bar that may grow, so the tabs stay left and the wallet and Back stay
 * right without either group being sized. picking-mode is Ignore in the UXML: it spans whatever is
 * left over between two touch targets and must not swallow a press aimed at either. */
.shop-bar__gap {
    flex-grow: 1;
}

/* A tab is the section's name and its selector at once. --on is CONTRAST plus the underline; it
 * never changes the tab's geometry, so switching tabs cannot reflow the bar. Same rule the class
 * strip in collection.uss follows. */
.shop-tab {
    min-height: var(--touch-min);
    padding: 0 var(--space-4);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-2);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: color, border-bottom-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.shop-tab:hover {
    color: var(--ink-1);
}

.shop-tab--on {
    color: var(--ink-1);
    border-bottom-color: var(--accent);
}

.shop-section__help,
.shop-status {
    color: var(--ink-2);
    font-size: var(--type-caption);
    white-space: normal;
}

/* The two balances are direct children of the bar now -- the `.shop-wallet` row that used to hold
 * them was one flex level whose only job was grouping, and the bar already lays out in a row. This
 * carries the separation that wrapper's margin-right used to. */
.shop-bar .emb-back {
    margin-left: var(--space-4);
}

.shop-wallet__balance {
    color: var(--ink-1);
    background-color: var(--surface-0);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-left: var(--space-2);
    font-size: var(--type-label);                /* 16dp. Was --type-h2 to survive the old scale. */
    -unity-font-style: bold;
}

.shop-wallet__balance--gold {
    border-left-width: 3px;
    border-left-color: var(--accent);
    background-image: url("/Assets/Art/Icons/gold_icon.png");
}

.shop-wallet__balance--gems {
    border-left-width: 3px;
    border-left-color: var(--mana);
    background-image: url("/Assets/Art/Icons/crystal_icon.png");
}

#shop-overlay .shop-wallet__balance {
    background-color: rgba(0, 0, 0, 0.62);
    border-width: 0;
    border-radius: 999px;
}

#shop-overlay .shop-wallet__balance--gold {
    color: var(--accent);
}

#shop-overlay .shop-wallet__balance--gems {
    color: var(--mana);
}

.shop-close,
.shop-action {
    min-height: var(--touch-min);
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: 0 var(--space-4);
}

#shop-overlay .shop-close {
    /* 96dp wide, 48dp tall — 48 is Android's touch floor exactly. Were 140/88 to survive the
       old reference-resolution scale. */
    min-width: 96px;
    min-height: var(--space-12);
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 0;
    border-radius: 999px;
}

#shop-overlay .shop-close:hover {
    background-color: var(--surface-3);
}

.shop-content {
    flex-grow: 1;
}

.shop-section {
    margin-bottom: var(--space-6);
}

/* NO BOTTOM MARGIN. It separated the two sections while they were stacked; with the tabs there is
 * never anything below the visible one, so it was 16dp of the content area spent on a gap to
 * nothing. Measured on the Pixel 5a rig: the packs tab came to 320.4dp of content in a 289.5dp
 * viewport, and this was half of the 31 it was over by. */
#shop-overlay .shop-section {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--space-2);
    padding: var(--space-4);
    margin-bottom: 0;
}

/* EXACTLY ONE SECTION IS EVER DISPLAYED, and `display: none` rather than an opacity or a translate
 * because a hidden section must cost NO height -- the whole point of the tabs is that the visible
 * one gets the entire content area. ShopPanelController owns which; the two are never both on
 * and never both off. */
.shop-section--hidden {
    display: none;
}

.shop-pack-list,
.shop-gem-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

/* THE GUTTER IS space-between, NOT A TRAILING MARGIN. Two tiles at 49% plus a 2% margin each
 * comes to 102% and wraps to one per row; dropping the last one's margin needs a `:last-child`
 * USS does not have. Letting the row distribute the 2% leaves no trailing margin to overflow and
 * no floating-point tie at exactly 100% -- the failure CharacterRosterController.RowSafetyMargin
 * exists for, one row down. */
.shop-pack-list {
    justify-content: space-between;
}

/* TWO UP, AS BIG AS THE ROW ALLOWS (Sam, 2026-08-31): "we just display it like the card wall,
 * 2 packs per row, big as possible basically."
 *
 * This was `width: 31%` with `min-width: 260px` from the 2026-08-30 pass, whose comment claimed
 * three per row. It never got three: 31% of the 777.9dp list this measures on a Pixel 5a is
 * 241.3, BELOW the 260 floor, so the floor clamped it UP and two tiles sat in 551 of 777.9 with
 * 227dp of dead width on their right. The floors are gone because the percentage is now the whole
 * answer -- a min-width can only ever fight it.
 *
 * The vertical is paid for in .shop-pack__art-rail's ratio, which is the term that moves when this
 * width does. Read the arithmetic there before changing either. */
.shop-pack {
    width: 49%;
    flex-shrink: 0;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-3);
    margin-top: var(--space-2);
}

#shop-overlay .shop-pack {
    background-color: rgba(11, 14, 19, 0.78);
    border-width: 0;
    border-radius: var(--space-2);
}

/* `aspect-ratio` IS supported — it is in the Dimensions block of the USS supported-properties
 * table for 6000.5.1f1, and Unity's own shadergraph package uses it. It was briefly replaced with
 * a hardcoded height on 2026-08-30 on the strength of a STALE comment in collection.uss claiming
 * the property does not exist; that claim was true once and is not now. Restored.
 *
 * `flex-shrink: 0` is kept: the ratio gives the rail a height, and without this the rail can still
 * surrender it when the tile's column is over-subscribed.
 *
 * THE RATIO IS WHAT PAYS FOR `.shop-pack`'s WIDTH, and 3.8 is measured, not chosen. The tile went
 * 31%-clamped-to-260dp -> 49% on 2026-08-31, which is what Sam asked for -- two per row, as big as
 * the row allows -- and a wider tile makes a `width: 100%` rail TALLER at a fixed ratio. At the
 * inherited 3.2 the rail came to 99.4dp and the packs tab overflowed its viewport by 19.0. On the
 * Pixel 5a rig, after 3.2 -> 3.8 and three 12dp gaps going to 8:
 *
 *      viewport 323.4   content 316.2   FITS (7.2 spare)
 *      tile 381.3 x 245.7      art-rail 326.5 x 85.7
 *
 * The rail is BIGGER than it was despite the flatter ratio -- 326.5x85.7 against the old
 * 236x73.75, 61% more picture -- because the width grew faster than the ratio took back.
 *
 * KEEP THE 7dp. It is not slack to spend: the help label above wraps at this width, and a third
 * line of it costs ~17. If you widen `.shop-pack` again, this number moves with it; verify the
 * Store content area at the target resolution. */
.shop-pack__art-rail {
    flex-direction: row;
    width: 100%;
    aspect-ratio: 3.8;
    flex-shrink: 0;
    margin-bottom: var(--space-2);
}

/* The slot has NO CHILDREN as of 2026-08-31 — the title plate that used to sit at its bottom edge
 * is gone (Sam), so the alignment and padding that positioned it went with it. Padding in
 * particular was working against the art: `scale-and-crop` fills the whole box, so the inset only
 * ever shaved the crop. */
.shop-pack__art-slot {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    margin-right: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.shop-pack__art-slot--loaded {
    background-color: rgba(11, 14, 19, 0.35);
}

.shop-pack__name {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
}

.shop-pack__detail {
    color: var(--ink-2);
    font-size: var(--type-caption);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.shop-pack__actions {
    flex-direction: row;
    flex-shrink: 0;
}

.shop-pack__buy {
    flex-grow: 1;
    min-height: 48px;
    margin-right: var(--space-2);
    border-radius: var(--space-2);
    -unity-font-style: bold;
}

#shop-overlay .shop-pack__buy {
    border-width: 0;
    border-radius: 999px;
}

.shop-pack__buy--gold {
    color: var(--surface-0);
    background-color: var(--accent);
    border-color: var(--accent);
}

.shop-pack__buy--gems {
    color: var(--ink-1);
    background-color: rgb(35, 91, 142);
    border-color: var(--mana);
}

.shop-pack__buy:disabled {
    opacity: 1;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-color: var(--surface-3);
}

.shop-gem {
    width: 31%;
    min-width: 180px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: var(--space-3);
    margin-right: 2%;
    margin-top: var(--space-2);
}

#shop-overlay .shop-gem {
    background-color: rgba(11, 14, 19, 0.78);
    border-width: 0;
    border-radius: 999px;
}

.shop-gem__amount {
    flex-grow: 1;
    color: var(--mana);
    font-size: var(--type-label);
    -unity-font-style: bold;
}

.shop-gem__price {
    color: var(--ink-2);
    font-size: var(--type-label);
}

.shop-status {
    min-height: 20px;
    color: var(--warning);
    margin-top: var(--space-2);
}

#shop-overlay .shop-status {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-top: 0;
}

/* AN EMPTY STATUS LINE COSTS NOTHING. A Label with no text still reserves its box -- measured at
 * 32dp of a 411dp panel here, taken straight off the content area, and the store is empty of
 * status most of the time it is open. ShopPanelController.SetStatus stamps and clears this; the
 * UXML ships it on, because the label starts empty. Same band, same fix, as the roster's in
 * 32dfdb81. */
.shop-status--empty {
    display: none;
}
