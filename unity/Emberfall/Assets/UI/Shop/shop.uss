/* UNITS: every "dp" in the comments below that predates 2026-09-01 is a PRE-#349 unit, when
 * the panel ran ConstantPhysicalSize and was 914 x 411. It is 2400 x 1080 authored px now —
 * see the unit block at the top of Common/theme.uss. Those passages are kept because the
 * DECISIONS they record still stand; their arithmetic is history, not a live budget. */

/* The store's own scene root. `.emb-root` carries only design tokens, so — exactly like
 * `.main-menu` and `.collection` do for their screens — the sizing lives here: the two overlays
 * below are absolutely positioned against it and need a parent that actually fills the panel. */
.shop-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
}

.shop-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.94);
    /* No padding here on purpose: this element carries .emb-bleed, and theme.uss
       pads every bleed layer by --edge-safe. Restating it here would win on source
       order (shop.uss loads after theme.uss) and quietly become the real value. */
}

.shop-overlay--hidden {
    display: none;
}


.chrome-button {
    min-height: 56px;
    padding: 12px 30px;
    border-width: 0;
    border-radius: 0;
    color: var(--ink-1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: rgb(232, 236, 242);
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.chrome-button--primary {
    background-color: rgba(16, 13, 10, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.5px;
    color: rgb(250, 230, 193);
}
.chrome-button--secondary {
    background-color: rgba(21, 28, 38, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
}
 
.chrome-button:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(205, 211, 220);
}
.chrome-button:disabled {
    opacity: 0.42;
}
.chrome-button {
    min-height: 56px;
    height: 56px;
    padding: 12px 30px;

}
/* The store uses the same plate-and-scrim language as Collection: illustrated space is the page,
 * and controls sit on dark translucent surfaces instead of inside a second generic modal.
 *
 * The id scope kept this off the pack-reveal stage, which shared `.shop-overlay`. It no longer
 * does — the reveal moved to packreveal.uss on 2026-08-20 and `#shop-overlay` is now the only
 * `.shop-overlay` there is, so the two blocks could be collapsed into one whenever someone is
 * in here anyway. Left split because a merge is a re-test of the store's whole layout for no
 * behaviour change. */
#shop-overlay {
    align-items: stretch;
    justify-content: flex-start;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    /* No padding here either, and this is the block that actually mattered. The
       element carries .emb-bleed, whose `padding: var(--edge-safe)` comes from
       theme.uss as a CLASS rule -- and `#shop-overlay` is an ID selector, so it
       outranks the theme no matter what order the sheets load in. The padding
       that used to live here (0 24 24) is why the store looked untouched on a
       Pixel 5a after the clearance landed everywhere else: the Back button sat
       under the front camera and the theme never got a say. */
}

.shop-shell {
    width: 96%;
    height: 94%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-4);
}

#shop-overlay .shop-shell {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
}

/* ---------- The bar: tabs, wallet, Back ----------
 * Replaced `.shop-header` on 2026-08-31. The store's `Shop` title and its subtitle are gone, and
 * so is the pair of `.shop-section__title` labels below — the tabs carry the section names now.
 *
 * WHY, in dp. The Pixel 5a's panel is 914.3 x 411.4. The header cost ~96 of that (a --type-h1
 * line, a caption under it, 12dp of padding each side and a 16dp margin) and each section spent
 * another ~30 on a title it did not need, against a content area of ~280 that the two sections
 * had to share between them. They never did: the packs section alone came to ~304dp, so Gem
 * Bundles began below the fold and could only be reached by scrolling.
 *
 * TABS, NOT A TALLER SCROLLER. The sections no longer share the screen: exactly one compact tab is
 * visible, so the old ScrollView was retired after empty-range overscroll could move a complete
 * pack row offscreen and make its purchase buttons appear clipped. */
.shop-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

#shop-overlay .shop-bar {
    flex-shrink: 0;
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
}

/* PANEL GONE, VAULT ART THROUGH (Sam, 2026-09-07): the bar's own dark strip was one of the panels
 * sitting on top of `#shop-overlay`'s CollectionPlate_Vault background and hiding it. Same
 * visibility trick as Collection's card-wall panel and deck drawer: `visibility` is INHERITED, so
 * hiding it here and re-showing every direct child (tabs, wallet chips, Back) removes the strip
 * without touching the layout box `.shop-bar` still reserves or any child's own opacity. */
#shop-overlay .shop-bar {
    visibility: hidden;
}
.shop-bar > * {
    visibility: visible;
}

/* The one element in the bar that may grow, so the tabs stay left and the wallet and Back stay
 * right without either group being sized. picking-mode is Ignore in the UXML: it spans whatever is
 * left over between two touch targets and must not swallow a press aimed at either. */
.shop-bar__gap {
    flex-grow: 1;
}

/* A tab is the section's name and its selector at once. --on is CONTRAST plus the underline; it
 * never changes the tab's geometry, so switching tabs cannot reflow the bar. Same rule the class
 * strip in collection.uss follows. */
.shop-tab {
    min-height: var(--touch-min);
    padding: 0 var(--space-4);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-2);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: color, border-bottom-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.shop-tab:hover {
    color: var(--ink-1);
}

.shop-tab--on {
    color: var(--ink-1);
    border-bottom-color: var(--accent);
}

.shop-section__help,
.shop-status {
    color: var(--ink-2);
    font-size: var(--type-caption);
    white-space: normal;
}

.shop-wallet__balance {
    color: var(--ink-1);
    background-color: var(--surface-0);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-left: var(--space-2);
    font-size: var(--type-label);                /* 16dp. Was --type-h2 to survive the old scale. */
    -unity-font-style: bold;
}

.shop-wallet__balance--gold {
    border-left-width: 3px;
    border-left-color: var(--accent);
    background-image: url("/Assets/Art/Icons/gold_icon.png");
}

.shop-wallet__balance--gems {
    border-left-width: 3px;
    border-left-color: var(--mana);
    background-image: url("/Assets/Art/Icons/crystal_icon.png");
}

/* Pill background dropped, not hidden (Sam, 2026-09-07): unlike the panels above, this element
 * paints its own icon and text directly -- no child to fall back to -- so `visibility` would take
 * the icon with it. Icon and text now sit straight on the vault art, same as everything else on
 * this screen. */
#shop-overlay .shop-wallet__balance {
    border-width: 0;
}

#shop-overlay .shop-wallet__balance--gold {
    color: var(--accent);
}

#shop-overlay .shop-wallet__balance--gems {
    color: var(--mana);
}

.shop-close,
.shop-action {
    min-height: var(--touch-min);
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: 0 var(--space-4);
}

#shop-overlay .shop-close {
    /* 96dp wide, 48dp tall — 48 is Android's touch floor exactly. Were 140/88 to survive the
       old reference-resolution scale. */
    min-width: 96px;
    min-height: var(--space-12);
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 0;
    border-radius: 999px;
}

#shop-overlay .shop-close:hover {
    background-color: var(--surface-3);
}

.shop-content {
    flex-grow: 1;
}

.shop-section {
    flex-grow: 1;
    margin-bottom: var(--space-6);
}

/* NO BOTTOM MARGIN. It separated the two sections while they were stacked; with the tabs there is
 * never anything below the visible one, so it was 16dp of the content area spent on a gap to
 * nothing. Measured on the Pixel 5a rig: the packs tab came to 320.4dp of content in a 289.5dp
 * viewport, and this was half of the 31 it was over by. */
#shop-overlay .shop-section {
    padding: var(--space-4);
    margin-bottom: 0;
    /* Reserves Back's footprint (Sam, 2026-09-07): `.col-back-corner` sits absolute at
       bottom:var(--space-6)=24 with height:var(--touch-min)=56, so 24+56=80 plus a var(--space-3)=12
       clearance gap is 92 -- otherwise the last pack row or the section label under it renders
       straight under the button, same trap `.deck-chooser-frame` hit in collection.uss. */
    padding-bottom: 92px;
}

/* Same panel-removal as `.shop-bar` above: the section's dark card was the other layer sitting
 * between the player and the vault background. `.shop-section--hidden`'s `display: none` still
 * decides which section exists at all -- visibility only governs whether the visible one paints
 * its own backdrop. */
#shop-overlay .shop-section {
    visibility: hidden;
}
.shop-section > * {
    visibility: visible;
}

/* EXACTLY ONE SECTION IS EVER DISPLAYED, and `display: none` rather than an opacity or a translate
 * because a hidden section must cost NO height -- the whole point of the tabs is that the visible
 * one gets the entire content area. ShopPanelController owns which; the two are never both on
 * and never both off. */
.shop-section--hidden {
    display: none;
}

.shop-gem-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

/* STACKED, NOT SIDE BY SIDE (Sam, 2026-09-05). Replaces "two up, as big as the row allows"
 * (2026-08-31): at 49% width the row-wrap layout sized each pack off its art-rail's fixed
 * aspect ratio and stopped there, leaving roughly half of .shop-section's height empty below
 * it. Column flow plus flex-grow on both the list and each pack (below) lets the two packs
 * split whatever height the section actually has, on any device, with no ratio to re-measure. */
.shop-pack-list {
    flex-direction: column;
    flex-grow: 1;
    align-items: stretch;
}

/* FULL WIDTH, FLEX-GROWN HEIGHT (Sam, 2026-09-05). `flex-basis: 0` with `flex-grow: 1` splits
 * .shop-pack-list's height evenly between the two packs instead of sizing each to its content
 * and stranding the rest of the section blank. */
/* ROW, NAME LEFT OF THE RAIL (Sam, 2026-09-07): replaces a name label stacked full-width below
 * the rail, which is what the absolute bottom-left Back button collided with on the last pack in
 * the list. NOT align-items: center on this container -- the rail needs the default `stretch` to
 * keep filling the row's full height (it did in the old column layout via flex-grow, which only
 * governs the MAIN axis; centering here would leave the rail's cross-axis height at 0, which is
 * exactly what happened the first time this shipped). The name centers itself instead, below. */
.shop-pack {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-3);
    margin-top: var(--space-2);
}

#shop-overlay .shop-pack {
    border-width: 0;
    border-radius: var(--space-2);
}

/* Same panel-removal as `.shop-bar` / `.shop-section` above: the tile's own dark card was another
 * layer over the vault art. The name and the art-rail (and its slots, which keep their own
 * placeholder chrome -- that is card content, not panel backdrop) inherit back to visible. */
#shop-overlay .shop-pack {
    visibility: hidden;
}
.shop-pack > * {
    visibility: visible;
}

/* THE RAIL FILLS WHATEVER HEIGHT THE PACK HAS (Sam, 2026-09-05), replacing the measured
 * `aspect-ratio: 3.8` from 2026-08-31. That ratio was tuned for a 49%-wide tile sitting in a
 * content area that stopped short of the section's real height; stacking the packs made it
 * meaningless on sight, since the tile is now full width and `.shop-section` is flex-grown to
 * fill its parent. `flex-grow: 1` with `min-height: 0` lets the rail take whatever is left after
 * the name, detail and buttons below it claim their content height -- no ratio to re-measure
 * when the tile's size changes again. */
.shop-pack__art-rail {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* The slot has NO CHILDREN as of 2026-08-31 — the title plate that used to sit at its bottom edge
 * is gone (Sam), so the alignment and padding that positioned it went with it. Padding in
 * particular was working against the art: `scale-and-crop` fills the whole box, so the inset only
 * ever shaved the crop. */
.shop-pack__art-slot {
    flex-grow: 1;
    flex-basis: 0;
    /* background-color: var(--surface-2); */
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    margin-right: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* BORDERLESS (Sam, 2026-09-07): the outline around each face read as another panel edge once the
 * vault art was showing through everything around it. The art itself is scale-and-crop, so nothing
 * relied on the border for a boundary -- overflow: hidden above is what actually clips it. */
#shop-overlay .shop-pack__art-slot {
    border-width: 0;
}

/* A SHARED PERCENTAGE COLUMN, NOT CONTENT WIDTH (Sam, 2026-09-07): sizing-to-content (previous
 * pass) let "Rekindling" claim more width than "Emberfall", so each row's art-rail started at a
 * different x and the second row read as shifted right. Every `.shop-pack` row is the same width
 * (100% of `.shop-pack-list`), so a percentage here lands every row's name column -- and therefore
 * every rail's left edge -- at the identical x regardless of which set's name is longest. Same
 * outcome as a dedicated label column running down the whole list, without splitting the tile's
 * name+rail out of one clickable element. white-space: nowrap still guards the wrap this replaced. */
.shop-pack__name {
    flex-shrink: 0;
    width: 10%;
    align-self: center;
    margin-right: var(--space-3);
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    white-space: nowrap;
}

/* THE WHOLE TILE IS THE TAP TARGET (Sam, 2026-09-05): the buy buttons and the "5 cards..." line
 * moved into #pack-detail-overlay, opened by tapping anywhere on the tile. The hover tint is the
 * only affordance a plain VisualElement gets for free -- it is not a Button. */
.shop-pack:hover {
    background-color: var(--surface-2);
}

#shop-overlay .shop-pack:hover {
    background-color: rgba(11, 14, 19, 0.92);
}

.shop-pack__buy {
    flex-grow: 1;
    min-height: 48px;
    margin-right: var(--space-2);
    border-radius: var(--space-2);
    -unity-font-style: bold;
}

#shop-overlay .shop-pack__buy {
    border-width: 0;
    border-radius: 999px;
}

.shop-pack__buy--gold {
    color: var(--surface-0);
    background-color: var(--accent);
    border-color: var(--accent);
}

.shop-pack__buy--gems {
    color: var(--ink-1);
    background-color: rgb(35, 91, 142);
    border-color: var(--mana);
}

.shop-pack__buy:disabled {
    opacity: 1;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-color: var(--surface-3);
}

.shop-gem {
    width: 31%;
    min-width: 180px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: var(--space-3);
    margin-right: 2%;
    margin-top: var(--space-2);
}

#shop-overlay .shop-gem {
    background-color: rgba(11, 14, 19, 0.78);
    border-width: 0;
    border-radius: 999px;
}

.shop-gem__amount {
    flex-grow: 1;
    color: var(--mana);
    font-size: var(--type-label);
    -unity-font-style: bold;
}

.shop-gem__price {
    color: var(--ink-2);
    font-size: var(--type-label);
}

.shop-status {
    min-height: 20px;
    color: var(--warning);
    margin-top: var(--space-2);
}

#shop-overlay .shop-status {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-top: 0;
}

/* AN EMPTY STATUS LINE COSTS NOTHING. A Label with no text still reserves its box -- measured at
 * 32dp of a 411dp panel here, taken straight off the content area, and the store is empty of
 * status most of the time it is open. ShopPanelController.SetStatus stamps and clears this; the
 * UXML ships it on, because the label starts empty. Same band, same fix, as the roster's in
 * 32dfdb81. */
.shop-status--empty {
    display: none;
}

/* ---------- Pack detail (Sam, 2026-09-05) ----------
 * Same nested overlay/shell shape as #shop-overlay and .reveal-overlay above: one hidden class
 * removes the whole thing from layout, and the shell centers itself inside the scrim.
 *
 * THE SHELL FLIES IN FROM THE TAPPED TILE AND BACK OUT AGAIN (Sam, 2026-09-07 follow-up), rather
 * than fading or scaling from its own center: ShopPanelController computes the tapped tile's
 * on-screen rect and sets the shell's translate/scale to exactly overlap it, then -- on a later
 * tick, once that has actually rendered once -- flips translate/scale back to identity so the
 * transition system animates the shell traveling from the tile's position to its natural centered
 * layout. --animating is where the transition lives (not here): the very first translate/scale
 * this element receives each open is that tile-matched starting point, and it must land instantly
 * with no transition, or the whole effect is backwards. See ShopPanelController.OpenDetail /
 * CloseDetail for the two-tick sequencing this depends on. */
.pack-detail-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    /* 0.5, not 0.94 (Sam, 2026-09-07 follow-up): "significantly" less dimming -- the tile row
     * behind the shell should still read as present, not go nearly black. */
    background-color: rgba(11, 14, 19, 0.5);
    /* NO TRANSITION HERE ANY MORE (Sam, 2026-09-07 follow-up, reversing the previous note this
     * replaced): syncing the scrim's fade to the shell's 1.5s duration was worse, not better --
     * the shell has no background of its own, so its legibility against the still-bright,
     * undimmed shop behind it depends on the scrim's contrast. With both easing in together, the
     * early part of the flight was too low-contrast to actually perceive; only the last portion,
     * once the scrim had darkened enough to read the card against it, registered at all. That is
     * what looked like "starts centered and transparent, then fades into view" -- the motion was
     * real the whole time, just invisible for its first stretch. Snapping the scrim to full
     * darkness instantly puts the WHOLE flight at full contrast from frame one. */
    opacity: 1;
}

.pack-detail-overlay--hidden {
    display: none;
}

/* NO FIXED HEIGHT (Sam, 2026-09-07 follow-up): the art rail this used to hold is gone, and a
 * shell still stretched to 94% of the screen left three lines of content sitting in a mostly
 * empty transparent box -- there is no background-color here, so that leftover height just showed
 * the scrim through it. Sized to content instead, centered by .pack-detail-overlay's
 * align-items/justify-content: center. */
/* max-width 820px, not 640px (Sam, 2026-09-07 follow-up): at 640, boxing the art down to fit
 * beside the title/note/buttons text made it end up SMALLER than the ~515x410 tile art-slot it
 * flew in from, so the pack visibly shrank instead of growing. The art is the thing that has to
 * read as "getting bigger" -- see .pack-detail-art below, sized off this wider shell. */
.pack-detail-shell {
    width: 90%;
    max-width: 820px;
    flex-direction: column;
    border-width: 0px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-4);
}

/* Transition lives in its own modifier, never on the base rule above: the shell's translate/scale
 * get set directly in code, and the FIRST such set each open/close (the tile-matched jump) must
 * apply with no active transition or it animates the wrong direction. --animating is added only
 * once that jump has already rendered a frame.
 *
 * 0.45s, not 0.28s (Sam, 2026-09-07 follow-up): measured live by slowing this to 60s and polling
 * mid-flight -- the flip DOES run and interpolate correctly, but Unity's ease-out curve is so
 * front-loaded that at 0.28s essentially all the visible motion lands inside the first ~50ms,
 * reading as a pop instead of a flight. Longer duration, same ease-out Sam asked for. */
/* ease-in-out, not ease-out (Sam, 2026-09-07 follow-up): ease-out is heavily front-loaded --
 * nearly all the motion lands in the first sliver of the duration -- which read as a fast pop at
 * the start even once the duration was long enough to see. ease-in-out ramps up from a standstill
 * instead, so the flight has a visible beginning as well as a settle. */
.pack-detail-shell--animating {
    transition-property: translate, scale;
    transition-duration: 2.5s;
    transition-timing-function: ease-in-out;
}

.pack-detail-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--space-3);
}

/* The one piece actually tapped, with Contain scaling (set alongside backgroundImage in
 * ShopPanelController.OpenDetail) so the art's own proportions decide how it fills the box rather
 * than being stretched. Sized off WIDTH with an aspect-ratio matching the tile's own art-slot
 * (~515x410, i.e. 1.256) instead of a fixed height (Sam, 2026-09-07 follow-up) -- a fixed height
 * shorter than the slot it flew in from is what made the art shrink instead of grow. At 82% of
 * the now-820px-max shell this comes out bigger than the slot on both axes. display:none by
 * default -- OpenDetail only shows it when the FLIP origin was a real art slot, never for the
 * tile/name-label fallback, where there is no specific piece to show. */
.pack-detail-art {
    flex-shrink: 0;
    align-self: center;
    width: 82%;
    aspect-ratio: 1.256;
    margin-bottom: var(--space-3);
    border-radius: var(--space-2);
    overflow: hidden;
    display: none;
}

.pack-detail-title {
    flex-grow: 1;
    color: var(--ink-1);
    font-size: var(--type-h1);
    -unity-font-style: bold;
    white-space: normal;
}

.pack-detail-close {
    min-width: var(--space-12);
    min-height: var(--space-12);
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 0;
    border-radius: 999px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pack-detail-close:hover {
    background-color: var(--surface-3);
}

.pack-detail-note {
    flex-shrink: 0;
    color: var(--ink-2);
    font-size: var(--type-label);
    white-space: normal;
    margin-bottom: var(--space-3);
}

/* COLUMN, NOT ROW (Sam, 2026-09-07 follow-up): two same-shape buttons side by side read as two
 * different purchasable things. Stacked, they read as two ways to pay for the single pack named
 * in the title above. */
.pack-detail-actions {
    flex-direction: column;
    flex-shrink: 0;
}

/* Bigger than the tile's own buy buttons -- the detail shell has the room the tile never did.
 * The gap between the two stacked buttons is set in C# (ShopPanelController.OpenDetail, on the
 * second button only) rather than a :first-child rule here -- Unity does not support that
 * pseudo-class (logs "Unknown pseudo class 'first-child' in StyleSheet shop" and silently never
 * applies it; the pre-existing matchsettings.uss usage this was copied from has the same warning
 * and the same dead rule). */
.pack-detail-actions .shop-pack__buy {
    width: 100%;
    min-height: var(--space-12);
    font-size: var(--type-h2);
}
