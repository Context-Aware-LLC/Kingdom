/* The store's own scene root. `.emb-root` carries only design tokens, so — exactly like
 * `.main-menu` and `.collection` do for their screens — the sizing lives here: the two overlays
 * below are absolutely positioned against it and need a parent that actually fills the panel. */
.shop-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
}

.shop-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.94);
    padding: var(--space-4);
}

.shop-overlay--hidden {
    display: none;
}

/* The store uses the same plate-and-scrim language as Collection: illustrated space is the page,
 * and controls sit on dark translucent surfaces instead of inside a second generic modal.
 *
 * The id scope kept this off the pack-reveal stage, which shared `.shop-overlay`. It no longer
 * does — the reveal moved to packreveal.uss on 2026-08-20 and `#shop-overlay` is now the only
 * `.shop-overlay` there is, so the two blocks could be collapsed into one whenever someone is
 * in here anyway. Left split because a merge is a re-test of the store's whole layout for no
 * behaviour change. */
#shop-overlay {
    align-items: stretch;
    justify-content: flex-start;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    padding: 0 var(--space-6) var(--space-6);
}

.shop-shell {
    width: 96%;
    height: 94%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-4);
}

#shop-overlay .shop-shell {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
}

.shop-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

#shop-overlay .shop-header {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 0 0 var(--space-2) var(--space-2);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
}

.shop-heading {
    flex-grow: 1;
}

.shop-title {
    color: var(--ink-1);
    font-size: var(--type-h1);
    -unity-font-style: bold;
}

.shop-subtitle,
.shop-section__help,
.shop-status {
    color: var(--ink-2);
    font-size: var(--type-caption);
    white-space: normal;
}

.shop-wallet {
    flex-direction: row;
    margin-right: var(--space-4);
}

.shop-wallet__balance {
    color: var(--ink-1);
    background-color: var(--surface-0);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-left: var(--space-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
}

.shop-wallet__balance--gold {
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.shop-wallet__balance--gems {
    border-left-width: 3px;
    border-left-color: var(--mana);
}

#shop-overlay .shop-wallet__balance {
    background-color: rgba(0, 0, 0, 0.62);
    border-width: 0;
    border-radius: 999px;
}

#shop-overlay .shop-wallet__balance--gold {
    color: var(--accent);
}

#shop-overlay .shop-wallet__balance--gems {
    color: var(--mana);
}

.shop-close,
.shop-action {
    min-height: 44px;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: 0 var(--space-4);
}

#shop-overlay .shop-close {
    min-width: 96px;
    min-height: var(--space-12);
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 0;
    border-radius: 999px;
}

#shop-overlay .shop-close:hover {
    background-color: var(--surface-3);
}

.shop-scroll {
    flex-grow: 1;
}

.shop-scroll .unity-scroller {
    display: none;
}

.shop-section {
    margin-bottom: var(--space-6);
}

#shop-overlay .shop-section {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--space-2);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
}

.shop-section__title {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    margin-bottom: var(--space-1);
}

.shop-pack-list,
.shop-gem-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.shop-pack {
    width: 48%;
    min-width: 260px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-3);
    margin-right: 2%;
    margin-top: var(--space-3);
}

#shop-overlay .shop-pack {
    background-color: rgba(11, 14, 19, 0.78);
    border-width: 0;
    border-radius: var(--space-2);
}

.shop-pack__art-rail {
    flex-direction: row;
    width: 100%;
    aspect-ratio: 3.2;
    margin-bottom: var(--space-3);
}

.shop-pack__art-slot {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    margin-right: var(--space-1);
    padding: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.shop-pack__art-slot--loaded {
    background-color: rgba(11, 14, 19, 0.35);
}

.shop-pack__art-slot-label {
    color: var(--ink-1);
    background-color: rgba(11, 14, 19, 0.78);
    border-radius: var(--space-1);
    padding: 2px var(--space-1);
    font-size: var(--type-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.shop-pack__name {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
}

.shop-pack__detail {
    color: var(--ink-2);
    font-size: var(--type-caption);
    margin-bottom: var(--space-3);
}

.shop-pack__actions {
    flex-direction: row;
}

.shop-pack__buy {
    flex-grow: 1;
    min-height: 48px;
    margin-right: var(--space-2);
    border-radius: var(--space-2);
    -unity-font-style: bold;
}

#shop-overlay .shop-pack__buy {
    border-width: 0;
    border-radius: 999px;
}

.shop-pack__buy--gold {
    color: var(--surface-0);
    background-color: var(--accent);
    border-color: var(--accent);
}

.shop-pack__buy--gems {
    color: var(--ink-1);
    background-color: rgb(35, 91, 142);
    border-color: var(--mana);
}

.shop-pack__buy:disabled {
    color: var(--ink-2);
    background-color: var(--surface-2);
    border-color: var(--surface-3);
}

.shop-gem {
    width: 31%;
    min-width: 180px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: var(--space-3);
    margin-right: 2%;
    margin-top: var(--space-2);
}

#shop-overlay .shop-gem {
    background-color: rgba(11, 14, 19, 0.78);
    border-width: 0;
    border-radius: 999px;
}

.shop-gem__amount {
    flex-grow: 1;
    color: var(--mana);
    font-size: var(--type-label);
    -unity-font-style: bold;
}

.shop-gem__price {
    color: var(--ink-2);
    font-size: var(--type-label);
}

.shop-status {
    min-height: 20px;
    color: var(--warning);
    margin-top: var(--space-2);
}

#shop-overlay .shop-status {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-top: 0;
}
