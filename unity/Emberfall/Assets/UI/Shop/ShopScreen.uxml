<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/Shop/shop.uss?fileID=7433441132597879392&amp;guid=1bfa8e0e1ac74f0287ff03d16cc57e01&amp;type=3#shop"/>
    <Style src="project://database/Assets/UI/PackReveal/packreveal.uss?fileID=7433441132597879392&amp;guid=a201f4cb62914110a1d96762b261bb3d&amp;type=3#packreveal"/>
    <ui:VisualElement name="root" class="emb-root shop-screen">
        <ui:VisualElement name="shop-overlay" class="shop-overlay shop-overlay--hidden emb-bleed">
            <ui:VisualElement name="shop-shell" class="shop-shell">
                <!-- ONE BAR, NOT A HEADER (Sam, 2026-08-31). The store's title and subtitle are
                     gone: a screen you reached by pressing "Shop" does not need to tell you it is
                     the shop, and on a 411dp landscape phone that pair plus its own padding was
                     ~96dp of the ~280dp the two sections had to share. What survives is what you
                     act on: the two tabs, the wallet, and Back, in a single row.
                     (No double dash anywhere in this comment. An XML comment may not contain one,
                     and Unity does not report the parse failure: the whole screen renders EMPTY.)

                     THE TABS ARE THE SECTION TITLES. Each section's own `shop-section__title`
                     label was removed rather than duplicated up here; the tab that selects a
                     section is the only place its name now appears. -->
                <ui:VisualElement name="shop-bar" class="shop-bar">
                    <ui:Button name="shop-tab-packs" text="Booster Packs" class="shop-tab shop-tab--on"/>
                    <ui:Button name="shop-tab-gems" text="Gem Bundles" class="shop-tab"/>
                    <ui:VisualElement picking-mode="Ignore" class="shop-bar__gap"/>
                    <ui:Label name="shop-gold-balance" class="shop-wallet__balance shop-wallet__balance--gold"/>
                    <ui:Label name="shop-gem-balance" class="shop-wallet__balance shop-wallet__balance--gems"/>
                    <ui:Button name="btn-shop-close" text="← Back" class="col-button col-button--ghost chrome-button chrome-button--secondary emb-back"/>
                </ui:VisualElement>
                <ui:ScrollView name="shop-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="shop-scroll">
                    <ui:VisualElement name="shop-section-packs" class="shop-section">
                        <ui:Label text="Each pack contains five cards from Core plus its expansion, with at least one Rare or better." class="shop-section__help"/>
                        <ui:VisualElement name="shop-pack-list" class="shop-pack-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="shop-section-gems" class="shop-section shop-section--hidden">
                        <ui:Label text="Gem purchases are coming soon." class="shop-section__help"/>
                        <ui:VisualElement name="shop-gem-list" class="shop-gem-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="shop-status" text="" class="shop-status shop-status--empty"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Styled by packreveal.uss, not shop.uss: the same tree is hosted by PackRevealScreen,
             and it borrowed `.shop-overlay` / `.shop-shell` until 2026-08-20 — which is what made
             it unhostable anywhere but here. -->
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay reveal-overlay--hidden emb-bleed">
            <ui:VisualElement class="reveal-shell">
                <ui:Label name="reveal-title" text="Pack opened" class="reveal-title"/>
                <ui:Label name="reveal-summary" text="" class="reveal-summary"/>
                <ui:VisualElement name="reveal-cards" class="reveal-cards"/>
                <ui:Button name="btn-reveal-done" text="Add to collection" class="reveal-done"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
