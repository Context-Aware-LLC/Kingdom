<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/Shop/shop.uss?fileID=7433441132597879392&amp;guid=1bfa8e0e1ac74f0287ff03d16cc57e01&amp;type=3#shop"/>
    <ui:VisualElement name="root" class="emb-root shop-screen">
        <ui:VisualElement name="shop-overlay" class="shop-overlay shop-overlay--hidden emb-bleed">
            <ui:VisualElement name="shop-shell" class="shop-shell">
                <!-- ONE BAR, NOT A HEADER (Sam, 2026-08-31). The store's title and subtitle are
                     gone: a screen you reached by pressing "Shop" does not need to tell you it is
                     the shop, and on the 411-unit landscape panel this was decided against
                     (pre-#349) that pair plus its own padding was
                     ~96dp of the ~280dp the two sections had to share. What survives is what you
                     act on: the two tabs, the Vault link, the wallet, and Back, in a single row.
                     (No double dash anywhere in this comment. An XML comment may not contain one,
                     and Unity does not report the parse failure: the whole screen renders EMPTY.)

                     THE TABS ARE THE SECTION TITLES. Each section's own `shop-section__title`
                     label was removed rather than duplicated up here; the tab that selects a
                     section is the only place its name now appears. -->
                <ui:VisualElement name="shop-bar" class="shop-bar">
                    <ui:Button name="shop-tab-packs" text="Booster Packs" class="shop-tab shop-tab--on"/>
                    <ui:Button name="shop-tab-gems" text="Gem Bundles" class="shop-tab"/>
                    <ui:VisualElement name="shop-vault-entry" class="shop-vault-entry">
                        <ui:Button name="shop-card-vault" text="Card Vault" class="shop-vault-link"/>
                        <ui:Label name="shop-vault-count" text="" picking-mode="Ignore" class="shop-vault-count shop-vault-count--hidden"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="shop-bar__gap"/>
                    <ui:VisualElement tooltip="Gold" class="shop-wallet">
                        <ui:VisualElement picking-mode="Ignore" class="shop-wallet__icon shop-wallet__icon--gold"/>
                        <ui:Label name="shop-gold-balance" text="—" picking-mode="Ignore" class="shop-wallet__balance shop-wallet__balance--gold"/>
                    </ui:VisualElement>
                    <ui:VisualElement tooltip="Gems" class="shop-wallet">
                        <ui:VisualElement picking-mode="Ignore" class="shop-wallet__icon shop-wallet__icon--gems"/>
                        <ui:Label name="shop-gem-balance" text="—" picking-mode="Ignore" class="shop-wallet__balance shop-wallet__balance--gems"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="shop-content" class="shop-content">
                    <ui:VisualElement name="shop-section-packs" class="shop-section">
                        <ui:VisualElement name="shop-pack-list" class="shop-pack-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="shop-section-gems" class="shop-section shop-section--hidden">
                        <ui:Label text="Gem purchases are coming soon." class="shop-section__help"/>
                        <ui:VisualElement name="shop-gem-list" class="shop-gem-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Bottom-left, off the bar (Sam, 2026-09-07): same corner as every other
                     screen's Back button. `.emb-back-button` (theme.uss) is the canonical one. -->
                <ui:Button name="btn-shop-close" text="Back" class="emb-back emb-back-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Opened by tapping a tile in shop-pack-list (Sam, 2026-09-05; the shell FLIES IN from
             the tapped tile's position rather than cutting to a full-screen modal, as of the
             2026-09-07 follow-up; see ShopPanelController.OpenDetail/CloseDetail and shop.uss's
             pack detail shell animation modifier class): the buy buttons that used to sit on the
             tile live here instead, under the selected pack art.
             pack-detail-art shows the ONE piece actually tapped, not the tile's whole four-wide
             rail again, so the art the player's thumb was on travels into the card with the text
             instead of just vanishing under the scrim; OpenDetail leaves it hidden when the tap
             did not land on a specific art slot. pack-detail-shell stops its own ClickEvent from
             bubbling, so a tap on the panel does not fall through to this overlay's close-on-scrim
             handler — the same trap CraftModal's craft-scrim documents. On purchase, the shell
             flies to the Card Vault link rather than back to its source tile. -->
        <ui:VisualElement name="pack-detail-overlay" class="pack-detail-overlay pack-detail-overlay--hidden emb-bleed">
            <ui:VisualElement name="pack-detail-shell" class="pack-detail-shell">
                <ui:VisualElement name="pack-detail-art" class="pack-detail-art"/>
                <ui:VisualElement name="pack-detail-actions" class="pack-detail-actions"/>
                <ui:Label name="pack-detail-error" text="" class="pack-detail-error pack-detail-error--hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
