<?xml version="1.0" encoding="utf-8"?>
<!--
  CollectionScreen.uxml — one plate, two modes (#153).

  This used to be two plates. DeckbuilderScreen.uxml is gone; everything it declared is here, and
  which half you see is decided by a modifier class CollectionController puts on the root element
  (see the Modes block in collection.uss). Browse shows the header, the query bar and the wall.
  Deckbuild shows the filter chips, the wall and the deck panel.

  Bound at runtime by CollectionController. The wall itself is CardWall and the query controls are
  CardQueryBar, so nothing here re-implements either.

  The query chip rows are EMPTY on purpose. CardQueryBar generates their contents from the enums in
  Enums.cs, so a ninth class or a fifth rarity appears without anyone editing this file. Authoring
  them by hand is how a list silently stops matching the set it claims to describe.

  The three filter chips below ARE authored by hand, and that is not the same mistake: they are
  All, this character's pairing, and neutral, which is a fixed set of three regardless of how many
  classes exist.

  NEVER write a BEM modifier's double dash inside a comment in this file. XML forbids that sequence
  in a comment, so the importer fails the WHOLE file, CloneTree() returns zero children, every Q<>()
  is null, and NOTHING is logged — the screen is simply empty. Refer to modifier classes in words,
  never by writing the literal class name in a comment.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Deckbuilder/theme.uss" />
    <Style src="../Deckbuilder/deckbuilder.uss" />
    <Style src="collection.uss" />

    <ui:VisualElement name="root" class="emb-root collection">

        <!--
          Browse only. Deckbuild deliberately has no header (Sam, 2026-08-07): it carried the
          character's name and the deck's, both of which are on the roster one screen back, and
          repeating them cost the wall a band of vertical space. In that mode Back and the card
          count live in the deck panel instead, where the count labels the list it counts.
        -->
        <ui:VisualElement name="collection-header" class="col-header">
            <ui:VisualElement class="col-heading">
                <ui:Label text="Collection" class="col-title" />
                <ui:Label name="collection-count" text="" class="col-count" />
                <!--
                  Owned vs All (#146). Shown only when this account HAS an ownership record: with
                  none, the wall is already every card in the game and this would offer a choice
                  between a pool and itself. CollectionController adds the shown modifier, so an
                  account that has never been granted anything never meets this control. Which of
                  the two you are looking at is what the count label to the left says.
                -->
                <ui:VisualElement name="scope-row" class="col-scope">
                    <ui:Button name="scope-owned" text="Owned" class="db-chip db-chip--on" />
                    <ui:Button name="scope-all" text="All" class="db-chip" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="back-button" text="Back" class="col-button col-button--ghost" />
        </ui:VisualElement>

        <!--
          Query controls, browse only. Every one of these is optional to CardQueryBar: delete any
          and that facet is simply not offered, with no code change.

          Hidden while deckbuilding on purpose, and the reason is worth knowing: the class chips are
          generated from all nine classes, but a deckbuilding pool holds two of them plus neutral,
          so seven of those chips would match nothing. Offering the full bar in both modes is a real
          improvement and a real decision, not a side effect of merging two files.
        -->
        <ui:VisualElement name="query-bar" class="col-query">
            <ui:VisualElement class="col-query-row">
                <ui:TextField name="query-search" class="col-search" />
                <ui:DropdownField name="query-sort" class="col-sort" />
                <ui:Button name="query-sort-dir" text="Asc" class="db-chip col-sort-dir" />
                <ui:Button name="query-reset" text="Reset" class="db-chip" />
            </ui:VisualElement>
            <ui:VisualElement name="query-classes" class="col-chip-row" />
            <ui:VisualElement name="query-rarities" class="col-chip-row" />
            <ui:VisualElement name="query-types" class="col-chip-row" />
            <ui:VisualElement name="query-costs" class="col-chip-row" />
        </ui:VisualElement>

        <!-- Body. A row of two panels while deckbuilding; the left panel alone while browsing. -->
        <ui:VisualElement name="body" class="db-body">

            <ui:VisualElement name="collection-panel" class="db-panel db-collection">

                <!-- Deckbuild only: All, this character's pairing, neutral. -->
                <ui:VisualElement name="filter-row" class="db-filter-row">
                    <ui:Button name="filter-all" text="All" class="db-chip db-chip--on" />
                    <ui:Button name="filter-class" text="Class" class="db-chip" />
                    <ui:Button name="filter-neutral" text="Neutral" class="db-chip" />
                </ui:VisualElement>

                <ui:ScrollView name="collection-scroll" class="col-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="collection-grid" class="db-grid" />
                </ui:ScrollView>

                <!--
                  Inside the panel rather than at root, so it sits under the wall it describes in
                  both modes. Shown by CollectionController only when a query matches nothing: a
                  wall that goes blank with no text reads as a broken screen, not an empty result.
                -->
                <ui:Label name="collection-empty" text="Nothing matches those filters." class="col-empty" />

            </ui:VisualElement>

            <!--
              Deckbuild only. Set Default and Delete Deck went to the roster's deck dialog with the
              rest of deck management (Sam, 2026-08-07); what is left here edits the 30.

              Back lives in this panel rather than a footer row of its own (Sam, 2026-08-09): the
              legality box below it never had anything to say, since this screen cannot produce an
              illegal deck (SaveDeck is never legality gated), so it is gone and Back moved up next
              to the count. It still saves and leaves; see WireChrome.
            -->
            <ui:VisualElement name="deck-panel" class="db-panel db-deck">
                <ui:VisualElement name="deck-header" class="db-deck-header">
                    <ui:Button name="done-button" text="Back" class="db-button db-button--ghost db-button--back" />
                    <ui:Label name="count-label" text="0 / 30" class="db-count" />
                </ui:VisualElement>
                <ui:VisualElement name="curve-strip" class="db-curve" />
                <ui:ListView name="deck-list" class="db-list" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!--
          Crafting (GH#157 Render / GH#158 Reduce). One modal, declared once, used by BOTH modes —
          the same argument that made this one plate in the first place. CraftModal binds it and
          CollectionController opens it; both are hidden here at rest and shown from code, so a
          missing element is a broken plate rather than a mode that declined the modal.

          Two absolutely-positioned siblings, deliberately: the scrim is what a click outside the
          panel lands on, so it has to be a separate element the panel sits ON TOP of rather than a
          background on an ancestor. The panel stops click propagation itself.

          It is last inside root because UI Toolkit paints in document order and has no z-index; an
          overlay declared earlier would render UNDER the wall it is supposed to cover. Moving this
          block up is not a reordering, it is a disappearance.

          The buttons currently go nowhere. See CraftModal's class comment for what has to land
          before they do.
        -->
        <ui:VisualElement name="craft-scrim" class="craft-scrim" />

        <ui:VisualElement name="craft-modal" class="craft-modal">

            <ui:VisualElement class="craft-head">
                <ui:VisualElement class="craft-heading">
                    <ui:Label name="craft-card-name" text="" class="craft-name" />
                    <ui:Label name="craft-card-rarity" text="" class="craft-rarity" />
                </ui:VisualElement>
                <ui:VisualElement class="craft-wallet">
                    <ui:Label name="craft-shard-balance" text="0" class="craft-wallet-value" />
                    <ui:Label text="shards" class="craft-wallet-word" />
                </ui:VisualElement>
                <ui:Button name="craft-close" text="Close" class="col-button col-button--ghost" />
            </ui:VisualElement>

            <ui:VisualElement class="craft-body">

                <!-- The real card front, baked by CardFaceBaker — the same cached texture the wall
                     uses, so opening this on a card already on screen costs no bake. -->
                <ui:VisualElement class="craft-cardpane">
                    <ui:VisualElement name="craft-card-face" class="craft-card-face" />
                    <ui:Label name="craft-copies-owned" text="" class="craft-owned" />
                </ui:VisualElement>

                <!-- The two directions. Neither is ever removed; the one you cannot take right now
                     is marked dead by CraftModal and still states its price and its reason. -->
                <ui:VisualElement class="craft-halves">

                    <ui:VisualElement name="craft-render-half" class="craft-half">
                        <ui:Label text="Render" class="craft-half-title" />
                        <ui:Label text="Spend shards to make this card." class="craft-half-blurb" />
                        <ui:VisualElement class="craft-price">
                            <ui:Label name="craft-render-cost" text="0" class="craft-price-value" />
                            <ui:Label text="shards" class="craft-price-word" />
                        </ui:VisualElement>
                        <ui:Label name="craft-render-note" text="" class="craft-half-note" />
                        <ui:Button name="craft-render-button" text="Render" class="craft-action" />
                    </ui:VisualElement>

                    <ui:VisualElement name="craft-reduce-half" class="craft-half">
                        <ui:Label text="Reduce" class="craft-half-title" />
                        <ui:Label text="Break a copy down for shards." class="craft-half-blurb" />
                        <ui:VisualElement class="craft-price">
                            <ui:Label name="craft-reduce-payout" text="0" class="craft-price-value" />
                            <ui:Label text="shards" class="craft-price-word" />
                        </ui:VisualElement>
                        <ui:Label name="craft-reduce-note" text="" class="craft-half-note" />
                        <ui:Button name="craft-reduce-button" text="Reduce" class="craft-action craft-action--ghost" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
