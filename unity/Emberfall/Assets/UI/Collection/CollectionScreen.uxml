<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Deckbuilder/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/Deckbuilder/deckbuilder.uss?fileID=7433441132597879392&amp;guid=256848a7b7f34ec47b8b83dae3a72e79&amp;type=3#deckbuilder"/>
    <Style src="project://database/Assets/UI/Collection/collection.uss?fileID=7433441132597879392&amp;guid=8ec502da397030442998cd90701bbf86&amp;type=3#collection"/>
    <ui:VisualElement name="root" class="emb-root collection">
        <ui:VisualElement name="body" class="db-body">
            <ui:VisualElement name="collection-header" class="col-header">
                <ui:VisualElement class="col-heading">
                    <ui:Label text="Collection" class="col-title"/>
                    <ui:Label name="collection-count" text="" class="col-count"/>
                    <ui:VisualElement name="scope-row" class="col-scope">
                        <ui:Button name="scope-owned" text="Owned" class="db-chip db-chip--on"/>
                        <ui:Button name="scope-all" text="All" class="db-chip"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="tab-bar" style="grid-item flex-direction: column, flex-grow: 1;">
                    <ui:Button class="class-tab_art class-tab_art-emberward"/>
                    <ui:Button class="class-tab_art class-tab_art-stonewarden"/>
                    <ui:Button class="class-tab_art class-tab_art-tempest"/>
                    <ui:Button class="class-tab_art class-tab_art-nightveil"/>
                    <ui:Button class="class-tab_art class-tab_art-clockwright"/>
                    <ui:Button class="class-tab_art class-tab_art-verdant"/>
                    <ui:Button class="class-tab_art class-tab_art-tidecaller"/>
                    <ui:Button class="class-tab_art class-tab_art-gravekeep"/>
                    <ui:Button class="class-tab_art class-tab_art-neutral"/>
                </ui:VisualElement>
                <ui:VisualElement name="query-bar" class="col-query">
                    <ui:VisualElement class="col-query-row">
                        <ui:TextField name="query-search" class="col-search"/>
                        <ui:DropdownField name="query-sort" class="col-sort"/>
                        <ui:Button name="query-sort-dir" text="Asc" class="db-chip col-sort-dir"/>
                        <ui:Button name="query-reset" text="Reset" class="db-chip"/>
                        <ui:VisualElement name="filter-row" class="db-filter-row">
                            <ui:Button name="filter-primary" text="Primary" class="db-chip"/>
                            <ui:Button name="filter-secondary" text="Secondary" class="db-chip"/>
                            <ui:Button name="filter-neutral" text="Neutral" class="db-chip"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="query-rarities" class="col-chip-row"/>
                    <ui:VisualElement name="query-types" class="col-chip-row"/>
                    <ui:VisualElement name="query-costs" class="col-chip-row"/>
                </ui:VisualElement>
                <ui:VisualElement name="deck-panel" class="grid-item db-panel db-deck">
                    <ui:VisualElement name="deck-header" class="db-deck-header">
                        <ui:Button name="done-button" text="← Back" class="db-button db-button--ghost db-button--back"/>
                        <ui:Label name="count-label" text="0 / 30" class="db-count"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="curve-strip" class="db-curve"/>
                    <ui:ListView name="deck-list" class="db-list"/>
                </ui:VisualElement>
                <ui:VisualElement name="collection-panel" class="db-panel db-collection">
                <ui:ScrollView name="collection-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" touch-scroll-type="Elastic" class="col-scroll">
                <ui:VisualElement name="collection-grid" class="db-grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="deck-drawer" class="deck-drawer">
            <ui:VisualElement class="deck-drawer__header">
                <ui:VisualElement>
                    <ui:Label name="deck-drawer-title" text="Decks" class="deck-drawer__title"/>
                    <ui:Label name="deck-drawer-subtitle" text="Choose a deck to edit" class="deck-drawer__subtitle"/>
                </ui:VisualElement>
                <ui:Button name="deck-drawer-close" text="Close" class="col-button col-button--ghost"/>
            </ui:VisualElement>
            <ui:ScrollView name="deck-chooser" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="deck-chooser">
                <ui:VisualElement name="deck-chooser-list" class="deck-chooser__list"/>
                <ui:Label name="deck-chooser-empty" text="No decks yet." class="deck-chooser__empty"/>
            </ui:ScrollView>
            <ui:VisualElement name="deck-editor" class="deck-editor deck-editor--hidden">
                <ui:Button name="choose-another-deck" text="← All decks" class="deck-drawer__back"/>
                <ui:VisualElement class="deck-editor__identity">
                    <ui:Label name="deck-character-name" text="" class="deck-editor__character"/>
                    <ui:Label name="deck-name" text="" class="deck-editor__name"/>
                    <ui:Label name="count-label" text="0 / 30" class="db-count"/>
                </ui:VisualElement>
                <ui:VisualElement name="curve-strip" class="db-curve"/>
                <ui:ListView name="deck-list" class="db-list"/>
            </ui:VisualElement>
            <ui:Button name="manage-decks-button" text="Manage Characters &amp; Decks" class="deck-drawer__manage"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
