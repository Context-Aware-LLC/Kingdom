/* ---------------------------------------------------------------------------------------------
 * Was Assets/UI/Deckbuilder/deckbuilder.uss until 2026-08-25 (#161). It was never shared: by then
 * its ONLY consumer was CollectionScreen.uxml, which already loaded this file straight after it.
 *
 * PREPENDED, NOT APPENDED, AND THAT IS LOAD-BEARING. The screen loaded theme -> deckbuilder ->
 * collection, so collection's rules won every equal-specificity tie. Appending would have
 * silently inverted that on every selector the two sheets both touch.
 *
 * .card-tile's 276px width is a contract with CardWall.TileWidth. Nothing below restyles it.
 * --------------------------------------------------------------------------------------------- */

/*
 * S7 screen styles. Consumes tokens from Common/theme.uss only (no literal colors/sizes that a
 * token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 *
 * `.deckbuilder` was declared here and worn by NOTHING — no UXML, no AddToClassList. It styled the
 * screen root of the deckbuilder plate that #153 merged away. Deleted 2026-08-25 (#161); the live
 * root is `.emb-root.collection`.
 */

/* The screen had a header carrying the character's name, the deck's name and the count. It is
 * gone (Sam, 2026-08-07): the first two are on the roster, one screen back. */
/* Back + count share a row at the top of the deck panel (Sam, 2026-08-09) — Back used to be its
 * own footer row below the legality box, which is gone (see deck-header's UXML comment). */
.db-deck-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}
.db-count {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    -unity-text-align: middle-right;
}
.db-pill {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--surface-0);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
}
.db-pill--valid   { background-color: var(--positive); }
.db-pill--invalid { background-color: var(--warning); }

/* ---------- Body / split ---------- */
.db-body {
    flex-direction: row;
    flex-grow: 1;
}
.db-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}
/* 70/30 split (Sam, 2026-08-01) — collection reads as the primary surface, deck as the sidebar. */
.db-collection { flex-grow: 7; margin-right: var(--space-4); }
.db-deck       { flex-grow: 3; min-width: 360px; }
.db-panel-title {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-2);
    margin-bottom: var(--space-3);
}

/* ---------- Filter chips ---------- */
.db-filter-row { flex-direction: row; margin-bottom: var(--space-3); }
.db-chip {
    font-size: var(--type-label);
    color: var(--ink-2);
    background-color: var(--surface-3);
    border-width: 0;
    border-radius: 999px;
    padding: var(--space-1) var(--space-4);
    margin-right: var(--space-2);
    height: var(--touch-min);
}
.db-chip--on {
    color: var(--surface-0);
    background-color: var(--mana);
    -unity-font-style: bold;
}

/* ---------- Lists ---------- */
/* THE ONE MEMBER OF THE DECK COLUMN THAT MAY YIELD, and the only one that can do it harmlessly:
 * it is a ListView, so it scrolls what it cannot show. min-height: 0 is what lets it actually
 * reach zero rather than floor on its content and push the deficit back onto its pinned siblings. */
.db-list {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--surface-1);
    border-radius: var(--space-2);
}


/* ---------- Collection wall (§2.9 wall tile — the REAL card, baked by CardFaceBaker, not a
 * UI Toolkit re-implementation of the card front) ---------- */
/* justify-content is flex-start ON PURPOSE and must stay that way. CardWall.Layout computes the
 * column count, the bounded gutter and the outer breathing room itself and writes them as per-tile
 * margins; any other value here re-distributes the surplus it already spent, and the two solves
 * compose into neither. `space-between` did exactly that -- it pushed a sparse row's cards apart
 * into islands and, with the outer margin landing only on the left, sat the row flush against the
 * right edge. */
.db-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
}
.card-tile {
    width: 340px;
    height: 477px;
    /* margin-left/margin-right are runtime-computed per row by
     * CardWall.Layout (responsive tile tier, bounded gutter, centred
     * outer breathing room); only the top/bottom 4px here actually applies. */
    margin: var(--space-1) var(--space-2);
    background-color: var(--surface-3);   /* shows through until the bake resolves */
    -unity-background-scale-mode: scale-to-fit;
    border-radius: var(--space-2);
}
/* The two opacities allowed on the wall, both per-CARD facts and never the wall's state — the
 * no-dimming ruling that removed .card-tile--disabled was about a full deck greying out all ~90
 * tiles at once, which neither of these can do (Sam, 2026-08-07). See
 * CollectionController.DecorateTile, which is the only thing that sets either, and CardWall.RefreshTiles.
 *
 * They must never both land on one tile — DecorateTile's `!unowned` term is what guarantees it.
 * They mean opposite things and want opposite pixels. */

/* Spent: the deck already holds every copy of this card you are allowed. You are finished with it,
 * so it gets out of the way. Deckbuild only. */
.card-tile--maxed {
    opacity: 0.1;
}

/* Unowned: you hold no copy of this card. The opposite of spent — this is the one you are shopping
 * for, so it stays legible and reads as "not yours yet" rather than "gone". Both modes.
 *
 * THIS NUMBER IS THE TUNING KNOB. Too low and the wall goes dark for a new account, where nearly
 * every card is unowned — which is the no-dimming ruling's spirit even though its letter (per-card,
 * not wall-state) is satisfied. Sam's brief was "full colour, 100% opacity, your collection, mixed
 * in with those some dimmer unowned cards", so the contrast has to be readable at a glance without
 * the unowned half becoming furniture. */
.card-tile--unowned {
    opacity: 0.5;
}
/* Deck-side row (§2.3 full tiles are collection-only for now; the deck list stays a legible
 * full-width row for L1–L5 proof) */
.card-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 var(--space-3);
    margin: var(--space-1) var(--space-2);
    background-color: var(--surface-2);
    border-radius: var(--space-1);
    border-left-width: 4px;
    border-left-color: var(--class-neutral);
}
.card-row--disabled { opacity: 0.4; }
.card-cost {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--type-body);
    color: var(--surface-0);
    background-color: var(--mana);
    border-radius: 999px;
    margin-right: var(--space-3);
}
.card-name {
    flex-grow: 1;
    font-size: var(--type-body);
    color: var(--ink-1);
}
.card-rarity-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    margin-right: var(--space-3);
    background-color: var(--rarity-common);
}
/* ---------- Deck side ---------- */
/* The deck switcher (EF-046), the name field, Set Default and Delete Deck lived here. They are
 * all on the CharacterRoster screen now (Sam, 2026-08-07) — this panel edits one deck's 30 and
 * cannot change which deck, which deck is default, or whether it exists. */

.db-curve {
    /* See the note on .deck-drawer__back: unpinned, this collapsed under the deck name and drew
     * its bars and its 0..7+ labels through the text above it. */
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    height: 56px;
    margin-bottom: var(--space-3);
    padding: 0 var(--space-1);
}
.curve-col {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    margin: 0 1px;
}
.curve-bar {
    width: 60%;
    min-height: 2px;
    background-color: var(--mana);
    border-radius: 2px;
}
.curve-label {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-top: 2px;
}

/* ---------- Rarity / class modifiers (token-driven; set from C# by enum) ---------- */
.rarity--common    { background-color: var(--rarity-common); }
.rarity--rare      { background-color: var(--rarity-rare); }
.rarity--epic      { background-color: var(--rarity-epic); }
.rarity--legendary { background-color: var(--rarity-legendary); }

.edge--neutral    { border-left-color: var(--class-neutral); }
.edge--emberward  { border-left-color: var(--class-emberward); }
.edge--tidecaller { border-left-color: var(--class-tidecaller); }
.edge--gravekeep  { border-left-color: var(--class-gravekeep); }
.edge--verdant    { border-left-color: var(--class-verdant); }

/* ---------- Buttons ---------- */
.db-button {
    font-size: var(--type-body);
    -unity-font-style: bold;
    height: 48px;
    min-width: 140px;
    border-width: 0;
    border-radius: var(--space-2);
    padding: 0 var(--space-6);
}
/* Back sits in the deck-header row (§ deck side) — narrower than .db-button's default so it
 * reads as a corner control next to the count, not a footer; but still 48px tall for touch. */
.db-button--back {
    height: var(--space-12);
    min-width: 84px;
    padding: 0 var(--space-4);
}
.db-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}
.db-button--ghost {
    color: var(--ink-2);
    background-color: var(--surface-3);
}
.db-button:disabled { opacity: 0.35; }

/* =============================================================================================
 * BELOW: the collection's own sheet, unchanged.
 * ============================================================================================= */

/* collection.uss — the full-pool browse surface.
 *
 * Tokens come from theme.uss; only what is specific to this screen lives here. The tile itself is
 * deliberately NOT restyled: .card-tile is declared once at the top of this file and its compact size is
 * a contract with CardWall, which promotes it to larger responsive tiers at runtime. A second
 * .card-tile rule here would be a second source of truth for one number, which is the exact shape
 * of the card-frame drift this project already paid for.
 *
 * A USS parse error voids the WHOLE stylesheet silently — one bad declaration and every rule in
 * this file stops applying, with nothing logged. Keep declarations complete.
 */

.collection {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    /* The compact wall spends its full short axis. Medium and expanded restore progressively deeper
     * bottom framing below; the controls are an overlay and never consume flow space at any class. */
    padding: 0 var(--space-6) 0;
}
.collection.emb-sw-medium {
    padding-bottom: var(--space-4);
}
.collection.emb-sw-expanded {
    /* padding-bottom: var(--space-6); */
}

/* Owned vs All is runtime state: CollectionController is the only writer of the visible modifier. */
.col-scope {
    display: none;
    flex-direction: row;
}
.col-scope--on {
    display: flex;
}

.col-button {
    min-height: var(--space-12);
    padding: var(--space-2) var(--space-6);
    border-width: 0;
    border-radius: 999px;
    color: var(--ink-1);
    background-color: var(--surface-3);
    font-size: var(--type-label);
}
.col-button--ghost {
    background-color: rgba(0, 0, 0, 0.55);
}
.col-button--decks {
    min-width: 120px;
    margin-right: var(--space-3);
    color: var(--surface-0);
    background-color: var(--accent);
    -unity-font-style: bold;
}
/* A tab hanging from the top-LEFT, because that is now the edge its drawer arrives from. It was
 * centred (`left: 50%; translate: -50% 0`) while the drawer came down across the full width. */
.col-button--filters {
    position: absolute;
    top: 0;
    left: 0;
    width: 132px;
    height: 56px;
    min-height: 56px;
    padding: var(--space-2) var(--space-3) var(--space-1);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(240, 166, 60, 0.82);
    border-radius: 0 0 var(--space-2) var(--space-2);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.collection.emb-sw-medium .col-button--filters {
    width: 152px;
    height: 64px;
    min-height: 64px;
}
.collection.emb-sw-expanded .col-button--filters {
    width: 176px;
    height: 72px;
    min-height: 72px;
}
.col-button--filters-on {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.col-filter-ribbon__label {
    color: rgb(250, 230, 193);
    font-size: var(--type-label);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
/* TWO ROTATED BARS, NOT A GLYPH. This was `<ui:Label text="⌄">` — U+2304 DOWNWARDS CHEVRON —
 * and the font does not have it, so the FILTERS button's only affordance rendered as a
 * missing-glyph box. Seen in a device-dp capture 2026-08-25.
 *
 * Swapping in a different arrow character would just be the same bet on a different code
 * point. .ms-gear already solved this and says why in matchsettings.uss: "Three bars are child
 * VisualElements so the icon is font-independent." Same treatment here. */
.col-filter-ribbon__chevron {
    width: 22px;
    height: 12px;
    margin-top: 2px;
}
.col-filter-ribbon__chevron-arm {
    position: absolute;
    top: 3px;
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background-color: var(--accent);
}
.col-filter-ribbon__chevron-arm--left {
    left: -1px;
    rotate: 40deg;
}
.col-filter-ribbon__chevron-arm--right {
    right: -1px;
    rotate: -40deg;
}
.col-button--filters.chrome-button:active {
    translate: 0 1px;
}

/* Query toolbar + left drawer
 * The toolbar is an overlay declared after the wall in UXML: it paints above the cards but owns no
 * flow height. Its own picking is ignored so the transparent span does not swallow wall gestures;
 * the three Button children remain pickable. The query drawer follows it and therefore paints above
 * both toolbar and wall while open.
 *
 * `top` clears the class rail, which is IN FLOW above the wall as of 2026-08-31 — this overlay is
 * positioned against the screen ROOT, so at top:0 it painted over the rail's nine tabs and ate
 * their taps. It tucks under the rail's bottom edge; the 4dp of the rail's own margin-bottom is
 * deliberately not added, so the tab reads as hanging FROM the strip rather than floating below it.
 */
.col-query-toolbar {
    position: absolute;
    top: var(--touch-min);
    left: var(--edge-safe);
    right: var(--edge-safe);
    height: 72px;
}
.col-query-scrim {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.col-query-scrim--open {
    display: flex;
}
/* THE FILTER DRAWER IS A LEFT COLUMN (Sam, 2026-08-31), mirroring .deck-drawer on the right.
 *
 * It used to span left:0 to right:0 and slide DOWN, spending up to 332dp of a 411dp screen — the
 * SCARCE axis — to show controls that stack perfectly happily in a column. As a left column it
 * spends the abundant one, and the wall stays readable behind it instead of being buried.
 *
 * The width contract is deck-drawer's, deliberately: two drawers that arrive from opposite edges
 * and land on different widths read as two unrelated mechanisms.
 *
 * --edge-safe ON THE LEFT ONLY, and the asymmetry is measured rather than assumed. The left IS a
 * screen edge and the cutout is 52dp deep on a SIDE — it flips sides with rotation direction, which
 * is why the token is spent wherever a panel meets a short edge rather than on the side some API
 * happens to name. The drawer's right edge is interior and takes the ordinary gutter.
 *
 * TOP AND BOTTOM DO NOT PAY. The Pixel 5a's insets, read over USB 2026-08-21, are
 * ROTATION_90 [136,0][0,63] and ROTATION_270 [0,0][136,63] — left/right flip, top is 0 in BOTH, and
 * the 63 at the bottom is the gesture bar, which is hidden. The game is landscape-locked (NOR-283),
 * so no rotation puts a cutout on this panel's top or bottom. This is a LIST, and 52 on each would
 * cost it 104dp of a 411dp column for nothing — the same arithmetic .deck-drawer states.
 *
 * Painting to the edge is correct; putting CONTENT there is not — the .emb-bleed idea, just not all
 * four sides of it. Declared in audit_edge_safety.py's TOKEN_EXCEPTIONS.
 *
 * THE OLD COMPACT HEIGHT BUDGET IS GONE, not merely stale: it read "the search row, optional scope
 * row and three chip rows total at most 332dp of 411, and the 79dp remainder is the outside-tap
 * target that closes this drawer". In a column the rows stack and exceed the panel height instead,
 * which is why .col-query-scroll below exists and why the outside-tap target is now the wall to the
 * RIGHT of the drawer. There is no height budget to keep in sync any more.
 *
 * translate, never width: animating width would emit a GeometryChangedEvent every frame and
 * continuously relayout the fixed-size CardWall tiles. Same reason .deck-drawer gives. */
.col-query {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 20%;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--edge-safe);
    background-color: rgba(8, 12, 18, 0.98);
    border-right-width: 2px;
    border-right-color: var(--accent);
    translate: -110% 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.col-query--open {
    translate: 0 0;
    opacity: 1;
}
/* The rows overflow a 411dp column — see the UXML comment for why the fade is the ScrollView's
 * SIBLING and not its child. min-height:0 is what lets the ScrollView actually shrink to the
 * drawer rather than flooring on its content and pushing the overflow out of the panel. */
.col-query-scroll {
    flex-grow: 1;
    min-height: 0;
}
/* THE TINT IS THE HALF THAT MATTERS. `.emb-scroll-fade` ships a WHITE ramp so one texture can serve
 * every surface; the colour has to come from the use site, and here that is this drawer's own
 * rgba(8, 12, 18, 0.98). Drop this rule and the filter list fades to white. */
.col-query__fade {
    -unity-background-image-tint-color: rgb(8, 12, 18);
}
/* A COLUMN, not a row. Search + sort + sort-dir + reset shared one line across a full-width top
 * drawer; in a ~420dp column they stack. The 56/106/156px side margins that used to centre this
 * row inside the forged brackets' inner bay went with the brackets — there is no bay to centre in,
 * and a fixed side margin here would eat a quarter of the drawer's width at compact. */
.col-query-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: var(--space-2);
}
.col-query-utility-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}
.col-query-actions {
    position: absolute;
    top: var(--space-1);
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}
.col-query-actions .col-button {
    min-height: var(--touch-min);
    height: var(--touch-min);
    padding: 0 var(--space-4);
}
.col-query-actions .col-button--decks {
    min-width: 96px;
}
.collection.emb-sw-medium .col-query-actions {
    top: var(--space-2);
}
.collection.emb-sw-expanded .col-query-actions {
    top: var(--space-3);
}
/* `max-width: 58%` is gone with the row: it kept the search field from swallowing a full-width
 * drawer's line. In a column it would cap the field at 58% of ~370dp and leave the sort control
 * beneath it visibly wider, which reads as a broken alignment rather than a deliberate one. */
.col-search {
    margin-bottom: var(--space-2);
}
/* Stacked, so each control takes the drawer's width and the gap is vertical. These carried
 * width: 200/132/120 and margin-right while the four sat on one line. */
.col-sort {
    margin-bottom: var(--space-2);
}
.col-sort-dir {
    margin-bottom: var(--space-2);
}
#query-reset {
    margin-bottom: var(--space-2);
}
/* Wrapping remains the fallback for split-screen and unusually narrow panels. At the measured
 * compact phone width, the wider bay and compact chip step below keep each known facet on one row. */
.col-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    justify-content: center;
}
/* The 56/106/156px side margins here defined the narrower bay the forged brackets framed. Both the
 * brackets and the bay are gone; in a ~370dp content column those margins left roughly one chip's
 * width of usable row. */
.col-chip-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.collection .db-chip {
    min-height: 52px;
    height: 52px;
    padding: 0 var(--space-6);
    border-width: 0;
    border-radius: 0;
    background-color: rgba(21, 28, 38, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.42px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    color: var(--ink-2);
    font-size: var(--type-body);
    transition-property: -unity-background-image-tint-color, color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.collection.emb-sw-medium .db-chip {
    min-height: 54px;
    height: 54px;
}
.collection.emb-sw-expanded .db-chip {
    min-height: 56px;
    height: 56px;
}
.collection .db-chip:hover,
.collection .db-chip:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: var(--ink-1);
}
.collection .db-chip:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(196, 204, 214);
}
.collection .db-chip.db-chip--on {
    background-color: rgba(16, 13, 10, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.42px;
    -unity-background-image-tint-color: rgb(255, 239, 211);
    color: rgb(250, 230, 193);
}
.collection .db-chip:disabled {
    opacity: 0.42;
}

#query-rarities .db-chip,
#query-types .db-chip {
    width: 128px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}
.collection.emb-sw-medium #query-rarities .db-chip,
.collection.emb-sw-medium #query-types .db-chip {
    width: 130px;
}
.collection.emb-sw-expanded #query-rarities .db-chip,
.collection.emb-sw-expanded #query-types .db-chip {
    width: 132px;
}

#query-costs .db-chip {
    width: 60px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}
.collection.emb-sw-medium #query-costs .db-chip {
    width: 62px;
}
.collection.emb-sw-expanded #query-costs .db-chip {
    width: 64px;
}

/* ---------- Active-deck pairing + cost chip sizing (#160) ----------
 *
 * All of this is scoped under .collection--editing so browse is pixel-identical (the pairing chips
 * do not exist at rest, and the cost chips there keep their content-driven size). It is NOT put on
 * the shared .db-chip at the top of this file on purpose: that class is also worn by the scope toggle and
 * MatchSettings, and a width there would reach screens outside this issue (see GH#161).
 *
 * Sam ruling 4 (2026-08-11): a chip's width must not be driven by its label length — a row of chips
 * should read as a set of equal things. Exact pixels were left to the implementer; this is the
 * min-width-plus-centred-text shape Sam sketched. Pixels rather than percentages match every other
 * control dimension in this file (.col-sort 200px, .col-sort-dir 132px, .db-chip height 56px) — the
 * percentage-over-pixels house ruling is about responsive layout, not fixed control chrome. */

/* The three pairing chips: one floor width so they read as a set, text centred within it. */
.collection--editing .db-filter-row .db-chip {
    min-width: 100px;
    -unity-text-align: middle-center;
}

/* Ruling 3 sat the pairing chips on the SAME LINE as search/sort, with a small gap after Reset —
 * `margin-bottom: 0; margin-left: var(--space-3)`. That ruling was about a full-width top drawer
 * where the four controls shared one line and a second row of chips was the thing being avoided.
 * .col-query-row is a column now, so the chips are already on their own line and the horizontal gap
 * would only indent them out of alignment with everything above. */
.collection--editing .col-query-row .db-filter-row {
    margin-bottom: var(--space-2);
}

/* ---------- Wall ---------- */
.col-scroll {
    flex-grow: 1;
}

/* Shown by CollectionController only when a query matches nothing. A wall that goes blank with no
 * text reads as a broken screen rather than an empty result. */
.col-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
    display: none;
}
.col-empty--on {
    display: flex;
}

/* ---------- Persistent collection shell (NOR-210) ---------- */
.collection .db-filter-row {
    display: none;
}
.collection .db-collection {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin-right: 0;
}
.collection--editing .db-filter-row {
    display: flex;
}
/* NOTHING hides the plate here. `.collection--editing` is stamped on the PLATE
 * (CollectionController.StampEditing), so a bare `display: none` on it removes the whole
 * collection — wall included — from layout. That is what a
 * `.collection--editing { display: none; }` rule did between e034c700 (2026-08-16) and its
 * removal: opening the deck editor rendered an empty screen with no error, because a hidden
 * subtree is skipped by Yoga rather than failing. The symptom was
 * `[NOR-360] content.h=NaN layouts=1` — an unresolved layout, not a zero-height one.
 *
 * It arrived by editing a selector down to nothing: the rule was
 * `.collection--editing #query-classes { display: none; }` and the commit that deleted the
 * #query-classes control deleted the SUBJECT of the selector instead of the rule, leaving the
 * state modifier to apply on its own. Any rule whose selector is a lone `--` state modifier
 * with `display: none` is that mistake; a modifier describes a state, and something inside it
 * is what should be hidden. */

/* ---------- Deck drawer ----------
 * Absolute positioning and translate animation are load-bearing. Animating width would emit a
 * GeometryChangedEvent every frame and continuously relayout the fixed-size CardWall tiles. */
.deck-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 15%;
    /* min-width: 420px; */
    /* Three of this drawer's four sides ARE screen edges (top, right, bottom);
       its left is interior, so it takes the ordinary gutter there. .emb-bleed
       would pad all four by --edge-safe and leave 120px of usable column at the
       420px minimum, which is why this uses the token directly instead of the
       class. Declared in audit_edge_safety.py's TOKEN_EXCEPTIONS.

       Only the RIGHT spends --edge-safe. The drawer's top and bottom are screen
       edges with nothing on them -- the cutout is on a side and the gesture bar
       is hidden (see the token in theme.uss) -- and this is a LIST, so 52 on each
       cost it 104dp of a 411dp panel, about two deck rows, for nothing.

       THIS DECLARATION WAS DEAD TWICE OVER until 2026-08-30 and the drawer was
       simply running at a flat 24px. `--space-5` is not a token -- the scale is
       1/2/3/4/6/8/12/16 -- and ONE unresolvable var() invalidates the WHOLE
       shorthand, silently. On top of that `.deck-drawer.chrome-panel--outer`
       below re-declared `padding: 24px` at higher specificity. So the right edge
       never had its --edge-safe and the Close button sat under the hole-punch.
       Both are fixed; if you add a padding rule for this element, put it HERE. */
    padding: var(--space-4) var(--edge-safe) var(--space-4) var(--space-6);
    background-color: var(--surface-2);
    border-left-width: 2px;
    border-left-color: var(--accent);
    translate: 110% 0%;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.deck-drawer--open {
    translate: 0% 0%;
    opacity: 1;
}
.deck-drawer__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}
.deck-drawer__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.deck-drawer__subtitle {
    font-size: var(--type-label);
    color: var(--ink-2);
}
/* The recessed plate, and the coordinate space the bottom fade anchors to. The ScrollView
 * inside it is bare. See the UXML comment for why the fade cannot be the ScrollView's own child. */
.deck-chooser-frame {
    flex-grow: 1;
}
.deck-chooser {
    flex-grow: 1;
}
/* THE TINT IS THE HALF THAT MATTERS. `.emb-scroll-fade` ships a WHITE ramp so one texture can
 * serve every surface; the colour has to come from the use site, and it is the plate this fade
 * sits on -- `.deck-chooser-frame.chrome-panel--recessed` below, opaque so the ramp's own alpha
 * is the only thing varying. Drop this rule and the deck list fades to white. */
.deck-chooser__fade {
    -unity-background-image-tint-color: rgb(8, 12, 18);
}
.deck-chooser--hidden,
.deck-editor--hidden {
    display: none;
}
.deck-chooser__list {
    flex-grow: 1;
}
.deck-chooser__empty {
    display: none;
    font-size: var(--type-body);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
}
.deck-chooser__empty--on {
    display: flex;
}
.deck-choice-group {
    margin-bottom: var(--space-6);
}
.deck-choice-character {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}
.deck-choice-pairing {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-bottom: var(--space-3);
}
.deck-choice {
    min-height: 64px;
    margin-bottom: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-width: 0;
    border-left-width: 6px;
    border-left-color: var(--class-neutral);
    border-radius: 0;
    background-color: rgba(21, 28, 38, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-text-align: middle-left;
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.deck-choice:hover,
.deck-choice:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.deck-choice:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(196, 204, 214);
}
.deck-editor {
    flex-grow: 1;
}
/* EVERY FIXED-SIZE MEMBER OF THIS COLUMN CARRIES flex-shrink: 0, and `.db-list` is the one
 * element allowed to yield. A flex child shrinks by default, and a Label shrunk below its line
 * box STILL DRAWS ITS TEXT -- which is why an over-subscribed drawer rendered "New Deck", the
 * mana curve and "0 / 30" on top of one another instead of clipping or scrolling. Pinning some
 * of the column and not the rest is worse than pinning none: `.deck-drawer__manage` was pinned
 * alone, so the whole deficit landed on its unpinned siblings. Add a sibling here, pin it. */
.deck-drawer__back {
    flex-shrink: 0;
    height: var(--space-12);
    margin-bottom: var(--space-3);
    border-width: 0;
    border-radius: var(--space-2);
    background-color: var(--surface-3);
    color: var(--ink-2);
    -unity-text-align: middle-left;
}
/* A ROW, not a stack: the count is `-unity-text-align: middle-right` because it was authored for
 * the header row it used to live in, and giving it its own line cost a --type-h1 line box (~33dp)
 * of a column that had none to spare. */
.deck-editor__identity {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}
.deck-editor__naming {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.deck-editor__character {
    font-size: var(--type-label);
    color: var(--ink-2);
}
.deck-editor__name {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.deck-drawer__manage {
    flex-shrink: 0;
    min-height: 52px;
    margin-top: var(--space-4);
    border-width: 0;
    border-radius: var(--space-2);
    color: var(--ink-1);
    background-color: var(--surface-3);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

/* The class strip divides the ROOT's width between its nine tabs, so it starts flush with one edge
 * of the wall and runs clean to the other with nothing left over.
 *
 * WHY IT IS A ROW ACROSS THE TOP (Sam, 2026-08-31). It was a 130px column on the left of `body`.
 * Nine tabs sharing a 411dp panel HEIGHT via flex-grow came to 45.7dp each — under the 48dp
 * --touch-min floor — and 9 x 48 = 432 does not fit 411 on that axis at all, so nothing could fix
 * it there while the strip may not change shape. Across the width each tab gets ~84dp.
 *
 * flex-grow on the tabs rather than a width: nine tabs at 11% each leaves a remainder, and any
 * change to the tab count reopens it at a different size. flex-basis:0 makes the nine shares equal
 * regardless of what the art measures, so the strip always lands exactly on both edges no matter
 * how wide the screen is.
 *
 * What makes that resolvable: this bar is a child of the screen ROOT, which is a column, so its
 * align-items defaults to stretch and the bar already has the full width as a definite value to
 * divide. A percentage width would have needed the same thing and stayed brittle — see the
 * percent-height-needs-a-definite-parent trap this project has already paid for.
 *
 * HEIGHT IS --touch-min AND NOT A DP MORE. The strip is IN FLOW — Sam declined the overlay variant
 * on 2026-08-31 — so every dp here comes out of the wall's viewport, and CardWall's compact tier
 * derives the tile FROM that height: tile = floor((viewport/2 - 8)/16)*16, two rows visible.
 *
 * MEASURED at 914.3x411.4dp, before and after, not estimated:
 *     before   rail 129.9 wide x full height   wall viewport 687.6 x 403.0   tile 137 x 192
 *     after    rail 761.9 x 48                 wall viewport 817.5 x 350.9   tile 114 x 160
 * So this band costs the wall TWO 16dp tier steps, not one — about 17% off each tile edge. Making
 * it taller costs more, and the 129.9dp of width the strip handed back cannot buy any of it back:
 * tile width is derived from tile height by aspect, so the abundant axis cannot pay for the scarce
 * one. What the width did buy is a column — 4 before, 5 after — so the wall shows 10 smaller cards
 * where it showed 8 larger ones. CardWall.MaxColumns (5) is now the binding constraint; 6 columns
 * fit the measured 817.5dp and are refused by that cap.
 *
 * The horizontal margin is --edge-safe on top of the root's own --space-6, which over-pays the
 * 52dp cutout on purpose: these are the only INTERACTIVE elements that reach the screen's short
 * edges, and unlike the wall's forged frame (audit #11, decoration painting into the edge) a tab
 * under the hole-punch is a dead touch target. Declared in audit_edge_safety.py's TOKEN_EXCEPTIONS.
 *
 * flex-shrink:0 keeps the wall (flex-grow) from squeezing the strip away when space is tight;
 * Yoga does not floor a flex item at its content size the way CSS min-width:auto does. */
#class-tab-bar {
    flex-direction: row;
    height: var(--touch-min);
    flex-shrink: 0;
    margin: 0 var(--edge-safe) var(--space-1);
}
.class-tab_art {
    flex-grow: 1;
    flex-basis: 0;
    border-radius: 18px 18px 0 0;
    max-width: 11%;
    margin-top: 10px;
    margin-left: 6px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
.class-tab_art-emberward {
    background-image: url("/Assets/Art/UI/hptabs/ember_hp.png");
}
.class-tab_art-tempest {
    background-image: url("/Assets/Art/UI/hptabs/storm_hp.png");
}
.class-tab_art-stonewarden {
    background-image: url("/Assets/Art/UI/hptabs/stone_hp.png");
}
.class-tab_art-nightveil {
    background-image: url("/Assets/Art/UI/hptabs/night_hp.png");
}
.class-tab_art-verdant {
    background-image: url("/Assets/Art/UI/hptabs/verdant_hp.png");
}
.class-tab_art-gravekeep {
    background-image: url("/Assets/Art/UI/hptabs/grave_hp.png");
}
.class-tab_art-clockwright {
    background-image: url("/Assets/Art/UI/hptabs/clock_hp.png");
}
.class-tab_art-tidecaller {
    background-image: url("/Assets/Art/UI/hptabs/tide_hp.png");
}
.class-tab_art-neutral {
    background-color: var(--class-neutral);
}

/* Two states over that base, and they are about different questions.
 *
 * --off answers "can this tab lead anywhere": the pool holds no card of that class, because the
 * player owns none of them or the open character's pairing excludes them. It is dimmed and its
 * picking is turned off in CollectionController.StampClassTabs, so it reads as present-but-spent
 * rather than missing. Sam's ruling (2026-08-18): the strip never changes shape. All nine tabs are
 * on screen in every state; scoping deactivates, it does not hide, so the strip a player learns the
 * position of is the strip they always get.
 *
 * The tint is what carries it. Opacity alone on a strip of full-bleed portraits still reads as
 * eight lit tabs, so the art is also tinted toward the surface it sits on; the neutral tab paints a
 * flat colour rather than an image and takes the opacity half only.
 *
 * --on says "this tab is filtering the wall" by CONTRAST ONLY -- it draws nothing of its own; the
 * gold frame it used to fade in was removed 2026-08-30 (see below). Once any class is selected,
 * --muted quiets the other available portraits and the unmuted one is the answer; with no selection
 * they all remain vivid because the wall is unconstrained and every available class is included.
 * --on is still stamped by CollectionController and is still the hook to style selection from. */
.class-tab_art {
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
/* THE SELECTED TAB HAS NO GOLDEN FRAME (Sam, 2026-08-30). `.class-tab-frame` -- an absolutely
 * positioned child inside every `.class-tab_art`, an accent border plus an 8% accent wash, faded
 * in by `--on` -- is gone, rules AND the nine elements that carried it. Selection is said by
 * `--muted` quieting the other eight, which is the whole of the answer now. Do not reintroduce a
 * frame here without reintroducing its element: a class with no body is what
 * audit_edge_safety.py PASS 5 exists to catch. */
.class-tab_art--muted {
    opacity: 0.6;
    -unity-background-image-tint-color: rgb(158, 164, 177);
}
.class-tab_art--off {
    opacity: 0.3;
    -unity-background-image-tint-color: rgb(104, 110, 124);
}

/* ---------- Collection chrome kit ----------
 * These five sprites are deliberately separate assets. They have different proportions, materials,
 * and slice borders; combining them into an atlas would make iteration harder without reducing the
 * number of UI Toolkit style references. USS slice values are repeated here so the treatment remains
 * deterministic even if an importer border is changed while another screen experiments with it. */
.chrome-panel {
    border-width: 0;
    border-radius: 0;
}
.chrome-panel--outer {
    background-color: rgba(18, 23, 31, 0.96);
    background-image: url("/Assets/Art/UI/Chrome/ui_panel_outer_forged.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.35px;
}
.chrome-panel--recessed {
    background-color: rgba(8, 12, 18, 0.88);
    background-image: url("/Assets/Art/UI/Chrome/ui_panel_recessed_slate.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.35px;
}

/* The two nested panel sprites replace the former flat wall while keeping the responsive card
 * contract untouched. Compact collapses the lower ledge to 4dp; medium and expanded progressively
 * restore the framing as their short-axis budget grows. */
.collection .db-collection.chrome-panel--outer {
    padding: 4px 12px 4px;
    background-color: rgba(18, 23, 31, 0.96);
    overflow: hidden;
}
.collection .col-scroll.chrome-panel--recessed {
    padding: 0 12px;
}
.collection.emb-sw-medium .db-collection.chrome-panel--outer {
    padding: 4px 16px 12px;
}
.collection.emb-sw-medium .col-scroll.chrome-panel--recessed {
    padding: 4px 20px;
}
.collection.emb-sw-expanded .db-collection.chrome-panel--outer {
    padding-bottom: 20px;
}
.collection.emb-sw-expanded .col-scroll.chrome-panel--recessed {
    padding: 4px 20px;
}
/* NO PADDING HERE. This selector outranks `.deck-drawer`, so a padding written here silently
 * replaces the whole edge-clearance shorthand that rule authors -- which is exactly what
 * `padding: 24px` did from #228 until 2026-08-30. */
.deck-drawer.chrome-panel--outer {
    border-left-width: 0;
    background-color: rgba(18, 23, 31, 0.98);
}
/* The plate moved from the ScrollView to its frame when the bottom fade landed. The alpha is
 * 1 on the chooser, not 0.92: the fade ramps to a FLAT rgb(8, 12, 18) and a translucent plate
 * under it would show the drawer through the bottom band only, as a horizontal seam. */
.deck-chooser-frame.chrome-panel--recessed {
    padding: var(--space-4);
    background-color: rgb(8, 12, 18);
}
.deck-editor.chrome-panel--recessed {
    padding: var(--space-4);
    background-color: rgba(8, 12, 18, 0.92);
}

.chrome-button {
    min-height: var(--touch-min);
    padding: 0 24px;
    border-width: 0;
    border-radius: 0;
    color: var(--ink-1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: rgb(232, 236, 242);
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.chrome-button--primary {
    background-color: rgba(16, 13, 10, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.5px;
    color: rgb(250, 230, 193);
}
.chrome-button--secondary {
    background-color: rgba(21, 28, 38, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
}
.chrome-button:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.chrome-button:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(205, 211, 220);
}
.chrome-button:disabled {
    opacity: 0.42;
}
.col-query-actions .chrome-button {
    min-height: var(--touch-min);
    height: var(--touch-min);
    padding: 0 20px;
}
.deck-drawer__back.chrome-button {
    min-height: var(--touch-min);
    height: var(--touch-min);
    padding-left: 20px;
    color: var(--ink-1);
    -unity-text-align: middle-left;
}
.deck-drawer__manage.chrome-button {
    min-height: 52px;
    background-color: rgba(16, 13, 10, 0.98);
    color: rgb(250, 230, 193);
}

.chrome-input {
    min-height: 52px;
    height: 52px;
}
.chrome-input > .unity-base-text-field__input,
.chrome-input .unity-base-popup-field__input {
    min-height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(8, 12, 18, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_input_recessed_slate.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(224, 229, 236);
    color: var(--ink-1);
    font-size: var(--type-body);
}
.collection.emb-sw-medium .chrome-input {
    min-height: 54px;
    height: 54px;
}
.collection.emb-sw-medium .chrome-input > .unity-base-text-field__input,
.collection.emb-sw-medium .chrome-input .unity-base-popup-field__input {
    min-height: 54px;
}
.collection.emb-sw-expanded .chrome-input {
    min-height: 56px;
    height: 56px;
}
.collection.emb-sw-expanded .chrome-input > .unity-base-text-field__input,
.collection.emb-sw-expanded .chrome-input .unity-base-popup-field__input {
    min-height: 56px;
}
.chrome-input > .unity-base-text-field__input:hover,
.chrome-input .unity-base-popup-field__input:hover {
    -unity-background-image-tint-color: rgb(244, 247, 250);
}
.chrome-input > .unity-base-text-field__input:focus {
    -unity-background-image-tint-color: rgb(255, 239, 211);
}

/* ---------- Crafting modal (GH#157 Render / GH#158 Reduce) ----------
 *
 * Declared once, used by both modes. Bound by CraftModal, opened by CollectionController.
 *
 * Both the scrim and the panel are position: absolute against the plate root and both are hidden
 * at rest by an inline display written from code, not from here — CraftModal.Close() is the only
 * writer, and a display rule in this file would fight it. What lives here is what they look like
 * once shown.
 *
 * Percentages throughout, per the sizing ruling, with ONE exception: the card face is a fixed
 * 340x477, holding a card's 276:387 by giving both axes. Change one of those two numbers and you
 * must change the other. CardWall.TileWidth is a fixed 276 and a contract for the same reason.
 *
 * THIS PARAGRAPH USED TO SAY "UI Toolkit has no aspect-ratio property". THAT IS NO LONGER TRUE —
 * `aspect-ratio` is in the Dimensions block of the USS supported-properties table for 6000.5.1f1
 * and Unity's own shadergraph package uses it. The stale claim was read as current on 2026-08-30
 * and cost a wrong diagnosis plus a reverted commit, because a comment asserting what the engine
 * cannot do reads exactly like a comment asserting what it does not do YET. Both axes here are
 * still deliberate — a ratio would not pin the absolute size this face is a contract for — but
 * that is now a CHOICE, not a limitation, and expressing it as one is the point.
 */

.craft-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.82);
}

/* Inset on all four edges rather than sized in percentages. The old
   `left:10% top:8% width:80% height:84%` cleared a 2400px landscape by 240 and a
   1080px portrait by 108 -- the same aspect drift that had the shard counter
   landing somewhere different on every device. Offsets on all four sides size it
   as well as place it, so it fills the safe area exactly and cannot overflow the
   way `8% + --edge-safe + 84%` would. Declared in audit_edge_safety.py's
   TOKEN_EXCEPTIONS.

   --edge-safe on the SIDES only, and a plain gutter top and bottom, for the
   reason on the token in theme.uss: the cutout is on a side, the top and bottom
   measure zero, and 52 on each of them was 104dp of a 411dp panel spent inside a
   modal whose whole job is to show an illustration at size. 16 matches .mm-modal. */
.craft-modal {
    position: absolute;
    left: var(--edge-safe);
    top: var(--space-4);
    right: var(--edge-safe);
    bottom: var(--space-4);
    background-color: var(--surface-1);
    border-radius: var(--space-3);
    padding: var(--space-6);
    border-width: 1px;
    border-color: var(--surface-3);
}
.craft-illustration,
.craft-illustration-scrim {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
}
.craft-illustration {
    background-image: url("/Assets/Art/Backgrounds/CraftingForge_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.82;
}
.craft-illustration-scrim {
    background-color: rgba(5, 8, 12, 0.48);
}

.craft-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-6);
}
.craft-heading {
    flex-grow: 1;
}
.craft-name {
    font-size: var(--type-h1);
    color: var(--ink-1);
    -unity-font-style: bold;
}
.craft-rarity {
    font-size: var(--type-label);
    color: var(--rarity-common);
    -unity-font-style: bold;
}

/* The rarity accent is the fastest read of what a card costs to make — the word and the price are
 * saying the same thing, so they are coloured the same. CraftModal swaps exactly one of these on. */
.craft-rarity--common {
    color: var(--rarity-common);
}
.craft-rarity--rare {
    color: var(--rarity-rare);
}
.craft-rarity--epic {
    color: var(--rarity-epic);
}
.craft-rarity--legendary {
    color: var(--rarity-legendary);
}

/* The balance. #159 put this on the main menu's top edge; this is the same number at the moment it
 * is about to be spent, which is the one place a player actually needs it. */
.craft-wallet {
    flex-direction: row;
    align-items: flex-end;
    margin-right: var(--space-6);
}
.craft-wallet-value {
    font-size: var(--type-h2);
    color: var(--accent);
    -unity-font-style: bold;
}
.craft-wallet-word {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-left: var(--space-1);
    margin-bottom: var(--space-1);
}

.craft-body {
    flex-direction: row;
    flex-grow: 1;
}

.craft-cardpane {
    align-items: center;
    margin-right: var(--space-8);
}
.craft-card-face {
    width: 340px;
    height: 477px;
    background-color: var(--surface-3);   /* shows through until the bake resolves */
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-to-fit;
}
.craft-owned {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-top: var(--space-3);
}

/* The two directions, stacked. Equal flex so neither reads as the primary one: Render and Reduce
 * are opposite moves of the same standing, not an action and its footnote. */
.craft-halves {
    flex-grow: 1;
    justify-content: space-between;
}
.craft-half {
    flex-grow: 1;
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-6);
    margin-bottom: var(--space-4);
    justify-content: center;
}
.craft-half-title {
    font-size: var(--type-h2);
    color: var(--ink-1);
    -unity-font-style: bold;
}
.craft-half-blurb {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
    white-space: normal;
}
.craft-price {
    flex-direction: row;
    align-items: flex-end;
}
.craft-price-value {
    font-size: var(--type-display);
    color: var(--accent);
    -unity-font-style: bold;
}
.craft-price-word {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-left: var(--space-2);
    margin-bottom: var(--space-2);
}
.craft-half-note {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
    white-space: normal;
}

/* A half you cannot take right now. It stays READABLE — the price and the reason are exactly what
 * the player came to find out, and a half that dimmed to nothing would answer "can I break this
 * down?" with silence. This is a per-CARD fact like the wall's own treatments, never a mode. */
.craft-half--dead {
    opacity: 0.55;
}

.craft-action {
    height: 15%;
    min-height: var(--touch-min);             /* touch target floor; mobile-first */
    background-color: var(--accent);
    color: var(--surface-0);
    font-size: var(--type-body);
    -unity-font-style: bold;
    border-radius: var(--space-2);
    border-width: 0;
}
.craft-action:hover {
    background-color: var(--warning);
}
.craft-action:disabled {
    background-color: var(--surface-3);
    color: var(--ink-2);
}

/* Reduce is destructive, so it does not get the ember-gold CTA treatment Render has. It is a real
 * button, not a warning — the confirmation this needs is a surface of its own and is not built. */
.craft-action--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-1);
    border-width: 1px;
    border-color: var(--surface-3);
}
.craft-action--ghost:hover {
    background-color: var(--surface-3);
}
.craft-action--ghost:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-2);
}

.craft-modal.chrome-panel--outer {
    background-color: rgba(18, 23, 31, 0.98);
    border-width: 0;
    border-radius: 0;
}
.craft-half.chrome-panel--recessed {
    background-color: rgba(8, 12, 18, 0.9);
    border-radius: 0;
}
.craft-action.chrome-button {
    border-width: 0;
    border-radius: 0;
}
.craft-action.chrome-button--primary,
.craft-action.chrome-button--primary:hover {
    background-color: rgba(16, 13, 10, 0.98);
    color: rgb(250, 230, 193);
}
.craft-action.chrome-button--secondary,
.craft-action.chrome-button--secondary:hover {
    background-color: rgba(21, 28, 38, 0.98);
    color: var(--ink-1);
}
