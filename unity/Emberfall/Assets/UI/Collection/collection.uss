/* collection.uss — the full-pool browse surface.
 *
 * Tokens come from theme.uss; only what is specific to this screen lives here. The tile itself is
 * deliberately NOT restyled: .card-tile is declared once in deckbuilder.uss and its 276px width is
 * a contract with CardWall.TileWidth, which solves the per-row gutter against it. A second
 * .card-tile rule here would be a second source of truth for one number, which is the exact shape
 * of the card-frame drift this project already paid for.
 *
 * A USS parse error voids the WHOLE stylesheet silently — one bad declaration and every rule in
 * this file stops applying, with nothing logged. Keep declarations complete.
 */

.collection {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    padding: var(--space-6);
}

/* ---------- Header ---------- */
.col-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}
.col-header-actions {
    flex-direction: row;
    align-items: center;
}
.col-heading {
    flex-direction: row;
    align-items: flex-end;
}
.col-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.col-count {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-left: var(--space-3);
    margin-bottom: var(--space-1);
}

/* Owned vs All (#146). Hidden by default and turned on from code, the same shape as the empty label
 * below: it is present only for an account that HAS an ownership record, which is runtime state and
 * not a mode, so the mode modifiers at the bottom of this file are the wrong tool for it. Nothing
 * here can turn it on — CollectionController.WireScopeToggle is the only writer.
 *
 * align-items on .col-heading is flex-end, so the bottom margin is what sits these chips on the
 * title's baseline rather than under its descenders. */
.col-scope {
    display: none;
    flex-direction: row;
    margin-left: var(--space-4);
    margin-bottom: var(--space-1);
}
.col-scope--on {
    display: flex;
}

.col-button {
    font-size: var(--type-label);
    color: var(--ink-1);
    background-color: var(--surface-3);
    border-width: 0;
    border-radius: 999px;
    min-height: var(--space-12);
    padding: var(--space-2) var(--space-6);
}
.col-button--ghost {
    background-color: rgba(0, 0, 0, 0.55);
}
.col-button--decks {
    min-width: 120px;
    margin-right: var(--space-3);
    color: var(--surface-0);
    background-color: var(--accent);
    -unity-font-style: bold;
}

/* ---------- Query bar ----------
 * Sits on its own scrim rather than directly on the vault plate: the controls are small text on a
 * busy, high-contrast painting, and the braziers run straight through where the chips sit.
 */
.col-query {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--space-2);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
    /* Never let the wall shrink the bar away (#160 non-render, deckbuild). The body below is
     * flex-grow:1 and its flex-basis is the wall's content height — the full pairing pool in
     * deckbuild is ~90 tall tiles, so that basis overflows the column and the root distributes
     * negative space by shrinking every child. Yoga (UI Toolkit's layout engine) does NOT floor a
     * flex item at its content size the way CSS `min-height:auto` does, so with the default
     * flex-shrink:1 the bar collapses to zero height and vanishes — only in deckbuild, because
     * browse's owned-scope wall is short enough to leave non-negative free space. Pinning
     * flex-shrink:0 reserves the bar's height; the body absorbs the shrink and its ScrollView
     * scrolls, which is the intended behaviour. Browse is unchanged: its bar was never shrunk. */
    flex-shrink: 0;
}
.col-query-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}
.col-search {
    flex-grow: 1;
    margin-right: var(--space-3);
}
.col-sort {
    width: 180px;
    margin-right: var(--space-2);
}
.col-sort-dir {
    width: 72px;
}
/* Chips wrap: eight classes will not fit one row on a phone, and percentage-driven wrapping is the
 * project's sizing model rather than a pixel breakpoint. */
.col-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
}

/* ---------- Active-deck pairing + cost chip sizing (#160) ----------
 *
 * All of this is scoped under .collection--editing so browse is pixel-identical (the pairing chips
 * do not exist at rest, and the cost chips there keep their content-driven size). It is NOT put on
 * the shared .db-chip in deckbuilder.uss on purpose: that class is also worn by the scope toggle and
 * MatchSettings, and a width there would reach screens outside this issue (see GH#161).
 *
 * Sam ruling 4 (2026-08-11): a chip's width must not be driven by its label length — a row of chips
 * should read as a set of equal things. Exact pixels were left to the implementer; this is the
 * min-width-plus-centred-text shape Sam sketched. Pixels rather than percentages match every other
 * control dimension in this file (.col-sort 180px, .col-sort-dir 72px, .db-chip height 32px) — the
 * percentage-over-pixels house ruling is about responsive layout, not fixed control chrome. */

/* The three pairing chips: one floor width so they read as a set, text centred within it. */
.collection--editing .db-filter-row .db-chip {
    min-width: 100px;
    -unity-text-align: middle-center;
}

/* Sit the pairing chips on the same line as search/sort, with a small gap after Reset and no second
 * row of their own (ruling 3). .db-filter-row carries a margin-bottom for its old stacked home. */
.collection--editing .col-query-row .db-filter-row {
    margin-bottom: 0;
    margin-left: var(--space-3);
}

/* Cost chips are single glyphs (0..6, 7+): a narrow centred square, not a label-width pill. The
 * side padding on .db-chip would otherwise stretch a one-character chip absurdly wide. */
.collection--editing #query-costs .db-chip {
    min-width: 32px;
    width: 32px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

/* ---------- Wall ---------- */
.col-scroll {
    flex-grow: 1;
}

/* Shown by CollectionController only when a query matches nothing. A wall that goes blank with no
 * text reads as a broken screen rather than an empty result. */
.col-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
    display: none;
}
.col-empty--on {
    display: flex;
}

/* ---------- Persistent collection shell (NOR-210) ---------- */
.collection .db-filter-row {
    display: none;
}
.collection .db-collection {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin-right: 0;
}
.collection--editing .db-filter-row {
    display: flex;
}
.collection--editing #query-classes {
    display: none;
}

/* ---------- Deck drawer ----------
 * Absolute positioning and translate animation are load-bearing. Animating width would emit a
 * GeometryChangedEvent every frame and continuously relayout the fixed-size CardWall tiles. */
.deck-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 34%;
    min-width: 420px;
    padding: var(--space-5);
    background-color: var(--surface-2);
    border-left-width: 2px;
    border-left-color: var(--accent);
    translate: 110% 0%;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.deck-drawer--open {
    translate: 0% 0%;
    opacity: 1;
}
.deck-drawer__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}
.deck-drawer__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.deck-drawer__subtitle {
    font-size: var(--type-label);
    color: var(--ink-2);
}
.deck-chooser {
    flex-grow: 1;
}
.deck-chooser--hidden,
.deck-editor--hidden {
    display: none;
}
.deck-chooser__list {
    flex-grow: 1;
}
.deck-chooser__empty {
    display: none;
    font-size: var(--type-body);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
}
.deck-chooser__empty--on {
    display: flex;
}
.deck-choice-group {
    margin-bottom: var(--space-5);
}
.deck-choice-character {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}
.deck-choice-pairing {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-bottom: var(--space-3);
}
.deck-choice {
    min-height: 64px;
    margin-bottom: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-width: 0;
    border-left-width: 6px;
    border-left-color: var(--class-neutral);
    border-radius: var(--space-2);
    background-color: var(--surface-3);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-text-align: middle-left;
}
.deck-editor {
    flex-grow: 1;
}
.deck-drawer__back {
    height: var(--space-12);
    margin-bottom: var(--space-3);
    border-width: 0;
    border-radius: var(--space-2);
    background-color: var(--surface-3);
    color: var(--ink-2);
    -unity-text-align: middle-left;
}
.deck-editor__identity {
    margin-bottom: var(--space-3);
}
.deck-editor__character {
    font-size: var(--type-label);
    color: var(--ink-2);
}
.deck-editor__name {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.deck-drawer__manage {
    flex-shrink: 0;
    min-height: 52px;
    margin-top: var(--space-4);
    border-width: 0;
    border-radius: var(--space-2);
    color: var(--ink-1);
    background-color: var(--surface-3);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

#class-tab-bar {



}
.class-tab__art {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
.class-tab__art--emberward {
    background-image: url("/Assets/Art/UI/hptabs/ember_hp.png");
}
.class-tab__art--tempest {
    background-image: url("/Assets/Art/UI/hptabs/tempest_hp")
    }
.class-tab__art--stonewarden {
    background-image: url("/Assets/Art/UI/hptabs/stone_hp");
    }
.class-tab__art--nightveil {
    background-image: url("/Assets/Art/UI/hptabs/night_hp");
    }
.class-tab__art--verdant {
    background-image: url("/Assets/Art/UI/hptabs/verdant_hp");
    }
.class-tab__art--gravekeep {
    background-image: url("/Assets/Art/UI/hptabs/grave_hp");
    }
.class-tab__art--clockwright {
    background-image: url("/Assets/Art/UI/hptabs/clock_hp");
    }
.class-tab__art--tidecaller {
    background-image: url("/Assets/Art/UI/hptabs/tide_hp");
    }
