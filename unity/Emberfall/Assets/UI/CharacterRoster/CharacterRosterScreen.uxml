<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Deckbuilder/theme.uss" />
    <Style src="character-roster.uss" />
    <ui:VisualElement name="root" class="emb-root character-roster">
        <!--
          The create FORM is gone (NOR-278). The name field, class dropdowns, swap-order and
          starter-deck dropdown, and the Create button that used to fill a right-hand panel are
          replaced by the "New Character" button below and the portrait-grid overlay at the bottom
          of this file. This is the game-wide "eliminate forms" principle: no dropdowns, no
          multi-field forms — the choice is made by tapping a picture.
        -->
        <ui:VisualElement class="roster-header">
            <ui:VisualElement class="roster-header-left">
                <!-- The one way INTO character creation, top-left (NOR-278). -->
                <ui:Button name="new-character" text="+ New Character" class="roster-button roster-button--cta new-character-button" />
            </ui:VisualElement>
            <ui:VisualElement class="roster-header-actions">
                <!-- The way to the whole card pool, with no deck panel and no class filter (Sam,
                     2026-08-07). Moved into the header when the create panel it used to sit under
                     was removed (NOR-278); it is still a way further in, offered beside the way out. -->
                <ui:Button name="view-collection" text="View Collection" class="roster-button roster-button--ghost" />
                <ui:Button name="back-button" text="Main Menu" class="roster-button roster-button--ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="roster-body">
            <ui:VisualElement class="roster-panel roster-panel--list">
                <ui:ScrollView name="roster-scroll" mode="Vertical" class="roster-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="roster-list" class="roster-list" />
                    <ui:Label name="empty-state" text="No characters yet — tap New Character to make your first." class="roster-empty" />
                </ui:ScrollView>
                <ui:Label name="status" text="" class="roster-status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          Find Game's third step. The first two — pick a character, pick one of its decks — are the
          same rows the deck-management door draws; this bar is the only thing that door does not
          have. Hidden entirely outside a match pick.
        -->
        <ui:VisualElement name="match-bar" class="match-bar">
            <ui:Button name="match-continue" text="Continue" class="roster-button roster-button--cta" />
        </ui:VisualElement>

        <!--
          What a deck plate opens. One dialog, three panes — the menu, then whichever action was
          picked — because a deck's name and its card back are both edited from here now and two
          separate modals would be two separate places to leave a deck half-renamed.
        -->
        <ui:VisualElement name="deck-modal" class="delete-modal delete-modal--hidden">
            <ui:VisualElement name="deck-dialog" class="delete-dialog">
                <ui:Label name="deck-modal-title" text="" class="delete-title" />
                <ui:Label name="deck-modal-sub" text="" class="create-help" />

                <ui:VisualElement name="deck-menu-pane" class="deck-pane">
                    <!-- The primary action (Sam, 2026-08-09): opening a deck's menu is most often
                         "I want to change what's in it," and that used to have no button at all —
                         only the undiscoverable double-tap-the-plate gesture reached the deckbuilder. -->
                    <ui:Button name="deck-edit" text="Edit deck" class="roster-button roster-button--cta deck-action" />
                    <!-- Match pick only. Every other action below is offered from both doors. -->
                    <ui:Button name="deck-select" text="Select this deck" class="roster-button roster-button--cta deck-action" />
                    <ui:Button name="deck-image" text="Deck image" class="roster-button roster-button--ghost deck-action" />
                    <ui:Button name="deck-rename" text="Rename deck" class="roster-button roster-button--ghost deck-action" />
                    <ui:Button name="deck-change-back" text="Change card back" class="roster-button roster-button--ghost deck-action" />
                    <ui:Button name="deck-set-default" text="Set as default" class="roster-button roster-button--ghost deck-action" />
                    <ui:Button name="deck-delete" text="Delete deck" class="roster-button roster-button--danger deck-action" />
                    <ui:Label text="Double tap the deck to edit it." class="deck-edit-hint" />
                </ui:VisualElement>

                <!--
                  What "+" opens. The same two starter shapes character creation offers, for the
                  same reason: a blank deck is 30 decisions away from playable, and a player who
                  came here from Find Game wants one they can queue with.
                -->
                <ui:VisualElement name="deck-new-pane" class="deck-pane">
                    <ui:Button name="deck-new-generated" text="Generate a queue-ready deck" class="roster-button roster-button--cta deck-action" />
                    <ui:Button name="deck-new-blank" text="Start blank" class="roster-button roster-button--ghost deck-action" />
                    <ui:Label name="deck-new-note" text="" class="create-help create-help--starter" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-image-pane" class="deck-pane">
                    <ui:ScrollView name="deck-image-scroll" mode="Vertical" class="deck-image-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="deck-image-grid" class="deck-back-grid" />
                    </ui:ScrollView>
                    <ui:Label name="deck-image-note" text="" class="create-help create-help--starter" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-rename-pane" class="deck-pane">
                    <ui:TextField name="deck-rename-field" label="Name" max-length="24" class="roster-field" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-delete-pane" class="deck-pane">
                    <ui:Label name="deck-delete-message" text="" class="delete-message" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-back-pane" class="deck-pane">
                    <ui:VisualElement name="deck-back-grid" class="deck-back-grid" />
                    <ui:Label name="deck-back-note" text="" class="create-help create-help--starter" />
                </ui:VisualElement>

                <ui:Label name="deck-modal-error" text="" class="create-error" />
                <ui:VisualElement class="delete-actions">
                    <ui:Button name="deck-modal-cancel" text="Close" class="roster-button roster-button--ghost" />
                    <ui:Button name="deck-modal-confirm" text="Save" class="roster-button roster-button--cta" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          What a character's NAME opens. Not a modal: a small card anchored under the name, over a
          transparent scrim that catches the click that dismisses it. The row used to carry a
          standing Delete button, which spent permanent width on the one action nobody wants to
          reach for by accident (Sam, 2026-08-07).
        -->
        <ui:VisualElement name="character-menu" class="character-menu character-menu--hidden">
            <ui:VisualElement name="character-menu-scrim" class="character-menu-scrim" />
            <ui:VisualElement name="character-menu-card" class="character-menu-card">
                <ui:Label name="character-menu-title" text="" class="character-menu-title" />
                <ui:Button name="character-menu-delete" text="Delete character" class="roster-button roster-button--danger deck-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          Character creation (NOR-278): two sequential passes over ONE grid overlay, because a
          character is a permanent ORDERED primary+secondary class pair. Pass 1 picks the primary
          (its Hero Power); pass 2 picks the secondary (cards only). Three views share the dialog:
          the grid, a per-hero detail overlay, and a confirm screen that also collects the name.
        -->
        <ui:VisualElement name="character-create" class="delete-modal delete-modal--hidden character-create">
            <ui:VisualElement class="delete-dialog character-create-dialog">

                <!-- GRID: 2×4 portraits, one per real class. Pass-specific title/help above it. -->
                <ui:VisualElement name="create-grid-view">
                    <ui:Label name="create-pass-title" text="Choose your hero" class="delete-title" />
                    <ui:Label name="create-pass-help" text="" class="create-help" />
                    <ui:VisualElement name="create-hero-grid" class="hero-grid" />
                    <ui:VisualElement class="delete-actions">
                        <ui:Button name="create-cancel" text="Cancel" class="roster-button roster-button--ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- DETAIL: a single hero's traits + hero power. The copy blocks are RESERVED BUT
                     EMPTY (NOR-278): FlavorText and hero-power descriptions are unpopulated schema
                     fields, and authoring that copy is out of scope. The layout space is held. -->
                <ui:VisualElement name="create-detail-view">
                    <ui:VisualElement class="hero-detail-head">
                        <ui:VisualElement name="create-detail-portrait" class="hero-detail-portrait" />
                        <ui:VisualElement class="hero-detail-headings">
                            <ui:Label name="create-detail-name" text="" class="delete-title" />
                            <ui:Label name="create-detail-pass" text="" class="hero-detail-pass" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="create-detail-bullets" class="hero-detail-bullets" />
                    <!-- The hero power block is filled from the class's HERO_POWER card (NOR-291):
                         the name is the card's own, the description is generated from its typed
                         rules, so it is the same text the power shows in a match and cannot drift
                         from what the power actually does. The caption is static. -->
                    <ui:VisualElement name="create-power-block" class="hero-power-block">
                        <ui:Label text="Hero Power" class="hero-power-caption" />
                        <ui:Label name="create-power-name" text="" class="hero-power-name" />
                        <ui:Label name="create-power-desc" text="" class="hero-power-desc" />
                    </ui:VisualElement>
                    <ui:VisualElement class="delete-actions">
                        <ui:Button name="create-detail-back" text="Back" class="roster-button roster-button--ghost" />
                        <ui:Button name="create-detail-select" text="Select" class="roster-button roster-button--cta" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- CONFIRM: reached automatically once both classes are picked. Carries the ONE
                     text field in the whole flow — the character's name — validated by
                     PlayerName.Check, the same predicate the server's MatchGate enforces on the
                     wire (VULN-002). "Change something" drops the secondary pick only. -->
                <ui:VisualElement name="create-confirm-view">
                    <ui:Label text="Ready to build" class="delete-title" />
                    <ui:Label name="create-confirm-summary" text="" class="create-help" />
                    <ui:TextField name="create-name-field" label="Name" max-length="16" class="roster-field" />
                    <ui:Label name="create-name-error" text="" class="create-error" />
                    <ui:VisualElement class="delete-actions">
                        <ui:Button name="create-change" text="Change something" class="roster-button roster-button--ghost" />
                        <ui:Button name="create-continue" text="Continue to Deck Builder" class="roster-button roster-button--cta" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="delete-modal" class="delete-modal delete-modal--hidden">
            <ui:VisualElement class="delete-dialog">
                <ui:Label text="Delete character?" class="delete-title" />
                <ui:Label name="delete-message" text="" class="delete-message" />
                <ui:Label name="delete-error" text="" class="create-error" />
                <ui:VisualElement class="delete-actions">
                    <ui:Button name="cancel-delete" text="Cancel" class="roster-button roster-button--ghost" />
                    <ui:Button name="confirm-delete" text="Delete character" class="roster-button roster-button--danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
