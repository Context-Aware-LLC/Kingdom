.character-roster {
    flex-grow: 1;
    background-color: var(--surface-1);
    padding: var(--space-6);
    color: var(--ink-1);
}

.roster-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.roster-heading {
    flex-direction: row;
    align-items: center;
}

.roster-title {
    font-size: var(--type-display);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-right: var(--space-4);
}

.roster-count {
    font-size: var(--type-body);
    color: var(--ink-2);
}

.roster-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.roster-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}

.roster-panel--list {
    flex-grow: 7;
    margin-right: var(--space-4);
}

.roster-panel--create {
    flex-grow: 3;
    min-width: 380px;
    max-width: 520px;
}

.character-roster--match-pick .roster-panel--list {
    margin-right: 0;
}

.character-roster--match-pick .roster-panel--create {
    display: none;
}

.roster-intro,
.create-help,
.character-detail {
    font-size: var(--type-body);
    color: var(--ink-2);
    white-space: normal;
}

.roster-intro {
    margin-bottom: var(--space-3);
}

.roster-scroll,
.roster-list {
    flex-grow: 1;
    min-height: 0;
}

.roster-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    white-space: normal;
    padding: var(--space-8);
    -unity-text-align: middle-center;
}

.character-row {
    flex-direction: row;
    align-items: stretch;
    min-height: 232px;
    margin-bottom: var(--space-3);
    background-color: var(--surface-1);
    border-radius: var(--space-2);
    border-left-width: 6px;
    border-left-color: var(--class-neutral);
    overflow: hidden;
}

.character-row--emberward { border-left-color: var(--class-emberward); }
.character-row--tidecaller { border-left-color: var(--class-tidecaller); }
.character-row--gravekeep { border-left-color: var(--class-gravekeep); }
.character-row--verdant { border-left-color: var(--class-verdant); }

/* The character's own identity — name, pairing, hero power, and how its default deck stands.
 * A plain block, not a button: since the decks moved here from the deckbuilder, opening a
 * character means opening one of ITS DECKS, and there is no longer a "just the character"
 * destination for a click on this to go to. Fixed-width so the deck strip beside it starts on
 * the same column down the whole list. */
.character-identity {
    width: 26%;
    min-width: 240px;
    max-width: 340px;
    flex-shrink: 0;
    align-items: flex-start;
    padding: var(--space-4);
    color: var(--ink-1);
}

.character-name {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}

.character-pairing {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.pair-class {
    font-size: var(--type-h2);
    -unity-font-style: bold;
}

.pair-arrow {
    font-size: var(--type-h2);
    color: var(--ink-2);
    margin-left: var(--space-2);
    margin-right: var(--space-2);
}

.class--emberward { color: var(--class-emberward); }
.class--tidecaller { color: var(--class-tidecaller); }
.class--gravekeep { color: var(--class-gravekeep); }
.class--verdant { color: var(--class-verdant); }

.character-detail {
    margin-bottom: var(--space-1);
}

.queue-pill {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: normal;
}

.queue-pill--ready {
    color: var(--surface-0);
    background-color: var(--positive);
}

.queue-pill--draft {
    color: var(--surface-0);
    background-color: var(--warning);
}

/* ---- Deck strip (Sam, 2026-08-07) ------------------------------------------------------
 * The deck switcher and the deck name used to live at the top of the deckbuilder's right-hand
 * panel. They live here now: a character row is mostly empty space, and a deck is a thing you
 * pick BEFORE you open an editor for it, not a tab inside one. Each deck is drawn as a card —
 * its own card back — because that is what a player recognises a deck by.
 */
.deck-strip {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    overflow: hidden;
}

.deck-plate {
    width: 128px;
    align-items: center;
    margin: 0 var(--space-3) var(--space-3) 0;
    padding: var(--space-2);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--space-2);
    background-color: transparent;
    color: var(--ink-1);
}

.deck-plate:hover {
    background-color: var(--surface-2);
    border-color: var(--surface-3);
}

/* The card itself. scale-and-crop rather than stretch: a back is a full-bleed pattern or a
 * centred emblem, and letterboxing either one reads as a bug. */
.deck-plate-art {
    width: 108px;
    height: 152px;
    border-radius: var(--space-1);
    background-color: var(--surface-3);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.deck-plate--default .deck-plate-art {
    border-width: 2px;
    border-color: var(--accent);
}

/* The deck chosen to take into a match. Distinct from --default, which is a stored preference:
 * this one is a live selection that lasts until Continue. */
.deck-plate--selected {
    background-color: var(--surface-3);
    border-color: var(--positive);
}

.deck-plate--selected .deck-plate-art {
    border-width: 2px;
    border-color: var(--positive);
}

.deck-plate-name {
    width: 100%;
    margin-top: var(--space-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-1);
    text-overflow: ellipsis;
    overflow: hidden;
}

.deck-plate-count {
    font-size: var(--type-caption);
    color: var(--ink-2);
}

/* Draft state is a WORD, not a dimming. Sam, 2026-08-07: nothing in a collection surface gets
 * greyed out — the same ruling that took the disabled tint off the deckbuilder's card wall. */
.deck-plate-tag {
    margin-top: var(--space-1);
    padding: 0 var(--space-2);
    border-radius: 999px;
    font-size: var(--type-caption);
    -unity-font-style: bold;
    color: var(--surface-0);
}

.deck-plate-tag--ready { background-color: var(--positive); }
.deck-plate-tag--draft { background-color: var(--warning); }

.deck-plate--new .deck-plate-art {
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--surface-3);
    background-color: var(--surface-1);
}

.deck-plate-plus {
    font-size: var(--type-display);
    -unity-font-style: bold;
    color: var(--ink-2);
}

.deck-plate--new:hover .deck-plate-art { border-color: var(--accent); }
.deck-plate--new:hover .deck-plate-plus { color: var(--accent); }

/* A default deck the character points at was deleted — surfaced, never repaired. It used to be
 * the deckbuilder's job to say so; the pointer is a roster-level fact, so it says so here. */
.deck-strip-hint {
    width: 100%;
    margin-bottom: var(--space-2);
    font-size: var(--type-label);
    color: var(--warning);
    white-space: normal;
}

/* ---- Deck modal panes ---- */
.deck-pane {
    margin-bottom: var(--space-2);
}

.deck-action {
    align-self: stretch;
    margin-bottom: var(--space-2);
}

.deck-back-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
}

.deck-back-option {
    width: 128px;
    align-items: center;
    margin: 0 var(--space-3) var(--space-3) 0;
    padding: var(--space-2);
    border-width: 2px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    background-color: var(--surface-1);
    color: var(--ink-1);
}

.deck-back-option--on {
    border-color: var(--accent);
    background-color: var(--surface-3);
}

.delete-character {
    width: 112px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--surface-2);
    color: var(--negative);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.delete-character:hover {
    background-color: var(--surface-3);
}

/* Find Game's Continue bar. Match pick used to be a whole second row layout — text buttons per
 * deck, its own draft/empty states — which meant the same screen looked different depending on
 * which door you came through. It draws the ordinary plates now (Sam, 2026-08-07); this bar is
 * the only thing the match door adds. */
.match-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: var(--space-4);
}

.match-pick {
    flex-grow: 1;
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    -unity-text-align: middle-right;
    margin-right: var(--space-4);
    text-overflow: ellipsis;
    overflow: hidden;
}

.create-title,
.delete-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}

.create-help {
    margin-bottom: var(--space-4);
}

.create-help--starter {
    font-size: var(--type-label);
    margin-bottom: var(--space-2);
}

.roster-field {
    margin-bottom: var(--space-3);
}

.roster-field .unity-base-field__label {
    min-width: 120px;
    color: var(--ink-2);
    font-size: var(--type-body);
}

.roster-field .unity-base-text-field__input,
.roster-field .unity-base-popup-field__input {
    min-height: 44px;
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
    font-size: var(--type-body);
    padding: var(--space-2);
}

.create-order-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}

.power-hint {
    flex-grow: 1;
    font-size: var(--type-body);
    color: var(--accent);
    -unity-font-style: bold;
}

.create-error,
.roster-status {
    min-height: 24px;
    font-size: var(--type-label);
    color: var(--negative);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.roster-status {
    color: var(--ink-2);
    margin-top: var(--space-2);
    margin-bottom: 0;
}

.roster-status--error {
    color: var(--negative);
}

.roster-button {
    min-width: 148px;
    height: 48px;
    border-width: 0;
    border-radius: var(--space-2);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.roster-button--small {
    min-width: 128px;
    height: 40px;
    font-size: var(--type-label);
}

.roster-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}

.roster-button--ghost {
    color: var(--ink-1);
    background-color: var(--surface-3);
}

.roster-button--danger {
    color: var(--ink-1);
    background-color: var(--negative);
}

.create-button {
    align-self: stretch;
}

.delete-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.delete-modal--hidden {
    display: none;
}

.delete-dialog {
    width: 620px;
    max-width: 88%;
    padding: var(--space-6);
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    border-width: 1px;
    border-color: var(--surface-3);
}

.delete-message {
    font-size: var(--type-h2);
    color: var(--ink-1);
    white-space: normal;
    margin-bottom: var(--space-4);
}

.delete-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.delete-actions .roster-button {
    margin-left: var(--space-3);
}

/* No visible scrollbar chrome. Wheel, touch-drag, and keyboard scrolling remain available. */
#roster-scroll .unity-scroller,
#roster-scroll .unity-scroller--vertical,
#roster-scroll .unity-scroller--horizontal,
#roster-scroll .unity-scroll-view__vertical-scroller,
#roster-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}
