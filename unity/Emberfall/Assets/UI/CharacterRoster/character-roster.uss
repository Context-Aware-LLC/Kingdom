.character-roster {
    flex-grow: 1;
    background-color: var(--surface-1);
    padding: var(--space-6);
    color: var(--ink-1);
}

.roster-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.roster-heading {
    flex-direction: row;
    align-items: center;
}

.roster-title {
    font-size: var(--type-display);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-right: var(--space-4);
}

.roster-count {
    font-size: var(--type-body);
    color: var(--ink-2);
}

.roster-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.roster-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}

.roster-panel--list {
    flex-grow: 7;
    margin-right: var(--space-4);
}

.roster-panel--create {
    flex-grow: 3;
    min-width: 380px;
    max-width: 520px;
}

.character-roster--match-pick .roster-panel--list {
    margin-right: 0;
}

.character-roster--match-pick .roster-panel--create {
    display: none;
}

.roster-intro,
.create-help,
.character-detail {
    font-size: var(--type-body);
    color: var(--ink-2);
    white-space: normal;
}

.roster-intro {
    margin-bottom: var(--space-3);
}

.roster-scroll,
.roster-list {
    flex-grow: 1;
    min-height: 0;
}

.roster-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    white-space: normal;
    padding: var(--space-8);
    -unity-text-align: middle-center;
}

.character-row {
    flex-direction: row;
    align-items: stretch;
    min-height: 184px;
    margin-bottom: var(--space-3);
    background-color: var(--surface-1);
    border-radius: var(--space-2);
    border-left-width: 6px;
    border-left-color: var(--class-neutral);
    overflow: hidden;
}

.character-row--emberward { border-left-color: var(--class-emberward); }
.character-row--tidecaller { border-left-color: var(--class-tidecaller); }
.character-row--gravekeep { border-left-color: var(--class-gravekeep); }
.character-row--verdant { border-left-color: var(--class-verdant); }

.character-select {
    flex-grow: 1;
    align-items: flex-start;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: var(--space-4);
    margin: 0;
    color: var(--ink-1);
}

.character-select:hover {
    background-color: var(--surface-3);
}

.character-name {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}

.character-pairing {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.pair-class {
    font-size: var(--type-h2);
    -unity-font-style: bold;
}

.pair-arrow {
    font-size: var(--type-h2);
    color: var(--ink-2);
    margin-left: var(--space-2);
    margin-right: var(--space-2);
}

.class--emberward { color: var(--class-emberward); }
.class--tidecaller { color: var(--class-tidecaller); }
.class--gravekeep { color: var(--class-gravekeep); }
.class--verdant { color: var(--class-verdant); }

.character-detail {
    margin-bottom: var(--space-1);
}

.queue-pill {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: normal;
}

.queue-pill--ready {
    color: var(--surface-0);
    background-color: var(--positive);
}

.queue-pill--draft {
    color: var(--surface-0);
    background-color: var(--warning);
}

.delete-character {
    width: 112px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--surface-2);
    color: var(--negative);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.delete-character:hover {
    background-color: var(--surface-3);
}

.character-row--match-pick {
    flex-direction: column;
    padding: var(--space-4);
}

.match-character-details {
    margin-bottom: var(--space-3);
}

.match-deck-choices {
    flex-direction: row;
    flex-wrap: wrap;
}

.match-deck-choice {
    min-height: 48px;
    margin: 0 var(--space-2) var(--space-2) 0;
    padding: var(--space-2) var(--space-4);
    border-width: 0;
    border-radius: var(--space-2);
    color: var(--surface-0);
    background-color: var(--positive);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.match-deck-choice:hover {
    background-color: var(--accent);
}

.match-deck-draft {
    min-width: 280px;
    margin: 0 var(--space-2) var(--space-2) 0;
    padding: var(--space-3);
    border-radius: var(--space-2);
    background-color: var(--surface-3);
}

.match-deck-draft-name {
    color: var(--ink-2);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.match-deck-draft-reason {
    margin-top: var(--space-1);
    color: var(--warning);
    font-size: var(--type-label);
    white-space: normal;
}

.match-deck-edit {
    align-self: flex-start;
    min-width: 96px;
    min-height: 44px;
    margin-top: var(--space-2);
    border-width: 0;
    border-radius: var(--space-2);
    color: var(--ink-1);
    background-color: var(--surface-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
}

.match-deck-empty {
    min-height: 48px;
    color: var(--ink-2);
    font-size: var(--type-body);
    -unity-text-align: middle-left;
}

.create-title,
.delete-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}

.create-help {
    margin-bottom: var(--space-4);
}

.create-help--starter {
    font-size: var(--type-label);
    margin-bottom: var(--space-2);
}

.roster-field {
    margin-bottom: var(--space-3);
}

.roster-field .unity-base-field__label {
    min-width: 120px;
    color: var(--ink-2);
    font-size: var(--type-body);
}

.roster-field .unity-base-text-field__input,
.roster-field .unity-base-popup-field__input {
    min-height: 44px;
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
    font-size: var(--type-body);
    padding: var(--space-2);
}

.create-order-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}

.power-hint {
    flex-grow: 1;
    font-size: var(--type-body);
    color: var(--accent);
    -unity-font-style: bold;
}

.create-error,
.roster-status {
    min-height: 24px;
    font-size: var(--type-label);
    color: var(--negative);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.roster-status {
    color: var(--ink-2);
    margin-top: var(--space-2);
    margin-bottom: 0;
}

.roster-status--error {
    color: var(--negative);
}

.roster-button {
    min-width: 148px;
    height: 48px;
    border-width: 0;
    border-radius: var(--space-2);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.roster-button--small {
    min-width: 128px;
    height: 40px;
    font-size: var(--type-label);
}

.roster-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}

.roster-button--ghost {
    color: var(--ink-1);
    background-color: var(--surface-3);
}

.roster-button--danger {
    color: var(--ink-1);
    background-color: var(--negative);
}

.create-button {
    align-self: stretch;
}

.delete-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.delete-modal--hidden {
    display: none;
}

.delete-dialog {
    width: 620px;
    max-width: 88%;
    padding: var(--space-6);
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    border-width: 1px;
    border-color: var(--surface-3);
}

.delete-message {
    font-size: var(--type-h2);
    color: var(--ink-1);
    white-space: normal;
    margin-bottom: var(--space-4);
}

.delete-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.delete-actions .roster-button {
    margin-left: var(--space-3);
}

/* No visible scrollbar chrome. Wheel, touch-drag, and keyboard scrolling remain available. */
#roster-scroll .unity-scroller,
#roster-scroll .unity-scroller--vertical,
#roster-scroll .unity-scroller--horizontal,
#roster-scroll .unity-scroll-view__vertical-scroller,
#roster-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}
