.character-roster {
    flex-grow: 1;
    background-color: var(--surface-1);
    padding: var(--space-6);
    color: var(--ink-1);
}

.roster-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.roster-header-left {
    flex-direction: row;
    align-items: center;
}

.roster-header-actions {
    flex-direction: row;
    align-items: center;
}

.roster-header-actions .roster-button {
    margin-left: var(--space-3);
}

/* The one door into creation, top-left (NOR-278). CTA-gold so it reads as the primary thing to
 * do on an empty roster. Flush against the header's left edge (Sam, 2026-08-09) — it used to sit
 * right of a "Characters" / "N characters" heading that said nothing the roster below it didn't
 * already show, so the heading is gone and this no longer needs a margin to clear it. */
.new-character-button {
    min-width: 0;
    height: 40px;
    font-size: var(--type-label);
}

.roster-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.roster-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}

.roster-panel--list {
    flex-grow: 7;
    margin-right: var(--space-4);
}

.roster-panel--create {
    flex-grow: 3;
    min-width: 380px;
    max-width: 520px;
}

.character-roster--match-pick .roster-panel--list {
    margin-right: 0;
}

.character-roster--match-pick .roster-panel--create {
    display: none;
}

.roster-intro,
.create-help {
    font-size: var(--type-body);
    color: var(--ink-2);
    white-space: normal;
}

.roster-intro {
    margin-bottom: var(--space-3);
}

.roster-scroll,
.roster-list {
    flex-grow: 1;
    min-height: 0;
}

.roster-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    white-space: normal;
    padding: var(--space-8);
    -unity-text-align: middle-center;
}

/* No min-height: the plates decide how tall a row is now, and they are sized to the space the
 * strip actually has (CharacterRosterController.LayoutDeckStrip).
 *
 * A COLUMN, not a row (Sam, 2026-08-07): a name band, then the decks under it at the row's full
 * width. It was three side-by-side columns — name, strip, Delete — and the two text columns took
 * enough width off the strip to wrap a third deck onto a second line. */
.character-row {
    flex-direction: column;
    margin-bottom: var(--space-3);
    background-color: var(--surface-1);
    border-radius: var(--space-2);
    border-left-width: 6px;
    border-left-color: var(--class-neutral);
    overflow: hidden;
}

.character-row--emberward { border-left-color: var(--class-emberward); }
.character-row--tidecaller { border-left-color: var(--class-tidecaller); }
.character-row--gravekeep { border-left-color: var(--class-gravekeep); }
.character-row--verdant { border-left-color: var(--class-verdant); }

/* The decks no character claims (collection-deckbuilder.md §5 O-4). It uses the character row's
 * shape so the plates inside it size the same way, and then reads as clearly NOT a character: the
 * spine is the destructive red rather than a class colour, and the identity block carries a
 * sentence where every other row carries a name. It is only ever drawn when there is at least one,
 * so a healthy collection never sees it. */
.character-row--orphan {
    border-left-color: var(--negative);
    background-color: var(--surface-0);
}

.character-name--orphan {
    font-size: var(--type-h2);
    color: var(--ink-2);
}

/* Beside the count now, not under it — the identity block is a row. */
.orphan-note {
    font-size: var(--type-caption);
    color: var(--ink-2);
    flex-shrink: 1;
    white-space: normal;
}

/* The name band over the decks. It holds the name on the left and Delete on the right, and it is
 * the only thing in the row that is not deck art — which is the point: one line of height buys the
 * strip the row's whole width, where the old left-hand column charged 18% of it forever. */
.character-row-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4) 0 var(--space-4);
}

/* The character's name, and nothing else (Sam, 2026-08-07). Anything else on it is a line the
 * player re-reads for information they had after the first row. A plain block, not a button:
 * opening a character means opening one of ITS DECKS, and there is no "just the character"
 * destination left for a click to go to. */
.character-identity {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--ink-1);
}

.character-name {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    flex-shrink: 0;
    margin-right: var(--space-3);
    text-overflow: ellipsis;
    overflow: hidden;
}

/* The pairing used to be spelled out under the name. The row's coloured spine carries the
 * primary class now, and the decks carry the rest (Sam, 2026-08-07). */

/* ---- Deck strip (Sam, 2026-08-07) ------------------------------------------------------
 * The deck switcher and the deck name used to live at the top of the deckbuilder's right-hand
 * panel. They live here now: a character row is mostly empty space, and a deck is a thing you
 * pick BEFORE you open an editor for it, not a tab inside one.
 *
 * A deck is drawn as ONE CARD and carries no name (Sam, 2026-08-07): the art the player chose
 * from inside it is the identity, the way a physical deck is known by its sleeve.
 */
/* NOWRAP (Sam, 2026-08-07). A deck that does not fit makes every plate on the row narrower; it
 * never drops to a second line. The row is full-width now precisely so this rarely bites, but the
 * responsive shrink is the behaviour we want when it does — LayoutDeckStrip divides the width by
 * the plate count with no wrap point to solve for. */
.deck-strip {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    padding: var(--space-3) var(--space-4) var(--space-4) var(--space-4);
    overflow: hidden;
}

/* width, and the art's square side, are written per row by LayoutDeckStrip. The value here is
 * only what a plate looks like for the frame before that pass runs. */
.deck-plate {
    width: 132px;
    flex-shrink: 0;
    align-items: center;
    margin: 0 var(--space-3) 0 0;
    padding: var(--space-2);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--space-2);
    background-color: transparent;
    color: var(--ink-1);
}

.deck-image-scroll {
    max-height: 90%;
}

/* No visible scrollbars anywhere (Sam, 2026-08-01 ruling — see [[no-visible-scrollbars-ruling]] in
 * memory). Wheel/drag scrolling still works; this only hides the track+thumb chrome. Same three
 * selectors as #collection-scroll in deckbuilder.uss. */
#deck-image-scroll .unity-scroller,
#deck-image-scroll .unity-scroller--vertical,
#deck-image-scroll .unity-scroll-view__vertical-scroller {
    display: none;
}

/* The art of whichever card fronts the deck, rendered SQUARE (Sam, 2026-08-07) — a deck is not
 * a card-shaped thumbnail here. scale-and-crop rather than stretch: card art is not square, and
 * letterboxing it reads as a bug where cropping reads as framing. The plate strip overwrites
 * these two values every layout pass; they are the picker's size, and the plate's first frame. */
.deck-plate-art {
    width: 112px;
    height: 112px;
    border-radius: var(--space-1);
    background-color: var(--surface-3);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* GOLD MEANS READY TO PLAY (Sam, 2026-08-07). It is the only thing on a plate that says so —
 * the "17 / 30" caption and the Ready/Draft chip before it are both gone. A deck short of 30, or
 * holding something illegal, simply has no gold edge.
 *
 * The default deck is NOT a border. It is the star on the plate's Functions button, because gold
 * now means something else and a second ring colour on the same element would be read as one
 * state, not two.
 *
 * The match pick is the OUTER ring on the plate, so a picked deck still shows its gold inner edge
 * — two concentric rings, two independent facts. */
.deck-plate-art--ready {
    border-width: 3px;
    border-color: var(--accent);
}

.deck-plate--selected {
    background-color: var(--surface-3);
    border-color: var(--mana);
}

/* An orphan's plate. The art is NOT dimmed — refuse the deck, never the picture (Sam's collection
 * ruling) — and it never takes the gold ready edge, because it fails L5 by construction. What
 * marks it is the dashed-looking muted ring: present enough to say "this one is different", quiet
 * enough that it does not compete with gold. */
.deck-plate--orphan .deck-plate-art {
    border-width: 3px;
    border-color: var(--class-neutral);
}

.deck-plate--orphan:hover .deck-plate-art {
    border-color: var(--negative);
}

/* The plate has no button (Sam, 2026-08-07). It is the picture, and the picture is the control:
 * one tap opens the functions, two open the deckbuilder. So the only affordance it can offer is
 * the hover itself. */
.deck-plate:hover .deck-plate-art {
    border-width: 3px;
    border-color: var(--ink-1);
}

.deck-plate--default .deck-plate-art:hover,
.deck-plate-art--ready:hover {
    border-color: var(--ink-1);
}

/* The default marker, over the art's top-left. A glyph rather than a word, and not a border —
 * gold is spoken for. */
.deck-plate-star {
    position: absolute;
    top: var(--space-1);
    left: var(--space-2);
    font-size: var(--type-h2);
    color: var(--accent);
}

.deck-edit-hint {
    margin-top: var(--space-2);
    font-size: var(--type-label);
    color: var(--ink-2);
    -unity-text-align: middle-center;
}

.deck-plate--new .deck-plate-art {
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--surface-3);
    background-color: var(--surface-1);
}

.deck-plate-plus {
    font-size: var(--type-display);
    -unity-font-style: bold;
    color: var(--ink-2);
}

.deck-plate--new:hover .deck-plate-art { border-color: var(--accent); }
.deck-plate--new:hover .deck-plate-plus { color: var(--accent); }

/* There is no deck-strip-hint any more. A character whose default deck was deleted rolls onto
 * another one silently (Sam, 2026-08-07) — an error message above somebody's decks, about a deck
 * they deleted on purpose, is not news they can act on. */

/* ---- Deck modal header: account name + class badges (NOR-404) --------------------------------
 * The header row sits above the deck title. Account name is on the left; class badges pin to
 * the right. Hidden on orphan dialogs (no character, so no classes to show). */
.deck-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
}

.deck-modal-account {
    font-size: var(--type-caption);
    color: var(--ink-2);
    flex-shrink: 1;
    text-overflow: ellipsis;
    overflow: hidden;
}

.deck-modal-classes {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: var(--space-3);
}

.deck-modal-class-badge {
    font-size: var(--type-caption);
    -unity-font-style: bold;
    color: var(--surface-0);
    padding: 2px var(--space-2);
    border-radius: 10px;
    margin-left: var(--space-1);
    background-color: var(--class-neutral);
}

.deck-modal-class-badge--emberward  { background-color: var(--class-emberward); }
.deck-modal-class-badge--tidecaller { background-color: var(--class-tidecaller); }
.deck-modal-class-badge--gravekeep  { background-color: var(--class-gravekeep); }
.deck-modal-class-badge--verdant    { background-color: var(--class-verdant); }
.deck-modal-class-badge--tempest    { background-color: var(--class-tempest); }
.deck-modal-class-badge--clockwright { background-color: var(--class-clockwright); }
.deck-modal-class-badge--stonewarden { background-color: var(--class-stonewarden); }
.deck-modal-class-badge--nightveil  { background-color: var(--class-nightveil); }

/* ---- Deck modal panes ---- */
.deck-pane {
    margin-bottom: var(--space-2);
}

.deck-action {
    align-self: stretch;
    margin-bottom: var(--space-2);
}

.deck-back-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
}

.deck-back-option {
    width: 128px;
    align-items: center;
    margin: 0 var(--space-3) var(--space-3) 0;
    padding: var(--space-2);
    border-width: 2px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    background-color: var(--surface-1);
    color: var(--ink-1);
}

.deck-back-option--on {
    border-color: var(--accent);
    background-color: var(--surface-3);
}

/* Pickers label their options; deck plates on the roster do not. A card back has no other name,
 * and the deck-image grid identifies its cards by tooltip because the art is the point. */
.deck-back-option .deck-plate-name {
    width: 100%;
    margin-top: var(--space-2);
    font-size: var(--type-caption);
    -unity-text-align: middle-center;
    color: var(--ink-2);
    text-overflow: ellipsis;
    overflow: hidden;
}

/* ---- Character menu (Sam, 2026-08-07) --------------------------------------------------------
 * The row's Delete button is gone. It was a full-height spine down the right edge — permanent
 * width, on the one action nobody wants within a stray tap of the deck they meant to open. The
 * name opens it now.
 *
 * A popover, not a modal: the card is positioned under the name by
 * CharacterRosterController.OpenCharacterMenu, and the scrim behind it is transparent rather than
 * dimming, because this is a menu about one row and darkening the screen says otherwise. The
 * scrim still fills the panel — it is what makes "click anywhere else" close it, and what stops a
 * click landing on a deck plate underneath. */
.character-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.character-menu--hidden {
    display: none;
}

.character-menu-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* left/top are written per open. Width is fixed so the anchor pass has something to clamp
 * against before the card has ever been laid out. */
.character-menu-card {
    position: absolute;
    width: 260px;
    padding: var(--space-3);
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
}

.character-menu-title {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-bottom: var(--space-2);
    text-overflow: ellipsis;
    overflow: hidden;
}

/* The name is the control. Nothing else in the row is text you can click, so it says so on
 * hover rather than wearing a button's chrome permanently. The orphan row's heading is a
 * sentence, not a character, and opens nothing — so it must not offer the tell. */
.character-name:hover {
    color: var(--accent);
}

.character-name--orphan:hover {
    color: var(--ink-2);
}

/* Find Game's Continue bar. Match pick used to be a whole second row layout — text buttons per
 * deck, its own draft/empty states — which meant the same screen looked different depending on
 * which door you came through. It draws the ordinary plates now (Sam, 2026-08-07); this bar is
 * the only thing the match door adds. */
.match-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: var(--space-4);
}


.create-title,
.delete-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-2);
}

.create-help {
    margin-bottom: var(--space-4);
}

.create-help--starter {
    font-size: var(--type-label);
    margin-bottom: var(--space-2);
}

.roster-field {
    margin-bottom: var(--space-3);
}

.roster-field .unity-base-field__label {
    min-width: 120px;
    color: var(--ink-2);
    font-size: var(--type-body);
}

.roster-field .unity-base-text-field__input,
.roster-field .unity-base-popup-field__input {
    min-height: 44px;
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
    font-size: var(--type-body);
    padding: var(--space-2);
}

.create-order-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}

.power-hint {
    flex-grow: 1;
    font-size: var(--type-body);
    color: var(--accent);
    -unity-font-style: bold;
}

.create-error,
.roster-status {
    min-height: 24px;
    font-size: var(--type-label);
    color: var(--negative);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.roster-status {
    color: var(--ink-2);
    margin-top: var(--space-2);
    margin-bottom: 0;
}

.roster-status--error {
    color: var(--negative);
}

.roster-button {
    min-width: 148px;
    height: 48px;
    border-width: 0;
    border-radius: var(--space-2);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

.roster-button--small {
    min-width: 128px;
    height: 40px;
    font-size: var(--type-label);
}

.roster-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}

.roster-button--ghost {
    color: var(--ink-1);
    background-color: var(--surface-3);
}

.roster-button--danger {
    color: var(--ink-1);
    background-color: var(--negative);
}

.create-button {
    align-self: stretch;
}

.delete-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.delete-modal--hidden {
    display: none;
}

/* Sized for the menu pane (a stack of buttons) — the common case for opening this dialog.
 * .delete-dialog--wide (below) overrides this for the two panes that actually need the room:
 * a grid of card art wants width the button list would only stretch to fill (Sam, 2026-08-09).
 * Same override pattern as .character-create-dialog just below. */
.delete-dialog {
    width: 50%;
    max-width: 60%;
    height: 80%;
    padding: var(--space-6);
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    border-width: 1px;
    border-color: var(--surface-3);
}

.delete-dialog--wide {
    width: 80%;
    max-width: 88%;
}

.delete-message {
    font-size: var(--type-h2);
    color: var(--ink-1);
    white-space: normal;
    margin-bottom: var(--space-4);
}

.delete-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
}

.delete-actions .roster-button {
    margin-left: var(--space-3);
}

/* No visible scrollbar chrome. Wheel, touch-drag, and keyboard scrolling remain available. */
#roster-scroll .unity-scroller,
#roster-scroll .unity-scroller--vertical,
#roster-scroll .unity-scroller--horizontal,
#roster-scroll .unity-scroll-view__vertical-scroller,
#roster-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

/* ---- Character creation overlay (portrait grid, NOR-278) --------------------------------------
 * Reuses .delete-modal for the scrim, but the card is FULL-BLEED (Sam, NOR-288): it fills the
 * whole display rather than sitting in a 760px box. The portraits are the screen's entire subject
 * while it is open, and a boxed dialog spent most of a phone's landscape width on a dimmed
 * backdrop that had nothing left to show. No radius and no border, because neither reads as an
 * edge when there is nothing outside it. */
/* Out past the screen's padding. An absolutely-positioned child is laid out inside its parent's
 * content box, so left/top/right/bottom of 0 stops 24px short of every edge — .character-roster's
 * --space-6 padding — and the dialog's lighter surface would draw a frame around itself and read
 * as "nearly full screen". These four must stay the negative of that padding. */
.character-create {
    left: -24px;
    right: -24px;
    top: -24px;
    bottom: -24px;
}

.character-create-dialog {
    width: 100%;
    height: 100%;
    max-width: none;
    border-radius: 0;
    border-width: 0;
    justify-content: center;
}

/* The grid view takes whatever height the dialog has left after its header; the other two views
 * are text and controls, so they keep a readable column and centre in the space instead of
 * stretching a sentence across the display. */
#create-grid-view {
    flex-grow: 1;
    min-height: 0;
}

#create-detail-view,
#create-confirm-view {
    align-self: center;
    width: 720px;
    max-width: 100%;
}

/* Centred over a centred grid. */
#create-pass-title,
#create-pass-help {
    -unity-text-align: middle-center;
}

#create-pass-help {
    align-self: center;
    max-width: 900px;
}

/* One square portrait per class, wrapped into rows. Fills the view: CharacterRosterController
 * .LayoutHeroGrid writes every tile's width and its art's square side from the space this element
 * actually has, the same solve .deck-strip runs — flex alone cannot grow a square. */
.hero-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    margin-bottom: var(--space-4);
}

/* A portrait tile: art, a name under it, and a corner selection badge. The tile body is one tap
 * target (opens the detail overlay); the badge is a second, independent one (toggles selection).
 *
 * width, and the art's square side, are written per pass by LayoutHeroGrid. The values here are
 * only what a tile looks like for the frame before that pass runs. */
.hero-tile {
    width: 152px;
    align-items: center;
    justify-content: center;
    margin: var(--space-2);
    padding: var(--space-2);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--space-2);
    background-color: var(--surface-1);
}

.hero-tile:hover {
    border-color: var(--ink-1);
}

.hero-tile--selected {
    border-color: var(--accent);
    background-color: var(--surface-3);
}

/* Overwritten every layout pass by LayoutHeroGrid; this is the first frame's size. */
.hero-tile-art {
    width: 128px;
    height: 128px;
    border-radius: var(--space-1);
    background-color: var(--surface-3);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.hero-tile-name {
    width: 100%;
    margin-top: var(--space-2);
    font-size: var(--type-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-1);
    text-overflow: ellipsis;
    overflow: hidden;
}

/* The selection badge, bottom-left of the art, in the same circular treatment as the card's
 * mana-cost frame (NOR-278). Empty and quiet when unselected — still tappable, that is how you
 * select — and filled with the pick order (1 = primary/hero power, 2 = secondary) when on. */
.hero-tile-badge {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 2px;
    border-color: var(--surface-3);
    background-color: var(--surface-0);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hero-tile-badge:hover {
    border-color: var(--mana);
}

.hero-tile-badge--on {
    border-color: var(--mana);
    background-color: var(--mana);
    color: var(--surface-0);
}

/* ---- Detail overlay ---- */
.hero-detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-4);
}

.hero-detail-portrait {
    width: 96px;
    height: 96px;
    border-radius: var(--space-1);
    background-color: var(--surface-3);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    margin-right: var(--space-4);
}

.hero-detail-headings {
    flex-grow: 1;
    flex-shrink: 1;
}

.hero-detail-pass {
    font-size: var(--type-body);
    color: var(--accent);
    white-space: normal;
}

/* Traits/playstyle bullets, filled from hero-detail.json (NOR-281). */
.hero-detail-bullets {
    min-height: 72px;
    margin-bottom: var(--space-3);
}

.hero-detail-bullet {
    font-size: var(--type-body);
    color: var(--ink-2);
    white-space: normal;
    margin-bottom: var(--space-1);
}

/* Filled from the class's hero power card since NOR-291. The minimum height is now a floor for a
 * one-line power rather than a placeholder — it keeps the overlay the same height whether the
 * generated description wraps to one line or two. */
.hero-power-block {
    min-height: 64px;
    padding: var(--space-3);
    border-radius: var(--space-2);
    background-color: var(--surface-1);
    margin-bottom: var(--space-4);
}

.hero-power-caption {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-bottom: var(--space-1);
}

.hero-power-name {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
}

.hero-power-desc {
    font-size: var(--type-body);
    color: var(--ink-2);
    white-space: normal;
}

.unity-button {
    border-radius: 4px;
}