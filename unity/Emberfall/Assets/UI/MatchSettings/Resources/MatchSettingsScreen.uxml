<?xml version="1.0" encoding="utf-8"?>
<!--
  MatchSettingsScreen.uxml — in-match settings overlay (C-G1-3 / decision 23 §5).
  A persistent corner "menu" button that opens a modal panel. In-match, the top (and, for
  now, only) item is CONCEDE, gated behind a confirm because leaving IS forfeiting. Sound /
  Video are deferred — they land later as rows in #view-menu without touching this wiring.

  Loaded at runtime by the bootstraps AND by MainMenuController (Sam, 2026-08-09 — the gear is
  reachable from the main menu now, not just in-match) via Resources and bound by
  MatchSettingsController. On the menu mount, Concede is hidden (nothing to concede) and Switch
  account is what's left.
  Styled by theme.uss (shared meta-screen tokens, single source of truth) + mainmenu.uss (for the
  account-modal it reuses) + matchsettings.uss.

  The root is picking-mode Ignore so the world-space board keeps its clicks; only the gear
  (always) and the scrim (while open) are pickable. Board input is ALSO gated in InputRouter
  while this is open — UI Toolkit does not block Unity physics, so the scrim alone won't.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../Common/theme.uss" />
    <!-- Reused here for .mm-modal / .mm-accounts — the account switcher (below) is the same
         modal MainMenuController used to own directly; it now lives on this shared panel instead
         of being duplicated in matchsettings.uss. -->
    <Style src="../../MainMenu/mainmenu.uss" />
    <Style src="matchsettings.uss" />

    <ui:VisualElement name="root" class="emb-root ms-root" picking-mode="Ignore">

        <!-- Persistent corner button -->
        <ui:Button name="btn-settings" class="ms-gear emb-edge">
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
        </ui:Button>

        <!-- Modal overlay (display toggled by the controller) -->
        <ui:VisualElement name="overlay" class="ms-overlay emb-bleed">
            <ui:VisualElement name="scrim" class="ms-scrim emb-bleed" />

            <ui:VisualElement name="panel" class="ms-panel">

                <!-- Menu view -->
                <ui:VisualElement name="view-menu" class="ms-view">
                    <ui:Label text="Menu" class="ms-title" />
                    <ui:Button name="btn-concede" text="Concede" class="ms-item ms-item--danger" />
                    <ui:Button name="btn-close" text="Close" class="ms-item emb-back" />
                    <!-- Dev/testing only (Sam, moved off the main menu identity plate 2026-08-09) —
                         hidden here in the UXML so a release build stays hidden even if the show
                         call is ever reached; MatchSettingsController reveals it under
                         UNITY_EDITOR || DEVELOPMENT_BUILD, same gate DeviceAccounts itself uses. -->
                    <ui:Button name="btn-switch-account" text="Switch account" class="ms-item" style="display: none;" />
                    <!-- Quit (Sam, 2026-08-09): accessible, not a call to action — deliberately NOT
                         an .ms-item, so it never reads with the same weight as Concede/Close. Same
                         corner both places this panel mounts (match or main menu). -->
                    <ui:Button name="btn-quit" text="Quit" class="ms-item-quiet" />
                </ui:VisualElement>

                <!-- Confirm view -->
                <ui:VisualElement name="view-confirm" class="ms-view ms-hidden">
                    <ui:Label text="Concede this match?" class="ms-title" />
                    <ui:Label text="This counts as a loss." class="ms-subtitle" />
                    <ui:Button name="btn-confirm-concede" text="Concede" class="ms-item ms-item--danger" />
                    <ui:Button name="btn-cancel" text="Cancel" class="ms-item" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Account switcher (testing only — moved here from the main menu identity plate, Sam
             2026-08-09). Same mm-modal shell MainMenuController used to own; reachable from
             wherever this panel is mounted, match or main menu. -->
        <ui:VisualElement name="account-modal" class="mm-modal mm-modal--hidden">
            <ui:VisualElement name="account-panel" class="mm-modal__panel">
                <ui:Label name="account-title" text="Accounts on this device" class="mm-modal__title"/>
                <ui:Label name="account-help" text="Local testing only — each account has its own name, characters and decks, and joins matches as its own player. Switching reloads the scene." class="mm-modal__help"/>
                <ui:VisualElement name="account-list" class="mm-accounts"/>
                <ui:Label name="account-error" text=" " class="mm-modal__error"/>
                <ui:VisualElement class="mm-modal__actions">
                    <ui:Button name="btn-account-close" text="Close" class="mm-modal__button emb-back"/>
                    <ui:Button name="btn-account-new" text="New account" class="mm-modal__button mm-modal__button--cta"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
