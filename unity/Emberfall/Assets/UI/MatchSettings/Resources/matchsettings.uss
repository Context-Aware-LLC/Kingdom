/*
 * matchsettings.uss — in-match settings overlay (C-G1-3 / decision 23 §5).
 * Consumes tokens from theme.uss only (the single source of truth); no literal color/size a
 * token already names. UI Toolkit note: spacing via margins (no `gap`), layout is flexbox.
 */

.ms-root {
    flex-grow: 1;
}

/* ---------- Corner button (always visible) ----------
 * The one persistent surface: a small square "menu" (hamburger) button parked bottom-right.
 * Three bars are child VisualElements so the icon is font-independent.
 */
.ms-gear {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    width: 68px;
    height: 58px;
    background-color: rgba(18, 23, 31, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(218, 224, 232);
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}
.ms-gear:hover  { -unity-background-image-tint-color: rgb(255, 255, 255); }
.ms-gear:active { -unity-background-image-tint-color: rgb(188, 195, 205); translate: 0 1px; }
.ms-gear-bar {
    width: 22px;
    height: 3px;
    margin: 2px 0;
    background-color: rgb(232, 194, 132);
}

/* ---------- Modal overlay (hidden until the button is pressed) ---------- */
.ms-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;                       /* toggled by MatchSettingsController */
    align-items: center;
    justify-content: center;
}
.ms-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.68);
}
.ms-panel {
    min-width: 320px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: rgba(11, 14, 19, 0.7);
    border-radius: var(--space-3);
    padding: var(--space-6);
    align-items: stretch;
}

.ms-view { align-items: stretch; }
.ms-hidden { display: none; }

.ms-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-4);
}
.ms-subtitle {
    font-size: var(--type-body);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-6);
}

/* ---------- Audio (Sam, 2026-09-05: mute + separate music/SFX volume) ----------
 * Sits inside its own surface so it reads as one settings group rather than two more menu items —
 * .ms-item below is a full-width button; a label+control row needs its own row layout instead. */
.ms-audio {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-2);
}
.ms-toggle,
.ms-slider {
    flex-direction: row;
    margin-top: var(--space-2);
}
.ms-toggle:first-child,
.ms-slider:first-child { margin-top: 0; }
.ms-toggle > .unity-toggle__input,
.ms-toggle .unity-base-field__label,
.ms-slider .unity-base-field__label {
    color: var(--ink-1);
    font-size: var(--type-label);
    min-width: 90px;
}
.ms-toggle .unity-toggle__checkmark {
    background-color: var(--surface-3);
    border-width: 0;
    border-radius: var(--space-1);
}
/* Sam, 2026-09-05: the fill wasn't showing — ":checked" is a UI Toolkit pseudo-state, not a class,
 * and ".unity-toggle--checked" (what this said before) matches nothing. MatchSettingsController
 * drives .ms-toggle--on explicitly instead of trusting the pseudo-state, matching .db-chip--on's
 * pattern elsewhere in this project. */
.ms-toggle--on .unity-toggle__checkmark {
    background-color: var(--mana);
}
.ms-slider .unity-base-slider__tracker {
    background-color: var(--surface-3);
    border-width: 0;
    border-radius: 999px;
}
.ms-slider .unity-base-slider__dragger {
    background-color: var(--mana);
    border-width: 0;
    border-radius: 999px;
}
/* Dimmed rather than hidden while muted (MatchSettingsController.SetEnabled) — the values are
 * still there to look at, just not adjustable until unmuted. */
.ms-slider:disabled { opacity: 0.4; }

/* ---------- Menu items ---------- */
.ms-item {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    background-color: var(--surface-2);
    border-width: 0;
    border-radius: var(--space-2);
    height: 56px;
    margin-top: var(--space-2);
    padding: 0 var(--space-6);
}
.ms-item:hover  { background-color: var(--surface-3); }
.ms-item:active { background-color: var(--surface-0); }

/* Concede is destructive — it reads in the negative color and warms on hover. */
.ms-item--danger        { color: var(--negative); }
.ms-item--danger:hover  { background-color: rgba(229, 72, 77, 0.22); }

/* Quit (Sam, 2026-08-09): accessible, never a call to action. No background, no bold, smaller and
 * quieter than the .ms-item rows above it — it should read as the last, least-important line in
 * the menu, not compete with Concede/Close for attention. */
.ms-item-quiet {
    font-size: var(--type-caption);
    color: var(--ink-2);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    height: auto;
    margin-top: var(--space-4);
    padding: var(--space-1) 0 0 0;
    -unity-text-align: middle-center;
}
.ms-item-quiet:hover  { color: var(--ink-1); }
.ms-item-quiet:active { color: var(--ink-2); }
