<?xml version="1.0" encoding="utf-8"?>
<!--
  DeckbuilderScreen.uxml — S7 split view (dev-docs/ui/client-surfaces.md:9).
    left:  filtered card list (class ∪ neutral for this hero), virtualized ListView
    right: the 30-card deck list (curve strip + counts + legality state)
  Bound at runtime by DeckbuilderController; styled by theme.uss (tokens) + deckbuilder.uss.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="theme.uss" />
    <Style src="deckbuilder.uss" />

    <ui:VisualElement name="root" class="emb-root deckbuilder">

        <!--
          No header (Sam, 2026-08-07). It carried the character's name and the deck's, and both are
          on the previous screen: the character is named once on its roster row, and the deck name
          sits under the plate you clicked to get here. Repeating them cost the collection wall a
          band of vertical space to tell the player something they had just read. The card count
          moved down into the deck panel, where it labels the list it counts.
        -->

        <!-- Body: split view -->
        <ui:VisualElement name="body" class="db-body">

            <!-- Left: collection -->
            <ui:VisualElement name="collection-panel" class="db-panel db-collection">
                <ui:VisualElement name="filter-row" class="db-filter-row">
                    <ui:Button name="filter-all" text="All" class="db-chip db-chip--on" />
                    <ui:Button name="filter-class" text="Class" class="db-chip" />
                    <ui:Button name="filter-neutral" text="Neutral" class="db-chip" />
                </ui:VisualElement>
                <ui:ScrollView name="collection-scroll" class="db-list" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="collection-grid" class="db-grid" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!--
              Right: the deck. Set Default and Delete Deck went to the roster's deck dialog with
              the rest of deck management (Sam, 2026-08-07) — what is left here edits the 30.
            -->
            <ui:VisualElement name="deck-panel" class="db-panel db-deck">
                <!--
                  Back lives here now, not in a footer row of its own (Sam, 2026-08-09): the
                  legality box below it never had anything to say — this screen can't produce an
                  illegal deck (SaveDeck is never legality-gated) — so it's gone, and Back moved up
                  next to the count instead of being squeezed into what was left of the footer.
                  It still saves and leaves; see WireChrome.
                -->
                <ui:VisualElement name="deck-header" class="db-deck-header">
                    <ui:Button name="done-button" text="Back" class="db-button db-button--ghost db-button--back" />
                    <ui:Label name="count-label" text="0 / 30" class="db-count" />
                </ui:VisualElement>
                <ui:VisualElement name="curve-strip" class="db-curve" />
                <ui:ListView name="deck-list" class="db-list" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
