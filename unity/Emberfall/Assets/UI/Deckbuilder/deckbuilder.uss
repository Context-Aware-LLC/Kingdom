/*
 * deckbuilder.uss — S7 screen styles. Consumes tokens from theme.uss only (no literal
 * colors/sizes that a token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 */
.deckbuilder {
    flex-grow: 1;
    background-color: var(--surface-1);
    padding: var(--space-4);
}

/* ---------- Header ---------- */
.db-header {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 20px;
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-4);
}
.db-title {
    font-size: var(--type-display);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.db-header-spacer { flex-grow: 1; }
/* Which deck this is. Read-only — renaming is on the roster with the rest of deck management. */
.db-deck-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    max-width: 40%;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}
.db-hero {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--class-emberward);
    margin-right: var(--space-6);
}
.db-count {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-right: var(--space-4);
    min-width: 96px;
    -unity-text-align: middle-right;
}
.db-pill {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--surface-0);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
}
.db-pill--valid   { background-color: var(--positive); }
.db-pill--invalid { background-color: var(--warning); }

/* ---------- Body / split ---------- */
.db-body {
    flex-direction: row;
    flex-grow: 1;
}
.db-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}
/* 70/30 split (Sam, 2026-08-01) — collection reads as the primary surface, deck as the sidebar. */
.db-collection { flex-grow: 7; margin-right: var(--space-4); }
.db-deck       { flex-grow: 3; min-width: 360px; }
.db-panel-title {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-2);
    margin-bottom: var(--space-3);
}

/* ---------- Filter chips ---------- */
.db-filter-row { flex-direction: row; margin-bottom: var(--space-3); }
.db-chip {
    font-size: var(--type-label);
    color: var(--ink-2);
    background-color: var(--surface-3);
    border-width: 0;
    border-radius: 999px;
    padding: var(--space-1) var(--space-4);
    margin-right: var(--space-2);
    height: 32px;
}
.db-chip--on {
    color: var(--surface-0);
    background-color: var(--mana);
    -unity-font-style: bold;
}

/* ---------- Lists ---------- */
.db-list {
    flex-grow: 1;
    background-color: var(--surface-1);
    border-radius: var(--space-2);
}


/* ---------- Collection wall (§2.9 wall tile — the REAL card, baked by CardFaceBaker, not a
 * UI Toolkit re-implementation of the card front) ---------- */
.db-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}
.card-tile {
    width: 276px;
    height: 387px;
    /* margin-left/margin-right are runtime-computed per row by
     * DeckbuilderController.LayoutCollectionGrid (fixed tile size, variable gutter, no dead
     * space on the right edge); only the top/bottom 8px here actually applies. */
    margin: var(--space-2);
    background-color: var(--surface-3);   /* shows through until the bake resolves */
    -unity-background-scale-mode: scale-to-fit;
    border-radius: var(--space-2);
}
/* Deck-side row (§2.3 full tiles are collection-only for now; the deck list stays a legible
 * full-width row for L1–L5 proof) */
.card-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 var(--space-3);
    margin: var(--space-1) var(--space-2);
    background-color: var(--surface-2);
    border-radius: var(--space-1);
    border-left-width: 4px;
    border-left-color: var(--class-neutral);
}
.card-row--disabled { opacity: 0.4; }
.card-cost {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--type-body);
    color: var(--surface-0);
    background-color: var(--mana);
    border-radius: 999px;
    margin-right: var(--space-3);
}
.card-name {
    flex-grow: 1;
    font-size: var(--type-body);
    color: var(--ink-1);
}
.card-rarity-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    margin-right: var(--space-3);
    background-color: var(--rarity-common);
}
/* ---------- Deck side ---------- */
/* The deck switcher (EF-046) and the name field lived here. They are on the CharacterRoster
 * screen now (Sam, 2026-08-07) — this panel edits one deck and cannot change which. */
.db-deck-actions {
    flex-direction: row;
    margin-bottom: var(--space-3);
}
.db-button--small {
    height: 36px;
    min-width: 0;
    flex-grow: 1;
    font-size: var(--type-label);
    padding: 0 var(--space-3);
    margin-right: var(--space-2);
}
/* The trailing button zeroes its own margin inline in the UXML: UI Toolkit has no
 * :last-child (no structural pseudo-classes at all), and an unsupported selector is
 * a silent parse failure, not a no-op. */
.db-button--danger { color: var(--negative); }

.db-curve {
    flex-direction: row;
    align-items: flex-end;
    height: 56px;
    margin-bottom: var(--space-3);
    padding: 0 var(--space-1);
}
.curve-col {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    margin: 0 1px;
}
.curve-bar {
    width: 60%;
    min-height: 2px;
    background-color: var(--mana);
    border-radius: 2px;
}
.curve-label {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-top: 2px;
}

.db-legality {
    margin-top: var(--space-3);
    min-height: 24px;
}
.legality-msg {
    font-size: var(--type-label);
    color: var(--warning);
    margin-bottom: var(--space-1);
}

/* ---------- Rarity / class modifiers (token-driven; set from C# by enum) ---------- */
.rarity--common    { background-color: var(--rarity-common); }
.rarity--rare      { background-color: var(--rarity-rare); }
.rarity--epic      { background-color: var(--rarity-epic); }
.rarity--legendary { background-color: var(--rarity-legendary); }

.edge--neutral    { border-left-color: var(--class-neutral); }
.edge--emberward  { border-left-color: var(--class-emberward); }
.edge--tidecaller { border-left-color: var(--class-tidecaller); }
.edge--gravekeep  { border-left-color: var(--class-gravekeep); }
.edge--verdant    { border-left-color: var(--class-verdant); }

/* ---------- Footer / buttons ---------- */
.db-footer {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-4);
}
.db-button {
    font-size: var(--type-body);
    -unity-font-style: bold;
    height: 48px;
    min-width: 140px;
    border-width: 0;
    border-radius: var(--space-2);
    padding: 0 var(--space-6);
}
.db-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}
.db-button--ghost {
    color: var(--ink-2);
    background-color: var(--surface-3);
}
.db-button:disabled { opacity: 0.35; }

/* No visible scrollbars anywhere (Sam, 2026-08-01 ruling — see [[no-visible-scrollbars-ruling]]
 * in memory). Wheel/drag scrolling still works; this only hides the track+thumb chrome, which
 * read as generic UI Toolkit default rather than anything in this game's visual language. */
 #collection-scroll .unity-scroller {
    display: none;
}

#collection-scroll .unity-scroller--vertical {
    display: none;
}

#collection-scroll .unity-scroll-view__vertical-scroller {
    display: none;
}