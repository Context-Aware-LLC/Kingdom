.emb-root {
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --space-16: 64px;
    --type-display: 36px;
    --type-h1: 28px;
    --type-h2: 22px;
    --type-body: 18px;
    --type-label: 16px;
    --type-caption: 14px;
    --surface-0: rgb(11, 14, 19);
    --surface-1: rgb(20, 25, 34);
    --surface-2: rgb(30, 37, 48);
    --surface-3: rgb(42, 51, 64);
    --ink-1: rgb(237, 241, 246);
    --ink-2: rgb(154, 167, 182);
    --accent: rgb(240, 166, 60);
    --positive: rgb(75, 208, 123);
    --negative: rgb(229, 72, 77);
    --warning: rgb(245, 166, 35);
    --info: rgb(76, 154, 255);
    --mana: rgb(61, 165, 245);
    --rarity-common: rgb(154, 167, 182);
    --rarity-rare: rgb(61, 123, 245);
    --rarity-epic: rgb(162, 75, 229);
    --rarity-legendary: rgb(240, 166, 60);
    --class-neutral: rgb(138, 143, 152);
    --class-emberward: rgb(229, 96, 42);
    --class-tidecaller: rgb(31, 138, 143);
    --class-gravekeep: rgb(126, 107, 158);
    --class-verdant: rgb(75, 154, 84);
    --class-tempest: rgb(16, 14, 150);
    --class-clockwright: rgb(114, 101, 61);
    --class-stonewarden: rgb(107, 129, 141);
    --class-nightveil: rgb(35, 5, 78);
}

.unity-base-dropdown__label {
    color: var(--unity-colors-dropdown-text);
}

.class-tab__art {
    width: 56px;
    height: 56px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.class-tab__art--emberward {
    background-image: url("project://database/Assets/Art/UI/hptabs/ember_hp.png?fileID=2800000&guid=723e5ec5e4632ad49a447f9e7a80dbb1&type=3#ember_hp");
}

.class-tab {
}
