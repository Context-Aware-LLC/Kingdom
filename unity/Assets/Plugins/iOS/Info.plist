<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- emberfall://auth URL scheme — catches the Google OAuth redirect on iOS (NOR-384).
         Unity merges this file into the generated Xcode project's Info.plist at build time. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.nordaware.emberfall.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>emberfall</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
