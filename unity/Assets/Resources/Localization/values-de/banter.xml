<?xml version="1.0" encoding="utf-8"?>
<!-- Versus captions (de): German captions, first pass 2026-11-26; the audio stays English. -->
<resources>
    <string name="banter_emberward_emberward">Tolle Frisur.</string>
    <string name="banter_emberward_tidecaller">Ich versuche, dich nicht zu kochen.</string>
    <string name="banter_emberward_gravekeep">Ist es feuerfest?</string>
    <string name="banter_emberward_verdant">Hübscher Garten.</string>
    <string name="banter_emberward_clockwright">Hatte.</string>
    <string name="banter_emberward_nightveil">Komm raus, Chéri. Ich leuchte dir den Weg.</string>
    <string name="banter_emberward_stonewarden">Finden wir es gemeinsam heraus.</string>
    <string name="banter_emberward_tempest">Alles.</string>
    <string name="banter_tidecaller_emberward">Ich hab Handtücher dabei.</string>
    <string name="banter_tidecaller_tidecaller">Oh. Die Flut kommt.</string>
    <string name="banter_tidecaller_gravekeep">Gern geschehen.</string>
    <string name="banter_tidecaller_verdant">Das macht sie zweimal am Tag.</string>
    <string name="banter_tidecaller_clockwright">Das sagen sie alle.</string>
    <string name="banter_tidecaller_nightveil">Ich hab dir den Nebel mitgebracht.</string>
    <string name="banter_tidecaller_stonewarden">Das Meer zermürbt jede Mauer.</string>
    <string name="banter_tidecaller_tempest">Füße abtreten.</string>
    <string name="banter_gravekeep_emberward">Ich hab dich schon fürs Grab vermessen.</string>
    <string name="banter_gravekeep_tidecaller">Wer ertrinkt, landet früher oder später bei mir.</string>
    <string name="banter_gravekeep_gravekeep">Ich hab dich doch begraben.</string>
    <string name="banter_gravekeep_verdant">Bei mir auch. Das ist ein Problem.</string>
    <string name="banter_gravekeep_clockwright">Die sind nicht kaputt. Die sind im Ruhestand.</string>
    <string name="banter_gravekeep_nightveil">Mich findet jeder. Irgendwann.</string>
    <string name="banter_gravekeep_stonewarden">Der soll sie drinnen halten.</string>
    <string name="banter_gravekeep_tempest">Die Hälfte meiner Bewohner hat dein Blitz getroffen.</string>
    <string name="banter_verdant_emberward">Bitte nicht.</string>
    <string name="banter_verdant_tidecaller">Deine Flut hat meinen Garten versalzen.</string>
    <string name="banter_verdant_gravekeep">Alles, was ich pflanze, kommt wieder hoch.</string>
    <string name="banter_verdant_verdant">Runter von meinem Rasen.</string>
    <string name="banter_verdant_clockwright">Pass auf die Rosen auf.</string>
    <string name="banter_verdant_nightveil">Das kommt auf die Rechnung.</string>
    <string name="banter_verdant_stonewarden">Geht aufs Haus.</string>
    <string name="banter_verdant_tempest">Regen wäre schön.</string>
    <string name="banter_clockwright_emberward">Meine Maschine hat eine Feuerlöschanlage.</string>
    <string name="banter_clockwright_tidecaller">Alles ist wasserdicht.</string>
    <string name="banter_clockwright_gravekeep">Ich könnte deine Toten reparieren.</string>
    <string name="banter_clockwright_verdant">Die Maschine wurde über die Rosen informiert.</string>
    <string name="banter_clockwright_clockwright">Einer von uns ist ein Prototyp.</string>
    <string name="banter_clockwright_nightveil">Dann weißt du ja, dass sie nicht funktionieren.</string>
    <string name="banter_clockwright_stonewarden">Ah. Eine Mauer.</string>
    <string name="banter_clockwright_tempest">Bitte stillhalten, während ich dich vermesse.</string>
    <string name="banter_nightveil_emberward">Genau das ist ja das Problem.</string>
    <string name="banter_nightveil_tidecaller">Das wäre doch nicht nötig gewesen. Wirklich.</string>
    <string name="banter_nightveil_gravekeep">Dich wird niemand finden.</string>
    <string name="banter_nightveil_verdant">Ich hab mich in deiner Hecke versteckt.</string>
    <string name="banter_nightveil_clockwright">Ich hab deine Pläne gesehen.</string>
    <string name="banter_nightveil_nightveil">Ich hab dich gar nicht kommen sehen.</string>
    <string name="banter_nightveil_stonewarden">Ich bin längst auf deiner Seite.</string>
    <string name="banter_nightveil_tempest">Hinter dir. Vorsicht, Blitz.</string>
    <string name="banter_stonewarden_emberward">Stein brennt nicht.</string>
    <string name="banter_stonewarden_tidecaller">Dann bau ich eine neue.</string>
    <string name="banter_stonewarden_gravekeep">Hübscher Zaun.</string>
    <string name="banter_stonewarden_verdant">Ist das Moos auf meiner Mauer?</string>
    <string name="banter_stonewarden_clockwright">Zwei, genau genommen.</string>
    <string name="banter_stonewarden_nightveil">An meiner Mauer kommt keiner vorbei.</string>
    <string name="banter_stonewarden_stonewarden">Das ist meine Mauer.</string>
    <string name="banter_stonewarden_tempest">Nicht die Mauer treffen.</string>
    <string name="banter_tempest_emberward">Feuer und Blitz! Was soll da schon schiefgehen?</string>
    <string name="banter_tempest_tidecaller">Der Sturm ist da!</string>
    <string name="banter_tempest_gravekeep">Nur die Hälfte?</string>
    <string name="banter_tempest_verdant">Regen fällt aus. Blitz findet statt.</string>
    <string name="banter_tempest_clockwright">Wird. Nicht. Passieren.</string>
    <string name="banter_tempest_nightveil">Wo ist sie hin?</string>
    <string name="banter_tempest_stonewarden">Welche?</string>
    <string name="banter_tempest_tempest">Raus aus meinem Himmel.</string>
</resources>
