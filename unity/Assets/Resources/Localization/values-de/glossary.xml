<?xml version="1.0" encoding="utf-8"?>
<!-- Kingdom of Bad Ideas: game vocabulary (de). First pass 2026-10-20, written in-house; review before
     shipping. Every German screen and card reuses these words, so change a term here, not per string.
     Informal "du" throughout. -->
<resources>
    <!-- ===== Keywords ===== -->
    <string name="keyword_bulwark">Bollwerk</string>
    <string name="keyword_bulwark_desc">Feindliche Angriffe müssen zuerst an diesem Diener vorbei.</string>
    <string name="keyword_fervor">Eifer</string>
    <string name="keyword_fervor_desc">Kann im Zug des Ausspielens angreifen, auch den Helden.</string>
    <string name="keyword_skirmish">Scharmützel</string>
    <string name="keyword_skirmish_desc">Kann im Zug des Ausspielens angreifen, aber nicht den feindlichen Helden.</string>
    <string name="keyword_aegis">Ägis</string>
    <string name="keyword_aegis_desc">Fängt den nächsten Treffer vollständig ab und zerbricht dann.</string>
    <string name="keyword_lifedrain">Lebensraub</string>
    <string name="keyword_lifedrain_desc">Verursachter Schaden heilt deinen Helden um denselben Wert.</string>
    <string name="keyword_doublestrike">Doppelschlag</string>
    <string name="keyword_doublestrike_desc">Kann jeden Zug zweimal angreifen.</string>
    <string name="keyword_shroud">Schleier</string>
    <string name="keyword_shroud_desc">Kann nicht angegriffen oder anvisiert werden, bis er angreift.</string>
    <string name="keyword_venom">Gift</string>
    <string name="keyword_venom_desc">Jeder Diener, dem dies Schaden zufügt, wird vernichtet.</string>
    <string name="keyword_arcane_surge">Arkanflut</string>
    <string name="keyword_arcane_surge_desc">Deine Zauber verursachen 1 Schaden mehr. Mehrere Kopien addieren sich.</string>
    <string name="keyword_silence">Stille</string>
    <string name="keyword_silence_desc">Entfernt Kartentext, Schlüsselwörter und Verstärkungen eines Dieners.</string>
    <string name="keyword_frost">Frost</string>
    <string name="keyword_frost_desc">Was hiervon Schaden erleidet, verpasst seinen nächsten Angriff – auch Helden.</string>
    <string name="keyword_backdraft">Rückstau</string>
    <string name="keyword_backdraft_desc">Sperrt so viel deines Manas in deinem nächsten Zug.</string>
    <string name="keyword_drown">Ertränken</string>
    <string name="keyword_drown_imp">Ertränke</string>
    <string name="keyword_drown_desc">Verursacht die Hälfte des Lebens dieses Dieners, aufgerundet – 2 bei einem Helden. Ignoriert Ägis.</string>
    <string name="keyword_rekindle">Neuentfachen</string>
    <string name="keyword_rekindle_desc">Kehrt beim ersten Tod an seinen Platz zurück, mit 1 Leben.</string>
    <string name="keyword_overwhelm">Überwältigen</string>
    <string name="keyword_overwhelm_desc">Überschüssiger Angriffsschaden trifft den feindlichen Helden.</string>
    <string name="keyword_vanguard">Vorhut</string>
    <string name="keyword_vanguard_desc">Erleidet keinen Gegenschaden, wenn sein Angriff den Verteidiger tötet.</string>
