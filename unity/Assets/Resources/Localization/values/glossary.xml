<?xml version="1.0" encoding="utf-8"?>
<!-- Kingdom of Bad Ideas: game vocabulary (en). Translate this file FIRST and fix each term before
     card text is translated: card text, the keyword band, filters and tooltips all reuse these words,
     so a term rendered two ways reads as two different mechanics.
     Keys are read by GameTerms.cs from the engine's enum ids; do not rename a key. -->
<resources>

    <!-- ===== Keywords: name shown on the card's keyword band and in bold inside card text ===== -->
    <!-- Must stay ONE word or a short phrase: it is printed in bold mid-sentence. -->
    <string name="keyword_bulwark">Bulwark</string>
    <string name="keyword_bulwark_desc">Enemy attacks have to go through this minion first.</string>
    <string name="keyword_fervor">Fervor</string>
    <string name="keyword_fervor_desc">Can attack the turn it is played, hero included.</string>
    <string name="keyword_skirmish">Skirmish</string>
    <string name="keyword_skirmish_desc">Can attack the turn it is played, but not the enemy hero.</string>
    <string name="keyword_aegis">Aegis</string>
    <string name="keyword_aegis_desc">Absorbs the next hit completely, then breaks.</string>
    <string name="keyword_lifedrain">Lifedrain</string>
    <string name="keyword_lifedrain_desc">Damage this deals also heals your hero by the same amount.</string>
    <string name="keyword_doublestrike">Doublestrike</string>
    <string name="keyword_doublestrike_desc">Can attack twice each turn.</string>
    <string name="keyword_shroud">Shroud</string>
    <string name="keyword_shroud_desc">Can\'t be attacked or targeted until it attacks.</string>
    <string name="keyword_venom">Venom</string>
    <string name="keyword_venom_desc">Any minion this damages is destroyed.</string>
    <string name="keyword_arcane_surge">Arcane Surge</string>
    <string name="keyword_arcane_surge_desc">Your spells deal 1 more damage. Copies add up.</string>
    <string name="keyword_silence">Silence</string>
    <string name="keyword_silence_desc">Strips a minion\'s text, keywords and buffs.</string>
    <!-- Frost is the keyword; "Freeze" (label_freeze) is the verb a spell uses to apply it. -->
    <string name="keyword_frost">Frost</string>
    <string name="keyword_frost_desc">Whatever this damages misses its next attack — heroes too.</string>
    <string name="keyword_backdraft">Backdraft</string>
    <string name="keyword_backdraft_desc">Locks that much of your mana on your next turn.</string>
    <string name="keyword_drown">Drown</string>
    <string name="keyword_drown_desc">Deals half this minion\'s Health, rounded up — 2 to a hero. Ignores Aegis.</string>
    <string name="keyword_rekindle">Rekindle</string>
    <string name="keyword_rekindle_desc">The first time it dies it returns in place with 1 Health.</string>
    <string name="keyword_overwhelm">Overwhelm</string>
    <string name="keyword_overwhelm_desc">Excess damage from its attack spills onto the enemy hero.</string>
    <string name="keyword_vanguard">Vanguard</string>
    <string name="keyword_vanguard_desc">Takes no damage back when its attack kills the defender.</string>
    <!-- Never shown to a player (a reserved engine slot). Do not translate. -->
    <string name="keyword_reinforce" translatable="false">Reinforce</string>
    <string name="keyword_reinforce_desc" translatable="false">Gives a friendly minion +1/+1.</string>

    <!-- ===== Timing labels and game verbs: printed in bold at the start of card text ===== -->
    <!-- "Toll: Draw a card." means "when this dies, draw a card". -->
    <string name="label_toll">Toll</string>
    <!-- "Attack: ..." means "whenever this attacks, ...". -->
    <string name="label_attack">Attack</string>
    <!-- "Damaged: ..." means "whenever this takes damage, ...". -->
    <string name="label_damaged">Damaged</string>
    <!-- "Healed: ..." means "whenever this minion is healed, ...". -->
    <string name="label_healed">Healed</string>
    <!-- "Turn End: ..." means "at the end of each turn, ...". -->
    <string name="label_turn_end">Turn End</string>
    <!-- "Spell Cast: ..." means "whenever you cast a spell, ...". -->
    <string name="label_spell_cast">Spell Cast</string>
    <!-- "Aura: ..." is an effect that lasts while this card is on the board. -->
    <string name="label_aura">Aura</string>
    <!-- Bring back a minion from the graveyard. -->
    <string name="label_unearth">Unearth</string>
    <!-- Verb: apply Frost to a target. -->
    <string name="label_freeze">Freeze</string>
    <!-- Verb: remove Frost from a target. -->
    <string name="label_unfreeze">Unfreeze</string>

