<?xml version="1.0" encoding="utf-8"?>
<!-- Kingdom of Bad Ideas: game vocabulary (es-419). First pass 2026-11-27, written in-house; review
     before shipping. Every Spanish screen and card reuses these words, so change a term here, not per
     string. Latin-American Spanish: informal "tú", "ustedes" for plural, never "vosotros". -->
<resources>
    <!-- ===== Keywords ===== -->
    <string name="keyword_bulwark">Baluarte</string>
    <string name="keyword_bulwark_desc">Los ataques enemigos tienen que pasar primero por este esbirro.</string>
    <string name="keyword_fervor">Fervor</string>
    <string name="keyword_fervor_desc">Puede atacar en el turno en que se juega, también al héroe.</string>
    <string name="keyword_skirmish">Escaramuza</string>
    <string name="keyword_skirmish_desc">Puede atacar en el turno en que se juega, pero no al héroe enemigo.</string>
    <string name="keyword_aegis">Égida</string>
    <string name="keyword_aegis_desc">Absorbe el siguiente golpe por completo y luego se rompe.</string>
    <string name="keyword_lifedrain">Robo de vida</string>
    <string name="keyword_lifedrain_desc">El daño que inflige también cura a tu héroe en la misma cantidad.</string>
    <string name="keyword_doublestrike">Golpe doble</string>
    <string name="keyword_doublestrike_desc">Puede atacar dos veces por turno.</string>
    <string name="keyword_shroud">Velo</string>
    <string name="keyword_shroud_desc">No puede ser atacado ni elegido como objetivo hasta que ataque.</string>
    <string name="keyword_venom">Veneno</string>
    <string name="keyword_venom_desc">Cualquier esbirro al que dañe queda destruido.</string>
    <string name="keyword_arcane_surge">Oleada arcana</string>
    <string name="keyword_arcane_surge_desc">Tus hechizos infligen 1 de daño más. Las copias se suman.</string>
    <string name="keyword_silence">Silencio</string>
    <string name="keyword_silence_imp">Silencia</string>
    <string name="keyword_silence_desc">Le quita a un esbirro su texto, sus palabras clave y sus mejoras.</string>
    <string name="keyword_frost">Escarcha</string>
    <string name="keyword_frost_desc">Lo que reciba daño de esto pierde su siguiente ataque, héroes incluidos.</string>
    <string name="keyword_backdraft">Contrafuego</string>
    <string name="keyword_backdraft_desc">Bloquea esa cantidad de tu maná en tu siguiente turno.</string>
    <string name="keyword_drown">Ahogar</string>
    <string name="keyword_drown_imp">Ahoga</string>
    <string name="keyword_drown_desc">Inflige la mitad de la Salud de este esbirro, redondeando hacia arriba (2 a un héroe). Ignora la Égida.</string>
    <string name="keyword_rekindle">Reavivar</string>
    <string name="keyword_rekindle_desc">La primera vez que muere, regresa a su lugar con 1 de Salud.</string>
    <string name="keyword_overwhelm">Arrollar</string>
    <string name="keyword_overwhelm_desc">El daño sobrante de su ataque pasa al héroe enemigo.</string>
    <string name="keyword_vanguard">Vanguardia</string>
    <string name="keyword_vanguard_desc">No recibe daño de vuelta cuando su ataque mata al defensor.</string>
