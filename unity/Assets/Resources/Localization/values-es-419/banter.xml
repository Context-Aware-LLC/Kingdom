<?xml version="1.0" encoding="utf-8"?>
<!-- Versus captions (es-419): Spanish captions, first pass 2026-11-27; the audio stays English. -->
<resources>
    <string name="banter_emberward_emberward">Me encanta tu pelo.</string>
    <string name="banter_emberward_tidecaller">Intentaré no hervirte.</string>
    <string name="banter_emberward_gravekeep">¿Es a prueba de fuego?</string>
    <string name="banter_emberward_verdant">Qué lindo jardín.</string>
    <string name="banter_emberward_clockwright">Tenía.</string>
    <string name="banter_emberward_nightveil">Sal, querida. Yo te ilumino el camino.</string>
    <string name="banter_emberward_stonewarden">Averigüémoslo juntos.</string>
    <string name="banter_emberward_tempest">Todo.</string>
    <string name="banter_tidecaller_emberward">Traje toallas.</string>
    <string name="banter_tidecaller_tidecaller">Ay. Subió la marea.</string>
    <string name="banter_tidecaller_gravekeep">De nada.</string>
    <string name="banter_tidecaller_verdant">Lo hace dos veces al día.</string>
    <string name="banter_tidecaller_clockwright">Eso dicen todos.</string>
    <string name="banter_tidecaller_nightveil">Te traje la niebla.</string>
    <string name="banter_tidecaller_stonewarden">El mar desgasta todos los muros.</string>
    <string name="banter_tidecaller_tempest">Límpiate los pies.</string>
    <string name="banter_gravekeep_emberward">Ya te tomé las medidas para la fosa.</string>
    <string name="banter_gravekeep_tidecaller">Todos los ahogados terminan llegando a mí.</string>
    <string name="banter_gravekeep_gravekeep">Juraría que te enterré.</string>
    <string name="banter_gravekeep_verdant">A mí también me pasa. Es un problema.</string>
    <string name="banter_gravekeep_clockwright">No están descompuestos. Están jubilados.</string>
    <string name="banter_gravekeep_nightveil">A mí todos me encuentran. Tarde o temprano.</string>
    <string name="banter_gravekeep_stonewarden">Es para que no se salgan.</string>
    <string name="banter_gravekeep_tempest">A la mitad de mis inquilinos los fulminaste tú.</string>
    <string name="banter_verdant_emberward">Por favor, no.</string>
    <string name="banter_verdant_tidecaller">Tu marea me saló el jardín.</string>
    <string name="banter_verdant_gravekeep">Todo lo que planto vuelve a salir.</string>
    <string name="banter_verdant_verdant">¡Sal de mi césped!</string>
    <string name="banter_verdant_clockwright">Cuidado con las rosas.</string>
    <string name="banter_verdant_nightveil">Eso va en la factura.</string>
    <string name="banter_verdant_stonewarden">Cortesía de la casa.</string>
    <string name="banter_verdant_tempest">Un poco de lluvia no estaría mal.</string>
    <string name="banter_clockwright_emberward">Mi máquina tiene un sistema contra incendios.</string>
    <string name="banter_clockwright_tidecaller">Todo está impermeabilizado.</string>
    <string name="banter_clockwright_gravekeep">Podría arreglar a tus muertos.</string>
    <string name="banter_clockwright_verdant">La máquina ya fue informada sobre las rosas.</string>
    <string name="banter_clockwright_clockwright">Uno de los dos es un prototipo.</string>
    <string name="banter_clockwright_nightveil">Entonces sabes que no funcionan.</string>
    <string name="banter_clockwright_stonewarden">Ah. Un muro.</string>
    <string name="banter_clockwright_tempest">No te muevas mientras te mido, por favor.</string>
    <string name="banter_nightveil_emberward">Ese es justamente el problema.</string>
    <string name="banter_nightveil_tidecaller">No tenías por qué. En serio.</string>
    <string name="banter_nightveil_gravekeep">Nadie te va a encontrar.</string>
    <string name="banter_nightveil_verdant">Me estuve escondiendo en tu seto.</string>
    <string name="banter_nightveil_clockwright">Vi tus planos.</string>
    <string name="banter_nightveil_nightveil">No te vi llegar.</string>
    <string name="banter_nightveil_stonewarden">Ya estoy de tu lado del muro.</string>
    <string name="banter_nightveil_tempest">Detrás de ti. Cuidado con el rayo.</string>
    <string name="banter_stonewarden_emberward">La piedra no arde.</string>
    <string name="banter_stonewarden_tidecaller">Entonces construyo otro.</string>
    <string name="banter_stonewarden_gravekeep">Linda cerca.</string>
    <string name="banter_stonewarden_verdant">¿Eso es musgo en mi muro?</string>
    <string name="banter_stonewarden_clockwright">Dos, de hecho.</string>
    <string name="banter_stonewarden_nightveil">Nadie pasa mi muro.</string>
    <string name="banter_stonewarden_stonewarden">Ese es mi muro.</string>
    <string name="banter_stonewarden_tempest">No le pegues al muro.</string>
    <string name="banter_tempest_emberward">¡Fuego y rayos! ¿Qué podría salir mal?</string>
    <string name="banter_tempest_tidecaller">¡Llegó la tormenta!</string>
    <string name="banter_tempest_gravekeep">¿Solo la mitad?</string>
    <string name="banter_tempest_verdant">Lluvia, cancelada. Rayos, confirmados.</string>
    <string name="banter_tempest_clockwright">Eso. No. Va. A. Pasar.</string>
    <string name="banter_tempest_nightveil">¿A dónde se fue?</string>
    <string name="banter_tempest_stonewarden">¿A cuál?</string>
    <string name="banter_tempest_tempest">Sal de mi cielo.</string>
</resources>
