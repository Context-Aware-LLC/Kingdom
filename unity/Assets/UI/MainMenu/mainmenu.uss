/* UNITS: every "dp" in the comments below that predates 2026-09-01 is a PRE-#349 unit, when
 * the panel ran ConstantPhysicalSize and was 914 x 411. It is 2400 x 1080 authored px now —
 * see the unit block at the top of Common/theme.uss. Those passages are kept because the
 * DECISIONS they record still stand; their arithmetic is history, not a live budget. */

/*
 * mainmenu.uss — S1 front door styles. Consumes tokens from theme.uss only (no literal
 * colors/sizes a token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 *
 * THIS WARNING LIVES HERE BECAUSE UI BUILDER DELETES UXML COMMENTS. Opening
 * MainMenuScreen.uxml in Unity's UI Builder rewrites the file and strips every comment in it
 * — 87 lines of documentation went that way on 2026-07-31, including this warning, which is
 * why it now sits in the stylesheet instead. Unity does not rewrite .uss.
 *
 * NEVER write a BEM modifier's double dash inside a UXML comment. XML forbids that sequence
 * in a comment, so the importer fails the WHOLE file, CloneTree() returns zero children,
 * every Q<>() is null, and NOTHING is logged — the screen is simply empty. Refer to modifier
 * classes in words ("the hidden modifier"), never by writing the literal class name in a
 * comment. `Kingdom/Verify/UXML Integrity` catches it if it happens again.
 */

.main-menu {
    flex-grow: 1;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/MainMenu_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
    /* 24dp each side, not --space-12's 48dp: 96dp of a 411dp landscape panel went to padding
       alone. Edge clearance is NOT this padding's job -- that is .emb-edge on the chrome. */
    padding: var(--space-6);
}

/* Boot state: hidden until MainMenuController.RevealMenu() runs (LoadingOverlay covers frame 0
 * instead). visibility:hidden, NOT display:none: this root is the panel's only top-level
 * element, so display:none here means Yoga never runs a single layout pass on it (unlike a
 * modal, which starts hidden too but sits inside an already-laid-out root) - flipping display
 * back on later leaves worldBound stuck at NaN and nothing ever draws. visibility keeps it in
 * the layout tree (bounds always valid) while still suppressing paint and click-through. */
.mm-root--hidden {
    visibility: hidden;
}

/* Dark scrim over the plate so the wordmark + buttons stay legible (design-system §4.5). */
.mm-scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.42);
}

/* ---------- Command assembly ----------
 * Phase one of the character-led lobby: navigation owns the left third and the right side remains
 * a cinematic stage. A selected character can be added to that stage later without moving any of
 * today's controls. The command field itself stays clear so the backdrop remains the page; the
 * full-material controls provide the mass until the later character-stage art arrives. */
.mm-command {
    position: absolute;
    left: 11%;
    top: 14%;
    bottom: 12%;
    width: 568px;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: center;
    /* The bottom padding reserves the band the dock row occupies (bottom 24 + 160 tall), so
       the centred brand and menu cannot slide under it. Padding does not move the
       dock itself, because it is absolute. Before this, the three-line KINGDOM / of / BAD IDEAS
       wordmark pushed the Leaderboards row about 49px under the vault. */
    padding: 0 0 184px 0;
    background-color: rgba(8, 11, 16, 0);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.36s;
    transition-timing-function: ease-out;
}
.mm-root--entering .mm-command {
    opacity: 0;
    translate: -32px 0;
}

/* ---------- Brand ---------- */
.mm-brand {
    align-items: center;
    /* 24dp, not --space-16's 64dp. 64 was authored when the panel scaled by pixel count and the
       column had far more vertical room; at referenceDpi 160 it was 64 of the 411dp the whole
       screen gets. See the budget note on .mm-menu (#249). */
    margin-bottom: var(--space-8);
}
/* One outlined VectorImage replaces the former three live-text labels. Its 1600:620 viewBox is
 * rendered with contain semantics, so the whole mark remains visible while PanelSettings scales
 * the authored 1080px height to the device. The fixed 568px command column makes the mark 568x220
 * authored px at every supported landscape aspect ratio; only the panel's device scale changes. */
.mm-wordmark-art {
    width: 100%;
    height: 220px;
    flex-shrink: 0;
    background-image: url("/Assets/Art/UI/MainMenu_Wordmark_KingdomOfBadIdeas.svg");
    -unity-background-scale-mode: scale-to-fit;
}
.mm-tagline {
    font-size: var(--type-h2);
    color: rgb(238, 168, 67);
    margin-top: var(--space-2);
    letter-spacing: 3px;
}

/* ---------- Navigation plate ----------
 * The vault is deliberately a different control category from the four-row menu: the plate owns
 * both regions, while the standalone pack fan gives the vault its own silhouette and hit
 * target. Keep it separate from the four standard .mm-button rows. */
.mm-nav-plate {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    padding-top: var(--space-4);
    padding-right: 124px;
    padding-bottom: var(--space-1);
    padding-left: var(--space-4);
    background-color: rgba(8, 11, 16, 0.84);
    background-image: url("/Assets/Art/UI/Chrome/ui_panel_outer_forged.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.55px;
}

/* ---------- Menu column ---------- */
.mm-menu {
    align-items: stretch;
    min-width: 0;
    width: 100%;
    flex-shrink: 0;
}
.mm-button {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    /* Clear, not a fill: the chrome art has rounded corners, and a fill behind it shows as square
     * corners around them (Sam, 2026-09-28). Every state repeats it, as the sign-in buttons do. */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 68px;
    margin-bottom: var(--space-3);
    padding: 0 var(--space-8);
    letter-spacing: 2px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    transition-property: -unity-background-image-tint-color, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.mm-button:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    translate: 5px 0;
}
.mm-button:active {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(192, 198, 207);
    translate: 2px 1px;
}
.mm-button--secondary {
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.62px;
}
.mm-button--cta {
    height: 88px;
    margin-bottom: var(--space-4);
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.72px;
    color: rgb(255, 226, 179);
    font-size: var(--type-h1);
    letter-spacing: 3px;
    -unity-background-image-tint-color: rgb(255, 236, 205);
}
.mm-button--cta:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ---------- First-run collection guide (Sam, 2026-11-04) ----------
 * After a new player's starter packs, MainMenuController.ApplyCollectionGuide dims and disables
 * every destination but Collection, and pulses Collection's brightness until they tap it.
 * Locked controls: one opacity on the dimmed element, and its disabled children are held at full
 * opacity so a theme's own disabled fade does not stack on top and make them vanish. */
.main-menu .mm-guide-locked,
.main-menu .mm-guide-locked:disabled {
    opacity: 0.35;
}
.main-menu .mm-guide-locked .unity-disabled {
    opacity: 1;
}
/* The pulse: the controller flips --guide-bright every 1.1s and this transition eases between the
 * two tints, so the swing is a soft breath rather than a blink. The duration must match
 * GuidePulseHalfMs in MainMenuController. Tint can only darken the art, so "bright" is the art at
 * full value and the trough sits below the menu's resting tint. */
.main-menu .mm-button.mm-button--guide {
    -unity-background-image-tint-color: rgb(170, 175, 182);
    transition-property: -unity-background-image-tint-color, translate;
    transition-duration: 1.1s, 0.12s;
    transition-timing-function: ease-in-out, ease-out;
}
.main-menu .mm-button.mm-button--guide.mm-button--guide-bright {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
/* The same pulse on the vault, whose tint lives on its art child rather than on the button. */
.main-menu .mm-dock-button.mm-button--guide .mm-dock-art {
    -unity-background-image-tint-color: rgb(150, 155, 162);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 1.1s;
    transition-timing-function: ease-in-out;
}
.main-menu .mm-dock-button.mm-button--guide.mm-button--guide-bright .mm-dock-art {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ---------- Starter grant presentation (Sam, 2026-11-04) ----------
 * StarterGiftPresentation stages each granted item on the menu's empty right side, then flies it
 * into the control it lives behind. The 0.35s arrival and 0.65s flight are ArriveMs and FlyMs in
 * that class; change both together. */
.mm-gift-stage {
    position: absolute;
    left: 50%;
    right: 4%;
    top: 18%;
    bottom: 14%;
    align-items: center;
    justify-content: center;
}
.mm-gift-beat {
    align-items: center;
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}
.mm-gift-beat--enter {
    opacity: 0;
    scale: 0.7 0.7;
}
.mm-gift-payload {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 300px;
}
.mm-gift-item {
    width: 220px;
    height: 220px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, scale, opacity;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-cubic;
}
/* Packs: a pack's proportions, overlapped into a fan. */
.mm-gift-item--fanned {
    width: 170px;
    height: 243px;
    margin-left: -56px;
    margin-right: -56px;
    border-radius: var(--space-2);
}
/* The starter cards: the multi-pack reveal's rarity plates (packreveal.uss), sized for this stage.
 * Qualified so it outranks .reveal-list__panel's percentage width. */
.main-menu .mm-gift-piece {
    width: 280px;
    min-height: 140px;
    margin: 0 var(--space-3);
    transition-property: translate, scale, opacity;
    transition-duration: 0.65s;
    transition-timing-function: ease-in-cubic;
}
.mm-gift-icon--shards {
    background-image: url("/Assets/Art/UI/Crafting/Currency/craft-shard-cyan-v1.png");
}
.mm-gift-icon--gold {
    background-image: url("/Assets/Art/UI/Icons/icon_currency_gold.png");
}
/* A pack line with no art yet still reads as a pack. */
.mm-gift-icon--pack {
    background-color: rgb(120, 46, 38);
    border-width: 3px;
    border-color: rgb(214, 170, 92);
}
.mm-gift-amount,
.mm-gift-caption {
    color: var(--ink-1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.mm-gift-amount {
    margin-top: var(--space-4);
    font-size: var(--type-h1);
    color: rgb(255, 226, 179);
}
.mm-gift-caption {
    font-size: var(--type-h2);
    letter-spacing: 2px;
}
.mm-gift-beat--leaving .mm-gift-amount,
.mm-gift-beat--leaving .mm-gift-caption {
    opacity: 0;
}

/* ---------- Dock: Card Vault packs, the Ledger book and the King's crown ----------
 * Each control's art is its silhouette. Keep the transparent edges visible and the 160px height
 * so the reserved navigation band does not move the menu rows. The book sits to the vault's
 * right (Sam, 2026-10-21). */
.mm-dock-row {
    position: absolute;
    left: var(--space-1);
    bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
}
.mm-vault-dock {
    width: 208px;
    align-items: center;
}
.mm-dock-button {
    width: 208px;
    height: 160px;
    min-width: 208px;
    min-height: 160px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    overflow: visible;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.mm-dock-art {
    width: 208px;
    height: 160px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    border-radius: 0;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}
.mm-vault-art {
    background-image: url("/Assets/Art/UI/Chrome/ui_card_vault_packs.png");
}
.mm-ledger-button,
.mm-ledger-art {
    width: 160px;
    min-width: 160px;
}
.mm-ledger-button {
    margin-left: var(--space-4);
}
.mm-ledger-art {
    background-image: url("/Assets/Art/UI/Chrome/ui_ledger_book.png");
}
/* The King of the Week (#421): the crown on its cushion beside the book. Hidden in the markup
 * until GET /king names a King; with none the row is exactly the vault and the book. His epithet
 * and commission are on the sheet the crown opens, not here: over the stage art they
 * could not be read (Sam, 2026-11-03). */
.mm-king-dock {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    margin-left: var(--space-4);
}
.mm-king-button,
.mm-king-art {
    width: 160px;
    min-width: 160px;
}
.mm-king-art {
    background-image: url("/Assets/Art/UI/Chrome/ui_king_crown.png");
}
.mm-dock-button:hover,
.mm-dock-button:focus {
    scale: 1.05 1.05;
}
.mm-dock-button:hover .mm-dock-art,
.mm-dock-button:focus .mm-dock-art {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.mm-dock-button:active {
    scale: 0.98 0.98;
}
.mm-dock-button:active .mm-dock-art {
    -unity-background-image-tint-color: rgb(210, 210, 210);
}
/* Outrank Unity's built-in enabled/hover button fill in every interactive state. */
.main-menu .mm-dock-button.unity-button,
.main-menu .mm-dock-button.unity-button:hover:enabled,
.main-menu .mm-dock-button.unity-button:active:enabled,
.main-menu .mm-dock-button.unity-button:focus,
.main-menu .mm-dock-button.unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
}
.mm-vault-count {
    display: none;
    position: absolute;
    right: 8px;
    top: 0;
    padding: var(--space-1) var(--space-2);
    color: var(--surface-0);
    background-color: var(--accent);
    border-width: 2px;
    border-color: rgb(255, 226, 179);
    border-radius: 999px;
    font-size: var(--type-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- Top status rail ----------
 * Quests and all three wallet balances share one horizontal line. There is deliberately no outer
 * panel: the backdrop remains visible between the translucent quest cards and currency readouts.
 * These offsets are the no-inset fallback; the controller adds Screen.safeArea's normalized
 * top/right inset at runtime while .emb-edge owns the fixed left/right hardware clearance. */
.mm-top-rail {
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    right: var(--space-6);
    min-height: 124px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.36s;
    transition-timing-function: ease-out;
}
.mm-root--entering .mm-top-rail {
    opacity: 0;
    translate: 0 -24px;
}
.mm-quest-strip {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.mm-quest-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
}
.mm-quest-status {
    flex-grow: 1;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    white-space: normal;
}
.mm-quest-status--hidden {
    display: none;
}
.mm-quest-row {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: rgba(12, 16, 22, 0.28);
    border-radius: var(--space-2);
}
.mm-quest-row--complete {
    opacity: 0.78;
}
/* The rail grows to fit the card rather than the card's lines shrinking to fit the rail: a
   two-line quip under a fixed 124px rail squeezed the heading, and the title's overflow clip
   cut it in half (Sam, 2026-10-21). */
.mm-quest-row > * {
    flex-shrink: 0;
}
.mm-quest-row__heading {
    flex-direction: row;
    align-items: center;
}
/* One line, never wrapped (Sam, 2026-10-20): a title that ran long ("Win a match that runs past
   turn 15") wrapped to a second line. The day tag that shared this row is gone, so the title has
   the whole width; an ellipsis is the guard for a title longer than that. */
.mm-quest-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* Further from the title and lighter than --ink-2, which read as too dim to scan
   (Sam, 2026-10-20). */
.mm-quest-quip {
    margin-top: var(--space-2);
    color: rgb(206, 214, 224);
    font-size: var(--type-caption);
    white-space: normal;
}
/* Bar on the left, its count on the right; the reward sits in the heading's right corner. */
.mm-quest-summary {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-2);
}
.mm-quest-detail {
    flex-shrink: 0;
    margin-left: var(--space-3);
    color: var(--ink-2);
    font-size: var(--type-caption);
    -unity-font-style: bold;
}
.mm-quest-row--complete .mm-quest-detail {
    color: var(--positive);
}
.mm-quest-reward {
    flex-direction: row;
    align-items: center;
    margin-left: var(--space-2);
}
.mm-quest-reward__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    background-image: url("/Assets/Art/UI/Icons/icon_currency_gold.png");
    -unity-background-scale-mode: scale-to-fit;
}
.mm-quest-reward__amount {
    margin-left: var(--space-1);
    color: var(--accent);
    font-size: var(--type-caption);
    -unity-font-style: bold;
}
.mm-quest-progress {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 6px;
    background-color: rgba(47, 54, 68, 0.58);
    overflow: hidden;
}
.mm-quest-progress__fill {
    height: 100%;
    background-color: var(--accent);
}
.mm-quest-row--complete .mm-quest-progress__fill {
    background-color: var(--positive);
}

.mm-wallet-strip {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-left: var(--space-3);
}
.mm-wallet-chip {
    min-width: 116px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background-color: rgba(8, 11, 16, 0.34);
    border-bottom-width: 2px;
    border-bottom-color: var(--surface-3);
    border-radius: var(--space-2);
}
/* Play Games achievements (#418). Android only: MainMenuController shows it. It sits in the
 * top rail because the menu column has no room for a fifth row. A wallet chip's shape, with its
 * own clear fill so the theme's button chrome does not draw behind it. */
.mm-achievements {
    height: 64px;
    margin: 0 0 0 var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-image: none;
    background-color: rgba(8, 11, 16, 0.34);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(1, 135, 95);
    border-radius: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
}
.mm-achievements:hover {
    background-color: rgba(8, 11, 16, 0.5);
}
.mm-achievements:active {
    background-color: rgba(8, 11, 16, 0.64);
}
.mm-wallet-chip--gold {
    border-bottom-color: var(--accent);
}
.mm-wallet-chip--gems {
    border-bottom-color: var(--mana);
}
.mm-wallet-chip--shards {
    border-bottom-color: rgb(58, 201, 219);
}
.mm-wallet-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.mm-wallet-icon--gold {
    background-image: url("/Assets/Art/UI/Icons/icon_currency_gold.png");
}
.mm-wallet-icon--gems {
    background-image: url("/Assets/Art/UI/Icons/icon_currency_gems.png");
}
.mm-wallet-icon--shards {
    background-image: url("/Assets/Art/UI/Crafting/Currency/craft-shard-cyan-v1.png");
}
.mm-wallet-amount {
    margin-left: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* ---------- Modals ----------
 * Full-screen backdrop + a centred panel. The backdrop is opaque enough to read as modal and
 * picks up clicks itself (UI Toolkit will not block the menu underneath otherwise).
 */
.mm-modal {
    position: absolute;
    /* These four are not decoration. Without them the backdrop shrink-wraps its panel and sits at
       its STATIC position, so it stops covering the menu AND the two modals stack on each other at
       the same spot instead of each filling the screen in turn. Measured 2026-08-23. */
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 19, 0.78);
    /* The modal's own vertical gutter, and the ONLY thing holding a panel off the top and bottom
     * edges: `.emb-bleed` on this element spends --edge-safe left and right only, because the
     * camera cutout is on a SIDE in landscape and the top and bottom measure zero (the derivation
     * is on --edge-safe in theme.uss). 16 rather than the 52 that used to arrive here by accident
     * is worth 72dp of panel to `.mm-modal__panel`'s `max-height: 100%` — the leaderboard needed
     * a modifier of its own to claw that back, and the sign-in name step overflowed its 307dp box
     * by 51dp without it.
     *
     * LONGHANDS, not the `padding` shorthand. The shorthand would replace the horizontal clearance
     * too, and that is the exact defeat `tooling/scripts/audit_edge_safety.py` PASS 6 exists to
     * fail — a rule on this element outranking .emb-bleed on the same property, silently. */
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
}
.mm-modal--hidden {
    display: none;
}
.mm-modal__panel {
    width: 520px;
    max-width: 90%;
    /* The panel may never be taller than the screen it is centred in. A flex child that overflows a
       justify-content:center parent overflows EQUALLY at both ends, so the first field goes off the
       TOP edge with no way to reach it — that is what hid the sign-in email field. */
    max-height: 100%;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-3);
    padding: var(--space-8);
}
.mm-modal__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    white-space: normal;
}
.mm-modal__help {
    font-size: var(--type-caption);
    color: var(--ink-2);
    white-space: normal;
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
}
.mm-modal__field {
    font-size: var(--type-h2);
    margin-bottom: var(--space-2);
}
.mm-modal__field > .unity-base-text-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    padding: var(--space-3);
    color: var(--ink-1);
    /* The caret defaults to black when unset, invisible against this near-black background —
       a focused field looked unresponsive with nothing wrong functionally. */
    --unity-cursor-color: var(--ink-1);
}
.mm-modal__dropdown {
    margin-bottom: var(--space-2);
}
.mm-modal__dropdown .unity-base-field__label {
    color: var(--ink-2);
    font-size: var(--type-label);
    min-width: 96px;
}
.mm-modal__dropdown .unity-base-popup-field__input {
    background-color: var(--surface-0);
    border-color: var(--surface-3);
    border-radius: var(--space-1);
    color: var(--ink-1);
}
/* The selected class is permanent player-facing data; style its text directly instead of depending
 * on the popup input's inherited color. */
.mm-modal__dropdown .unity-base-popup-field__text {
    color: var(--ink-1);
}
/* Reserves its line whether or not there is an error, so confirming does not shift the buttons. */
.mm-modal__error {
    font-size: var(--type-caption);
    color: var(--negative);
    white-space: normal;
    min-height: 18px;
    margin-bottom: var(--space-4);
}
.mm-modal__actions {
    flex-direction: row;
    justify-content: flex-end;
}
/* Geometry and type only; chrome is theme.uss's `.unity-button` / `.emb-primary`. */
.mm-modal__button {
    font-size: var(--type-label);
    height: var(--touch-min);
    padding: 0 var(--space-6);
    margin-left: var(--space-2);
}

/* ---------- Ranked ladder, the King's Favor and the Succession Roll ----------
 * Three boards in one modal (#421). The tab row belongs to the tabs alone, and Close sits bottom
 * left in the footer (Sam, 2026-11-03): with Close beside them, every title ellipsized in this
 * panel, and a full-screen page was too much. */
.mm-leaderboard {
    width: 1200px;
    max-width: 100%;
    height: 100%;
    padding: var(--space-6);
    border-color: rgba(240, 166, 60, 0.55);
}
.mm-leaderboard__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-4);
}
.mm-leaderboard__tabs {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
}
/* A tab is the board's name and its selector at once, copied from .shop-tab (shop.uss), at its
 * --type-h2: --on is CONTRAST plus the underline and never changes geometry, so switching boards
 * cannot reflow the header. A tab is as wide as its title and never shrinks: the three titles
 * measure about 770 of the row's 1152. The ellipsis stays as the backstop for a translation that
 * still runs long, never a wrap. */
.mm-leaderboard__tab {
    flex-shrink: 0;
    min-height: var(--touch-min);
    padding: 0 var(--space-6);
    margin: 0;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: var(--ink-2);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    transition-property: color, border-bottom-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.mm-leaderboard__tab:hover {
    color: var(--ink-1);
}
.mm-leaderboard__tab--on {
    color: var(--ink-1);
    border-bottom-color: var(--accent);
}
/* Close bottom left, the footer note beside it. */
.mm-leaderboard__footer {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-4);
}
.mm-leaderboard__close {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: var(--space-6);
}
.mm-leaderboard__columns--hidden {
    display: none;
}
.mm-leaderboard__columns,
.mm-leaderboard__row {
    flex-direction: row;
    align-items: center;
}
.mm-leaderboard__columns {
    min-height: 30px;
    color: var(--ink-2);
    font-size: var(--type-caption);
    -unity-font-style: bold;
    padding: 0 var(--space-3);
}
.mm-leaderboard__list {
    flex-grow: 1;
    flex-shrink: 1;
}
.mm-leaderboard__row {
    min-height: var(--touch-min);
    background-color: var(--surface-2);
    border-bottom-width: 1px;
    border-color: var(--surface-3);
    padding: 0 var(--space-3);
}
.mm-leaderboard__row--even {
    background-color: rgba(30, 37, 48, 0.72);
}
.mm-leaderboard__row--podium {
    border-left-width: 3px;
    border-left-color: var(--accent);
}
.mm-leaderboard__rank {
    width: 64px;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
}
/* A player's name: PEER-AUTHORED. Clipped in PIXELS here and drawn with rich text off where the
 * row is built (MainMenuController.NameLabelFor), the pair security.md sets, as .fr-row__name. */
.mm-leaderboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-font-style: bold;
}
.mm-leaderboard__rating,
.mm-leaderboard__score {
    width: 100px;
    color: var(--accent);
    font-size: var(--type-body);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
.mm-leaderboard__record {
    width: 150px;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-right;
}
/* The Succession Roll: reign, Favorite, and the King in two lines, his epithet over his fate. The
 * row grows to hold both lines; the King takes more of the width than the name, because an epithet
 * runs to fifty characters and a name to twenty. */
.mm-leaderboard__row--roll {
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
}
.mm-leaderboard__reign {
    width: 120px;
    flex-shrink: 0;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-font-style: bold;
}
.mm-leaderboard__row--roll .mm-leaderboard__name,
#roll-columns .mm-leaderboard__name {
    flex-basis: 0;
}
.mm-leaderboard__name--none {
    color: var(--ink-2);
    -unity-font-style: italic;
    font-size: var(--type-label);
}
.mm-leaderboard__king {
    flex-grow: 1.6;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    padding-left: var(--space-4);
}
.mm-leaderboard__epithet,
.mm-leaderboard__fate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.mm-leaderboard__epithet {
    color: var(--ink-1);
    font-size: var(--type-label);
}
.mm-leaderboard__fate {
    color: var(--ink-2);
    font-size: var(--type-caption);
}
.mm-leaderboard__status {
    flex-grow: 1;
    justify-content: center;
    color: var(--ink-2);
    font-size: var(--type-body);
    -unity-text-align: middle-center;
    white-space: normal;
}
.mm-leaderboard__status--error {
    color: var(--negative);
}
.mm-leaderboard__status--hidden {
    display: none;
}
/* Your own place on the Favor board, pinned under the list when you are off it. Holds one row
 * built like the list's; the accent rule sets it apart from the hundred above. */
.mm-leaderboard__me {
    border-top-width: 2px;
    border-top-color: var(--accent);
}
.mm-leaderboard__me--hidden {
    display: none;
}
.mm-leaderboard__updated {
    flex-shrink: 1;
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--type-caption);
}

/* ---------- Update gate (UpdateGateOverlay: waiting, update required, unreachable) ---------- */
/* A painted scene, not a dim over the menu (Sam, 2026-11-02). A dialog you can see the menu through
 * reads as something you could dismiss to get back to it; this one cannot be dismissed, and looking
 * dismissible is what would make a player hunt for the close button that is not there. The backdrop
 * hides the menu completely, and the panel goes translucent so the scene reads through it. */
.mm-modal--gate {
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/UpdateGate_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}
.mm-modal--gate .mm-modal__panel {
    background-color: rgba(11, 14, 19, 0.78);
    border-color: rgba(240, 138, 60, 0.35);
}
/* Near white and a size up from the blocking modal's body, for the same reason as the sign-in
 * screen's loose text (Sam, 2026-11-02): ink-2 was illegible over the painted scene. Two classes on
 * the root, because the .mm-modal--blocking rules below set the help's size and come later. */
.mm-modal--gate .mm-modal__title {
    color: rgb(255, 255, 255);
}
.mm-modal--blocking.mm-modal--gate .mm-modal__help {
    color: rgb(255, 250, 240);
    font-size: var(--type-h2);
}
/* The waiting state's burning crown: a three-frame strip, one frame wide, so the image is 300% of
 * the box and UpdateGateOverlay steps background-position-x through 0%, 50% and 100%. */
.mm-gate__fuse {
    width: 220px;
    height: 220px;
    align-self: center;
    margin-bottom: var(--space-4);
    background-image: url("/Assets/Art/UI/Loading/crown_logo_long_fuse_burn_3frame.png");
    background-size: 300% 100%;
    background-repeat: no-repeat;
}

/* ---------- Blocking modal: failed boot and forced update (ConnectionFailedScreen.uxml) ----------
 * The whole screen is this panel and one decision, read on a phone, so it takes the top of the
 * type scale and a button several times the touch floor. The base .mm-modal__* size is a dialog
 * opened over a menu; scoped here so rename and accounts keep it. */
.mm-modal--blocking .mm-modal__panel {
    width: 960px;
    padding: var(--space-12);
}
.mm-modal--blocking .mm-modal__title {
    font-size: var(--type-display);
    -unity-text-align: middle-center;
}
.mm-modal--blocking .mm-modal__help {
    font-size: var(--type-body);
    -unity-text-align: middle-center;
    margin-top: var(--space-4);
    margin-bottom: var(--space-12);
}
/* Equal shares of the row, so the forced update's single button spans the panel and the failed
 * boot's two split it. */
.mm-modal--blocking .mm-modal__button {
    flex-grow: 1;
    flex-basis: 0;
    height: 128px;
    margin: 0 var(--space-2);
    font-size: var(--type-h2);
}

/* ---------- First-login sizing (NOR-283, extended NOR-284) ----------
 * Every rule below is scoped to .mm-modal--onboard on purpose. It marks a modal that IS the first
 * launch — the sign-in gate, and the name/password prompt that follows it — on a phone held at arm's
 * length. The ordinary modals (rename, accounts) are things a player opens on top of a menu they can
 * already read, so they must NOT carry this class: they keep the compact base .mm-modal__* size.
 *
 * The gate always onboards, so it gets the class in the UXML. The name modal is REUSED for later
 * renames, so it gets the class only for the required (first-run) state — MainMenuController toggles
 * it in OpenNameModal. Both first-login modals were inheriting a 520px box with 13px help text built
 * for a desktop monitor; on a handset that reads as a small floating dialog on an empty screen rather
 * than the screen itself.
 *
 * Sized in percentages, not pixels: the box should be a fraction of whatever canvas it lands on,
 * which is the one thing a fixed pixel width cannot be. That is still true and is independent of
 * how the panel scales — do not turn these back into pixels.
 * Do not fold these values back into .mm-modal__* — that would resize the rename and account modals.
 */
.mm-modal--onboard .mm-modal__panel {
    width: 72%;
    min-width: 480px;
    max-width: 92%;
    /* HEIGHT is the scarce axis here, not width. The panels are ConstantPhysicalSize at
       referenceDpi 160, so a 1080-tall landscape handset gives roughly 414dp of panel height, and
       the email step stacks title, help, field, error, actions, "or" and the Google button into it.
       48dp of padding at each end spent a quarter of that budget on nothing. Vertical padding is
       --space-6; the horizontal stays --space-12, where there is room to spare. */
    padding: var(--space-6) var(--space-12);
    border-radius: var(--space-4);
}
/* TYPOGRAPHY IS DELIBERATELY ABSENT HERE, and its absence is the fix.
 * Until 2026-08-23 this block also set a 46px title, 26px help, 30px fields, 24px errors and 28px
 * buttons. Those were authored when the panels scaled to a 1920x1080 REFERENCE RESOLUTION, which on
 * a handset delivered every base size at roughly half a millimetre; the overrides were the only
 * thing making the gate readable. The panels are ConstantPhysicalSize at referenceDpi 160 now, so an
 * authored pixel is one Android dp and the base .mm-modal__* scale arrives at the size it claims.
 * Kept, the overrides multiplied a real scale a second time and the gate overflowed the screen.
 * Add a size here only for a reason that survives that sentence. */

/* Touch target, not a pointer target — the one size that does still need saying. The base 44px is a
 * mouse height; Android's floor for a finger is 48dp, which at referenceDpi 160 is 48px. */
.mm-modal--onboard .mm-modal__button {
    height: 48px;
}
/* ---------- Pitch / form columns ----------
 * A COLUMN BY DEFAULT. Both first-login modals wrap their contents in .mm-modal__columns, and in
 * the ordinary (rename, account) case that wrapper does nothing at all — a 520px dialog has no
 * width to give away, and two 236px columns would wrap the title onto three lines.
 */
.mm-modal__columns {
    flex-direction: column;
}
.mm-modal__pitch,
.mm-modal__form {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* A ROW only when the modal IS the first login. Landscape is wide and short, and these two modals
 * are the only ones that have to fit a whole flow into it.
 *
 * Measured on the Pixel-class emulator 2026-08-23 (1080x2400 at density 420 = a 914x411dp panel
 * canvas). As one column BOTH overflowed and BOTH lost the control that ends the step:
 *   - the gate put "or" and the Google button below the fold;
 *   - the name modal clipped the second password field and pushed Continue off the screen
 *     entirely, with no scroll to reach it. That one was a dead end, not a cosmetic problem.
 * In both cases the right half of the panel was empty space beside a two-line help paragraph.
 * Splitting the pitch from the form spends the axis that had room: the gate lands near 276dp and
 * the name modal near 358dp, against 411 available.
 */
.mm-modal--onboard .mm-modal__columns,
.account-create-screen .mm-modal__columns {
    flex-direction: row;
    align-items: flex-start;
}
.mm-modal--onboard .mm-modal__pitch,
.account-create-screen .mm-modal__pitch {
    padding-right: var(--space-8);
}
/* 24dp under every help paragraph was a desktop rhythm. The name modal carries TWO of them and
 * needs the 24 back. */
.mm-modal--onboard .mm-modal__help,
.account-create-screen .mm-modal__help {
    margin-bottom: var(--space-3);
}

/* The code is six characters the player is copying by eye off another screen. Wide tracking and a
 * larger face is the difference between reading it back once and reading it back three times.
 * Must come after .mm-modal__field, which the code field also carries: equal specificity, so this
 * rule wins only by being later in the file. Keep it below the modal block. */
.mm-signin__code {
    font-size: var(--type-h1);
    letter-spacing: 8px;
    -unity-text-align: middle-center;
}
.mm-signin__code > .unity-base-text-field__input {
    -unity-text-align: middle-center;
}
/* A text link, not a third button: resending is a recovery, and giving it a button's weight puts it
 * in competition with the thing the player should actually be doing. */
.mm-signin__resend {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    color: var(--ink-2);
    font-size: var(--type-caption);              /* 14dp. Below the 16dp .mm-modal__button so the
                                                  * recovery reads as subordinate to the CTA. Was a
                                                  * bare 24px from the old reference-resolution
                                                  * scale, which made it the LARGEST text in the
                                                  * step. */
    align-self: flex-end;
    padding: var(--space-4) 0 0 0;
    margin-top: var(--space-2);
}
.mm-signin__resend:hover {
    color: var(--ink-1);
}
.mm-signin__resend:disabled {
    color: var(--surface-3);
}
/* A separator label between two buttons, so it sits ON the button's own size (--type-label) and
 * separates by colour and weight instead — --ink-2 and unbold against the CTA's --ink-1 bold. */
.mm-signin__or {
    color: var(--ink-2);
    font-size: var(--type-label);
    align-self: center;
    padding: var(--space-4) 0 var(--space-2) 0;
}
.mm-signin__google {
    align-self: stretch;
    justify-content: center;
    margin-left: 0;
}

/* ---------- Footer ----------
 * Bottom-left (Sam, 2026-08-09): the in-match settings gear (.ms-gear, settings.uss) lives
 * bottom-right, and MainMenuController now mounts that same overlay over this screen so Settings
 * is reachable from the menu too. The version label moved out of that corner to make room for it,
 * rather than the two ever sharing a slot.
 */
.mm-footer {
    position: absolute;
    bottom: var(--space-6);                      /* clearance is .emb-edge's, not this rule's */
    left: var(--space-6);
}
.mm-version {
    font-size: var(--type-caption);              /* 14dp. Was --type-label to survive the old scale. */
    color: var(--ink-2);
}

/* ---------- Account creation, as a SCREEN (Sam, 2026-08-25) ----------
 * The sign-in gate and the name step were two .mm-modal overlays here until then. This root
 * replaces .mm-modal AND .mm-modal__panel: there is no backdrop to draw and nothing to centre a
 * 520px dialog inside, because the root IS the panel.
 *
 * WHY THE ROW TREATMENT ABOVE WAS NOT ALREADY ENOUGH. Its comment budgets the flow "against 411
 * available", and that number is wrong: both modals carried .emb-bleed — padding: var(--edge-safe),
 * 52dp PER EDGE — when it was written, so the real box was 411 - 104 = 307dp. The gate's 276dp
 * fitted with 31 to spare; the name step's 358dp overflowed by 51, and the name step is the one
 * with no way past it. On top of that .mm-modal__panel spent another var(--space-8) per edge
 * INSIDE that box. Re-hosting is the fix precisely because the nesting was the problem: one
 * clearance (.emb-bleed on this root, in the UXML) and no second padding inside it.
 *
 * flex-grow: 1 is the same load-bearing declaration .character-create-screen documents at length:
 * without it a scene root sizes to CONTENT and everything below it resolves to nothing.
 *
 * RETIREMENT TRIGGER: if the sign-in gate ever becomes skippable — it is unskippable by Sam's
 * 2026-08-08 ruling — this stops being a whole screen and the .mm-modal rules above come back
 * into play. Neither this block nor AccountCreateController survives that change unread. */
/* TOP-JUSTIFIED, NOT CENTRED (Sam, 2026-08-30). Both views carry a text field, so the IME is open
 * on this screen more often than not, and on the Pixel 5a its top edge sits at about 29% of the
 * panel height -- centring spends the free height putting content UNDER the keyboard. Everything
 * that has to be read while typing belongs in that top band.
 *
 * Measured as "119dp of the 411dp panel" and restated as a FRACTION on 2026-09-04, because the
 * panel stopped being sized in dp on 2026-09-01 (see the block at the top of theme.uss) and this
 * is a live justification, not a record. 29% of today's 1080 authored px is about 313. The ratio
 * is what the argument rests on and it survives the next unit change too.
 *
 * BOTH rules, and the inner one is the one that mattered: the views are flex-grow: 1 so they fill
 * the root either way, which means the root's own justify-content had nothing left to distribute
 * and changing it alone would have moved nothing. */
.account-create-screen {
    flex-grow: 1;
    background-color: var(--surface-1);
    color: var(--ink-1);
    justify-content: flex-start;
}
.account-create-screen #signin-view,
.account-create-screen #name-view {
    flex-grow: 1;
    justify-content: flex-start;
}

/* THE TWO ROWS. Row 1 is the question and the answer -- prompt, field, CTA. Row 2 is everything
 * secondary, laid out horizontally rather than stacked, because the panel has ~119dp above the
 * keyboard and width to spare. `.mm-modal__error` keeps a min-height, so it holds its line whether
 * or not there is a message and the row above never shifts when one appears. */
.account-create-screen .mm-row {
    flex-direction: row;
    align-items: flex-start;
}
.account-create-screen .mm-row--secondary {
    align-items: center;
    margin-top: var(--space-2);
}
/* These carry --space-6 of bottom margin from the shared modal rules, which is a desktop rhythm and
 * pure cost here: the help sits BESIDE its field now, not above it, and this screen is fighting for
 * every dp above the IME. */
.account-create-screen .mm-modal__help,
.account-create-screen .mm-modal__error {
    margin-bottom: 0;
}
.account-create-screen .mm-row--secondary > * {
    margin-right: var(--space-3);
}
/* The name step's error, on its own line under row 2 so it wraps instead of running off the edge. */
.account-create-screen .mm-name-error {
    white-space: normal;
    margin-top: var(--space-2);
}

/* ---------- Sign-in restyle (Sam, 2026-09-28) ----------
 * The Kingdom of Bad Ideas pass: a painted backdrop, a dark plate that keeps the form legible over
 * it, larger type, and chrome buttons. The layout is unchanged: still two rows, still pinned to
 * the top above the IME (see the TOP-JUSTIFIED note above).
 *
 * TYPE SIZES ARE LOCAL, NOT TOKENS, ON PURPOSE. The shared type scale is authored against the
 * 1080 px panel, where 18 px is about 7 dp on a phone. Sam judged everything below the title too
 * small to read, so this screen sets its own sizes rather than moving the scale under every screen.
 *
 * Buttons: slate by default, ember for the one call to action on screen. That is Google while it is
 * visible, "Sign in" on the code step (SignInGateController toggles the ember modifier there), and
 * Continue on the name step. */
.account-create-screen {
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/Login_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
}
/* The plate hugs its content (flex-grow 0) so the backdrop shows below it. 0.6 is where Sam
 * judged the text legible (2026-11-02, stepped up from 0.5), and the plate is still partly clear,
 * so the loose text below carries a shadow to stay legible over the bright backdrop. */
.account-create-screen #signin-view,
.account-create-screen #name-view {
    flex-grow: 0;
    background-color: rgba(11, 14, 19, 0.6);
    border-width: 2px;
    border-color: rgba(240, 138, 60, 0.35);
    border-radius: 18px;
    padding: var(--space-6) var(--space-8);
}
.account-create-screen .mm-modal__help {
    font-size: 30px;
}
.account-create-screen .mm-modal__title,
.account-create-screen .mm-modal__help,
.account-create-screen .mm-modal__error,
.account-create-screen .mm-signin__or,
.account-create-screen .mm-signin__resend {
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}
.account-create-screen .mm-modal__error {
    font-size: 26px;
}
/* EVERY LOOSE LINE IS NEAR WHITE (Sam, 2026-11-02): anything not in a field or on a button sits
 * on the bright backdrop through a half-clear plate, and the theme's ink-2 grey and the deep
 * negative red were illegible there. The error keeps its hue, lifted. */
.account-create-screen .mm-modal__title {
    color: rgb(255, 255, 255);
}
.account-create-screen .mm-modal__help {
    color: rgb(255, 250, 240);
}
.account-create-screen .mm-signin__or,
.account-create-screen .mm-signin__resend {
    color: rgb(255, 244, 226);
}
.account-create-screen .mm-signin__resend:hover {
    color: rgb(255, 255, 255);
}
.account-create-screen .mm-modal__error {
    color: rgb(255, 150, 140);
}
.account-create-screen .mm-modal__field {
    font-size: 34px;
}
.account-create-screen .mm-modal__field > .unity-base-text-field__input {
    min-height: 76px;
    padding: 12px 20px;
    background-color: rgba(8, 11, 16, 0.92);
    border-width: 2px;
    border-color: rgba(239, 228, 207, 0.22);
    border-radius: 10px;
}
.account-create-screen .mm-modal__field:focus > .unity-base-text-field__input {
    border-color: rgb(240, 138, 60);
}
/* The helper text inside an empty field. Unity adds this modifier while the placeholder shows. */
.account-create-screen .unity-base-text-field__input--placeholder {
    color: rgba(169, 177, 187, 0.85);
}
.account-create-screen .mm-signin__code {
    font-size: 44px;
}
.account-create-screen .mm-signin__resend {
    font-size: 26px;
}
.account-create-screen .mm-signin__or {
    font-size: 28px;
}
.account-create-screen .signin-btn {
    height: 96px;
    min-width: 260px;
    padding: 0 var(--space-8);
    margin-left: var(--space-3);
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(236, 231, 220);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.8px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    transition-property: -unity-background-image-tint-color, translate, opacity;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.account-create-screen .signin-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.account-create-screen .signin-btn:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(192, 198, 207);
}
.account-create-screen .signin-btn:disabled {
    opacity: 0.45;
}
.account-create-screen .signin-btn--ember {
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    color: rgb(255, 226, 179);
    -unity-background-image-tint-color: rgb(255, 236, 205);
}
.account-create-screen .mm-signin__google {
    min-width: 440px;
    margin-left: var(--space-3);
}

/* The sign-in view as a centred stack (Sam, 2026-09-28): header, field row, then one line that
 * reads "Skip the paperwork and [Google] or [I have an account] I Jest! [I am new here]". The name view
 * still uses the two-row layout above. */
.account-create-screen .signin-stack {
    align-items: center;
}
.account-create-screen .signin-header {
    align-items: center;
}
.account-create-screen .signin-header > .mm-modal__title,
.account-create-screen .signin-header > .mm-modal__help {
    -unity-text-align: upper-center;
    max-width: 1500px;
}
.account-create-screen .signin-line {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-3);
}
.account-create-screen .signin-choice {
    margin-top: 0;
}
.account-create-screen .signin-field {
    width: 620px;
    margin-bottom: 0;
    margin-left: var(--space-3);
}
.account-create-screen .signin-line > .mm-signin__code {
    width: 360px;
    margin-bottom: 0;
}
.account-create-screen .signin-line .mm-signin__or {
    align-self: center;
    padding: 0;
    margin: 0 var(--space-2) 0 var(--space-3);
}
.account-create-screen .signin-line > .mm-signin__resend {
    align-self: center;
    padding: 0;
    margin: 0 var(--space-3);
}
