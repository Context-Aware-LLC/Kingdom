<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/MainMenu/mainmenu.uss?fileID=7433441132597879392&amp;guid=a7ebbdf5907b4c844915adc374612cc8&amp;type=3#mainmenu"/>
    <Style src="project://database/Assets/UI/Common/tidbit.uss?fileID=7433441132597879392&amp;guid=59a3d1cad3c148f488a43eafde7ad1ee&amp;type=3#tidbit"/>
    <ui:VisualElement name="root" class="emb-root main-menu mm-root--hidden mm-root--entering">
        <ui:VisualElement name="scrim" picking-mode="Ignore" class="mm-scrim emb-bleed" style="background-image: none;"/>
        <ui:VisualElement name="top-rail" class="mm-top-rail emb-edge">
            <ui:VisualElement name="quest-strip" class="mm-quest-strip">
                <ui:Label name="quest-status" text="Loading quests…" class="mm-quest-status"/>
                <ui:VisualElement name="quest-list" class="mm-quest-list"/>
            </ui:VisualElement>
            <ui:VisualElement name="wallet-strip" class="mm-wallet-strip">
                <ui:Button name="btn-achievements" text="Achievements" tooltip="Play Games achievements" class="mm-achievements" style="display: none;"/>
                <ui:VisualElement name="gold-wallet" tooltip="Gold" class="mm-wallet-chip mm-wallet-chip--gold">
                    <ui:VisualElement picking-mode="Ignore" class="mm-wallet-icon mm-wallet-icon--gold"/>
                    <ui:Label name="gold-balance" text="0" picking-mode="Ignore" class="mm-wallet-amount"/>
                </ui:VisualElement>
                <ui:VisualElement name="gem-wallet" tooltip="Gems" class="mm-wallet-chip mm-wallet-chip--gems">
                    <ui:VisualElement picking-mode="Ignore" class="mm-wallet-icon mm-wallet-icon--gems"/>
                    <ui:Label name="gem-balance" text="0" picking-mode="Ignore" class="mm-wallet-amount"/>
                </ui:VisualElement>
                <ui:VisualElement name="shard-wallet" tooltip="Shards" class="mm-wallet-chip mm-wallet-chip--shards">
                    <ui:VisualElement picking-mode="Ignore" class="mm-wallet-icon mm-wallet-icon--shards"/>
                    <ui:Label name="shard-balance" text="0" picking-mode="Ignore" class="mm-wallet-amount"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="command" class="mm-command emb-edge">
            <ui:VisualElement name="brand" class="mm-brand">
                <ui:VisualElement name="wordmark" tooltip="Kingdom of Bad Ideas" picking-mode="Ignore" class="mm-wordmark-art"/>
            </ui:VisualElement>
            <ui:VisualElement name="menu" class="mm-menu">
                <ui:Button name="btn-find-game" text="Find Game" class="mm-button mm-button--cta"/>
                <ui:Button name="btn-collection" text="Collection" class="mm-button mm-button--secondary"/>
                <ui:Button name="btn-store" text="Store" class="mm-button mm-button--secondary"/>
                <ui:Button name="btn-leaderboards" text="Leaderboards" class="mm-button mm-button--secondary"/>
            </ui:VisualElement>
            <ui:VisualElement name="dock-row" class="mm-dock-row">
                <ui:VisualElement name="vault-dock" class="mm-vault-dock">
                    <ui:Button name="btn-card-vault" text="" tooltip="Open Card Vault" class="mm-dock-button">
                        <ui:VisualElement picking-mode="Ignore" class="mm-dock-art mm-vault-art"/>
                    </ui:Button>
                    <ui:Label name="vault-pack-count" text="" picking-mode="Ignore" class="mm-vault-count"/>
                </ui:VisualElement>
                <ui:Button name="btn-ledger" text="" tooltip="Open the Ledger" class="mm-dock-button mm-ledger-button">
                    <ui:VisualElement picking-mode="Ignore" class="mm-dock-art mm-ledger-art"/>
                </ui:Button>
                <ui:VisualElement name="king-dock" class="mm-king-dock" style="display: none;">
                    <ui:Button name="btn-king" text="" tooltip="Read His Majesty's commission" class="mm-dock-button mm-king-button">
                        <ui:VisualElement picking-mode="Ignore" class="mm-dock-art mm-king-art"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="mm-footer emb-edge">
            <ui:Label name="version-label" text="—" class="mm-version"/>
        </ui:VisualElement>
        <ui:VisualElement name="leaderboard-modal" class="mm-modal mm-modal--board mm-modal--hidden emb-bleed">
            <ui:VisualElement class="mm-modal__panel mm-leaderboard">
                <!-- THE TABS ARE THE BOARD TITLES, as in ShopScreen.uxml. The Favor and Roll tabs stay
                     hidden until a King is read (MainMenuController.ShowKingAsync), like king-dock. -->
                <ui:VisualElement class="mm-leaderboard__header">
                    <ui:VisualElement class="mm-leaderboard__tabs">
                        <ui:Button name="leaderboard-tab-ladder" text="Ladder" class="mm-leaderboard__tab mm-leaderboard__tab--on"/>
                        <ui:Button name="leaderboard-tab-favor" text="King's Favorites" class="mm-leaderboard__tab" style="display: none;"/>
                        <ui:Button name="leaderboard-tab-roll" text="The Succession Roll" class="mm-leaderboard__tab" style="display: none;"/>
                    </ui:VisualElement>
                    <ui:Button name="btn-leaderboard-close" text="Close" class="mm-modal__button mm-leaderboard__close"/>
                </ui:VisualElement>
                <ui:VisualElement name="leaderboard-columns" class="mm-leaderboard__columns">
                    <ui:Label text="RANK" class="mm-leaderboard__rank"/>
                    <ui:Label text="PLAYER" class="mm-leaderboard__name"/>
                    <ui:Label text="RATING" class="mm-leaderboard__rating"/>
                    <ui:Label text="W — L — D" class="mm-leaderboard__record"/>
                </ui:VisualElement>
                <ui:VisualElement name="favor-columns" class="mm-leaderboard__columns mm-leaderboard__columns--hidden">
                    <ui:Label text="RANK" class="mm-leaderboard__rank"/>
                    <ui:Label text="PLAYER" class="mm-leaderboard__name"/>
                    <ui:Label text="SCORE" class="mm-leaderboard__score"/>
                </ui:VisualElement>
                <ui:VisualElement name="roll-columns" class="mm-leaderboard__columns mm-leaderboard__columns--hidden">
                    <ui:Label text="REIGN" class="mm-leaderboard__reign"/>
                    <ui:Label text="FAVORITE" class="mm-leaderboard__name"/>
                    <ui:Label text="KING" class="mm-leaderboard__king"/>
                </ui:VisualElement>
                <ui:Label name="leaderboard-status" text="Calling the keepers…" class="mm-leaderboard__status"/>
                <ui:ScrollView name="leaderboard-list" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="mm-leaderboard__list"/>
                <ui:VisualElement name="favor-me" class="mm-leaderboard__me mm-leaderboard__me--hidden"/>
                <ui:Label name="leaderboard-updated" text="Ratings update after every eligible match." class="mm-leaderboard__updated"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- TIDBIT: the first-look card, driven by FirstRunTidbit (#403). LAST CHILD ON PURPOSE:
             UI Toolkit has no z-index, so document order is the only thing putting this over
             everything else on the screen. It starts hidden in the markup AND FirstRunTidbit
             hides it again in its constructor. The same block as CharacterCreateScreen.uxml,
             which carries the notes. No doubled hyphen in this comment: it empties the screen. -->
        <ui:VisualElement name="tidbit-overlay" class="tidbit-overlay tidbit-overlay--hidden">
            <ui:VisualElement name="tidbit-card" class="tidbit-card">
                <ui:VisualElement class="tidbit-header">
                    <ui:Label name="tidbit-title" text="" class="tidbit-title"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-body-row">
                    <ui:VisualElement name="tidbit-art" class="tidbit-art" picking-mode="Ignore"/>
                    <ui:Label name="tidbit-body" text="" class="tidbit-copy"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-actions">
                    <ui:Button name="btn-tidbit-done" text="Got it" class="tidbit-done emb-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
