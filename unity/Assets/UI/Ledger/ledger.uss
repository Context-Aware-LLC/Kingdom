/* ============================================================================
   THE LEDGER OF BAD IDEAS — every achievement, one entry each
   Whimsy pass 2026-10-17, #2. Opened from the main menu's book by LedgerOverlay.

   The dim and the paper come from tidbit.uss (.tidbit-overlay, .tidbit-card).
   Sized in the 2400 x 1080 authored panel (#349). It turns PAGES rather than
   scrolling: a journal reads that way, and a ScrollView still loses its touch
   drag to its content container on a device.
   ============================================================================ */

.ledger-sheet {
    width: 72%;
    max-width: 92%;
    flex-shrink: 0;
}

.ledger-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    border-bottom-width: 2px;
    border-bottom-color: rgba(84, 58, 34, 0.45);
    padding-bottom: var(--space-2);
}

.ledger-title {
    font-size: var(--type-display);
}

.ledger-count {
    font-size: var(--type-label);
    -unity-font-style: italic;
    color: rgb(84, 58, 34);
}

.ledger-status {
    font-size: var(--type-body);
    color: rgb(84, 58, 34);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: var(--space-12) 0;
}

/* Two entries to a row, three rows to a page. Fixed height, so turning to a page
   with fewer entries does not shrink the sheet under the player's thumb. */
.ledger-page {
    flex-direction: row;
    flex-wrap: wrap;
    height: 528px;
    align-content: flex-start;
}

/* Icon, then text, then the right gutter. The 96 of right padding is the seals' gutter
   (LedgerOverlay places each 72 wide at right 8), so no text runs under the wax. */
.ledger-entry {
    width: 50%;
    height: 176px;
    padding: var(--space-2) 96px var(--space-2) var(--space-2);
    flex-direction: row;
    align-items: center;
}

/* THE ICON IS 96 (2026-11-02). Every pixel of it comes out of the text's width, and the
   entry's 160 of content height is fixed, so the smallest icon that still reads won: 4/3 of
   the 72 seal, ~36dp on a Pixel 5a. An ESTIMATE, in Inter against every AchievementTexts row,
   not a measurement: on a 2400-wide panel the text box goes 640 -> 528, 2 entries gain a line
   (6 at 128) and Comeback's four lines run ~20 past 160, as they do at any icon size. A
   1920-wide (16:9) panel starts at 467, already 2 entries over, and 96 makes it 7; that is
   the entry height's problem, not one an icon size can solve. The slot keeps its size with no
   art, so a missing sprite leaves the page laid out the same. */
.ledger-entry__icon {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    margin-right: var(--space-4);
    -unity-background-scale-mode: scale-to-fit;
}

/* A basis of 0 that grows: exactly the width the icon and the gutter leave, so the labels wrap
   inside it. Not overflow: hidden, which on a shrinkable flex child deletes children. */
.ledger-entry__text {
    flex-basis: 0;
    flex-grow: 1;
    flex-direction: column;
}

.ledger-entry__name {
    font-size: var(--type-body);
    -unity-font-style: bold;
    color: rgb(58, 36, 18);
}

.ledger-entry__plain {
    font-size: var(--type-label);
    color: rgb(84, 58, 34);
    white-space: normal;
}

.ledger-entry__citation {
    font-size: var(--type-label);
    -unity-font-style: italic;
    color: rgb(84, 58, 34);
    white-space: normal;
}

.ledger-entry__date {
    font-size: var(--type-caption);
    color: rgb(120, 92, 62);
    margin-top: var(--space-1);
}

/* A page nobody has earned yet: one line, faded, and nothing that gives it away. */
.ledger-entry--unearned .ledger-entry__name {
    color: rgba(84, 58, 34, 0.5);
    letter-spacing: 4px;
}

/* Its icon greyed, like a locked achievement in Play Games: the built-in grayscale filter
   (USS filter, Unity 6.3+; no shader of ours) for the colour, and plain opacity for the dim,
   at the 0.5 the line beside it fades to. Opacity is the element property, not the filter's
   opacity(), so the icon still reads as locked if the filter ever renders nothing. */
.ledger-entry--unearned .ledger-entry__icon {
    filter: grayscale(100%);
    opacity: 0.5;
}

.ledger-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-4);
}

.ledger-pager {
    flex-direction: row;
    align-items: center;
}

.ledger-page-label {
    font-size: var(--type-label);
    color: rgb(84, 58, 34);
    margin: 0 var(--space-4);
}

.ledger-button {
    min-width: 148px;
    height: 68px;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    font-size: var(--type-body);
}
