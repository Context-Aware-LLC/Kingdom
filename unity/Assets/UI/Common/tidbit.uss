/* ============================================================================
   FIRST-RUN TIDBIT — the one-scroll overlay
   Slice 4 of docs/dev-docs/specs/first-run-and-pack-opening.md.

   Self-contained: backdrop, scroll surface, layout and the Got it control's size
   all live here, so a host needs this sheet and theme.uss and nothing else. The
   button's chrome is theme.uss's .emb-primary.
   ============================================================================ */

/* Display, not opacity: an overlay left at opacity 0 still eats every touch on the
   screen behind it, and this one sits over a screen whose only job is to be
   tapped. */
.tidbit-overlay--hidden {
    display: none;
}

/* Full-screen dim that centres the card. UI Toolkit has no z-index: the
   overlay covers the screen because it is the LAST child of the root, and moving
   it up the tree is what would put a screen on top of it.

   If it ever needs inset from the screen edge, use MARGIN on .tidbit-card and not
   padding on the root — #237, padding does not reach absolute children and fails
   by doing nothing. */
.tidbit-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

/* THE SCROLL. FirstRunTidbit builds these three around .tidbit-card in code, so no host's
   markup carries them: the wrapper holds the footprint, the clip is the window the sheet is
   revealed through, and the two rollers ride the clip's edges.

   Sized in the 2400 x 1080 authored panel (#349): half the screen wide. The rollers overhang
   that on both sides and top and bottom, which is why nothing here clips but the clip. */
.tidbit-scroll {
    width: 50%;
    max-width: 90%;
    align-items: center;
}

/* Its width is the unfurl: FirstRunTidbit drives it from 0 to the wrapper's width. flex-shrink 0
   on it and on the card, because a shrinkable flex child with overflow: hidden deletes its
   children outright in UI Toolkit. */
.tidbit-scroll__clip {
    overflow: hidden;
    flex-shrink: 0;
}

/* One rolled scroll, used twice (the second mirrored). Position and size are set per frame in
   code: they follow the clip's edges and the card's height, neither of which USS can express. */
.tidbit-scroll__roller {
    position: absolute;
    background-image: url("/Assets/Art/UI/Surfaces/rolled-complete.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* The sheet. It is always laid out at its full width, so the copy never re-wraps while the clip
   opens over it. The slices are paper.png's torn border plus its transparent margin (0 left,
   18 top, 12 right, 32 bottom of 738 x 491).

   Side padding clears the half of each roller that sits over the sheet: the roll itself is
   about 40% of rolled-complete.png's width, so roughly 70px of a 520px-tall sheet. */
.tidbit-card {
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Art/UI/Surfaces/paper.png");
    -unity-slice-left: 60;
    -unity-slice-right: 72;
    -unity-slice-top: 78;
    -unity-slice-bottom: 92;
    padding: 72px 120px 84px 120px;
}

.tidbit-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.tidbit-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    /* Ink on parchment: the theme's --ink-* are light, for slate. */
    color: rgb(58, 36, 18);
}

/* Art left, copy right. Two lines of body against a 4:3 illustration is the whole
   card, so nothing here scrolls and nothing measures. */
.tidbit-body-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-6);
}

/* 4:3, matching the 800x600 source in spec §6.5. FirstRunTidbit.Render sets
   display: none on this element when the sprite does not resolve, so the copy
   takes the full width rather than sitting beside a hole. */
.tidbit-art {
    width: 400px;
    height: 300px;
    margin-right: var(--space-6);
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* flex-basis 0 with grow, so the label wraps to the space left rather than sizing
   itself to its text and pushing the art out of the card. No overflow: hidden —
   a shrinkable flex child with it deletes its children outright in UI Toolkit. */
.tidbit-copy {
    flex-grow: 1;
    flex-basis: 0;
    white-space: normal;
    font-size: var(--type-body);
    color: rgb(84, 58, 34);
}

.tidbit-actions {
    flex-direction: row;
    justify-content: flex-end;
}

/* The roster's .roster-button box, restated: that rule lives in character-roster.uss, which
   only the roster and deck creation link, so on any other host the button had no size. */
.tidbit-done {
    min-width: 148px;
    height: 68px;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    font-size: var(--type-body);
}
