/* ============================================================================
   FIRST-RUN TIDBIT — the one-card overlay
   Slice 4 of docs/dev-docs/specs/first-run-and-pack-opening.md.

   Self-contained: backdrop, card surface, layout and the Got it control's size
   all live here, so a host needs this sheet and theme.uss and nothing else. The
   button's chrome is theme.uss's .emb-primary.
   ============================================================================ */

/* Display, not opacity: an overlay left at opacity 0 still eats every touch on the
   screen behind it, and this one sits over a screen whose only job is to be
   tapped. */
.tidbit-overlay--hidden {
    display: none;
}

/* Full-screen dim that centres the card. UI Toolkit has no z-index: the
   overlay covers the screen because it is the LAST child of the root, and moving
   it up the tree is what would put a screen on top of it.

   If it ever needs inset from the screen edge, use MARGIN on .tidbit-card and not
   padding on the root — #237, padding does not reach absolute children and fails
   by doing nothing. */
.tidbit-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

/* Sized in the 2400 x 1080 authored panel (#349), on the same footing as the roster's
   .delete-dialog: half the screen wide, theme surfaces and type steps. */
.tidbit-card {
    width: 50%;
    max-width: 90%;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--surface-3);
    border-radius: var(--space-2);
    padding: var(--space-6);
}

.tidbit-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.tidbit-title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
}

/* Art left, copy right. Two lines of body against a 4:3 illustration is the whole
   card, so nothing here scrolls and nothing measures. */
.tidbit-body-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-6);
}

/* 4:3, matching the 800x600 source in spec §6.5. FirstRunTidbit.Render sets
   display: none on this element when the sprite does not resolve, so the copy
   takes the full width rather than sitting beside a hole. */
.tidbit-art {
    width: 400px;
    height: 300px;
    margin-right: var(--space-6);
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* flex-basis 0 with grow, so the label wraps to the space left rather than sizing
   itself to its text and pushing the art out of the card. No overflow: hidden —
   a shrinkable flex child with it deletes its children outright in UI Toolkit. */
.tidbit-copy {
    flex-grow: 1;
    flex-basis: 0;
    white-space: normal;
    font-size: var(--type-body);
    color: var(--ink-2);
}

.tidbit-actions {
    flex-direction: row;
    justify-content: flex-end;
}

/* The roster's .roster-button box, restated: that rule lives in character-roster.uss, which
   only the roster and deck creation link, so on any other host the button had no size. */
.tidbit-done {
    min-width: 148px;
    height: 68px;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    font-size: var(--type-body);
}
