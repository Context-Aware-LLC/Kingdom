/* The pack vault — the rack of unopened packs, the stage and rail they open on, and the chrome
 * around the reveal.
 *
 * The reveal itself is NOT styled here. `packreveal.uss` owns every `.reveal-*` rule and this
 * screen links it alongside this sheet, the same way ShopScreen.uxml does. That sheet was pulled
 * out of shop.uss in 2026-08-20 precisely so a second host could exist; this is that host.
 *
 * `.emb-root` (theme.uss) is the only other dependency, and only for the design tokens. */

.pack-vault-screen {
    flex-grow: 1;
    background-color: var(--surface-0);
    /* BackgroundArt supplies the device's resolution tier. */
    background-image: none;
    -unity-background-scale-mode: scale-and-crop;
}

/* Carries .emb-bleed in the markup, so the horizontal clearance is the theme's and the padding
 * below is vertical only. Do not add a horizontal padding here: a class rule in this sheet ties
 * theme.uss on specificity and wins on sheet order, so it would silently defeat --edge-safe.
 * (The same defeat packreveal.uss documents for .reveal-overlay.) */
.vault-shell {
    flex-grow: 1;
    /* The rack, then the stage-and-rail column beside it. */
    flex-direction: row;
    padding-top: var(--space-4);
    /* Same 68px Back footprint, 24px edge offset, and 12px gap reserved by Shop (updated
       2026-09-27 for the canonical `.emb-back-button`, theme.uss). */
    padding-bottom: 104px;
}

/* ── The gift banner ─────────────────────────────────────────────────────────────────────────
 *
 * Gift mode only (PackVaultMode.Gift), and only once a non-empty shelf has rendered. It is TEXT ON
 * A PLATE, not an image: `gift_ribbon.png` is specified (spec §6.3 #10) and does not exist, and a
 * banner that waits for art is a banner that ships blank. When the ribbon lands it becomes a
 * background-image on this rule and nothing else moves.
 * RETIREMENT TRIGGER: when Assets/Art/UI/Chrome/PackVault/gift_ribbon.png is placed, set it here
 * as a 9-sliced background and drop the border. */
.vault-banner {
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: var(--space-3);
    align-items: center;

    /* The entrance. Both properties are transitioned here rather than on the --enter rule, so the
     * animation runs in BOTH directions off one declaration and a class that is only ever removed
     * still animates. Duration matches the slot stagger's step. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-banner__title {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.vault-banner__body {
    color: var(--ink-2);
    font-size: var(--type-label);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Vault mode's resting state, and the authored default in the UXML — a returning player must never
 * be congratulated for arriving. `display: none` rather than opacity, so it holds no height. */
.vault-banner--hidden {
    display: none;
}

/* Staged. PackVaultController adds this at show time and schedules its removal, at which point the
 * transition above runs. */
.vault-banner--enter {
    opacity: 0;
    translate: 0 -12px;
}

/* ── The rack ─────────────────────────────────────────────────────────────────────────────────
 *
 * One slot per pack LINE, down the left edge (Sam, 2026-09-27). It replaced a wrapping shelf of one
 * tile per pack, which at forty packs drew rows it could not scroll to. A slot carries the count in
 * a bubble, so the rack's height is bounded by the number of EXPANSIONS, not packs. A slot is a
 * third of the rack's height, so three packs fill the screen top to bottom (Sam, 2026-10-02). The
 * rightmost 18% is the vertical hold rail; the slots and rail sit directly on the backdrop. */
.vault-rack {
    width: 22%;
    max-width: 460px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    padding-right: var(--space-4);
}

.vault-rack__slots {
    width: 82%;
    flex-shrink: 0;
    /* Fewer than three lines spread over the whole height instead of bunching in the middle. */
    justify-content: space-around;
    align-items: center;
    padding-right: var(--space-3);
}

/* The pack, centred in the column, with its name under it. */
.vault-slot {
    width: 100%;
    height: 33.3%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) 0;
    background-color: rgba(0, 0, 0, 0);

    /* Rest state for the gift entrance (.vault-slot--enter). Harmless in Vault mode, which never
     * stages a slot and so never transitions it. */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 260ms, 260ms;
    transition-timing-function: ease-out, ease-out;
}

.vault-slot:disabled {
    opacity: 0.45;
}

/* The gift's entrance: applied at BUILD time by PackVaultController and released one slot at a
 * time, so the packs arrive in sequence. The transition lives on .vault-slot, not here. */
.vault-slot--enter {
    opacity: 0;
    translate: -16px 0;
}

/* The slot a drag was lifted from, while the ghost is away from it. */
.vault-source--lifted {
    opacity: 0.5;
}

.vault-slot__label {
    flex-shrink: 0;
    margin-top: var(--space-2);
    color: var(--ink-1);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* A pack miniature: the rack slot's and the drag ghost's. 0.7 is the pack's
 * portrait ratio (see .vault-pack__face). No aspect-ratio here: both sides are set, and the rack
 * slot and the ghost each override them. */
.vault-mini {
    width: 72px;
    height: 103px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: var(--space-2);
}

/* The rack's pack. The panel is always 1080 tall (KingdomPanelSettings matches height), which
 * leaves a slot 320: 260 of pack, and the name under it. Pixels, so it does NOT shrink with the
 * slot; a fourth pack line needs these two numbers cut. */
.vault-slot .vault-mini {
    width: 182px;
    height: 260px;
}

/* Only once art actually resolved; an artless pack keeps the plain plate. */
.vault-mini--art {
    background-color: rgba(0, 0, 0, 0);
}

/* The count bubble, over the miniature's top-right corner. A notification bubble, so it is the
 * alarm colour and it breaks the pack's silhouette on purpose. */
.vault-count {
    position: absolute;
    top: -12px;
    right: -16px;
    min-width: 46px;
    height: 46px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 23px;
    border-width: 2px;
    border-color: rgba(11, 14, 19, 0.9);
    background-color: var(--negative);
    color: rgb(255, 255, 255);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 110ms, 110ms;
    transition-timing-function: ease-out, ease-out;
}

/* One tick of the rail's count-up. PackRackDrag adds it and takes it off again, so the bubble pops
 * on every +1. */
.vault-count--bump {
    scale: 1.3 1.3;
}

/* The stack has reached what the player holds, or the batch cap. */
.vault-count--max {
    background-color: var(--accent);
    color: var(--surface-0);
}

/* ── The stage ────────────────────────────────────────────────────────────────────────────── */

.vault-main {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Where a dropped pack opens. It holds no pack until one is dropped on it; the pack that tears is
 * built into it by PackVaultController.PlaceStagePack. */
.vault-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--space-4);
}

.vault-stage--armed {
    border-color: var(--accent);
    background-color: rgba(255, 214, 148, 0.08);
}

.vault-loading {
    /* Direct child of .pack-vault-screen: these four edges are the full viewport, so flex
     * centering remains exact even when the rack changes width. */
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.vault-loading__icon {
    width: 400px;
    height: 400px;
    flex-shrink: 0;
    translate: 34px -50px;
    background-image: url("/Assets/Art/UI/PackVault/vault-loading-cache-seal.png");
    -unity-background-scale-mode: scale-to-fit;
}

.vault-loading--hidden {
    display: none;
}

.vault-stage__hint {
    color: var(--ink-2);
    font-size: var(--type-h2);
    -unity-text-align: middle-center;
    white-space: normal;
}

.vault-stage__hint--hidden {
    display: none;
}

/* The vertical hold rail occupies the rack's rightmost 18%. A pack held over it counts up; a
 * pack dropped on it goes home, as from anywhere but the stage. The element is the HIT ZONE and
 * stays transparent; what the player sees is the rod inside it. */
.vault-rail {
    width: 18%;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 56px;
    background-color: rgba(0, 0, 0, 0);
}

/* The rod (2026-11-06): a fixed CAP (finial, wall bracket, a little shaft), a SHAFT element that
 * repeats a 120-row tile down whatever height is left, and a FOOT that mirrors the cap. All three
 * come from one sheet whose source lives in art-pipeline/ui-chrome. The cap's last row is the
 * tile's true predecessor and the tile wraps without a seam. `round` fits a whole number of tiles
 * (stretching each a little) so no partial tile meets the foot: a cut at an arbitrary row would
 * show as a line. The foot is the cap flipped for its shape but carries the unflipped ball's
 * shading, so both balls are lit from above.
 * Cap, tile and foot are 73 texture px wide with the shaft at the same columns, and everything is
 * drawn at 0.8 (73 → 58, 120 → 96, 109 → 87): change one number and change them all, or the shaft
 * steps sideways at a join.
 * Idle is tinted down so armed can brighten it: a tint only multiplies. */
.vault-rail__rod {
    width: 58px;
    flex-grow: 1;
    flex-shrink: 0;
}

.vault-rail__cap,
.vault-rail__foot {
    height: 87px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.vault-rail__cap {
    background-image: url("/Assets/Art/UI/Chrome/pack-vault-rail-cap.png");
}

.vault-rail__foot {
    background-image: url("/Assets/Art/UI/Chrome/pack-vault-rail-foot.png");
}

.vault-rail__shaft {
    flex-grow: 1;
    background-image: url("/Assets/Art/UI/Chrome/pack-vault-rail-shaft.png");
    background-size: 58px 96px;
    background-repeat: no-repeat round;
    background-position-x: center;
    background-position-y: top;
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

/* A pack held over it: the rod catches the light. */
.vault-rail--armed .vault-rail__cap,
.vault-rail--armed .vault-rail__shaft,
.vault-rail--armed .vault-rail__foot {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.vault-rail--hidden {
    display: none;
}

/* The pack under the finger. Added to the screen root's hierarchy by PackRackDrag, picking-ignored,
 * and centred on the pointer from script. A little larger than the rack miniature: it is lifted. */
.vault-ghost {
    position: absolute;
    width: 196px;
    height: 280px;
}

.vault-ghost__face {
    width: 100%;
    height: 100%;
}

/* A booster is a portrait object. 0.7 is the reveal card's ratio, so a pack and the cards it
 * becomes read as the same family — and it is the ratio the starter pack's art is authored at
 * (1024x1536, spec §6.1). `aspect-ratio` IS supported; the claim that it is not was true once and
 * is not now — see the note in shop.uss. */
.vault-pack__face {
    width: 100%;
    aspect-ratio: 0.7;
    flex-shrink: 0;
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* Only once art actually resolved. A set whose art has not been drawn yet is the normal state
 * (PackArtProvider says so out loud), so an artless pack keeps the plain plate above rather than
 * reading as a picture that failed to load. */
.vault-pack__face--art {
    background-color: rgba(0, 0, 0, 0);
}

/* The pack on the stage — the only .vault-pack__face now. Explicit on both sides, overriding the
 * 100% width above; 336 x 480 is the same 0.7 portrait, so the aspect ratio still agrees. */
.vault-stage__pack {
    width: 336px;
    height: 480px;
}

.vault-status {
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: var(--space-3);
    min-height: var(--space-8);
}

/* Collapsed rather than blanked, so an empty status does not hold a band of dead space between the
 * stage and the rail. */
.vault-status--empty {
    display: none;
}

/* ============================================================================================
 * THE TEAR (slice 3), IN PLACE. Every rule below is a child of `.vault-pack__face` — the pack the
 * player dropped on the stage. There is no overlay and no second render of the pack;
 * PackTearAnimator's remarks say why, and the UXML carries the same note.
 *
 * PackTearAnimator drives all of this by adding a modifier; there is no keyframe anywhere, because
 * USS has none — each beat is a transition on the base rule that a scheduled class toggle releases.
 * Read that class's remarks before changing a duration: the C# schedule and these transitions are
 * one clock, and moving only one half leaves the two baked edges visibly out of step.
 *
 * THE TORN PIECES ARE BAKED. PackWrapperBaker renders them from the intact wrapper's source
 * sprite across a shared procedural tear line, so files 4 and 5 of spec §6.1 were never art anybody
 * had to produce — that table is corrected. There is no fallback colour on the pieces: a bake that
 * cannot run means there is no picture to tear, and the animator fades the tile instead.
 *
 * THE FOIL STRIP IS GONE (Sam, 2026-09-03). It was a flat placeholder band laid across the pack art
 * and it read as exactly that — a block of yellow over the picture. A strip only makes sense as a
 * thing you pull, and there is no pull gesture any more. If pack_tear_strip.png is ever drawn, it
 * belongs in the authored wrapper, not painted over it by a rule here. */

/* The tile while it is coming apart. `overflow: hidden` is off so the pieces can travel past the
 * tile's own bounds — a tear clipped to the pack it came out of reads as a wipe. */
.vault-pack__face--tearing {
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    scale: 1 1;
    rotate: 0deg;
    transition-property: scale, rotate;
    transition-duration: 140ms;
    transition-timing-function: ease-out;
}

.vault-pack__face--tension {
    scale: 1.045 0.97;
    rotate: -2deg;
}

/* The artless degrade: nothing to tear, so the pack goes. See PackTearAnimator's remarks on why
 * this branch exists rather than parting two blank plates. */
.vault-pack__face--spent {
    opacity: 0;
    scale: 0.94 0.94;
    transition-property: opacity, scale;
    transition-duration: 320ms, 320ms;
    transition-timing-function: ease-out, ease-out;
}

/* NOT TWO HALVES, and the art is what says so. Spec §6.1 sizes pack_torn_top at 1024 × 640 and
 * pack_torn_bottom at 1024 × 1024 against a 1024 × 1536 front: 41.7% and 66.7%, overlapping by
 * ~8% at the tear line. That is how a pack actually opens — you tear the crimped end OFF, you do
 * not halve it — and it is also what leaves the authored crimp on the OUTER edge of each piece to
 * never cross the tear. Each height is set on the piece's own rule below; do not collapse them back
 * to 50% without changing the art brief with it.
 *
 * Absolute, so parting them cannot reflow the shelf around them: a layout-driven split would emit a
 * GeometryChangedEvent every frame, which is the same reason collection.uss animates its drawers on
 * translate and never on width. */
.tear-half {
    position: absolute;
    left: 0;
    right: 0;
    /* No scale mode here: PackWrapperBaker sets background-size Contain inline on both
     * pieces, which is what keeps them aligned with the intact face they replace. */
    translate: 0 0;
    rotate: 0deg;
    opacity: 1;
    transition-property: translate, rotate, opacity;
    transition-duration: 360ms, 360ms, 360ms;
    transition-timing-function: ease-in-out, ease-in-out, ease-in-out;
}

/* 640 / 1536. The torn edge is its BOTTOM edge; the crimp is its top. */
.tear-half--top {
    top: 0;
    height: 41.7%;
}

/* 1024 / 1536. The torn edge is its TOP edge; the crimp is its bottom. It overlaps the top piece by
 * design — the two torn edges interlock rather than meeting on a line, which is what stops a seam
 * showing through the pack in the frame before it parts. */
.tear-half--bottom {
    bottom: 0;
    height: 66.7%;
}

/* Parted. The modifier alone carries what both pieces share; the direction comes from each piece's
 * own rule below — one class, two directions.
 *
 * They rotate as well as travel, in OPPOSITE directions. Two pieces sliding straight apart read as
 * a door; a torn wrapper falls away off-axis. The shader bakes each piece as its own texture so the
 * rotation costs nothing and never distorts the source image (Sol, 2026-09-03).
 *
 * Travel is in PERCENT, not pixels, so the throw scales with whatever size the stage pack is. */
.tear-half--parted {
    opacity: 0;
}

.tear-half--top.tear-half--parted {
    translate: -12% -68%;
    rotate: -14deg;
}

.tear-half--bottom.tear-half--parted {
    translate: 8% 64%;
    rotate: 10deg;
}
