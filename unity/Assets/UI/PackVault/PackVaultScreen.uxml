<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/PackVault/packvault.uss?fileID=7433441132597879392&amp;guid=36eac866b4624b47af05d928f36743f1&amp;type=3#packvault"/>
    <Style src="project://database/Assets/UI/PackReveal/packreveal.uss?fileID=7433441132597879392&amp;guid=a201f4cb62914110a1d96762b261bb3d&amp;type=3#packreveal"/>
    <Style src="project://database/Assets/UI/Common/tidbit.uss?fileID=7433441132597879392&amp;guid=59a3d1cad3c148f488a43eafde7ad1ee&amp;type=3#tidbit"/>
    <!-- The pack vault: a RACK on the left (one slot per pack line, filled by PackVaultController
         from the balance on GET /collection), a narrow vertical RAIL inside the rack where a held
         pack counts up a stack, and the STAGE where a dropped pack opens.

         THE reveal-* TREE IS THE STORE'S, VERBATIM, AND MUST STAY THAT WAY. PackRevealPanel
         queries these NAMES out of whatever root it is handed, which is the whole reason it was
         split out of the store in 2026-08-20. Renaming one here does not break a build; it makes
         a pack open to a blank screen after the entitlement is already spent.
         (No double dash anywhere in this comment. An XML comment may not contain one, and Unity
         does not report the parse failure: the whole screen renders EMPTY.) -->
    <ui:VisualElement name="root" class="emb-root pack-vault-screen">
        <ui:VisualElement name="vault-shell" class="vault-shell emb-bleed">
            <ui:VisualElement name="vault-rack" class="vault-rack">
                <ui:VisualElement name="vault-rack-slots" class="vault-rack__slots"/>
                <!-- vault-rail is the HIT ZONE (PackRackDrag tests its worldBound); the rod inside
                     it is drawing only, so it ignores picking. -->
                <ui:VisualElement name="vault-rail" class="vault-rail vault-rail--hidden">
                    <ui:VisualElement class="vault-rail__rod" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="vault-main" class="vault-main">
                <!-- Gift mode only, and hidden here so Vault mode never has to turn it off. It is
                     shown by PackVaultController once a rack with packs on it has actually rendered:
                     a banner saying "here is a gift" over a spinner, or over "could not reach the
                     server", is worse than no banner at all. The staged entrance modifier is added at
                     show time and is deliberately not authored here.
                     (No double dash anywhere in this comment either, for the reason above.) -->
                <ui:VisualElement name="vault-banner" class="vault-banner vault-banner--hidden">
                    <ui:Label name="vault-banner-title" text="A gift to start you off" class="vault-banner__title"/>
                    <ui:Label name="vault-banner-body" text="Open them and keep everything inside." class="vault-banner__body"/>
                </ui:VisualElement>
                <ui:VisualElement name="vault-stage" class="vault-stage"/>
                <ui:Label name="vault-status" text="" class="vault-status vault-status--empty"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- A direct child of the full-screen root so absolute zero-edge positioning centers the
             seal in the viewport rather than in the stage column beside the rack. -->
        <ui:VisualElement name="vault-loading" picking-mode="Ignore" class="vault-loading vault-loading--hidden">
            <ui:VisualElement name="vault-loading-icon" picking-mode="Ignore" class="vault-loading__icon"/>
        </ui:VisualElement>
        <ui:Button name="btn-vault-back" text="Back" class="emb-back emb-back-button"/>
        <!-- NO TEAR OVERLAY (Sam, 2026-09-03). The pack that tears is the one the player dropped on
             vault-stage, so everything the beat draws is a child of that pack. A full screen overlay
             that re-rendered it would put a second copy of an on-screen object on screen. -->
        <!-- The reveal is the cards on the vault backdrop, nothing else (Sam, 2026-09-27): no
             panel, no title, no count, no button. A tap anywhere off a card dismisses it.
             reveal-dismiss is that tap: it fills the overlay BEHIND the cards, and reveal-cards
             ignores picking so its gaps fall through to it. It also carries emb-back, so Android's
             back gesture dismisses the reveal before it leaves the screen: BackNavigation clicks
             the DEEPEST visible back control, and this sits one level below Back. -->
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay reveal-overlay--hidden emb-bleed">
            <ui:VisualElement name="reveal-dismiss" class="reveal-dismiss emb-back"/>
            <ui:VisualElement name="reveal-cards" class="reveal-cards" picking-mode="Ignore"/>
            <!-- Vault only: the per rarity receipt a multi pack open adds under the cards
                 (PackRevealPanel.ShowMany). It ignores picking, so a tap on it dismisses too. -->
            <ui:VisualElement name="reveal-list" class="reveal-list reveal-list--hidden" picking-mode="Ignore"/>
        </ui:VisualElement>
        <!-- TIDBIT: the first-look card, driven by FirstRunTidbit (#403). LAST CHILD ON PURPOSE:
             UI Toolkit has no z-index, so document order is the only thing putting this over
             everything else on the screen. It starts hidden in the markup AND FirstRunTidbit
             hides it again in its constructor. The same block as CharacterCreateScreen.uxml,
             which carries the notes. No doubled hyphen in this comment: it empties the screen. -->
        <ui:VisualElement name="tidbit-overlay" class="tidbit-overlay tidbit-overlay--hidden">
            <ui:VisualElement name="tidbit-card" class="tidbit-card">
                <ui:VisualElement class="tidbit-header">
                    <ui:Label name="tidbit-title" text="" class="tidbit-title"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-body-row">
                    <ui:VisualElement name="tidbit-art" class="tidbit-art" picking-mode="Ignore"/>
                    <ui:Label name="tidbit-body" text="" class="tidbit-copy"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-actions">
                    <ui:Button name="btn-tidbit-done" text="Got it" class="tidbit-done emb-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
