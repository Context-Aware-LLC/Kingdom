<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Common/theme.uss" />
    <Style src="character-roster.uss" />
    <Style src="../Common/tidbit.uss" />
    <ui:VisualElement name="root" class="emb-root character-roster emb-bleed">
        <!--
          A FLAT LIST OF DECKS (ADR-0009, 2026-09-04). This screen was a roster of characters, each
          drawn as a row with its own deck strip inside it; the character menu overlay and the
          delete-character modal that used to sit at the bottom of this file went with the type.
          What is left is one grid of deck plates, built by CharacterRosterController.

          The create FORM is gone (NOR-278). The name field, class dropdowns, swap-order and
          starter-deck dropdown, and the Create button that used to fill a right-hand panel are
          replaced by the grid's trailing "+" plate and the class-picker scene it opens. This is
          the game-wide "eliminate forms" principle: no dropdowns, no multi-field forms — the
          choice is made by tapping a picture.

          The header used to carry a second door to the same place ("+ New Deck", top-left) — cut
          2026-09-08 (Sam) as redundant with the "+" plate, which is always on screen and never
          scrolled out of view the way this one could be.

          The header's two-button actions row (View Collection, Main Menu) is gone the same day.
          "View Collection" is now this screen's only Back button — Main Menu's old job, same
          corner every other screen uses via the canonical `.emb-back-button` (theme.uss).
          Browsing the collection as its OWN destination from this screen is cut; the deck grid
          and the deck modal are what this screen is for.
        -->
        <ui:VisualElement class="roster-body">
            <ui:VisualElement class="roster-panel roster-panel--list">
                <ui:ScrollView name="roster-scroll" mode="Vertical" class="roster-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="roster-list" class="roster-list" />
                    <ui:Label name="empty-state" text="No decks yet — tap + to build your first." class="roster-empty" />
                </ui:ScrollView>
                <ui:Label name="status" text="" class="roster-status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- AFTER `.roster-body`, not before (2026-09-08, fixing the button that shipped dead):
             `.roster-scroll` covers the same bottom-left corner `.emb-back-button` anchors to, and
             a LATER sibling paints over an earlier one and wins hit-testing on the overlap — with
             this above `.roster-body` the scroll view sat on top and ate every click before it
             reached the button. -->
        <ui:Button name="back-button" text="Back" class="emb-back emb-back-button" />

        <!--
          Find Game's second step. The first — pick a deck — is the same grid the deck-management
          door draws; this bar is the only thing that door does not have. Hidden entirely outside a
          match pick. (It was the THIRD step until ADR-0009, when picking a character stopped being
          a step at all.)
        -->
        <ui:VisualElement name="match-bar" picking-mode="Ignore" class="match-bar">
            <ui:Button name="match-continue" text="Continue" class="roster-button emb-primary" />
        </ui:VisualElement>

        <!--
          What a deck plate opens. One dialog, with the menu and its action panes — whichever was
          picked — because a deck's name and its card back are both edited from here now and two
          separate modals would be two separate places to leave a deck half-renamed.
        -->
        <ui:VisualElement name="deck-modal" class="delete-modal delete-modal--hidden emb-bleed">
            <ui:VisualElement name="deck-dialog" class="delete-dialog">
                <ui:VisualElement name="deck-modal-header" class="deck-modal-header">
                    <ui:VisualElement name="deck-modal-classes" class="deck-modal-classes" />
                </ui:VisualElement>
                <ui:Label name="deck-modal-title" text="" class="delete-title" />
                <ui:Label name="deck-modal-sub" text="" class="create-help" />

                <ui:VisualElement name="deck-menu-pane" class="deck-pane">
                    <!-- The primary action (Sam, 2026-08-09): opening a deck's menu is most often
                         "I want to change what's in it," and that used to have no button at all —
                         only the undiscoverable double-tap-the-plate gesture reached the deckbuilder. -->
                    <ui:Button name="deck-edit" text="Edit deck" class="roster-button emb-primary deck-action" />
                    <!-- Match pick only. Every other action below is offered from both doors. -->
                    <ui:Button name="deck-select" text="Select this deck" class="roster-button emb-primary deck-action" />
                    <ui:Button name="deck-rename" text="Rename deck" class="roster-button deck-action" />
                    <ui:Button name="deck-change-back" text="Change card back" class="roster-button deck-action" />
                    <!-- "Set as default" was here until ADR-0009. It answered "which of this
                         character's decks do I open on"; a flat deck list does not ask it, and the
                         queue never read the answer anyway (#343). -->
                    <ui:Button name="deck-delete" text="Delete deck" class="roster-button roster-button--danger deck-action" />
                    <ui:Label text="Double tap the deck to edit it." class="deck-edit-hint" />
                </ui:VisualElement>

                <!--
                  The new-deck pane was here until ADR-0009: two buttons, generated or blank. A
                  deck's class pairing is permanent from the moment it exists, so creating one now
                  begins with choosing that pairing — a full screen of choice, not a pane — and "+"
                  loads the class-picker scene. The two starter shapes are still offered, on that
                  screen's confirm view.
                -->
                <ui:VisualElement name="deck-rename-pane" class="deck-pane">
                    <ui:Label name="deck-rename-help" text="Choose a name for this deck (up to 24 characters)." class="create-help" />
                    <ui:TextField name="deck-rename-field" max-length="24" class="roster-field" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-delete-pane" class="deck-pane">
                    <ui:Label name="deck-delete-message" text="" class="delete-message" />
                </ui:VisualElement>

                <ui:VisualElement name="deck-back-pane" class="deck-pane">
                    <ui:VisualElement name="deck-back-grid" class="deck-back-grid" />
                </ui:VisualElement>

                <ui:Label name="deck-modal-error" text="" class="create-error" />
                <ui:VisualElement class="delete-actions">
                    <ui:Button name="deck-modal-cancel" text="Close" class="roster-button emb-back" />
                    <ui:Button name="deck-modal-confirm" text="Save" class="roster-button emb-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
          Two overlays stood here until ADR-0009 and both went with the type they were about: the
          character menu (a card anchored under a row's name, holding Delete character) and the
          delete-character modal with its cascade warning. Deleting a deck is confirmed on the deck
          dialog's own Delete pane, which is where every other thing done to a deck already lives.
        -->
        <!-- TIDBIT: the first-look card, driven by FirstRunTidbit (#403). LAST CHILD ON PURPOSE:
             UI Toolkit has no z-index, so document order is the only thing putting this over
             everything else on the screen. It starts hidden in the markup AND FirstRunTidbit
             hides it again in its constructor. The same block as CharacterCreateScreen.uxml,
             which carries the notes. No doubled hyphen in this comment: it empties the screen. -->
        <ui:VisualElement name="tidbit-overlay" class="tidbit-overlay tidbit-overlay--hidden">
            <ui:VisualElement name="tidbit-card" class="tidbit-card">
                <ui:VisualElement class="tidbit-header">
                    <ui:Label name="tidbit-title" text="" class="tidbit-title"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-body-row">
                    <ui:VisualElement name="tidbit-art" class="tidbit-art" picking-mode="Ignore"/>
                    <ui:Label name="tidbit-body" text="" class="tidbit-copy"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-actions">
                    <ui:Button name="btn-tidbit-done" text="Got it" class="tidbit-done emb-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
