<?xml version="1.0" encoding="utf-8"?>
<!--
  MatchSettingsScreen.uxml — in-match settings overlay (C-G1-3 / decision 23 §5).
  A persistent corner "menu" button that opens a modal panel. In-match, the top item is
  CONCEDE, gated behind a confirm because leaving IS forfeiting. Sound landed 2026-09-05 as
  the mute toggle + music/SFX sliders in #audio-settings, bound by
  MatchSettingsController.BindAudioSettings and applied through Kingdom.Presentation.AudioSettings.
  Video is still deferred.

  Loaded at runtime by the bootstraps AND by MainMenuController (Sam, 2026-08-09 — the gear is
  reachable from the main menu now, not just in-match) via Resources and bound by
  MatchSettingsController. On the menu mount, Concede is hidden (nothing to concede).
  Styled by Common/settings.uss, which theme.uss imports (Sam, 2026-09-30). Every rule for the gear
  and the panel lives there; add none here, inline, or in a screen sheet.

  The root is picking-mode Ignore so the world-space board keeps its clicks; only the gear
  (always) and the scrim (while open) are pickable. Board input is ALSO gated in InputRouter
  while this is open — UI Toolkit does not block Unity physics, so the scrim alone won't.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../Common/theme.uss" />

    <ui:VisualElement name="root" class="emb-root ms-root" picking-mode="Ignore">

        <!-- Persistent corner button -->
        <ui:Button name="btn-settings" class="ms-gear emb-edge">
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
            <ui:VisualElement class="ms-gear-bar" picking-mode="Ignore" />
        </ui:Button>

        <!-- Modal overlay (display toggled by the controller) -->
        <ui:VisualElement name="overlay" class="ms-overlay emb-bleed">
            <ui:VisualElement name="scrim" class="ms-scrim emb-bleed" />

            <ui:VisualElement name="panel" class="ms-panel">

                <!-- Menu view -->
                <ui:VisualElement name="view-menu" class="ms-view">
                    <ui:VisualElement name="audio-settings" class="ms-audio">
                        <ui:Toggle name="toggle-mute" label="Mute" class="ms-toggle" />
                        <ui:Slider name="slider-music" label="Music" low-value="0" high-value="1" class="ms-slider" />
                        <ui:Slider name="slider-sfx" label="SFX" low-value="0" high-value="1" class="ms-slider" />
                    </ui:VisualElement>
                    <ui:Button name="btn-concede" text="Concede" class="ms-item ms-item--danger" />
                    <!-- Sign out (Sam, 2026-09-02). The player-facing way to leave an identity, and
                         the reason it exists now: testing that a roster comes back required
                         uninstalling the app, which is a blunt instrument and needs a re-signed
                         session either way. Hidden when nobody is signed in — the controller shows
                         it, because "is there a session" is not something the UXML can know. -->
                    <ui:Button name="btn-sign-out" text="Sign out" class="ms-item" style="display: none;" />
                    <!-- Account (2026-10-02, #385): the legal links and the Play-policy delete entry. -->
                    <ui:Button name="btn-account" text="Account" class="ms-item" />
                    <!-- Quit (Sam, 2026-09-27): styled as a regular .ms-item, same as the rest. -->
                    <ui:Button name="btn-quit" text="Quit" class="ms-item" />
                </ui:VisualElement>

                <!-- Account view (#385). Every row opens the website in the system browser. -->
                <ui:VisualElement name="view-account" class="ms-view ms-hidden">
                    <ui:Button name="btn-privacy" text="Privacy Policy" class="ms-item" />
                    <ui:Button name="btn-terms" text="Terms of Service" class="ms-item" />
                    <ui:Button name="btn-delete-account" text="Delete account" class="ms-item ms-item--danger" />
                    <ui:Button name="btn-account-back" text="Back" class="ms-item emb-back" />
                </ui:VisualElement>

                <!-- Confirm view — SHARED, not concede's own (2026-09-02). Two things now need a
                     confirm and a second copy of this panel would drift from the first, so the
                     controller fills the title, the subtitle and the button, and holds the action.
                     The text below is the concede wording only because it is the one that existed
                     first; nothing reads it. -->
                <ui:VisualElement name="view-confirm" class="ms-view ms-hidden">
                    <ui:Label name="confirm-title" text="Concede this match?" class="ms-title" />
                    <ui:Label name="confirm-subtitle" text="This counts as a loss." class="ms-subtitle" />
                    <ui:Button name="btn-confirm" text="Concede" class="ms-item ms-item--danger" />
                    <ui:Button name="btn-cancel" text="Cancel" class="ms-item" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
