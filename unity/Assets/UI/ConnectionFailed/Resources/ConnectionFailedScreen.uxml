<?xml version="1.0" encoding="utf-8"?>
<!--
  ConnectionFailedScreen.uxml — #232: the boot-failure recovery panel. Whatever loading/versus
  overlay is already up when a networked match fails to start (deck rejected, no seat, dead
  server, ...) stays up behind this and keeps showing the failure text; this panel is the only
  way OUT of that state short of killing the app — before it, the player was simply stuck.

  Built at runtime by NetworkedGameBootstrap.BootFailed via Resources, same pattern
  MatchSettingsController uses for its own UXML. Reuses .mm-modal / .mm-modal__panel etc. from
  mainmenu.uss instead of inventing a second modal language — this is the same "one thing you
  must resolve before anything else" shape as the account switcher.

  UpdateGateOverlay builds from this same tree: it rewrites the title and the reason, removes
  Back, and turns Retry into its one button; its waiting state removes the whole
  .mm-modal__actions row. Renaming an element or that class here breaks both.

  .emb-root IS LOAD-BEARING. This tree is its own UIDocument, so no screen root is above it, and
  every token the .mm-modal__* rules read (the type scale, the spacing run, the touch floor) is
  declared on .emb-root and nowhere else. Without it each var() is unresolved, USS drops the
  declaration, and the panel renders at Unity's default 12px type with a button as tall as its
  text. That shipped from #232 until 2026-10-12, when Sam met the Update button on a phone.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../Common/theme.uss" />
    <Style src="../../MainMenu/mainmenu.uss" />

    <ui:VisualElement name="modal" class="emb-root mm-modal mm-modal--blocking emb-bleed">
        <ui:VisualElement name="panel" class="mm-modal__panel">
            <ui:Label name="title" text="Couldn't reach the match" class="mm-modal__title" />
            <ui:Label name="reason" text=" " class="mm-modal__help" />
            <ui:VisualElement class="mm-modal__actions">
                <ui:Button name="btn-back" text="Back to menu" class="mm-modal__button emb-back" />
                <ui:Button name="btn-retry" text="Retry" class="mm-modal__button emb-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
