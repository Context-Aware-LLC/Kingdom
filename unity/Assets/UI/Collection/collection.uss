/* ---------------------------------------------------------------------------------------------
 * Was Assets/UI/Deckbuilder/deckbuilder.uss until 2026-08-25 (#161). It was never shared: by then
 * its ONLY consumer was CollectionScreen.uxml, which already loaded this file straight after it.
 *
 * PREPENDED, NOT APPENDED, AND THAT IS LOAD-BEARING. The screen loaded theme -> deckbuilder ->
 * collection, so collection's rules won every equal-specificity tie. Appending would have
 * silently inverted that on every selector the two sheets both touch.
 *
 * THE CARD SIZE LIVES IN THIS FILE — see the --card-tile-width/--card-tile-height block on
 * .collection-list below. CardWall reads those two and may only shrink them to fit whole rows.
 * --------------------------------------------------------------------------------------------- */

/*
 * S7 screen styles. Consumes tokens from Common/theme.uss only (no literal colors/sizes that a
 * token already names). dev-docs/ui/client-surfaces.md:22.
 * UI Toolkit note: no `gap` — spacing is margins; layout is flexbox.
 *
 * `.deckbuilder` was declared here and worn by NOTHING — no UXML, no AddToClassList. It styled the
 * screen root of the deckbuilder plate that #153 merged away. Deleted 2026-08-25 (#161); the live
 * root is `.emb-root.collection`.
 */

/* The screen had a header carrying the character's name, the deck's name and the count. It is
 * gone (Sam, 2026-08-07): the first two are on the roster, one screen back. */
/* Back + count share a row at the top of the deck panel (Sam, 2026-08-09) — Back used to be its
 * own footer row below the legality box, which is gone (see deck-header's UXML comment). */
.db-deck-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}
.db-count {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
    -unity-text-align: middle-right;
}
.db-pill {
    font-size: var(--type-label);
    -unity-font-style: bold;
    color: var(--surface-0);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
}
.db-pill--valid   { background-color: var(--positive); }
.db-pill--invalid { background-color: var(--warning); }

/* ---------- Body / split ---------- */
.db-body {
    flex-direction: row;
    flex-grow: 1;
}
.db-panel {
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    padding: var(--space-4);
}
/* 70/30 split (Sam, 2026-08-01) — collection reads as the primary surface, deck as the sidebar. */
.db-collection { flex-grow: 7; margin-right: var(--space-4); }
.db-deck       { flex-grow: 3; min-width: 360px; }
.db-panel-title {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-2);
    margin-bottom: var(--space-3);
}

/* ---------- Filter chips ---------- */
.db-chip {
    font-size: var(--type-label);
    color: var(--ink-2);
    padding: var(--space-1) var(--space-4);
    margin-right: var(--space-2);
    height: var(--touch-min);
}

/* ---------- Lists ---------- */
/* THE ONE MEMBER OF THE DECK COLUMN THAT MAY YIELD, and the only one that can do it harmlessly:
 * it is a ListView, so it scrolls what it cannot show. min-height: 0 is what lets it actually
 * reach zero rather than floor on its content and push the deficit back onto its pinned siblings. */
.db-list {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--surface-1);
    border-radius: var(--space-2);
}


/* ---------- Collection wall (§2.9 wall tile — the REAL card, baked by CardFaceBaker, not a
 * UI Toolkit re-implementation of the card front) ---------- */
/* ---------------------------------------------------------------------------------------------
 * THE CARD TILE SIZE. This is the authoring surface — change the card size here, not in C#.
 *
 * CardWall reads these two through CustomStyleResolvedEvent and may only SHRINK them, to make
 * whole rows fit a short viewport; it never grows them. So the number below is the number on
 * screen on every device tall enough for two rows of it, which is every phone and every desktop.
 *
 * UNITLESS ON PURPOSE. A CustomStyleProperty<float> reads a number, not a length, so `384px`
 * would not resolve.
 *
 * THE UNIT IS PANEL px, AND THE PANEL IS 1080 TALL ON EVERY DEVICE. It runs ScaleWithScreenSize
 * against 1920x1080 matched on height, so a landscape panel is 1080 tall and 1080 * aspect wide
 * — 2400 x 1080 on a Pixel 5a. A tile is therefore a several-hundred number, not a ~150 one.
 * (It WAS ~150: until #349 the panel ran ConstantPhysicalSize and one authored px was one
 * Android dp, which made a phone panel 411 units tall. Every number in this file predating
 * 2026-09-01 was authored against that and reads ~2.6x too small.)
 *
 * Aspect is preserved from whatever pair is authored here, so keep width/height near 0.712 (the
 * card frame's own proportions) unless the frame art changes too.
 * ------------------------------------------------------------------------------------------- */
.collection-list {
    flex-grow: 1;
    min-height: 0;

    /* Was the `expanded` step of a three-step screen-class run; #349 retired the run, because
     * the panel's short axis is now a constant 1080 and only that step could ever fire. These
     * are the values that were actually rendering on every device. */
    --card-tile-width: 274;
    --card-tile-height: 384;
}
.card-tile {
    /* width/height AND all four margins are written as inline styles by CardWall.Layout, from the
     * --card-tile-* properties above. Nothing declared here would survive, so nothing is: this
     * block once carried a 350x477 that no build had used since the solve landed, and it drifted
     * from both the header comment (276) and the C# constant (340) without anyone noticing —
     * three numbers for one tile, because none of them were read.
     * RETIREMENT TRIGGER: if CardWall stops writing the size inline, the size belongs here. */
    margin: var(--space-1) var(--space-2);
    background-color: var(--surface-3);   /* shows through until the bake resolves */
    -unity-background-scale-mode: scale-to-fit;
    border-radius: var(--space-2);
}
.collection-card-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
}
/* ListView still paints its item :hover state when selectionType is None. One item is one
 * five-card row here, so that default reads as a sixth interaction surface spanning unrelated
 * cards. CardWall owns the individual tile gestures; the recycling wrapper stays invisible.
 * The ID is deliberate: Unity's theme uses a compound selector and beat the former class-scoped
 * override. Both item class names cover the BaseVerticalCollectionView and ListView generations. */
#collection-list .unity-collection-view__item:hover,
#collection-list .unity-list-view__item:hover {
    background-color: rgba(0, 0, 0, 0);
}
/* The two opacities allowed on the wall, both per-CARD facts and never the wall's state — the
 * no-dimming ruling that removed .card-tile--disabled was about a full deck greying out all ~90
 * tiles at once, which neither of these can do (Sam, 2026-08-07). See
 * CollectionController.DecorateTile, which is the only thing that sets either, and CardWall.RefreshTiles.
 *
 * They must never both land on one tile — DecorateTile's `!unowned` term is what guarantees it:
 * opacity on one element does not stack, but the two are still different facts. */

/* Spent: the deck already holds every copy of this card you are allowed. Deckbuild only.
 * Halfway between its old 0.1, where you could barely tell a card was there, and the unowned
 * fade, so the two still read apart (Sam, 2026-10-05). */
.card-tile--maxed {
    opacity: 0.3;
}

/* Unowned: you hold no copy of this card. The opposite of spent — this is the one you are shopping
 * for, so it stays legible and reads as "not yours yet" rather than "gone". Both modes.
 *
 * THIS NUMBER IS THE TUNING KNOB. Too low and the wall goes dark for a new account, where nearly
 * every card is unowned — which is the no-dimming ruling's spirit even though its letter (per-card,
 * not wall-state) is satisfied. Sam's brief was "full colour, 100% opacity, your collection, mixed
 * in with those some dimmer unowned cards", so the contrast has to be readable at a glance without
 * the unowned half becoming furniture. */
.card-tile--unowned {
    opacity: 0.5;
}
/* Deck-side row (§2.3 full tiles are collection-only for now; the deck list stays a legible
 * full-width row for L1–L5 proof) */
.card-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 var(--space-3);
    margin: var(--space-1) var(--space-2);
    background-color: var(--surface-2);
    border-radius: var(--space-1);
    border-left-width: 4px;
    border-left-color: var(--class-neutral);
}
.card-row--disabled { opacity: 0.4; }
/* A fixed disc. It was 100% x 100% — a pill filling the whole row — before it was taken out.
 * The number takes the card's rarity colour (Sam, 2026-10-20), so the disc is dark with a mana
 * ring: rare blue on a mana-blue fill is unreadable. SetCardRow swaps exactly one modifier on. */
.card-cost {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--type-body);
    color: var(--rarity-common);
    background-color: var(--surface-0);
    border-width: 2px;
    border-color: var(--mana);
    border-radius: 999px;
    margin-right: var(--space-3);
}
.card-cost--common    { color: var(--rarity-common); }
.card-cost--rare      { color: var(--rarity-rare); }
.card-cost--epic      { color: var(--rarity-epic); }
.card-cost--legendary { color: var(--rarity-legendary); }
/* A Label resolves flex-shrink: 0, so without the shrink and min-width a long name grew past the
 * row and pushed the copy count off its right edge, where nothing showed it. */
.card-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--type-body);
    color: var(--ink-1);
}
.card-count {
    flex-shrink: 0;
    margin-left: var(--space-2);
    -unity-font-style: bold;
    font-size: var(--type-body);
    color: var(--ink-2);
}
/* ---------- Deck side ---------- */
/* The deck switcher (EF-046), the name field, Set Default and Delete Deck lived here. They are
 * all on the CharacterRoster screen now (Sam, 2026-08-07) — this panel edits one deck's 30 and
 * cannot change which deck, which deck is default, or whether it exists. */

.db-curve {
    /* See the note on .deck-drawer__back: unpinned, this collapsed under the deck name and drew
     * its bars and its 0..7+ labels through the text above it. */
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    height: 56px;
    margin-bottom: var(--space-3);
    padding: 0 var(--space-1);
}
.curve-col {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    margin: 0 1px;
}
.curve-bar {
    width: 60%;
    min-height: 2px;
    background-color: var(--mana);
    border-radius: 2px;
}
.curve-label {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-top: 2px;
}

/* ---------- Rarity / class modifiers (token-driven; set from C# by enum) ---------- */
.rarity--common    { background-color: var(--rarity-common); }
.rarity--rare      { background-color: var(--rarity-rare); }
.rarity--epic      { background-color: var(--rarity-epic); }
.rarity--legendary { background-color: var(--rarity-legendary); }

.edge--neutral    { border-left-color: var(--class-neutral); }
.edge--emberward  { border-left-color: var(--class-emberward); }
.edge--tidecaller { border-left-color: var(--class-tidecaller); }
.edge--gravekeep  { border-left-color: var(--class-gravekeep); }
.edge--verdant    { border-left-color: var(--class-verdant); }
.edge--clockwright { border-left-color: var(--class-clockwright); }
.edge--nightveil  { border-left-color: var(--class-nightveil); }
.edge--stonewarden { border-left-color: var(--class-stonewarden); }
.edge--tempest    { border-left-color: var(--class-tempest); }

/* ---------- Buttons ---------- */
.db-button {
    font-size: var(--type-body);
    -unity-font-style: bold;
    height: 48px;
    min-width: 140px;
    border-width: 0;
    border-radius: var(--space-2);
    padding: 0 var(--space-6);
}
/* Back sits in the deck-header row (§ deck side) — narrower than .db-button's default so it
 * reads as a corner control next to the count, not a footer; but still 48px tall for touch. */
.db-button--back {
    height: var(--space-12);
    min-width: 84px;
    padding: 0 var(--space-4);
}
.db-button--cta {
    color: var(--surface-0);
    background-color: var(--accent);
}
.db-button--ghost {
    color: var(--ink-2);
    background-color: var(--surface-3);
}
.db-button:disabled { opacity: 0.35; }

/* =============================================================================================
 * BELOW: the collection's own sheet, unchanged.
 * ============================================================================================= */

/* collection.uss — the full-pool browse surface.
 *
 * Tokens come from theme.uss; only what is specific to this screen lives here. The tile itself is
 * deliberately NOT restyled: .card-tile is declared once at the top of this file and its compact size is
 * a contract with CardWall, which promotes it to larger responsive tiers at runtime. A second
 * .card-tile rule here would be a second source of truth for one number, which is the exact shape
 * of the card-frame drift this project already paid for.
 *
 * A USS parse error voids the WHOLE stylesheet silently — one bad declaration and every rule in
 * this file stops applying, with nothing logged. Keep declarations complete.
 */

.collection {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--surface-0);
    background-image: url("/Assets/Art/Backgrounds/CollectionPlate_Vault.png");
    -unity-background-scale-mode: scale-and-crop;
    /* The wall spends its full short axis: no bottom framing. The controls are an overlay and
     * never consume flow space. (A screen-class run once stepped a padding-bottom in here; its
     * only reachable step had that declaration commented out, so retiring the run in #349
     * changed nothing.) */
    padding: 0 var(--space-6) 0;
}

/* Owned vs All is runtime state: CollectionController is the only writer of the visible modifier. */
.col-scope {
    display: none;
    flex-direction: row;
}
.col-scope--on {
    display: flex;
}

.col-button {
    min-height: var(--space-12);
    padding: var(--space-2) var(--space-6);
    color: var(--ink-1);
    font-size: var(--type-label);
}
.col-button--decks {
    min-width: 120px;
    margin-right: var(--space-3);
}
/* A tab hanging from the top-LEFT, because that is now the edge its drawer arrives from. It was
 * centred (`left: 50%; translate: -50% 0`) while the drawer came down across the full width. */
.col-button--filters {
    position: absolute;
    top: 0;
    left: 0;
    width: 176px;
    height: 72px;
    min-height: 72px;
    padding: var(--space-2) var(--space-3) var(--space-1);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(240, 166, 60, 0.82);
    border-radius: 0 0 var(--space-2) var(--space-2);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.col-button--filters-on {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.col-filter-ribbon__label {
    color: rgb(250, 230, 193);
    font-size: var(--type-label);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
/* TWO ROTATED BARS, NOT A GLYPH. This was `<ui:Label text="⌄">` — U+2304 DOWNWARDS CHEVRON —
 * and the font does not have it, so the FILTERS button's only affordance rendered as a
 * missing-glyph box. Seen in a device-dp capture 2026-08-25.
 *
 * Swapping in a different arrow character would just be the same bet on a different code
 * point. .ms-gear already solved this and says why in settings.uss: "Three bars are child
 * VisualElements so the icon is font-independent." Same treatment here. */
.col-filter-ribbon__chevron {
    width: 22px;
    height: 12px;
    margin-top: 2px;
}
.col-filter-ribbon__chevron-arm {
    position: absolute;
    top: 3px;
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background-color: var(--accent);
}
.col-filter-ribbon__chevron-arm--left {
    left: -1px;
    rotate: 40deg;
}
.col-filter-ribbon__chevron-arm--right {
    right: -1px;
    rotate: -40deg;
}
.col-button--filters.chrome-button:active {
    translate: 0 1px;
}

/* Query toolbar + left drawer
 * The toolbar is an overlay declared after the wall in UXML: it paints above the cards but owns no
 * flow height. Its own picking is ignored so the transparent span does not swallow wall gestures;
 * the three Button children remain pickable. The query drawer follows it and therefore paints above
 * both toolbar and wall while open.
 *
 * `top` clears the class rail, which is IN FLOW above the wall as of 2026-08-31 — this overlay is
 * positioned against the screen ROOT, so at top:0 it painted over the rail's nine tabs and ate
 * their taps. It tucks under the rail's bottom edge; the 4dp of the rail's own margin-bottom is
 * deliberately not added, so the tab reads as hanging FROM the strip rather than floating below it.
 */
.col-query-toolbar {
    position: absolute;
    top: var(--touch-min);
    left: var(--edge-safe);
    right: var(--edge-safe);
    height: 72px;
}
.col-query-scrim {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.col-query-scrim--open {
    display: flex;
}
/* Outside taps dismiss the deck CHOOSER. ShowDrawerPane hides this layer while editing so
 * card clicks and wheel events reach the wall. Back still closes the selected deck.
 * Declared before the drawer so its buttons and rows remain above the dismiss layer. */
.deck-drawer-scrim {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.deck-drawer-scrim--open {
    display: flex;
}
/* THE FILTER DRAWER IS A LEFT COLUMN (Sam, 2026-08-31), mirroring .deck-drawer on the right.
 *
 * It used to span left:0 to right:0 and slide DOWN, spending up to 332dp of a 411dp screen — the
 * SCARCE axis — to show controls that stack perfectly happily in a column. As a left column it
 * spends the abundant one, and the wall stays readable behind it instead of being buried.
 *
 * The width contract is deck-drawer's, deliberately: two drawers that arrive from opposite edges
 * and land on different widths read as two unrelated mechanisms.
 *
 * --edge-safe ON THE LEFT ONLY, and the asymmetry is measured rather than assumed. The left IS a
 * screen edge and the cutout is 52dp deep on a SIDE — it flips sides with rotation direction, which
 * is why the token is spent wherever a panel meets a short edge rather than on the side some API
 * happens to name. The drawer's right edge is interior and takes the ordinary gutter.
 *
 * TOP AND BOTTOM DO NOT PAY. The Pixel 5a's insets, read over USB 2026-08-21, are
 * ROTATION_90 [136,0][0,63] and ROTATION_270 [0,0][136,63] — left/right flip, top is 0 in BOTH, and
 * the 63 at the bottom is the gesture bar, which is hidden. The game is landscape-locked (NOR-283),
 * so no rotation puts a cutout on this panel's top or bottom. This is a LIST, and 52 on each would
 * cost it 104dp of a 411dp column for nothing — the same arithmetic .deck-drawer states.
 *
 * Painting to the edge is correct; putting CONTENT there is not — the .emb-bleed idea, just not all
 * four sides of it. Declared in audit_edge_safety.py's TOKEN_EXCEPTIONS.
 *
 * THE OLD COMPACT HEIGHT BUDGET IS GONE, not merely stale: it read "the search row, optional scope
 * row and three chip rows total at most 332dp of 411, and the 79dp remainder is the outside-tap
 * target that closes this drawer". In a column the rows stack and exceed the panel height instead,
 * which is why .col-query-scroll below exists and why the outside-tap target is now the wall to the
 * RIGHT of the drawer. There is no height budget to keep in sync any more.
 *
 * translate, never width: animating width would emit a GeometryChangedEvent every frame and
 * continuously relayout the fixed-size CardWall tiles. Same reason .deck-drawer gives. */
.col-query {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 18%;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--edge-safe);
    background-color: rgba(8, 12, 18, 0.98);
    border-right-width: 2px;
    border-right-color: var(--accent);
    translate: -110% 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.col-query--open {
    translate: 0 0;
    opacity: 1;
}
/* The rows overflow a 411dp column — see the UXML comment for why the fade is the ScrollView's
 * SIBLING and not its child. min-height:0 is what lets the ScrollView actually shrink to the
 * drawer rather than flooring on its content and pushing the overflow out of the panel. */
.col-query-scroll {
    flex-grow: 1;
    min-height: 0;
}
/* THE TINT IS THE HALF THAT MATTERS. `.emb-scroll-fade` ships a WHITE ramp so one texture can serve
 * every surface; the colour has to come from the use site, and here that is this drawer's own
 * rgba(8, 12, 18, 0.98). Drop this rule and the filter list fades to white. */
.col-query__fade {
    -unity-background-image-tint-color: rgb(8, 12, 18);
}
/* A COLUMN, not a row. Search + sort + sort-dir + reset shared one line across a full-width top
 * drawer; in a ~420dp column they stack. The 56/106/156px side margins that used to centre this
 * row inside the forged brackets' inner bay went with the brackets — there is no bay to centre in,
 * and a fixed side margin here would eat a quarter of the drawer's width at compact. */
.col-query-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: var(--space-2);
}
.col-query-utility-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}
.col-query-actions {
    position: absolute;
    top: var(--space-2);
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}
/* Bigger corner nav pass (Sam, 2026-09-27): 64 (up from --touch-min's 56), and `top` above moved
 * from --space-3 to --space-2 so 8+64=72 stays flush with `.col-query-toolbar`'s own 72px row
 * instead of overrunning it. */
.col-query-actions .col-button {
    min-height: 64px;
    height: 64px;
    padding: 0 var(--space-4);
    font-size: var(--type-body);
}
.col-query-actions .col-button--decks {
    min-width: 96px;
}
/* BACK MOVES TO THE BOTTOM-LEFT (Sam, 2026-09-07): it used to share `.col-query-actions`' top-right
 * row with Decks, crowding both against the deck-drawer's own Close when the drawer was open.
 * The canonical `.emb-back-button` (theme.uss, 2026-09-27) is what every screen's Back control
 * uses now. */
/* `max-width: 58%` is gone with the row: it kept the search field from swallowing a full-width
 * drawer's line. In a column it would cap the field at 58% of ~370dp and leave the sort control
 * beneath it visibly wider, which reads as a broken alignment rather than a deliberate one. */
.col-search {
    margin-bottom: var(--space-2);
}
/* Stacked, so each control takes the drawer's width and the gap is vertical. These carried
 * width: 200/132/120 and margin-right while the four sat on one line. */
.col-sort {
    margin-bottom: var(--space-2);
}
.col-sort-dir {
    margin-bottom: var(--space-2);
}
#query-reset {
    margin-bottom: var(--space-2);
}
/* Wrapping remains the fallback for split-screen and unusually narrow panels. At the measured
 * compact phone width, the wider bay and compact chip step below keep each known facet on one row. */
.col-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    justify-content: center;
}
/* The 56/106/156px side margins here defined the narrower bay the forged brackets framed. Both the
 * brackets and the bay are gone; in a ~370dp content column those margins left roughly one chip's
 * width of usable row. */
.col-chip-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.collection .db-chip {
    min-height: 56px;
    height: 56px;
    padding: 0 var(--space-6);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.42px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    color: var(--ink-2);
    font-size: var(--type-body);
    transition-property: -unity-background-image-tint-color, color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.collection .db-chip:hover,
.collection .db-chip:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: var(--ink-1);
}
.collection .db-chip:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(196, 204, 214);
}
.collection .db-chip.db-chip--on {
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.42px;
    -unity-background-image-tint-color: rgb(255, 239, 211);
    color: rgb(250, 230, 193);
}
.collection .db-chip:disabled {
    opacity: 0.42;
}

#query-rarities .db-chip,
#query-types .db-chip {
    width: 132px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

/* One expansion per row, a single stack under the cost chips. */
#query-sets {
    flex-direction: column;
    align-items: center;
}
#query-sets .db-chip {
    width: 264px;
    margin-bottom: var(--space-2);
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

#query-costs .db-chip {
    width: 64px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

/* ---------- Wall ---------- */

/* Shown by CollectionController only when a query matches nothing. A wall that goes blank with no
 * text reads as a broken screen rather than an empty result. */
.col-empty {
    font-size: var(--type-h2);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
    display: none;
}
.col-empty--on {
    display: flex;
}

/* ---------- Persistent collection shell (NOR-210) ---------- */
.collection .db-collection {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin-right: 0;
}
/* NOTHING hides the plate here. `.collection--editing` is stamped on the PLATE
 * (CollectionController.StampEditing), so a bare `display: none` on it removes the whole
 * collection — wall included — from layout. That is what a
 * `.collection--editing { display: none; }` rule did between e034c700 (2026-08-16) and its
 * removal: opening the deck editor rendered an empty screen with no error, because a hidden
 * subtree is skipped by Yoga rather than failing. The symptom was
 * `[NOR-360] content.h=NaN layouts=1` — an unresolved layout, not a zero-height one.
 *
 * It arrived by editing a selector down to nothing: the rule was
 * `.collection--editing #query-classes { display: none; }` and the commit that deleted the
 * #query-classes control deleted the SUBJECT of the selector instead of the rule, leaving the
 * state modifier to apply on its own. Any rule whose selector is a lone `--` state modifier
 * with `display: none` is that mistake; a modifier describes a state, and something inside it
 * is what should be hidden. */

/* ---------- Deck drawer ----------
 * Absolute positioning and translate animation are load-bearing. Animating width would emit a
 * GeometryChangedEvent every frame and continuously relayout the fixed-size CardWall tiles. */
.deck-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 18%;
    /* min-width: 420px; */
    /* Three of this drawer's four sides ARE screen edges (top, right, bottom);
       its left is interior, so it takes the ordinary gutter there. .emb-bleed
       would pad all four by --edge-safe and leave 120px of usable column at the
       420px minimum, which is why this uses the token directly instead of the
       class. Declared in audit_edge_safety.py's TOKEN_EXCEPTIONS.

       Only the RIGHT spends --edge-safe. The drawer's top and bottom are screen
       edges with nothing on them -- the cutout is on a side and the gesture bar
       is hidden (see the token in theme.uss) -- and this is a LIST, so 52 on each
       cost it 104dp of a 411dp panel, about two deck rows, for nothing.

       THIS DECLARATION WAS DEAD TWICE OVER until 2026-08-30 and the drawer was
       simply running at a flat 24px. `--space-5` is not a token -- the scale is
       1/2/3/4/6/8/12/16 -- and ONE unresolvable var() invalidates the WHOLE
       shorthand, silently. On top of that `.deck-drawer.chrome-panel--outer`
       below re-declared `padding: 24px` at higher specificity. So the right edge
       never had its --edge-safe and the Close button sat under the hole-punch.
       Both are fixed; if you add a padding rule for this element, put it HERE. */
    padding: var(--space-4) var(--edge-safe) var(--space-4) var(--space-6);
    background-color: var(--surface-2);
    border-left-width: 2px;
    border-left-color: var(--accent);
    translate: 110% 0%;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.deck-drawer--open {
    translate: 0% 0%;
    opacity: 1;
}
.deck-drawer__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    min-height: 10%;
}
.deck-drawer__title {
    font-size: var(--type-h1);
    -unity-font-style: bold;
    color: var(--ink-1);
}
.deck-drawer__subtitle {
    font-size: var(--type-label);
    color: var(--ink-2);
}
/* The recessed plate, and the coordinate space the bottom fade anchors to. The ScrollView
 * inside it is bare. See the UXML comment for why the fade cannot be the ScrollView's own child. */
/* padding-bottom reserves `.deck-drawer__manage`'s own footprint (58px + its var(--space-6)
 * bottom offset = 82) now that button is position: absolute and no longer in this flex column to
 * push the frame up on its own -- without it the scroll list runs its last rows under the
 * floating button instead of stopping short of it. */
.deck-chooser-frame {
    flex-grow: 1;
    padding-bottom: 82px;
}
.deck-chooser {
    flex-grow: 1;
}
/* THE TINT IS THE HALF THAT MATTERS. `.emb-scroll-fade` ships a WHITE ramp so one texture can
 * serve every surface; the colour has to come from the use site, and it is the plate this fade
 * sits on -- `.deck-drawer.chrome-panel--outer` now that the chooser's own recessed plate is
 * gone, nearly opaque so the ramp's own alpha is the only thing varying. Drop this rule and the
 * deck list fades to white. */
.deck-chooser__fade {
    -unity-background-image-tint-color: rgb(18, 23, 31);
}
.deck-chooser--hidden,
.deck-editor--hidden {
    display: none;
}
.deck-chooser__list {
    flex-grow: 1;
}
.deck-chooser__empty {
    display: none;
    font-size: var(--type-body);
    color: var(--ink-2);
    -unity-text-align: middle-center;
    margin-top: var(--space-8);
}
.deck-chooser__empty--on {
    display: flex;
}
.deck-choice-group {
    margin-bottom: var(--space-2);
}
.deck-choice-character {
    font-size: var(--type-h2);
    -unity-font-style: bold;
    color: var(--ink-1);
    margin-bottom: var(--space-1);
}
.deck-choice {
    min-height: 64px;
    /* margin-bottom: var(--space-2); */
    padding: 0;
    border-width: 0;
    border-radius: var(--space-2);
    overflow: hidden;
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(222, 227, 234);
    color: var(--ink-1);
    font-size: var(--type-body);
    -unity-text-align: middle-left;
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.deck-class-portrait--drawer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.deck-choice:hover .deck-class-portrait--drawer,
.deck-choice:focus .deck-class-portrait--drawer {
    opacity: 0.88;
}
.deck-choice:hover,
.deck-choice:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.deck-choice:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(196, 204, 214);
}
.deck-editor {
    flex-grow: 1;
}
/* EVERY FIXED-SIZE MEMBER OF THIS COLUMN CARRIES flex-shrink: 0, and `.db-list` is the one
 * element allowed to yield. A flex child shrinks by default, and a Label shrunk below its line
 * box STILL DRAWS ITS TEXT -- which is why an over-subscribed drawer rendered "New Deck", the
 * mana curve and "0 / 30" on top of one another instead of clipping or scrolling. Pinning some
 * of the column and not the rest is worse than pinning none: `.deck-drawer__manage` was pinned
 * alone, so the whole deficit landed on its unpinned siblings. Add a sibling here, pin it. */
.deck-drawer__back {
    font-size: var(--type-body);
    flex-shrink: 0;
    height: var(--space-12);
    /* margin-bottom: var(--space-3); */
    border-width: 0;
    border-radius: var(--space-2);
    background-color: var(--surface-3);
    color: var(--ink-2);
    -unity-text-align: middle-left;
}
/* Keep the deck count right-aligned above the mana curve. */
.deck-editor__identity {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
}
/* A save the server did not take. Out of the layout until there is one, because every px it
 * holds comes off `.db-list`. CollectionController.ShowDeckSaveFailed owns the modifier. */
.deck-save-failed {
    display: none;
    flex-shrink: 0;
    margin-top: var(--space-3);
}
.deck-save-failed--on {
    display: flex;
}
.deck-save-failed__text {
    font-size: var(--type-label);
    color: var(--negative);
    white-space: normal;
    margin-bottom: var(--space-2);
}
.deck-save-failed__discard.chrome-button {
    min-height: var(--touch-min);
    height: var(--touch-min);
    font-size: var(--type-body);
    color: var(--ink-1);
}
/* SITS ALONGSIDE `.ms-gear` (settings.uss), not stacked above it (Sam, 2026-09-07). That
 * button is the persistent corner settings gear CollectionController mounts on this same screen
 * (Sam, 2026-09-05: "same corner settings gear as the main menu"), anchored 24px from the right
 * and shifted another 52px by its `.emb-edge` margin. At 68px wide its LEFT edge is therefore
 * 144px from the screen edge. This button stops the safe inset plus 108px from that edge (160px
 * with the current token), a 16px gap short of the gear. It used to run 44px beneath it, but the
 * gear's sprite has clear corners now (2026-09-30), and this button's ember showed through them
 * as if the gear's corners were filled. Their bottom/height match
 * (var(--space-6), 68px -- updated 2026-09-27 alongside `.ms-gear`) so the two read as one row.
 * Pulling this button out of the drawer's flex column into position:absolute is what makes that
 * alignment exact -- a flex sibling can't be told "match this unrelated element's bottom" any
 * other way. left matches the drawer's own left padding (var(--space-6)) so it still reads as
 * flush with the rest of the drawer's content above it. */
.deck-drawer__manage {
    position: absolute;
    left: var(--space-6);
    right: var(--edge-safe);
    margin-right: 108px;
    bottom: var(--space-6);
    height: 68px;
    border-width: 0;
    border-radius: var(--space-2);
    color: var(--ink-1);
    background-color: var(--surface-3);
    font-size: var(--type-body);
    -unity-font-style: bold;
}

/* The class strip is a centred row of nine compact portrait controls (Sam, 2026-09-01).
 *
 * WHY IT IS HORIZONTAL. It was a 130px column on the left of `body`; on the 411-tall panel it was
 * authored against, nine tabs sharing that axis came to 45.7 each, under the touch floor, and
 * 9 x 48 could not fit. THAT ARITHMETIC NO LONGER FORCES IT (#349): nine tabs share 1080 now. It
 * stays horizontal because a nine-item rail down the side of a card wall spends the axis the wall
 * needs, which is the reason that did not depend on the unit. The explicit size also stops a wide
 * monitor stretching portraits into banners.
 *
 * SPACING IS `margin-left`, NOT `justify-content: space-between` (Sam, 2026-09-08). The strip used
 * to be a fixed 600px box with the tabs' own width distributing whatever it didn't use across the
 * eight gaps automatically -- so growing a tab also silently shrank its neighbours' gap. Fixed
 * per-tab margins make the gutter a number you set, not one that falls out of how much of the 600
 * the tabs happen to fill; `#class-tab-bar`'s own width below is sized to the tabs' authored total
 * so nothing is left over to distribute in the first place.
 *
 * HEIGHT AND CARD ROWS. The rail is 64dp: 60dp portraits after their 4dp top inset. It remains in
 * flow, but its former 4dp bottom gap and the wall shell's decorative vertical padding are removed
 * below. On compact screens that leaves CardWall above the 336dp threshold for two authored 160dp
 * cards plus margins; medium and expanded reclaim still more height. CardWall's separate 8dp
 * rounding reserve remains untouched so the last row cannot clip on device pixels.
 *
 * POSITION: ABSOLUTE, NOT IN FLOW (Sam, 2026-09-07, confirmed live in the Unity UI Debugger).
 * The strip used to reserve its own height in `root`'s column flow, pushing `body` (and the card
 * wall inside it) down by exactly that much. Now that the wall's own panel is invisible chrome
 * over a fixed clip boundary (see `#collection-panel`), that reservation is no longer needed --
 * the strip floats over the top of the wall instead, and `#collection-panel`'s own margin-top is
 * the only clearance left to tune. `left: 50%; translate: -50% 0` centers it without depending on
 * a literal half-width offset, so it still centers correctly if `max-width: 100%` ever actually
 * clamps the 600px on a narrow device.
 *
 * "FLOATS OVER THE TOP OF THE WALL" WAS ASPIRATIONAL UNTIL TODAY (Sam, 2026-09-08). This element
 * was declared BEFORE `body` in CollectionScreen.uxml, and UI Toolkit paints and hit-tests later
 * siblings OVER earlier ones -- so wherever a baked card tile reached this strip, the tile painted
 * (and picked) on top of it. That is why the tabs read as untargetable regardless of how much
 * clearance `#collection-panel`'s margin-top left below: no vertical offset fixes a z-order
 * inversion. It is now declared AFTER `body`, so the strip is unconditionally on top and a tab is
 * clickable no matter how tight the clearance above the wall gets. NOTE: theme.uss's own
 * measurement says vertical hardware clearance is ZERO on this axis (the cutout is left/right
 * only, confirmed on a Pixel 5a) -- the offset below is legibility clearance for the first card
 * row, not a safe-area workaround; it was originally added on that theory before the paint-order
 * bug was found, and is kept because the strip still needs SOME headroom to read as its own row.
 *
 * TOP: 82px (52 + 30, Sam, 2026-09-08 -- "there's a lot of space between the [card] rows, let's
 * capitalize on that"). `#collection-panel`'s margin-top below is set to this strip's own bottom
 * edge (top + height, both authored here), so the wall's first row starts exactly where the strip
 * ends -- flush, matching the tabs' flat-bottomed shape, no gap and (now that z-order is fixed) no
 * harm if a future height tweak leaves a sliver of intentional overlap instead. Whichever of the
 * two numbers changes, walk to `#collection-panel` and update the other -- USS drops calc()
 * silently (see theme.uss's own warning), so this can't be written as one formula.
 *
 * WHY THE FIRST FIX MADE IT WORSE (Sam, 2026-09-08: "centering is worse but its fine" -- fixed
 * anyway, it's the same math this comment already got wrong once). `flex-grow: 0; flex-shrink: 0;`
 * on `.class-tab_art` means `flex-basis` alone sizes the tab on this row's main axis -- `width` is
 * not consulted at all once flex-basis is a definite length, same as plain CSS flexbox. The WIDTH
 * total below was computed off `width` (123) instead of the number actually rendering (flex-basis,
 * 99), so the box came out 216px too wide, the flex-start-aligned tabs sat flush left inside it,
 * and centering that oversized box put the visible tabs 108px LEFT of centre -- worse than the
 * 7.5px right-of-centre the previous, off-by-one-margin box had. `width` is deleted below rather
 * than reconciled: keeping two numbers that don't both apply is exactly how this happened twice.
 *
 * WHY IT LOOKED OFF-CENTRE, the ORIGINAL finding: the first `margin-left` pass put one on every
 * tab, `class-tab-emberward` included -- so the box had a 15px gap before the first tab and none
 * after the last, and `translate: -50%` centers the BOX, not the tabs inside it. `#class-tab-emberward`
 * below zeroes its own margin so the gutter is between tabs only (8 gaps for 9 tabs, not 9).
 *
 * WIDTH: 1091px = 9 tabs x 99 (flex-basis, the ONLY sizing property on `.class-tab_art` now) +
 * 8 gaps x 25 margin-left. Grow a tab or the gutter and this needs the same arithmetic redone by
 * hand -- no calc(). Getting it wrong under-sizes the box, which does not clip the tabs (nothing
 * here sets overflow) but does throw off `left: 50%; translate: -50% 0`, which centers against
 * this width, not the tabs' actual total. */
#class-tab-bar {
    position: absolute;
    top: 85px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    width: 1091px;
    max-width: 100%;
    height: 99px;
}
.class-tab_art {
    flex-grow: 0;
    flex-shrink: 0;
    /* THE ONLY SIZING PROPERTY -- no separate `width` (see `#class-tab-bar`'s comment above for why
     * carrying one was the bug). 99, up from 89 (Sam, 2026-09-08: "+10 width"). */
    flex-basis: 100px;
    /* +4dp top margin below = 97, this strip's height. Grow this and the strip's own height
     * together. */
    height: 95px;
    /* 25, not 15 (Sam, 2026-09-08: "+10 to the left margin"). See `#class-tab-emberward` below --
     * the first tab overrides this to 0 so the gutter reads as BETWEEN tabs, not before the first
     * one too, which is what centering the box actually requires. */
    margin-left: 25px;
    border-radius: 18px 18px 0 0;
    margin-top: var(--space-1);
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
/* No margin BEFORE the first tab -- see the "WHY IT LOOKED OFF-CENTRE" note on `#class-tab-bar`.
 * `.class-tab_art`'s margin-left is the gutter between tabs; the leftmost tab isn't between
 * anything on its left, so it doesn't get one. */
#class-tab-emberward {
    margin-left: 0;
}
/* THE CLASS -> HERO-POWER-ART MAP MOVED TO Common/theme.uss (2026-09-03). It is not a collection
 * concern: the character-create picker needs the same eight images to put a class's hero power on
 * its plate, and a second copy of a map whose keys do not match its values -- TEMPEST is storm_hp,
 * CLOCKWRIGHT is clock_hp -- is the exact shape of thing that drifts. The selector names are
 * unchanged, so this screen's UXML and CollectionController.WireClassTabs need no edit; theme.uss
 * loads before this file on every screen that has both. */
.class-tab_art-neutral {
    background-image: url("/Assets/Art/UI/hptabs/neutral_hp.png");
}

/* Two states over that base, and they are about different questions.
 *
 * --off answers "can this tab lead anywhere": the pool holds no card of that class, because the
 * player owns none of them or the open character's pairing excludes them. It is dimmed and its
 * picking is turned off in CollectionController.StampClassTabs, so it reads as present-but-spent
 * rather than missing. Sam's ruling (2026-08-18): the strip never changes shape. All nine tabs are
 * on screen in every state; scoping deactivates, it does not hide, so the strip a player learns the
 * position of is the strip they always get.
 *
 * The tint is what carries it. Opacity alone on a strip of full-bleed portraits still reads as
 * eight lit tabs, so the art is also tinted toward the surface it sits on. Neutral now has its own
 * king portrait and follows the same image treatment as the eight hero classes.
 *
 * --on says "this tab is filtering the wall" by CONTRAST ONLY -- it draws nothing of its own; the
 * gold frame it used to fade in was removed 2026-08-30 (see below). Once any class is selected,
 * --muted quiets the other available portraits and the unmuted one is the answer; with no selection
 * they all remain vivid because the wall is unconstrained and every available class is included.
 * --on is still stamped by CollectionController and is still the hook to style selection from. */
.class-tab_art {
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
/* THE SELECTED TAB HAS NO GOLDEN FRAME (Sam, 2026-08-30). `.class-tab-frame` -- an absolutely
 * positioned child inside every `.class-tab_art`, an accent border plus an 8% accent wash, faded
 * in by `--on` -- is gone, rules AND the nine elements that carried it. Selection is said by
 * `--muted` quieting the other eight, which is the whole of the answer now. Do not reintroduce a
 * frame here without reintroducing its element: a class with no body is what
 * audit_edge_safety.py PASS 5 exists to catch. */
.class-tab_art--muted {
    opacity: 0.6;
    -unity-background-image-tint-color: rgb(158, 164, 177);
}
.class-tab_art--off {
    opacity: 0.3;
    -unity-background-image-tint-color: rgb(104, 110, 124);
}

/* ---------- Collection chrome kit ----------
 * These five sprites are deliberately separate assets. They have different proportions, materials,
 * and slice borders; combining them into an atlas would make iteration harder without reducing the
 * number of UI Toolkit style references. USS slice values are repeated here so the treatment remains
 * deterministic even if an importer border is changed while another screen experiments with it. */
.chrome-panel {
    border-width: 0;
    border-radius: 0;
}
.chrome-panel--outer {
    background-color: rgba(18, 23, 31, 0.96);
    background-image: url("/Assets/Art/UI/Chrome/ui_panel_outer_forged.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.35px;
}
.chrome-panel--recessed {
    background-color: rgba(8, 12, 18, 0.88);
    background-image: url("/Assets/Art/UI/Chrome/ui_panel_recessed_slate.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.35px;
}

/* The two nested panel sprites replace the former flat wall while keeping the responsive card
 * contract untouched. Vertical padding here was zero from 2026-09-01 until 2026-09-05 (Sam: the
 * class rail spends the space, an empty ledge below the final row is not useful chrome), but zero
 * meant the ListView had nothing reserving the top/bottom border art from its own scrolled rows —
 * both frames' 9-slice borders sit ON TOP of card content the instant a row scrolls under them
 * (Sam, 2026-09-05: "cards go up and over the chrome"). --space-2/3 are fractions of the panel's
 * own height (see the authored-px note above `.collection-list`), not a device unit, so this is a
 * small clip margin, not the old ledge back. Bottom runs one step bigger than top (--space-3 vs
 * --space-2) — Sam, 2026-09-05, the last row still wanted a touch more room than the first.*/
/* TOP IS 0, NOT var(--space-2), AS OF THE CARD WALL PANEL GOING INVISIBLE (Sam, 2026-09-07).
 * The clip margin these two paddings reserved was for the 9-slice border ART, so a scrolled row
 * would duck under painted chrome instead of drawing over it (see the comment above). Both
 * panels are `visibility: hidden` below -- nothing paints there any more, so there is nothing
 * left to duck under, and the 16px (8 + 8) that used to read as a gap between the class-tab
 * strip and the first card row moved INTO that strip's own height instead of sitting here doing
 * nothing. The two moves are one change: grow the strip by exactly what you zero here, or
 * the first card row drifts off its on-load position. Bottom keeps its own reasoning untouched
 * -- that clip margin is still real paint (nothing hides the LAST row's chrome) and was never
 * about the tab strip. */
.collection .db-collection.chrome-panel--outer {
    padding: 0 20px var(--space-3) 20px;
    background-color: rgba(18, 23, 31, 0.96);
    overflow: hidden;
}
.collection .collection-list.chrome-panel--recessed {
    padding: 0 20px var(--space-3) 20px;
}
/* THE CARD WALL PANEL IS INVISIBLE, NOT GONE. Its `overflow: hidden` above is what pins the
 * scroll-clip boundary at the first card row's own top edge (now that the top padding is gone,
 * the two coincide exactly) -- deleting the element, or stripping its chrome-panel classes the
 * way the deck drawer's nested panes were flattened, would drop that clip with it and let
 * scrolled cards ride up past the class-tab strip. `visibility` does not touch layout or
 * clipping, only paint, so hiding it here keeps the box exactly where it is and removes only the
 * background/border chrome.
 *
 * `visibility: hidden` is INHERITED, so everything that still needs to render overrides back to
 * `visible` explicitly: the empty-state label, and the ListView's own scrollable content --
 * `#collection-list` itself carries the SAME recessed-panel chrome as its parent and stays
 * hidden too, on purpose, so only its rows escape via the content-container underneath it.
 *
 * margin-top (Sam, 2026-09-07, confirmed live in the Unity UI Debugger) is the clearance under
 * the absolutely-positioned `#class-tab-bar` -- that strip no longer reserves flow space (see its
 * own rule), so without this the wall would start flush at the screen edge.
 *
 * 179px = #class-tab-bar's OWN top (82) + height (97) -- written out, not calc(), because USS
 * silently drops calc() (see theme.uss's own warning) and a dropped declaration here reads as "no
 * clearance at all" rather than an error. This puts the wall's first row exactly flush against the
 * strip's bottom edge, which is now safe to run tight against (2026-09-08): the strip paints and
 * hit-tests ON TOP of the wall (it is declared after `body` in the UXML), so even a tab that dips
 * into the first row's art stays clickable. Change either number and update the other to match. */
#collection-panel {
    visibility: hidden;
    margin-top: 179px;
}
#collection-empty {
    visibility: visible;
}
#collection-list .unity-scroll-view__content-container {
    visibility: visible;
}
/* NO PADDING HERE. This selector outranks `.deck-drawer`, so a padding written here silently
 * replaces the whole edge-clearance shorthand that rule authors -- which is exactly what
 * `padding: 24px` did from #228 until 2026-08-30. */
.deck-drawer.chrome-panel--outer {
    border-left-width: 0;
    background-color: rgba(18, 23, 31, 0.98);
}
/* THE DRAWER PANEL IS INVISIBLE, NOT GONE (Sam, 2026-09-07) -- same move as `#collection-panel`
 * above, and the answer to "opacity: 0 needs every child set back to opacity: 1": opacity is a
 * GROUP compositing operation, so a child re-asserting opacity: 1 does not undo a transparent
 * ancestor -- the whole subtree still renders through the parent's alpha. `visibility` is a
 * plain inherited toggle, not a compositing op, so ONE override at the top of what should still
 * render is enough; everything below that node inherits `visible` from THERE, not from
 * `#deck-drawer`. That is why this needs only the drawer's direct children re-asserted, not
 * "all its children" the way opacity would have.
 *
 * `#deck-drawer` keeps its padding, its slide-in `translate`/`opacity` transition and its
 * `position: absolute` box exactly as declared above -- visibility touches paint only, so the
 * drawer still opens, closes and clips precisely as before, just without its own background art. */
#deck-drawer {
    visibility: hidden;
}
.deck-drawer > * {
    visibility: visible;
}
/* The chooser and editor panes used to be their own nested recessed plates (Sam, 2026-09-07:
 * "everything sits in" a card-within-a-card, eating horizontal space to double padding). Both
 * now render directly on the outer drawer's own surface above -- one container, not two -- so
 * there is nothing left for `.deck-chooser-frame`/`.deck-editor` to carry beyond their flex-grow
 * layout rules further up this file. */

.chrome-button {
    min-height: var(--touch-min);
    padding: 0 24px;
    border-width: 0;
    border-radius: 0;
    color: var(--ink-1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: rgb(232, 236, 242);
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}
.chrome-button--primary {
    background-image: url("/Assets/Art/UI/Chrome/ui_button_primary_ember.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.5px;
    color: rgb(250, 230, 193);
}
.chrome-button--secondary {
    background-image: url("/Assets/Art/UI/Chrome/ui_button_secondary_slate.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 36;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
}
.chrome-button:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.chrome-button:active {
    translate: 0 1px;
    -unity-background-image-tint-color: rgb(205, 211, 220);
}
.chrome-button:disabled {
    opacity: 0.42;
}
/* The first-run guide (CollectionController.Light): the controller flips --bright every 1.1s and
 * this eases between the tints, as on the main menu. Tint only darkens, so bright is full value. */
.chrome-button.col-guide {
    -unity-background-image-tint-color: rgb(150, 155, 162);
    transition-property: -unity-background-image-tint-color, opacity, translate;
    transition-duration: 1.1s, 0.1s, 0.1s;
    transition-timing-function: ease-in-out, ease-out, ease-out;
}
.chrome-button.col-guide.col-guide--bright {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
/* The guide's dim (CollectionController.ShowSpotlight). The controller sizes the four shades
 * around the guided button, so they cover the screen except the button itself. --shown displays
 * it at 0 opacity and --lit fades it up a frame later, because a transition does not run from
 * display: none. The ring breathes with the button, on the same 1.1s. */
.col-spotlight {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}
.col-spotlight--shown {
    display: flex;
}
.col-spotlight--lit {
    opacity: 1;
}
.col-spotlight__shade {
    position: absolute;
    background-color: rgba(6, 8, 12, 0.6);
}
.col-spotlight__ring {
    position: absolute;
    border-width: 3px;
    border-radius: 12px;
    border-color: rgba(232, 196, 104, 0.5);
    transition-property: border-color;
    transition-duration: 1.1s;
    transition-timing-function: ease-in-out;
}
.col-spotlight__ring--bright {
    border-color: rgb(255, 222, 132);
}
.col-query-actions .chrome-button {
    min-height: 64px;
    height: 64px;
    padding: 0 20px;
}
.deck-drawer__back.chrome-button {
    min-height: var(--touch-min);
    height: var(--touch-min);
    padding-left: 20px;
    color: var(--ink-1);
    -unity-text-align: middle-left;
}
.deck-drawer__manage.chrome-button {
    min-height: 52px;
    color: rgb(250, 230, 193);
}

.chrome-input {
    min-height: 56px;
    height: 56px;
}
.chrome-input > .unity-base-text-field__input,
.chrome-input .unity-base-popup-field__input {
    min-height: 56px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(8, 12, 18, 0.98);
    background-image: url("/Assets/Art/UI/Chrome/ui_input_recessed_slate.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(224, 229, 236);
    color: var(--ink-1);
    font-size: var(--type-body);
}
.chrome-input > .unity-base-text-field__input:hover,
.chrome-input .unity-base-popup-field__input:hover {
    -unity-background-image-tint-color: rgb(244, 247, 250);
}
.chrome-input > .unity-base-text-field__input:focus {
    -unity-background-image-tint-color: rgb(255, 239, 211);
}

/* ---------- Crafting modal (GH#157 Render / GH#158 Reduce) ----------
 *
 * Declared once, used by both modes. Bound by CraftModal, opened by CollectionController.
 *
 * Both the scrim and the panel are position: absolute against the plate root and both are hidden
 * at rest by an inline display written from code, not from here — CraftModal.Close() is the only
 * writer, and a display rule in this file would fight it. What lives here is what they look like
 * once shown.
 *
 * Percentages throughout, per the sizing ruling, with ONE exception: the card face is a fixed
 * 340x477, holding a card's 276:387 by giving both axes. Change one of those two numbers and you
 * must change the other. CardWall.TileWidth is a fixed 276 and a contract for the same reason.
 *
 * THIS PARAGRAPH USED TO SAY "UI Toolkit has no aspect-ratio property". THAT IS NO LONGER TRUE —
 * `aspect-ratio` is in the Dimensions block of the USS supported-properties table for 6000.5.1f1
 * and Unity's own shadergraph package uses it. The stale claim was read as current on 2026-08-30
 * and cost a wrong diagnosis plus a reverted commit, because a comment asserting what the engine
 * cannot do reads exactly like a comment asserting what it does not do YET. Both axes here are
 * still deliberate — a ratio would not pin the absolute size this face is a contract for — but
 * that is now a CHOICE, not a limitation, and expressing it as one is the point.
 */

.craft-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 14, 19, 0.82);
}

/* Inset on all four edges rather than sized in percentages. The old
   `left:10% top:8% width:80% height:84%` cleared a 2400px landscape by 240 and a
   1080px portrait by 108 -- the same aspect drift that had the shard counter
   landing somewhere different on every device. Offsets on all four sides size it
   as well as place it, so it stays within the screen and cannot overflow the
   way `8% + --edge-safe + 84%` would. Declared in audit_edge_safety.py's
   TOKEN_EXCEPTIONS.

   The frame extends 20px into each safe inset; 24px inner padding keeps content
   4px inside the safe boundary. With the current 52px token, side gutters are
   32px. Top and bottom gutters remain 16px, matching .mm-modal. */
.craft-modal {
    position: absolute;
    left: var(--edge-safe);
    top: var(--space-4);
    right: var(--edge-safe);
    bottom: var(--space-4);
    margin-left: -20px;
    margin-right: -20px;
    background-color: var(--surface-1);
    border-radius: var(--space-3);
    padding: var(--space-6);
    border-width: 1px;
    border-color: var(--surface-3);
}
.craft-illustration,
.craft-illustration-scrim {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
}
.craft-illustration {
    background-image: url("/Assets/Art/Backgrounds/CraftingForge_Backdrop.png");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.82;
}
.craft-illustration-scrim {
    background-color: rgba(5, 8, 12, 0.48);
}

.craft-loading {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
.craft-loading-icon {
    width: 70%;
    height: 70%;
    flex-shrink: 0;
    background-image: url("/Assets/Art/UI/Crafting/craft-loading-alchemy-ring-v1.png");
    -unity-background-scale-mode: scale-to-fit;
}
.craft-modal--loading .craft-head,
.craft-modal--loading .craft-body {
    visibility: hidden;
}
.craft-modal--loading .craft-feedback {
    display: none;
}
.craft-modal--loading .craft-loading {
    display: flex;
}

.craft-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-6);
}
.craft-heading {
    flex-grow: 1;
}
.craft-metadata {
    flex-direction: row;
    align-items: center;
}
.craft-name {
    font-size: var(--type-h1);
    color: var(--ink-1);
    -unity-font-style: bold;
}
.craft-rarity {
    font-size: var(--type-label);
    color: var(--rarity-common);
    -unity-font-style: bold;
}

/* The rarity accent is the fastest read of what a card costs to make — the word and the price are
 * saying the same thing, so they are coloured the same. CraftModal swaps exactly one of these on. */
.craft-rarity--common {
    color: var(--rarity-common);
}
.craft-rarity--rare {
    color: var(--rarity-rare);
}
.craft-rarity--epic {
    color: var(--rarity-epic);
}
.craft-rarity--legendary {
    color: var(--rarity-legendary);
}

/* The balance. #159 put this on the main menu's top edge; this is the same number at the moment it
 * is about to be spent, which is the one place a player actually needs it. */
.craft-wallet {
    flex-direction: row;
    align-items: flex-end;
    margin-right: var(--space-6);
}
/* The way into the bulk Reduce. It sits with the balance because that is what it changes. */
.craft-spares {
    flex-shrink: 0;
    margin-right: var(--space-4);
}
.craft-wallet-value {
    font-size: var(--type-h2);
    color: var(--accent);
    -unity-font-style: bold;
}

.craft-body {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.craft-feedback {
    flex-direction: row;
    align-items: center;
}
.craft-status {
    flex-grow: 1;
    color: var(--ink-2);
    font-size: var(--type-label);
    white-space: normal;
}

.craft-cardpane {
    align-items: center;
    flex-shrink: 0;
    margin-right: var(--space-8);
}
.craft-card-face {
    /* CraftModal fits the face to the full body height. */
    flex-shrink: 0;
    background-color: var(--surface-3);   /* shows through until the bake resolves */
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-to-fit;
}
.craft-set {
    flex-shrink: 0;
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-left: var(--space-6);
}
.craft-owned {
    flex-shrink: 0;
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-left: var(--space-6);
}

/* The two opposite actions share the body's full height. Stacking them forced each panel below its
 * content height; UI Toolkit shrank the panel boxes while their labels and buttons painted through
 * one another. Equal widths keep Render and Reduce peers without sacrificing vertical room. */
.craft-halves {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    justify-content: space-between;
}
.craft-half {
    width: 49%;
    flex-grow: 1;
    background-color: transparent;
    border-radius: var(--space-2);
    padding: var(--space-6);
    margin-bottom: 0;
    justify-content: center;
}
.craft-half-title {
    font-size: var(--type-h2);
    color: var(--ink-1);
    -unity-font-style: bold;
}
.craft-half-blurb {
    font-size: var(--type-caption);
    color: var(--ink-2);
    margin-bottom: var(--space-4);
    white-space: normal;
}
.craft-price {
    flex-direction: row;
    align-items: flex-end;
}
.craft-price-value {
    font-size: var(--type-display);
    color: var(--accent);
    -unity-font-style: bold;
}
.craft-shard-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    align-self: center;
    margin-left: var(--space-2);
    background-image: url("/Assets/Art/UI/Crafting/Currency/craft-shard-cyan-v1.png");
    -unity-background-scale-mode: scale-to-fit;
}
.craft-shard-icon--wallet {
    width: 28px;
    height: 28px;
    margin-left: var(--space-1);
}
.craft-half-note {
    font-size: var(--type-label);
    color: var(--ink-2);
    margin-top: var(--space-1);
    margin-bottom: var(--space-4);
    white-space: normal;
}

/* A half you cannot take right now. It stays READABLE — the price and the reason are exactly what
 * the player came to find out, and a half that dimmed to nothing would answer "can I break this
 * down?" with silence. This is a per-CARD fact like the wall's own treatments, never a mode. */
.craft-half--dead {
    opacity: 0.55;
}

.craft-action {
    width: 60%;
    align-self: center;
    height: 15%;
    min-height: var(--touch-min);             /* touch target floor; mobile-first */
    background-color: var(--accent);
    color: var(--surface-0);
    font-size: var(--type-body);
    -unity-font-style: bold;
    border-radius: var(--space-2);
    border-width: 0;
}
.craft-action:hover {
    background-color: var(--warning);
}
.craft-action:disabled {
    background-color: var(--surface-3);
    color: var(--ink-2);
}

/* Reduce is destructive, so it does not get the ember-gold CTA treatment Render has. It is a real
 * button, not a warning — the confirmation this needs is a surface of its own and is not built. */
.craft-action--ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-1);
    border-width: 1px;
    border-color: var(--surface-3);
}
.craft-action--ghost:hover {
    background-color: var(--surface-3);
}
.craft-action--ghost:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-2);
}

/* How many copies one Reduce takes. Below the note so the price above it and the button below it
 * both read as answers to the number in the middle. */
.craft-stepper {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: var(--space-4);
}
.craft-stepper__button {
    width: 64px;
    height: 64px;
    min-height: 64px;
    padding: 0;
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
}
.craft-stepper__count {
    min-width: 72px;
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---- Spares: the bulk Reduce. The frame, head and price are the craft modal's own classes. ---- */
.spares-summary {
    font-size: var(--type-label);
    color: var(--ink-2);
}
.spares-list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--space-6);
    padding: var(--space-3) var(--space-4);
}
/* A row is a button: each tap takes one copy back out of what will be broken down, the way a tap
 * on a deck line takes a copy out of the deck. */
.spares-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 64px;
    padding: var(--space-2) 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--surface-3);
}
.spares-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}
/* Every copy taken back out. Still listed, so the next tap can put them all back. */
.spares-row--kept {
    opacity: 0.45;
}
.spares-row__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--type-label);
    -unity-font-style: bold;
}
.spares-row__copies {
    flex-shrink: 0;
    width: 120px;
    color: var(--ink-2);
    font-size: var(--type-label);
    -unity-text-align: middle-right;
}
.spares-row__payout {
    flex-shrink: 0;
    width: 96px;
    color: var(--accent);
    font-size: var(--type-label);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}
.spares-side {
    width: 38%;
    flex-shrink: 0;
    padding: var(--space-6);
    justify-content: center;
}
.spares-side.chrome-panel--recessed {
    background-color: transparent;
    background-image: none;
    border-radius: 0;
}
.spares-status {
    flex-grow: 0;
    margin-bottom: var(--space-4);
}
.spares-toggle {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 64px;
    align-items: center;
    margin-bottom: var(--space-4);
}
.spares-toggle > .unity-toggle__input,
.spares-toggle .unity-base-field__label {
    color: var(--ink-1);
    font-size: var(--type-label);
}
.spares-toggle .unity-toggle__checkmark,
.spares-toggle:hover .unity-toggle__checkmark,
.spares-toggle:focus .unity-toggle__checkmark {
    width: 40px;
    height: 40px;
    background-color: var(--surface-0);
    border-width: 2px;
    border-color: var(--ink-2);
    border-radius: var(--space-1);
}
/* Driven by SparesPanel, not `:checked` — the same pattern as .ms-toggle--on. */
.spares-toggle--on .unity-toggle__checkmark,
.spares-toggle--on:hover .unity-toggle__checkmark,
.spares-toggle--on:focus .unity-toggle__checkmark {
    background-color: var(--rarity-legendary);
}

.craft-modal.chrome-panel--outer {
    background-color: rgba(18, 23, 31, 0.98);
    border-width: 0;
    border-radius: 0;
}
.craft-half.chrome-panel--recessed {
    background-color: transparent;
    background-image: none;
    border-radius: 0;
}
.craft-action.chrome-button {
    border-width: 0;
    border-radius: 0;
}
.craft-action.chrome-button--primary,
.craft-action.chrome-button--primary:hover {
    color: rgb(250, 230, 193);
}
.collection-deck-drag-preview {
    position: absolute;
    translate: -50% -50%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.94;
}

/* Inspect the full baked card beside the deck drawer. Ignore picking so wall gestures still work. */
.deck-card-preview {
    display: none;
    position: absolute;
    top: 50%;
    right: 20%;
    translate: 0 -50%;
    width: 360px;
    height: 505px;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-2);
    border-radius: var(--space-2);
    -unity-background-scale-mode: scale-to-fit;
}

.deck-card-preview__fallback {
    color: var(--ink-1);
    font-size: var(--type-h2);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: var(--space-4);
}
.collection-deck-drag-preview > Label {
    background-color: var(--surface-2);
    color: var(--ink-1);
    white-space: normal;
    padding: var(--space-3);
}
.collection-deck-drop-preview {
    position: absolute;
    display: none;
    border-width: 3px;
    border-color: var(--accent);
    border-radius: var(--space-2);
    background-color: rgba(225, 183, 94, 0.08);
}

.craft-action.chrome-button--secondary,
.craft-action.chrome-button--secondary:hover {
    color: var(--ink-1);
}

/* CLEAR CORNERS (Sam, 2026-09-29; the same treatment as `.mm-button` and the shop's buy buttons).
 * Every chrome-art button on this screen has rounded transparent corners, and any fill behind the
 * art -- Unity's default button grey, `.col-button`'s surface, `.craft-action`'s accent, a chip's
 * mana -- shows through them as square caps. Clear in EVERY state, because each of those rules
 * repaints on :hover/:disabled. Last in the file and at three-class specificity so it outranks
 * the per-button fills above without anyone having to remember them. No radius on the
 * chrome-buttons either: a pill radius clips the art's own corners. */
.chrome-button.chrome-button--primary,
.chrome-button.chrome-button--primary:hover,
.chrome-button.chrome-button--primary:active,
.chrome-button.chrome-button--primary:focus,
.chrome-button.chrome-button--primary:disabled,
.chrome-button.chrome-button--secondary,
.chrome-button.chrome-button--secondary:hover,
.chrome-button.chrome-button--secondary:active,
.chrome-button.chrome-button--secondary:focus,
.chrome-button.chrome-button--secondary:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}
.collection .db-chip,
.collection .db-chip:hover,
.collection .db-chip:active,
.collection .db-chip:focus,
.collection .db-chip:disabled,
.collection .db-chip.db-chip--on,
.collection .db-chip.db-chip--on:hover,
.collection .db-chip.db-chip--on:active,
.collection .db-chip.db-chip--on:focus,
.deck-choice,
.deck-choice:hover,
.deck-choice:active,
.deck-choice:focus {
    background-color: rgba(0, 0, 0, 0);
}
