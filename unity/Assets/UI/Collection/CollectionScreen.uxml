<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Common/theme.uss?fileID=7433441132597879392&amp;guid=3131d0e26db176f4fa42842abbfea4d0&amp;type=3#theme"/>
    <Style src="project://database/Assets/UI/Collection/collection.uss?fileID=7433441132597879392&amp;guid=8ec502da397030442998cd90701bbf86&amp;type=3#collection"/>
    <Style src="project://database/Assets/UI/Common/tidbit.uss?fileID=7433441132597879392&amp;guid=59a3d1cad3c148f488a43eafde7ad1ee&amp;type=3#tidbit"/>
    <ui:VisualElement name="root" class="emb-root collection">
        <ui:VisualElement name="body" class="db-body" style="transform-origin: 25%; justify-content: flex-start; overflow: visible;">
            <ui:VisualElement name="collection-panel" class="db-panel db-collection chrome-panel chrome-panel--outer">
                <ui:ListView name="collection-list" class="collection-list chrome-panel chrome-panel--recessed"/>
                <ui:Label name="collection-empty" text="Nothing matches those filters." class="col-empty"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- DECLARED AFTER `body`, ON PURPOSE (Sam, 2026-09-08). UI Toolkit paints later siblings
             over earlier ones and hit-tests the same way, so with this block BEFORE `body` (its
             position until today) every card tile the wall overlaps it with painted, and picked,
             on top of it: the tabs were untargetable wherever a row's tile reached them, no
             matter how much clearance `#collection-panel`'s margin-top left. Declaring it after
             `body` makes "the strip floats over the top of the wall" (the comment on `#class-tab-bar`
             below) literally true in z-order, not just in intent, so a class tab is always
             clickable regardless of how tight the clearance above the wall gets. -->
        <ui:VisualElement name="class-tab-bar">
            <ui:VisualElement name="class-tab-emberward" class="class-tab_art class-tab_art-emberward"/>
            <ui:VisualElement name="class-tab-stonewarden" class="class-tab_art class-tab_art-stonewarden"/>
            <ui:VisualElement name="class-tab-tempest" class="class-tab_art class-tab_art-tempest"/>
            <ui:VisualElement name="class-tab-nightveil" class="class-tab_art class-tab_art-nightveil"/>
            <ui:VisualElement name="class-tab-clockwright" class="class-tab_art class-tab_art-clockwright"/>
            <ui:VisualElement name="class-tab-verdant" class="class-tab_art class-tab_art-verdant"/>
            <ui:VisualElement name="class-tab-tidecaller" class="class-tab_art class-tab_art-tidecaller"/>
            <ui:VisualElement name="class-tab-gravekeep" class="class-tab_art class-tab_art-gravekeep"/>
            <ui:VisualElement name="class-tab-neutral" class="class-tab_art class-tab_art-neutral"/>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="col-query-toolbar">
            <ui:Button name="query-toggle" class="col-button col-button--filters chrome-button chrome-button--primary">
                <ui:Label text="FILTERS" picking-mode="Ignore" class="col-filter-ribbon__label"/>
                <ui:VisualElement picking-mode="Ignore" class="col-filter-ribbon__chevron">
                    <ui:VisualElement picking-mode="Ignore" class="col-filter-ribbon__chevron-arm col-filter-ribbon__chevron-arm--left"/>
                    <ui:VisualElement picking-mode="Ignore" class="col-filter-ribbon__chevron-arm col-filter-ribbon__chevron-arm--right"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:VisualElement picking-mode="Ignore" class="col-query-actions">
                <ui:Button name="spares-button" text="Spares" class="col-button col-button--spares chrome-button chrome-button--secondary"/>
                <ui:Button name="decks-button" text="Decks" class="col-button col-button--decks chrome-button chrome-button--secondary"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="back-button" text="Back" class="emb-back emb-back-button"/>
        <ui:VisualElement name="query-scrim" picking-mode="Ignore" class="col-query-scrim"/>
        <ui:VisualElement name="query-bar" picking-mode="Ignore" class="col-query chrome-panel chrome-panel--outer">
            <ui:ScrollView name="query-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="col-query-scroll">
                <ui:VisualElement class="col-query-row">
                    <ui:TextField name="query-search" placeholder-text="Search cards" hide-placeholder-on-focus="true" emoji-fallback-support="false" class="col-search chrome-input"/>
                </ui:VisualElement>
                <ui:VisualElement class="col-query-utility-row">
                    <ui:VisualElement name="scope-row" class="col-scope">
                        <ui:Button name="scope-owned" text="Owned" class="db-chip db-chip--on"/>
                        <ui:Button name="scope-unowned" text="Unowned" class="db-chip"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="col-chip-group">
                    <ui:VisualElement name="query-rarities" class="col-chip-row"/>
                </ui:VisualElement>
                <ui:VisualElement class="col-chip-group">
                    <ui:VisualElement name="query-types" class="col-chip-row"/>
                </ui:VisualElement>
                <ui:VisualElement class="col-chip-group">
                    <ui:VisualElement name="query-costs" class="col-chip-row"/>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement picking-mode="Ignore" class="emb-scroll-fade col-query__fade"/>
        </ui:VisualElement>
        <ui:VisualElement name="deck-drawer-scrim" class="deck-drawer-scrim"/>
        <ui:VisualElement name="deck-drawer" class="deck-drawer chrome-panel chrome-panel--outer">
            <ui:VisualElement class="deck-drawer__header">
                <ui:Button name="choose-another-deck" text="← All decks" class="deck-drawer__back chrome-button chrome-button--secondary"/>
            </ui:VisualElement>
            <ui:VisualElement name="deck-chooser-frame" class="deck-chooser-frame">
                <ui:ScrollView name="deck-chooser" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="deck-chooser">
                    <ui:VisualElement name="deck-chooser-list" class="deck-chooser__list"/>
                    <ui:Label name="deck-chooser-empty" text="No decks yet." class="deck-chooser__empty"/>
                </ui:ScrollView>
                <ui:VisualElement picking-mode="Ignore" class="emb-scroll-fade deck-chooser__fade"/>
            </ui:VisualElement>
            <ui:VisualElement name="deck-editor" class="deck-editor deck-editor--hidden">
                <ui:VisualElement class="deck-editor__identity">
                    <ui:Label name="count-label" text="0 / 30" class="db-count"/>
                </ui:VisualElement>
                <ui:VisualElement name="curve-strip" class="db-curve"/>
                <ui:ListView name="deck-list" class="db-list"/>
            </ui:VisualElement>
            <ui:Button name="manage-decks-button" text="Manage Decks" class="deck-drawer__manage chrome-button chrome-button--primary"/>
        </ui:VisualElement>
        <ui:VisualElement name="deck-card-preview" picking-mode="Ignore" class="deck-card-preview emb-edge">
            <ui:Label name="deck-card-preview-fallback" picking-mode="Ignore" class="deck-card-preview__fallback"/>
        </ui:VisualElement>
        <ui:VisualElement name="craft-scrim" class="craft-scrim emb-bleed" style="display: flex; visibility: hidden;"/>
        <ui:VisualElement name="craft-modal" class="craft-modal chrome-panel chrome-panel--outer" style="visibility: visible;">
            <ui:VisualElement picking-mode="Ignore" class="craft-illustration"/>
            <ui:VisualElement picking-mode="Ignore" class="craft-illustration-scrim"/>
            <ui:VisualElement class="craft-head">
                <ui:VisualElement class="craft-heading">
                    <ui:Label name="craft-card-name" text="" class="craft-name"/>
                    <ui:VisualElement class="craft-metadata">
                        <ui:Label name="craft-card-rarity" text="" class="craft-rarity"/>
                        <ui:Label name="craft-copies-owned" text="" class="craft-owned"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="craft-wallet">
                    <ui:Label name="craft-shard-balance" text="0" class="craft-wallet-value"/>
                    <ui:VisualElement class="craft-shard-icon craft-shard-icon--wallet" tooltip="Shards"/>
                </ui:VisualElement>
                <ui:Button name="craft-close" text="Close" class="col-button chrome-button chrome-button--secondary emb-back"/>
            </ui:VisualElement>
            <ui:VisualElement class="craft-feedback">
                <ui:Label name="craft-status" class="craft-status" style="display: none;"/>
                <ui:Button name="craft-retry" text="Refresh" class="col-button chrome-button chrome-button--secondary" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="craft-body">
                <ui:VisualElement class="craft-cardpane">
                    <ui:VisualElement name="craft-card-face" class="craft-card-face"/>
                </ui:VisualElement>
                <ui:VisualElement class="craft-halves">
                    <ui:VisualElement name="craft-render-half" class="craft-half chrome-panel chrome-panel--recessed">
                        <ui:Label text="Render" class="craft-half-title"/>
                        <ui:Label text="Spend shards to make this card." class="craft-half-blurb"/>
                        <ui:VisualElement class="craft-price">
                            <ui:Label name="craft-render-cost" text="0" class="craft-price-value"/>
                            <ui:VisualElement class="craft-shard-icon" tooltip="Shards"/>
                        </ui:VisualElement>
                        <ui:Label name="craft-render-note" text="" class="craft-half-note"/>
                        <ui:Button name="craft-render-button" text="Render" class="craft-action chrome-button chrome-button--primary"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="craft-reduce-half" class="craft-half chrome-panel chrome-panel--recessed">
                        <ui:Label text="Reduce" class="craft-half-title"/>
                        <ui:Label text="Break copies down for shards." class="craft-half-blurb"/>
                        <ui:VisualElement class="craft-price">
                            <ui:Label name="craft-reduce-payout" text="0" class="craft-price-value"/>
                            <ui:VisualElement class="craft-shard-icon" tooltip="Shards"/>
                        </ui:VisualElement>
                        <ui:Label name="craft-reduce-note" text="" class="craft-half-note"/>
                        <ui:VisualElement class="craft-stepper">
                            <ui:Button name="craft-reduce-less" text="-" class="craft-stepper__button chrome-button chrome-button--secondary"/>
                            <ui:Label name="craft-reduce-count" text="1" class="craft-stepper__count"/>
                            <ui:Button name="craft-reduce-more" text="+" class="craft-stepper__button chrome-button chrome-button--secondary"/>
                        </ui:VisualElement>
                        <ui:Button name="craft-reduce-button" text="Reduce" class="craft-action craft-action--ghost chrome-button chrome-button--secondary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="craft-loading">
                <ui:VisualElement name="craft-loading-icon" picking-mode="Ignore" class="craft-loading-icon"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- SPARES: the bulk Reduce, driven by SparesPanel. It borrows the craft modal's frame and
             type classes so the two read as one surface; only the spares-* names are its own. -->
        <ui:VisualElement name="spares-scrim" class="craft-scrim emb-bleed"/>
        <ui:VisualElement name="spares-panel" class="craft-modal spares-panel chrome-panel chrome-panel--outer">
            <ui:VisualElement class="craft-head">
                <ui:VisualElement class="craft-heading">
                    <ui:Label text="Reduce Spares" class="craft-name"/>
                    <ui:Label name="spares-summary" text="" class="spares-summary"/>
                </ui:VisualElement>
                <ui:Button name="spares-close" text="Close" class="col-button chrome-button chrome-button--secondary emb-back"/>
            </ui:VisualElement>
            <ui:VisualElement class="craft-body">
                <ui:ScrollView name="spares-list" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="spares-list chrome-panel chrome-panel--recessed"/>
                <ui:VisualElement class="spares-side chrome-panel chrome-panel--recessed">
                    <ui:Label text="Break every spare down for" class="craft-half-blurb"/>
                    <ui:VisualElement class="craft-price">
                        <ui:Label name="spares-total" text="0" class="craft-price-value"/>
                        <ui:VisualElement class="craft-shard-icon" tooltip="Shards"/>
                    </ui:VisualElement>
                    <ui:Label name="spares-note" text="" class="craft-half-note"/>
                    <ui:Toggle name="spares-legendary" label="Include Legendaries" class="spares-toggle"/>
                    <ui:Label name="spares-status" class="craft-status spares-status" style="display: none;"/>
                    <ui:Button name="spares-reduce" text="Reduce All" class="craft-action chrome-button chrome-button--primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- TIDBIT: the first-look card, driven by FirstRunTidbit (#403). LAST CHILD ON PURPOSE:
             UI Toolkit has no z-index, so document order is the only thing putting this over
             everything else on the screen. It starts hidden in the markup AND FirstRunTidbit
             hides it again in its constructor. The same block as CharacterCreateScreen.uxml,
             which carries the notes. No doubled hyphen in this comment: it empties the screen. -->
        <ui:VisualElement name="tidbit-overlay" class="tidbit-overlay tidbit-overlay--hidden">
            <ui:VisualElement name="tidbit-card" class="tidbit-card">
                <ui:VisualElement class="tidbit-header">
                    <ui:Label name="tidbit-title" text="" class="tidbit-title"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-body-row">
                    <ui:VisualElement name="tidbit-art" class="tidbit-art" picking-mode="Ignore"/>
                    <ui:Label name="tidbit-body" text="" class="tidbit-copy"/>
                </ui:VisualElement>
                <ui:VisualElement class="tidbit-actions">
                    <ui:Button name="btn-tidbit-done" text="Got it" class="tidbit-done emb-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
