{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3920249212d84fe9aeabc38f2f6429f6",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GammaGlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 100.0,
            "y": 0.0,
            "width": 240.0,
            "height": 300.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "68e8a827ca544c2287e5708876350317"
        },
        {
            "m_Id": "44733ca3b1a945f7a43ab2ae37eed9aa"
        },
        {
            "m_Id": "46519cbcf65f4f2fa739528c9fffe45d"
        },
        {
            "m_Id": "49195838936d48aca94dc8d62b7c4008"
        },
        {
            "m_Id": "34a0be1aeef34bd5ba28dbbeab472f59"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GammaGlow",
    "m_FunctionSource": "",
    "m_FunctionBody": "// Tuned by eye in Gamma; see Assets/Shaders/Functions/GammaTuned.hlsl.\n#if defined(UNITY_COLORSPACE_GAMMA)\nColor = Rim * GlowColor.rgb * Intensity;\nAlpha = Rim * GlowColor.a;\n#else\nColor = pow(max(Rim * pow(max(GlowColor.rgb, 0.0), 1.0 / 2.2) * Intensity, 0.0), 2.2);\nAlpha = pow(saturate(Rim * GlowColor.a), 2.2);\n#endif"
}
