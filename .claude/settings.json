{
  "permissions": {
    "allow": [
      "ClaudeInChromeDomain(hyper3d.ai)",
      "ClaudeInChromeDomain(cloud.unity.com)",
      "ClaudeInChromeDomain(127.0.0.1:8765)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-retire-session.py\"; [ -f \"$f\" ] || exit 0; command -v python >/dev/null 2>&1 || exit 0; PYTHONIOENCODING=utf-8 python \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true
  }
}
