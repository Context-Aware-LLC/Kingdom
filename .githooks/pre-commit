#!/bin/sh
#
# Keep the artifacts derived from the canonical card rows from separating from them.
#
# A hand-edit to unity/Emberfall/Assets/CardData/*.cards.json silently stales what is generated
# from those rows, and NOTHING in Unity notices. Found red on 2026-08-11, a day after the balance
# edit that opened it.
#
# It used to guard a second artifact too — the baked CardDefinitionSO assets under Assets/Cards,
# reachable only from the Card Authoring window's Bake buttons. That whole path was deleted on
# 2026-08-22: nothing read it at runtime and it belonged to no Addressables group.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# THIS HOOK MUTATES NOTHING. It does not run `git add`, and it does not write to the working
# tree. That is a hard rule here, learned the expensive way on 2026-08-11.
#
# The first version of this hook rebaked the stale asset and staged it with `git add`. That is
# unsafe in a working copy where more than one session is live, because a hook's `git add`
# lands in WHOEVER'S commit is currently running — not the commit of whoever caused the drift.
# It put a card asset into an unrelated deckbuilder merge, which was then pushed.
#
# `git commit -- <paths>` does NOT protect against this, which is the counter-intuitive part and
# the reason this comment is long. During a partial commit git points GIT_INDEX_FILE at a
# temporary index, so a hook's `git add` writes into that temp index and is committed anyway.
# Verified directly: a hook adding derived.txt put derived.txt into `git commit -- theirs.txt`.
#
# So: report and block. The person who edited the rows runs one command and stages the result
# themselves, in their own commit, where it belongs.
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git commit --no-verify   (the Unit lane still catches both)

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ── code-review-graph ────────────────────────────────────────────────────────────────────────
#
# Advisory, never blocking: refreshes the incremental knowledge graph and prints the change
# impact. Deliberately ABOVE the `-z "$STAGED_CARDS"` early exit below — the card-derivation
# checks are scoped to commits that stage card rows, but this one has to see every commit.
# `code-review-graph install` appends its own copy to the END of this file, which is past that
# early exit AND past the final `exit 0`, so the installed version never runs at all. If you
# reinstall, delete what it appends and keep this.
#
# The base is the commit the graph was last built at, not the default HEAD~1: a pull, merge,
# rebase or branch switch moves HEAD without firing a commit hook, and those commits sit behind
# HEAD~1 where a default update would never look at them again.
#
# `detect-changes --brief` is deliberately NOT run here. Its Token Savings panel compares the
# changed files' BYTE SIZE / 4 against the JSON summary's, so it reports a large percentage for
# saying nothing, and its test-gap half counts a .NET suite that was archived out of the repo in
# a9eaa0e3. PYTHONIOENCODING stays because that panel is not the only box-drawn output.
# RETIREMENT TRIGGER: deleting this block retires code-review-graph for this repo. If you do,
# also delete the "Ask the graph before you grep" section at the end of CLAUDE.md and the
# PreToolUse `enrich` hook in .claude/settings.json - both promise a graph that would no longer
# be refreshed, and neither says anything when it is stale rather than absent.
if command -v code-review-graph >/dev/null 2>&1; then
    CRG_BASE=$(code-review-graph status --json 2>/dev/null | python -c "import json,sys; print(json.load(sys.stdin).get('built_at_commit') or '')" 2>/dev/null) || CRG_BASE=
    if [ -n "$CRG_BASE" ] && git cat-file -e "$CRG_BASE^{commit}" 2>/dev/null; then
        PYTHONIOENCODING=utf-8 code-review-graph update --base "$CRG_BASE" --quiet || true
    else
        PYTHONIOENCODING=utf-8 code-review-graph update --quiet || true
    fi

    # `update` re-parses changed files, and the C# parser emits CALLS/INHERITS
    # targets as bare names that upstream's resolver cannot bind (it needs
    # file-level import evidence; C# `using` names a namespace). Re-run the
    # namespace-aware resolver so a commit that touches .cs files does not
    # silently walk the graph back to unresolved. See the module docstring in
    # tooling/scripts/csharp_resolver.py for the measurements.
    if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.cs$'; then
        python tooling/scripts/csharp_resolver.py >/dev/null 2>&1 || true
    fi
fi

# ── Card rows ────────────────────────────────────────────────────────────────────────────────
#
# There is deliberately NO card check here as of 2026-08-22. There was one — check_deck_pool_drift.py,
# which warned when a staged card edit moved DefaultDeckGenerator's output. It was removed because
# the thing it guarded does not exist: the starter deck is generated LIVE from the card database on
# every character creation (CharacterCreation.cs), nothing loads a DefaultDecks fixture at runtime,
# and the fixtures plus DefaultDeckFixtureTests it told you to re-run were archived in a9eaa0e3
# (2026-08-18). It detected real drift and then printed a dotnet test command that exits MSB1003.
#
# What DOES gate card rows is CI Stage 6 — Emberfall.Tools.CardCi over every row of every set — plus
# Stage 6b's trigger/selector drift guard. Neither needs a commit hook. If you want the local
# equivalent before pushing: python tooling/scripts/rebake_card_data.py --check

# ── Addressables groups ──────────────────────────────────────────────────────────────────────
#
# A new art SET FOLDER under Assets/Art/Shop/Packs/ or Assets/Art/Cards/ is INERT until the
# Addressables menu item is re-run: the art resolves through AssetDatabase in the Editor and
# through Addressables in a player, so it renders perfectly here and SHIPS EMPTY. Nothing else
# catches it — AddressablesGuard reported 9/9 ALL PASS on 2026-09-03 while the STARTER set had
# five faces, a valid manifest and no group.
#
# REPORTS AND BLOCKS; IT DOES NOT RUN THE SETUP FOR YOU, and the temptation is real because the
# menu item takes about a second. See the hard rule at the top of this file: a hook's `git add`
# lands in whoever's commit is running, via the temp index a partial commit uses, and the setup
# run rewrites AddressableAssetSettings.asset plus every group asset it touches — shared files,
# so a fixer here would reproduce the 2026-08-11 bug with a bigger blast radius. It also needs an
# Editor, which means it would fail exactly when someone has one open.
#
# Scoped to commits that stage something under a set root, so it is free on every other commit.
# The reasoning lives in the script's docstring; keep the two together.
if command -v python >/dev/null 2>&1; then
    PYTHONIOENCODING=utf-8 python tooling/scripts/check_addressable_groups.py || exit 1
fi

exit 0
