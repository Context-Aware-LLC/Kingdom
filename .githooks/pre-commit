#!/bin/sh
#
# Keep the artifacts derived from the canonical card rows from separating from them.
#
# A hand-edit to unity/Emberfall/Assets/CardData/*.cards.json silently staleness two things, and
# NOTHING in Unity notices: there is no ScriptedImporter, the CardDefinitionSO bake only happens
# on the Card Authoring window's Bake / Bake All buttons, and `Emberfall/Validate All Cards`
# reads the rows without ever opening Assets/Cards. Both were found red on 2026-08-11, a day
# after the balance edit that opened them.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# THIS HOOK MUTATES NOTHING. It does not run `git add`, and it does not write to the working
# tree. That is a hard rule here, learned the expensive way on 2026-08-11.
#
# The first version of this hook rebaked the stale asset and staged it with `git add`. That is
# unsafe in a working copy where more than one session is live, because a hook's `git add`
# lands in WHOEVER'S commit is currently running — not the commit of whoever caused the drift.
# It put a card asset into an unrelated deckbuilder merge, which was then pushed.
#
# `git commit -- <paths>` does NOT protect against this, which is the counter-intuitive part and
# the reason this comment is long. During a partial commit git points GIT_INDEX_FILE at a
# temporary index, so a hook's `git add` writes into that temp index and is committed anyway.
# Verified directly: a hook adding derived.txt put derived.txt into `git commit -- theirs.txt`.
#
# So: report and block. The person who edited the rows runs one command and stages the result
# themselves, in their own commit, where it belongs.
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git commit --no-verify   (the Unit lane still catches both)

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ── code-review-graph ────────────────────────────────────────────────────────────────────────
#
# Advisory, never blocking: refreshes the incremental knowledge graph and prints the change
# impact. Deliberately ABOVE the `-z "$STAGED_CARDS"` early exit below — the card-derivation
# checks are scoped to commits that stage card rows, but this one has to see every commit.
# `code-review-graph install` appends its own copy to the END of this file, which is past that
# early exit AND past the final `exit 0`, so the installed version never runs at all. If you
# reinstall, delete what it appends and keep this.
#
# The base is the commit the graph was last built at, not the default HEAD~1: a pull, merge,
# rebase or branch switch moves HEAD without firing a commit hook, and those commits sit behind
# HEAD~1 where a default update would never look at them again.
#
# PYTHONIOENCODING is not optional: the Token Savings panel is drawn with box characters, and
# git's console is cp1252, so without it every commit prints a UnicodeEncodeError traceback.
if command -v code-review-graph >/dev/null 2>&1; then
    CRG_BASE=$(code-review-graph status --json 2>/dev/null | python -c "import json,sys; print(json.load(sys.stdin).get('built_at_commit') or '')" 2>/dev/null) || CRG_BASE=
    if [ -n "$CRG_BASE" ] && git cat-file -e "$CRG_BASE^{commit}" 2>/dev/null; then
        PYTHONIOENCODING=utf-8 code-review-graph update --base "$CRG_BASE" --quiet || true
    else
        PYTHONIOENCODING=utf-8 code-review-graph update --quiet || true
    fi
    PYTHONIOENCODING=utf-8 code-review-graph detect-changes --brief || true
fi

STAGED_CARDS=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'unity/Emberfall/Assets/CardData/*.cards.json')

if [ -z "$STAGED_CARDS" ]; then
    exit 0
fi

if ! command -v python >/dev/null 2>&1; then
    echo "pre-commit: python not on PATH — skipping the card-derivation checks." >&2
    echo "            Run tooling/scripts/rebake_card_definition_so_assets.py --check by hand." >&2
    exit 0
fi

echo "pre-commit: card rows staged — checking what is derived from them."
echo "$STAGED_CARDS" | sed 's/^/  /'

# ── 1. The baked CardDefinitionSO assets ─────────────────────────────────────────────────────
#
# --check lists every mismatch across all 36 assets rather than stopping at the first, which is
# exactly where the parity test is weak: its Assert.Multiple sits inside a foreach, so the test
# only ever names the alphabetically-first stale asset.
if ! REPORT=$(python tooling/scripts/rebake_card_definition_so_assets.py --check); then
    echo "$REPORT"
    cat >&2 <<'BLOCKED'

pre-commit: BLOCKED — baked CardDefinitionSO assets disagree with the card rows.

Nothing in Unity will fix this for you: there is no ScriptedImporter, and
`Emberfall/Validate All Cards` reads the rows without ever opening Assets/Cards.

  python tooling/scripts/rebake_card_definition_so_assets.py --write

then stage the assets it rewrites and commit again. Staging is left to you on purpose —
a hook that stages files puts them in whichever commit happens to be running, which is
not always yours.
BLOCKED
    exit 1
fi
echo "$REPORT"

# ── 2. The generated starter decks ───────────────────────────────────────────────────────────
#
# Advisory, never blocking: regenerating needs a dotnet build, far too slow for a commit hook,
# and the new decks deserve eyes rather than a rubber stamp. DefaultDeckFixtureTests is the
# real gate; this only says so at the moment of the edit instead of after a CI round trip.
python tooling/scripts/check_deck_pool_drift.py

exit 0
