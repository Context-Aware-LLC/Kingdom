# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# .NET build output (the Emberfall.Core solution)
[Bb]in/
[Oo]bj/
.dotnet-build/
# CI gate evidence — regenerated every run, never committed
artifacts/

# Unity (for when the presentation/client code lands)
[Ll]ibrary/
[Tt]emp/
[Ll]ogs/
[Uu]ser[Ss]ettings/
# Player builds (M2 D1) — distributed as zips per decision 16, never committed
[Bb]uilds/

# NOTE: *.csproj / *.slnx / *.asmdef are NOW tracked source — the deterministic core is real
# code under src/ and tests/. Do not blanket-ignore project files anymore.

# Art generation corpus. NOT scratch — keep indefinitely (Sam, 2026-07-23). The frames and
# templates we build are slots meant to hold a variety of art, so unpicked candidates are not
# losers; they are seed material for future generations. Ignored because it is large and binary,
# not because it is disposable. Assets/ holds what a build needs; this holds what we can draw on.
art-bakeoff/*
# …except the calibrated card-frame finals (cuts + measured geometry), which the
# mock/render pipeline consumes directly (spec: docs techart/card-rendering.md §3.1)
!art-bakeoff/frames
art-bakeoff/frames/*
!art-bakeoff/frames/Frame_*_cut.png
!art-bakeoff/frames/Frame_*_fit.json

# Python bytecode from the tooling/scripts generators
__pycache__/

# Local secrets (Gemini key etc.) - never commit
.env

# Agent Related
.claude
# Vendor-installed agent skills — .claude/skills/* are symlinks into here.
# Content is disposable; skills-lock.json (tracked) pins source + hash to reinstall it.
.agents

# Scratch match-replay logs from bot/networked smoke tests - disposable
scratch-replays/

# Unity AI-generation cache (Assistant/asset-gen scratch) - never commit
unity/Emberfall/GeneratedAssets/

# Loading-screen preview scratch renders (regenerable via offscreen rig)
/wordmark_preview.png

# Playwright MCP session artifacts
.playwright-mcp/

