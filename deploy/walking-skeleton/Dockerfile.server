# Emberfall.Net.Server image (B1 commit 2, hist-docs/source-snapshots/2026-07-31-pre-reorganization/engineering/b1-match-server-design.md §11).
# BUILD CONTEXT IS THE REPO ROOT (RC F4): the server references five sibling src/ projects and
# bakes in the canonical card data — the echo's self-contained single-project context does not
# transfer. From deploy/walking-skeleton: docker compose build (context: ../..).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY src/ src/
RUN dotnet publish src/Emberfall.Net.Server/Emberfall.Net.Server.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
# Card definitions: source of truth stays unity/Emberfall/Assets/CardData (design §10).
COPY unity/Emberfall/Assets/CardData/ /app/cards/
# AI-opponent bot roster (2026-08-09 matchmaking fallback) — a null/unset EMBERFALL_BOT_ROSTER
# leaves bot-fill off, so both lines below must land together or the feature silently stays dark.
COPY tooling/data/bot-roster.json /app/bot-roster.json
# /data is the Fly volume (fly.toml [mounts], vol_rkgwj19p5yykeyo4). Both of these MUST point
# inside it: the container filesystem is replaced on every deploy, so a relative default would
# collect telemetry that looks healthy right up until the next machine swap eats it (C-G1-8).
ENV EMBERFALL_CARDS=/app/cards \
    EMBERFALL_BOT_ROSTER=/app/bot-roster.json \
    EMBERFALL_REPLAYS=/data/replays \
    EMBERFALL_TELEMETRY=/data \
    ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Emberfall.Net.Server.dll"]
