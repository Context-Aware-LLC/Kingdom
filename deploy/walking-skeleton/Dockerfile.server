# Kingdom.Net.Server image (B1 commit 2, hist-docs/source-snapshots/2026-07-31-pre-reorganization/engineering/b1-match-server-design.md §11).
# BUILD CONTEXT IS THE REPO ROOT (RC F4): the server references five sibling src/ projects and
# bakes in the canonical card data — the echo's self-contained single-project context does not
# transfer. From deploy/walking-skeleton: docker compose build (context: ../..).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY src/ src/
# -r linux-x64: ONNX Runtime ships a native library per platform, and a publish without a runtime
# copies all of them (the package is 160 MB). With it, only the 29 MB Linux one comes along.
RUN dotnet publish src/Kingdom.Net.Server/Kingdom.Net.Server.csproj -c Release -r linux-x64 \
    --self-contained false -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
# Card definitions: source of truth stays unity/Assets/CardData (design §10).
COPY unity/Assets/CardData/ /app/cards/
# AI-opponent bot roster (2026-08-09 matchmaking fallback) — a null/unset KINGDOM_BOT_ROSTER
# leaves bot-fill off, so both lines below must land together or the feature silently stays dark.
COPY tooling/data/bot-roster.json /app/bot-roster.json
# The network every bot seat plays (export-onnx), run in-process by ONNX Runtime. Unset
# KINGDOM_BOT_MODEL and bots play Greedy; set it to a directory that will not load and the
# server refuses to start rather than quietly serve Greedy.
# The folder is gitignored and filled by deploy/walking-skeleton/fetch-bot-model.ps1 from the private
# training repo; run that before building. The two files are named because COPY of an empty
# directory succeeds and ships a server with no model.
COPY tooling/data/bot-model/model.onnx tooling/data/bot-model/bot-model.json /app/bot-model/
# The network a newcomer's SECOND match is played against (launch item 5, Sam 2026-10-26): H1,
# checkpoint 978b89297989, pinned. Never the moving champion above. Unset
# KINGDOM_BOT_MODEL_SECOND_MATCH and game 2 is Greedy too; set it to a directory that will not load
# and the server refuses to start.
COPY tooling/data/bot-model-h1/ /app/bot-model-h1/
# /data is the Fly volume (fly.toml [mounts], vol_rkgwj19p5yykeyo4). All durable outputs MUST point
# inside it: the container filesystem is replaced on every deploy, so a relative default would
# collect telemetry that looks healthy right up until the next machine swap eats it (C-G1-8).
ENV KINGDOM_CARDS=/app/cards \
    KINGDOM_BOT_ROSTER=/app/bot-roster.json \
    KINGDOM_BOT_MODEL=/app/bot-model \
    KINGDOM_BOT_MODEL_SECOND_MATCH=/app/bot-model-h1 \
    KINGDOM_REPLAYS=/data/replays \
    KINGDOM_TRAINING_INBOX=/data/training-inbox \
    KINGDOM_TELEMETRY=/data \
    ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Kingdom.Net.Server.dll"]
