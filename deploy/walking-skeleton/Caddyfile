# Caddy auto-TLS reverse proxy for the walking skeleton (C-G0-6, now fronting the B1 server).
# {$DOMAIN} and {$EMAIL} come from the environment (see .env.example).
# Caddy provisions a Let's Encrypt cert automatically on first request.

{
	email {$EMAIL}
}

{$DOMAIN} {
	# WebSocket upgrade + normal HTTP both proxy to the match server (service + port move
	# together with docker-compose.yml — RC F4).
	reverse_proxy emberfall-server:8080 {
		# Immediate streaming, no response buffering — standard hygiene for a wss proxy.
		# (NB: not the fix for the 2026-07-19 connect-hang; that was a degraded stale server
		# process on the tiny box, cleared by a fresh redeploy — see gbrain/native memory.)
		flush_interval -1
	}
}
