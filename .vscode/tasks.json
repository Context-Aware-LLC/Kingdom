{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs by itself when this folder is opened. Asks one question: of the work we've
      // built but not pushed, which spec sections describe it? Harvested from the doc
      // citations already sitting in the source comments — nothing to remember, nothing
      // to maintain. See the header of tools/ci/docs-touched.sh for why this exists.
      //
      // First time VS Code sees this it will ask whether to allow automatic tasks.
      // Answer "Allow" (or run: Terminal > Configure Tasks > Allow Automatic Tasks).
      "label": "docs: what did we change that the specs describe?",
      "type": "shell",
      "command": "bash",
      "args": ["tools/ci/docs-touched.sh", "--unpushed"],
      "options": { "cwd": "${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true,
        "close": false
      },
      "problemMatcher": []
    },
    {
      // Same thing, scoped to what you're about to commit. Bind it or run it from the
      // command palette before a commit that changes behaviour.
      "label": "docs: check staged changes",
      "type": "shell",
      "command": "bash",
      "args": ["tools/ci/docs-touched.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
