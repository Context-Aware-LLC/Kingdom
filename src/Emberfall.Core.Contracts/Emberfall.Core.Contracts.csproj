<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Core.Contracts — the integration surface (dev-docs/architecture/system-overview.md:11).
    Plain C#, ZERO UnityEngine references (dev-docs/architecture/system-overview.md:9).
    Targets netstandard2.1 so the identical DLL loads in Unity (LTS), the
    headless dedicated server, and plain `dotnet test` CI (dev-docs/quality/testing-and-ci.md:20).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emberfall.Core.Contracts</AssemblyName>
    <RootNamespace>Emberfall.Core.Contracts</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Firewall, layer 1: no Unity engine refs are even available here. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emberfall.Core" />
    <InternalsVisibleTo Include="Emberfall.Core.Serialization" />
    <InternalsVisibleTo Include="Emberfall.Net.Protocol" />
    <InternalsVisibleTo Include="Emberfall.Core.Tests" />
  </ItemGroup>

</Project>
