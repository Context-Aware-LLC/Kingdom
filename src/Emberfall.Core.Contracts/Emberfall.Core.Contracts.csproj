<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Core.Contracts — the integration surface (interfaces.md).
    Plain C#, ZERO UnityEngine references (ARCHITECTURE.md §2/§3).
    Targets netstandard2.1 so the identical DLL loads in Unity (LTS), the
    headless dedicated server, and plain `dotnet test` CI (test-strategy.md §1.1).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emberfall.Core.Contracts</AssemblyName>
    <RootNamespace>Emberfall.Core.Contracts</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Firewall, layer 1: no Unity engine refs are even available here. -->
  </PropertyGroup>

</Project>
