<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kingdom.Tools.CollectionSelfCheck — the EF-046 DONE-WHEN harness.

    Satisfies "a scripted self-check creates a character, builds a legal 30-card deck, saves,
    reloads it from disk in a fresh session, and reports queue-eligible" without a Unity seat.

    Deliberately pure Kingdom.Core.Collection: it exercises the exact stores, validator and
    eligibility policy the deckbuilder binds (PlayerAccount is a thin Unity facade over these,
    2 UnityEngine touches), so a green run here is evidence about the shipping path rather than
    about a parallel test double. That is also why it is a tool and not a test — "a fresh
    session" is only honest if it is a second OS process re-reading the same files, which an
    in-process fixture cannot claim.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Kingdom.Tools.CollectionSelfCheck</AssemblyName>
    <RootNamespace>Kingdom.Tools.CollectionSelfCheck</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kingdom.Core.Cards\Kingdom.Core.Cards.csproj" />
    <ProjectReference Include="..\Kingdom.Core.Collection\Kingdom.Core.Collection.csproj" />
    <ProjectReference Include="..\Kingdom.Core.Contracts\Kingdom.Core.Contracts.csproj" />
  </ItemGroup>

</Project>
