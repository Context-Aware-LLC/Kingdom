<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Net.Client — the B3 client seam (dev-docs/architecture/system-overview.md:17).
    NetworkedMatchSession : IMatchSession over an IWireTransport, the connection state machine,
    verify-GATED wholesale snapshot apply (RC-F8), the RC-F7 TrySetResult+log interim, and the
    in-memory LoopbackTransport that peers against B1's REAL MatchSession (§8). netstandard2.1 so
    it compiles inside Unity (UPM package) on Mono/IL2CPP desktop; ZERO UnityEngine references, no
    float code path. References Contracts + Serialization (to re-hash the mirror) + Protocol; it
    NEVER references Emberfall.Core — the client decodes an already-projected snapshot and touches
    no rules/host/projector (ADR-0006).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emberfall.Net.Client</AssemblyName>
    <RootNamespace>Emberfall.Net.Client</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emberfall.Core.Contracts\Emberfall.Core.Contracts.csproj" />
    <ProjectReference Include="..\Emberfall.Core.Collection\Emberfall.Core.Collection.csproj" />
    <ProjectReference Include="..\Emberfall.Core.Serialization\Emberfall.Core.Serialization.csproj" />
    <ProjectReference Include="..\Emberfall.Net.Protocol\Emberfall.Net.Protocol.csproj" />
  </ItemGroup>

</Project>
