<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kingdom.Tools.StoreReconcile — EF-080c reconciliation report (store transactions vs ledger).
    Read-only: queries entitlement_grant in Postgres, asks Google Play about each granted order and
    for its voided purchases, and prints the finding categories: investigate, owed-clawback.
    Credential-gated (KINGDOM_ACCOUNTS_DB, KINGDOM_PLAY_SERVICE_ACCOUNT), so it lives here rather than in CI.
    Modelled on Kingdom.Tools.TelemetryVerify.

    Usage:
      KINGDOM_ACCOUNTS_DB=... KINGDOM_PLAY_SERVICE_ACCOUNT=... dotnet run -p src/Kingdom.Tools.StoreReconcile

    Exit 0 = no issues; 1 = issues found; 2 = misconfiguration.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Kingdom.Tools.StoreReconcile</AssemblyName>
    <RootNamespace>Kingdom.Tools.StoreReconcile</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kingdom.Net.Server\Kingdom.Net.Server.csproj" />
  </ItemGroup>

</Project>
