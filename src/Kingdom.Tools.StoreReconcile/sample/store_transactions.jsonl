// EF-080c stub feed. Replace with a real platform export once EF-080d lands.
// Lines starting with // are comments and are skipped by StoreTransactionFeed.
//
// "purchase" rows: the store charged the player and we should have a ledger grant.
// "refund"   rows: the store reversed the charge and we should have a clawback in the ledger.
//
// To exercise all three finding categories with a live DB:
//   - txn-demo-001: a real purchase present in the ledger (CLEAN)
//   - txn-demo-002: a purchase the callback never delivered (OWED GOODS)
//   - ref-demo-001: a refund already clawed back (CLEAN)
//   - ref-demo-002: a refund that was never reversed (OWED CLAWBACK)
// A row in the ledger with no corresponding purchase in this file would surface as INVESTIGATE.
{"kind":"purchase","txn_id":"txn-demo-001","player_id":"player-demo-aaa"}
{"kind":"purchase","txn_id":"txn-demo-002","player_id":"player-demo-bbb"}
{"kind":"refund","refund_id":"ref-demo-001","original_txn_id":"txn-demo-001","player_id":"player-demo-aaa"}
{"kind":"refund","refund_id":"ref-demo-002","original_txn_id":"txn-demo-999","player_id":"player-demo-ccc"}
