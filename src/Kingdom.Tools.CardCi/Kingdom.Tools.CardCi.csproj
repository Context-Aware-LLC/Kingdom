<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kingdom.Tools.CardCi — the pure-.NET card-validation CI stage (hist-docs/source-snapshots/2026-07-31-pre-reorganization/project/M2-KICKOFF.md WS C3,
    dev-docs/quality/testing-and-ci.md:12). Deliberately NOT the spec's Unity-batchmode CardCI: it runs
    license-free on any runner, over the flat-file-per-set card JSON, using the same shared
    CardValidator + CardJson the client and server load through (R1 — one parser, no drift).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Kingdom.Tools.CardCi</AssemblyName>
    <RootNamespace>Kingdom.Tools.CardCi</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kingdom.Core.Cards\Kingdom.Core.Cards.csproj" />
  </ItemGroup>

</Project>
