<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Emberfall.Core.Collection — Character (dual-class pairing) + deck list/legality (D4/D9,
    ui/collection-deckbuilder.md). Plain C#, ZERO UnityEngine references, so the identical L1-L5
    predicate that gates the deckbuilder's Save button can also re-run server-side at match-join
    (never trust the client) — same portability contract as Emberfall.Core.Cards (R1).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emberfall.Core.Collection</AssemblyName>
    <RootNamespace>Emberfall.Core.Collection</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emberfall.Core.Contracts\Emberfall.Core.Contracts.csproj" />
    <ProjectReference Include="..\Emberfall.Core.Cards\Emberfall.Core.Cards.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same version Emberfall.Core.Cards pins — one System.Text.Json in the Unity project. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
