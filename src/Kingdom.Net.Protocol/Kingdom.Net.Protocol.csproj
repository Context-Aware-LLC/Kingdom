<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kingdom.Net.Protocol — the wire vocabulary + codec (A5, dev-docs/contracts/wire-protocol.md:7).
    JSON envelope v=1, ratified message set, hash-per-message (ADR-0003: hash over the canonical
    serialized form, never the transport bytes). Hand-rolled dependency-free JSON — this assembly
    also compiles inside Unity (UPM package), where System.Text.Json does not exist; one codec,
    both ends, no parallel parser surfaces. ZERO UnityEngine references, no float code path.
    References Contracts + Serialization directly as a sibling of Core (dev-docs/architecture/system-overview.md:13);
    it never references Kingdom.Core — the protocol never touches rules, projection, or hosts.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Kingdom.Net.Protocol</AssemblyName>
    <RootNamespace>Kingdom.Net.Protocol</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kingdom.Core.Contracts\Kingdom.Core.Contracts.csproj" />
    <ProjectReference Include="..\Kingdom.Core.Serialization\Kingdom.Core.Serialization.csproj" />
  </ItemGroup>

</Project>
